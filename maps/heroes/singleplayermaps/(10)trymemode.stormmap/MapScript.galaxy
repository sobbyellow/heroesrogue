//--------------------------------------------------------------------------------------------------
void gt_OpenGatesTimerStartsDisplayTimers_Init () {
    gt_OpenGatesTimerStartsDisplayTimers = TriggerCreate("gt_OpenGatesTimerStartsDisplayTimers_Func");
    TriggerAddEventTimer(gt_OpenGatesTimerStartsDisplayTimers, libGame_gv_openTheGatesTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Regen Globe Generator Gains Behavior
//--------------------------------------------------------------------------------------------------
bool gt_RegenGlobeGeneratorGainsBehavior_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libGame_gv_gameOver == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libSCHO_gf_MMHODisplayRegenGlobeGeneratorTimer(EventUnit());
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RegenGlobeGeneratorGainsBehavior_Init () {
    gt_RegenGlobeGeneratorGainsBehavior = TriggerCreate("gt_RegenGlobeGeneratorGainsBehavior_Func");
    TriggerAddEventUnitBehaviorChange(gt_RegenGlobeGeneratorGainsBehavior, UnitRefFromUnit(UnitFromId(134)), "GenerateRegenGlobe", c_unitBehaviorChangeActivate);
    TriggerAddEventUnitBehaviorChange(gt_RegenGlobeGeneratorGainsBehavior, UnitRefFromUnit(UnitFromId(229)), "GenerateRegenGlobe", c_unitBehaviorChangeActivate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Regen Globe Generator Creates Globe
//--------------------------------------------------------------------------------------------------
bool gt_RegenGlobeGeneratorCreatesGlobe_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnitCreatedUnit()) == "RegenGlobeNeutral"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    AIAddCollectable(EventUnitCreatedUnit(), "CollectHealthPack", 1.0);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RegenGlobeGeneratorCreatesGlobe_Init () {
    gt_RegenGlobeGeneratorCreatesGlobe = TriggerCreate("gt_RegenGlobeGeneratorCreatesGlobe_Func");
    TriggerAddEventUnitCreated(gt_RegenGlobeGeneratorCreatesGlobe, null, null, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_InitializeMap_Init();
    gt_InitializeMapMechanic_Init();
    gt_MapMechanicIntroCallback_Init();
    gt_OpenGatesTimerStartsDisplayTimers_Init();
    gt_RegenGlobeGeneratorGainsBehavior_Init();
    gt_RegenGlobeGeneratorCreatesGlobe_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitTriggers();
}
