libAffx_Filter libAffx_filterDifficulty;

// ============================================================
// Rarity Data
// ============================================================

fixed libAffx_commonToUncommon    =   0.25;
fixed libAffx_commonToRare        =   0.05;
fixed libAffx_commonToEpic        =   0.025;
fixed libAffx_commonToLegendary   =   0.005;

fixed libAffx_uncommonToRare      =   0.125;
fixed libAffx_uncommonToEpic      =   0.075;
fixed libAffx_uncommonToLegendary =   0.01;

fixed libAffx_rareToEpic          =   0.20;
fixed libAffx_rareToLegendary     =   0.015;

fixed libAffx_epicToLegendary     =   0.02;

// ============================================================
// Affix Data
// ============================================================

libAffx_AffixData[libAffx_maxAffixes + 1] libAffx_affixes;
