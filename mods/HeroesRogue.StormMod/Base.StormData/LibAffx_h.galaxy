// ============================================================
// Structs
// ============================================================

struct libAffx_DialogAffixSelectionItem {
    int background;
    int affixBackground;
    int selectButton;
    int banButton;
    int icon;
    int iconOverlay;
    int nameLabel;
    int tooltipLabel;
    int rarityLabel;
};

struct libAffx_DialogAffixSelection {
    int dialog;
    int titleLabel;
    int rerollButton;
    int rerollLabel;
    int banLabel;
    libAffx_DialogAffixSelectionItem[libAffx_maxAffixSelection + 1] items;
};

struct libAffx_DialogOwnedAffixesItem {
    int icon;
    int iconOverlay;
    int nameLabel;
    int cooldownLabel;
};

struct libAffx_DialogOwnedAffixes {
    int dialog;
    int label;
    int nextButton;
    int previousButton;
    libAffx_DialogOwnedAffixesItem[libAffx_maxAffixes + 1] items;
};

struct libAffx_DialogOptionsItem {
    int label;
    int button;
    int checkbox;
};

struct libAffx_DialogOptions {
    int dialog;
    int label;
    int optionIndex;
    int frame;
    libAffx_DialogOptionsItem[libAffx_maxOptionDialogs + 1] option;
};

struct libAffx_DialogGameover {
    int dialog;
    int label;
    int continueButton;
    int restartButton;
    int exitButton;
    int leftStats;
    int middleStats;
    int rightStats;
};

struct libAffx_DialogAchievementsItem {
    int button;
    int label;
    int overlay;
};

struct libAffx_DialogAchievements {
    int dialog;
    int label;
    int closeButton;
    int resetButton;
    libAffx_DialogAchievementsItem[libAffx_maxAchievements + 1] achievement;
};

struct libAffx_Filter {
    unitfilter unitFilter;
    int requiredPlayer;
    string[libAffx_maxFilters + 1] requiredUnitTypes;
    int requiredUnitTypeIndex;
    string[libAffx_maxFilters + 1] excludedUnitTypes;
    int excludedUnitTypeIndex;
};

struct libAffx_CatalogModification {
    int player;
    int type;
    int operation;
    string reference;
    fixed value;
};

struct libAffx_Behavior {
    int player;
    string behavior;
    bool affectedByCount; // Whether behavior stacks scales with affix stacks.
    bool disallowManaUsers;
    bool onlyManaUsers;
};

struct libAffx_Trigger {
    int type;
    string name;
    string arg1;
    bool init;
    bool hasExecuted;
};

struct libAffx_Quest {
    bool isQuest;
    bool questDone;
    bool questProgressPersists;
    int questProgress;
    string tokenBehavior;
    fixed retainModifier;
    fixed tokenCount;
};

struct libAffx_QueuedAffix {
    int overrideAffix;
    int rarity;
    bool curse;
    int level;
    bool lockRarity;
    int choiceCount;
    bool rerollDisabled;
};

struct libAffx_Achievement {
    string name;
    int difficulty;
    bool earned;
    int type;
    int hero;
    string icon;
    int round;
    int timeRequired;
    int roundRequired;
};

struct libAffx_AffixData {
    string name;
    string icon;

    int count; // Current number of stacks of the affix.
    int max; // Maximum amount allowed. 0 = Infinite

    int rarity;
    int weight; // Weight used for rolling affixes. Higher number = More likely.

    int minLevel; // Minimum level requirement. 0 = No requirement
    int maxLevel; // Maximum level requirement. 0 = No requirement

    bool curse;
    int skipCurses;

    bool enabled;
    bool shouldExecute;

    bool cannotRoll;
    bool banned;

    int[libAffx_maxRequirements + 1] excludedAffixes; // List of mutually exclusive affixes.
    int[libAffx_maxRequirements + 1] requiredAffixes; // List of required affixes.
    int excludedCount;
    int requiredCount;
    bool requiresMaxStacks; // If required affixes also require maximum stacks.
    
    bool[libAffx_maxMaps + 1] allowedMap; // List of Map requirements
    bool[libAffx_maxHeroes + 1] allowedHero; // List of Hero requirements.
    bool heroExclusive;
    bool[libAffx_maxHeroes + 1] customTooltipForHero; 
    bool customTooltipForNonManaUsers;
    bool alwaysAppendTooltip;

    int minDifficulty;
    int minRound;

    string[libAffx_maxTalents + 1] addTalents;
    string[libAffx_maxTalents + 1] showTalents;
    string[libAffx_maxTalents + 1] disableTalents;
    string[libAffx_maxTalents + 1] requiredTalents;
    int requiredTalentsCount;
    bool talentsApplied;

    libAffx_CatalogModification[libAffx_maxCatalogModifications + 1] catalogModifications;
    libAffx_Behavior[libAffx_maxBehaviors + 1] behaviors;
    libAffx_Behavior[libAffx_maxBehaviors + 1] affixBehaviors;
    libAffx_Behavior[libAffx_maxBehaviors + 1] removeBehaviors;
    libAffx_Trigger[libAffx_maxTriggers + 1] triggers;
    trigger[libAffx_maxTriggers + 1] createdTriggers;

    libAffx_Quest quest;
    libAffx_Quest[libAffx_maxQuests + 1] questRetain;

    string cooldownLink;
    fixed cooldown;
    bool cooldownHidden;

    fixed customValue;
    bool customBool;

    int lastSeen;

    bool excludeChoGall;
    bool ignoredForStats;
};

