include "AffixTriggers"

int[8] libAffx_NazeeboTalents;
fixed libAffx_NazeeboZombieHandlerRange = 12;
fixed libAffx_NazeeboZombieHandlerChance = 0.5;
fixed libAffx_NazeeboZombieHandlerAdditionalChance = 0;
bool libAffx_NazeeboZombieHandlerAllowFriendlies = false;
fixed libAffx_NazeeboHardyBonesModifier;
int libAffx_NazeeboManyRitualsTotal;
int libAffx_NazeeboRitualOfBoonsIndex;
fixed libAffx_NazeeboMasterWebweaverChance = 0.5;
// ---------------------------------------------------------------
// Nazeebo - Add an empty talent when all talents on a tier are unavailable
// ---------------------------------------------------------------
bool libAffx_NazeeboTalent7 (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_NazeeboTalents[3] += 1;
    if (libAffx_NazeeboTalents[3] == 3) {
        libAffx_ShowTalent("DoNothing7", true);
    }
    return true;
}
// ---------------------------------------------------------------
// Diseased Zombies
// ---------------------------------------------------------------
bool libAffx_NazeeboDiseasedZombiesUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int owner = UnitGetOwner(deadUnit);
    int random;
    if (testConds) {
        if (owner != libAffx_player) {
            return false;
        }
        if (UnitGetType(deadUnit) != "WitchDoctorZombieWallUnit" && UnitGetType(deadUnit) != "WitchDoctorZombieWallDeadRushTalentUnit") {
            return false;
        }
        if (PlayerHasTalent(owner, "WitchDoctorDeadRush") && UnitGetType(deadUnit) == "WitchDoctorZombieWallUnit") {
            return false;
        }
    }
    if (!runActions) {
        return true;
    } 
    random = RandomInt(1, 100);
    if (random <= libAffx_NazeeboMasterWebweaverChance * 100) {
        UnitCreateEffectUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "NazeeboCorpseSpidersSpawnImpactSet", deadUnit);
    }
    return true;
}
// ---------------------------------------------------------------
// Diseased Toads
// ---------------------------------------------------------------
bool libAffx_NazeeboDiseasedToadsUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int owner = UnitGetOwner(deadUnit);
    int random;
    if (testConds) {
        if (owner != libAffx_player) {
            return false;
        }
        if (UnitGetType(deadUnit) != "WitchDoctorPlagueofToadsUnit") {
            return false;
        }
    }
    if (!runActions) {
        return true;
    } 
    random = RandomInt(1, 100);
    if (random <= libAffx_NazeeboMasterWebweaverChance * 100) {
        UnitCreateEffectUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "NazeeboCorpseSpidersSpawnImpactSet", deadUnit);
    }
    return true;
}

// ---------------------------------------------------------------
// Power Ritual
// ---------------------------------------------------------------
bool libAffx_NazeeboPowerRitualScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_SetDefaultLevelScaling("Effect,WitchDoctorHeroWeaponDamageSplash,Amount", player);

    return true;
}

// ---------------------------------------------------------------
// Zombie Handler
// ---------------------------------------------------------------
bool libAffx_NazeeboZombieHandlerAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_CatalogReferenceSet("Sound,WitchDoctor_Zombie_AttackLaunch,Volume", libAffx_player, "-20,-20");
    libAffx_CatalogReferenceSet("Sound,WitchDoctor_Zombie_Attack_Impact,Volume", libAffx_player, "-20,-20");
    libAffx_CatalogReferenceSet("Sound,WitchDoctor_Zombie_Birth,Volume", libAffx_player, "-8,-8");
    libAffx_CatalogReferenceSet("Sound,WitchDoctor_Zombie_Chase_Vox,Volume", libAffx_player, "-20,-20");
    libAffx_CatalogReferenceSet("Sound,WitchDoctor_Zombie_Death,Volume", libAffx_player, "-20,-20");
    
    return true;
}
bool libAffx_NazeeboZombieHandlerUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    point npcPosition = UnitGetPosition(deadUnit);
    int random;
    unit heroUnit = libAffx_GetPlayerHeroUnit(libAffx_player);
    int killingPlayer = libNtve_gf_KillingPlayer();
    if (testConds) {
        if (libAffx_NazeeboZombieHandlerAllowFriendlies) {
            if (!libAffx_UnitIsMinion(deadUnit)) {
                return false;
            }
        } else {
            if (!libAffx_UnitIsMinion(deadUnit) || UnitGetOwner(deadUnit) != libAffx_teamChaos) {
                return false;
            }
        }
        if (!UnitIsAlive(heroUnit)) {
            return false;
        }
        if (UnitFilterMatch(heroUnit, libAffx_player, UnitFilter(0, (1 << (c_targetFilterStasis - 32)), 0, 0))) {
            return false;
        }
    }
    if ((DistanceBetweenPoints(UnitGetPosition(heroUnit), npcPosition) <= libAffx_NazeeboZombieHandlerRange) || killingPlayer == libAffx_player) {
        random = RandomInt(1, 100);
        if (random <= libAffx_NazeeboZombieHandlerChance * 100) {
            UnitCreateEffectPoint(heroUnit, "NazeeboZombieHandlerCreatePersistent", npcPosition);
        }
        if (random <= libAffx_NazeeboZombieHandlerAdditionalChance * 100) {
            UnitCreateEffectPoint(heroUnit, "NazeeboZombieHandlerCreatePersistent", npcPosition);
        }
    }
    return true;
}
// ---------------------------------------------------------------
// Hardy Bones
// ---------------------------------------------------------------
bool libAffx_NazeeboHardyBonesAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_NazeeboHardyBonesModifier = 0.3 * libAffx_EventAffixCount();
    
    return true;
}
// ---------------------------------------------------------------
// Never Ending Swarm
// ---------------------------------------------------------------
bool libAffx_NazeeboNeverEndingSwarmAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_NazeeboZombieHandlerChance = 1;
    libAffx_NazeeboZombieHandlerAllowFriendlies = true;
    
    return true;
}
// ---------------------------------------------------------------
// Many Rituals
// ---------------------------------------------------------------
bool libAffx_NazeeboManyRitualsAffixAdded (bool testConds, bool runActions) {
    unit heroUnit = libGame_gv_players[libAffx_player].lv_heroUnit;
    int amount = 20 * libAffx_EventAffixCountAdded();
    if (!runActions) {
        return true;
    }

    if (libAffx_EventAffixCount() == libAffx_EventAffixCountAdded()) {
        amount += 20;
    }

    libAffx_AddUnitTokenCount(heroUnit, "WitchDoctorVoodooRitual", amount);
    libAffx_AddUnitTokenCount(heroUnit, "WitchDoctorVoodooRitualTokenCounter", amount);
    libAffx_AddUnitTokenCount(heroUnit, "WitchDoctorVoodooRitualVileInfectionTokenCounter", amount);
    libAffx_AddUnitTokenCount(heroUnit, "WitchDoctorThingOfTheDeepQuestToken", amount);
    libAffx_AddUnitTokenCount(heroUnit, "WitchDoctorRitualofBoonsQuestToken", amount);

    libAffx_NazeeboManyRitualsTotal += amount;
    
    return true;
}
// ---------------------------------------------------------------
// Ritual of Boons
// ---------------------------------------------------------------
bool libAffx_NazeeboRitualofBoonsAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_NazeeboRitualOfBoonsIndex = libAffx_EventAffix();
    
    return true;
}
bool libAffx_NazeeboRitualofBoons (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_AddPlayerBehavior(libAffx_player, "WitchDoctorRitualofBoonsQuestToken", 1, false);
    
    return true;
}
bool libAffx_NazeeboRitualofBoonsQuestComplete (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_NazeeboRitualOfBoonsIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_QueueBoon(libAffx_rarityUncommon, 1, false, true);
    libAffx_QueueBoon(libAffx_rarityRare, 1, false, true);
    libAffx_affixes[libAffx_NazeeboRitualOfBoonsIndex].quest.questDone = true;
    
    return true;
}
// ---------------------------------------------------------------
// Toad Master
// ---------------------------------------------------------------
bool libAffx_NazeeboToadMasterMilestone (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_CatalogReferenceModify("Effect,WitchDoctorPlagueofToadsInitialPersistent,PeriodCount", libAffx_player, "2", c_upgradeOperationAdd);
    
    return true;
}