    libPBU2_gv_curateHeroSelections[lv_row][5] = "Raynor";
    libPBU2_gv_curateHeroSelections[lv_row][6] = "SgtHammer";
    libPBU2_gv_curateHeroSelections[lv_row][7] = "Sylvanas";
    libPBU2_gv_curateHeroSelections[lv_row][8] = "Tassadar";
    libPBU2_gv_curateHeroSelections[lv_row][9] = "Tracer";
    libPBU2_gv_curateHeroSelections[lv_row][10] = "Tychus";
    libPBU2_gv_curateHeroSelections[lv_row][11] = "DemonHunter";
    libPBU2_gv_curateHeroSelections[lv_row][12] = "Zagara";
    libPBU2_gv_curateHeroSelections[lv_row][13] = "Zuljin";

    libPBU2_gf_DisplayCurateHSUI();

    if (libAffx_difficulty != 0) {
        libPBU2_SetDifficulty(libAffx_difficulty);
    }

    for (i = 1; i <= libAffx_goldenHeroesIndex; i += 1) {
        for (role = libPBU2_ge_CurateHeroSelectionRole_Tank; role <= libPBU2_ge_CurateHeroSelectionRole_RangedAssassin2; role += 1) {
            for (index = 1; index <= libPBU2_gv_curateHeroSelectionUIRoleHeroCountCol_C; index += 1) {
                if (libPBU2_gv_curateHeroSelections[role][index] == libAffx_goldenHeroes[i]) {
                    DialogControlSetVisible(libPBU2_gv_curateHeroSelectionUI.lv_heroButtonBordersAffixed[role][index], PlayerGroupAll(), true);
                }
            }
        }
    }

    return true;
}
void libAffx_CurateHeroesTrigger_Init () {
    libAffx_CurateHeroesTrigger = TriggerCreate("libAffx_CurateHeroesTrigger_Func");
}

bool libAffx_HeroSelectedTrigger_Func(bool testConds, bool runActions) {
    int i;
    // Actions
    if (!runActions) {
        return true;
    }
    for (i = 1; i <= 10; i += 1) {
        libAffx_playersHeroIndex[i] = libGame_gv_players[i].lv_heroIndex;
        if (i >= 2 && i <= 5) {
            libAffx_heroCounter[libAffx_teamOrderIndex][libAffx_playersHeroIndex[i]] += 1;
        } else if (i >= 6 && i <= 10) {
            libAffx_heroCounter[libAffx_teamChaosIndex][libAffx_playersHeroIndex[i]] += 1;
        }
    }

    return true;
}
