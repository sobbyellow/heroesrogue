bool libAffx_RexxarTrigger_Func (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    int player = UnitGetOwner(eventUnit);
    if (testConds) {
        if (UnitGetType(eventUnit) != "RexxarMisha") {
            return false;
        }
        if (UnitTestState(eventUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_SyncBehaviors(libGame_gv_players[player].lv_heroUnit, eventUnit);
    return true;
}

