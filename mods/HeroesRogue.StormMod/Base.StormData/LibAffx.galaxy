void libAffx_UpdateGameoverDialog() {
    int takedowns = libAffx_BankGetStats("Takedowns") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_takedowns);
    int kills = libAffx_BankGetStats("Kills") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_kills);
    int assists = libAffx_BankGetStats("Assists") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_assists);
    int deaths = libAffx_BankGetStats("Deaths") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_deaths);
    int spellDamage = libAffx_BankGetStats("SpellDamage") + libGame_gv_scoreValues[libAffx_player].lv_spellDamage;
    int physicalDamage = libAffx_BankGetStats("PhysicalDamage") + libGame_gv_scoreValues[libAffx_player].lv_physicalDamage;
    int healing = libAffx_BankGetStats("Healing") + libGame_gv_scoreValues[libAffx_player].lv_healing;
    int damageTaken = libAffx_BankGetStats("DamageTaken") + libGame_gv_scoreValues[libAffx_player].lv_damageTaken;
    int experience = libAffx_BankGetStats("Experience") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_individualXPEarned);
    int regenGlobes = libAffx_BankGetStats("RegenGlobes") + libGame_gv_scoreValues[libAffx_player].lv_regenGlobes;
    int minionKills = libAffx_BankGetStats("MinionKills") + libGame_gv_scoreValues[libAffx_player].lv_minionKills;
    int mercs = libAffx_BankGetStats("MercCaptures") + libGame_gv_scoreValues[libAffx_player].lv_creepCampsCaptured;
    int objectivesWon = libAffx_BankGetStats("ObjectivesWon") + libAffx_objectivesWonThisGame;
    int objectivesLost = libAffx_BankGetStats("ObjectivesLost") + libAffx_objectivesLostThisGame;
    int rerollsUsed = libAffx_BankGetStats("RerollsUsed") + libAffx_rerollsUsed;
    int rerollsCurseUsed = libAffx_BankGetStats("RerollsCurseUsed") + libAffx_rerollsCurseUsed;
    int bansUsed = libAffx_BankGetStats("BansUsed") + libAffx_bansUsed;
    int cursesSkipped = libAffx_BankGetStats("CursesSkipped") + libAffx_cursesSkipped;
    int cursesSwapped = libAffx_BankGetStats("CursesSwapped") + libAffx_cursesSwapped;
    int gameTime = libAffx_BankGetStats("GameTime") + FixedToInt(TimerGetElapsed(libGame_gv_gameTimer));
    int[libCore_gv_bALMaxTeams + 1][91] heroCounter;
    int[libCore_gv_bALMaxTeams + 1] mostHeroCounter;
    int[libCore_gv_bALMaxTeams + 1] mostHeroIndex;
    int kda;
    int boons;
    int curses;
    int[10] boonsRarity;
    int[10] cursesRarity;
    int i;
    int affix;
    libAffx_DisplayDebugMessage("Updating gameover dialog...");
    libAffx_CountOwnedAffixes();
    for (i = 1; i <= libAffx_ownedAffixesIndex[libAffx_affixTypeBoon]; i += 1) {
        affix = libAffx_ownedAffixes[libAffx_affixTypeBoon][i];
        if (libAffx_affixes[affix].ignoredForStats) {
            continue;
        }
        boons += libAffx_affixes[affix].count;
        boonsRarity[libAffx_affixes[affix].rarity] += libAffx_affixes[affix].count;
    }
    for (i = 1; i <= libAffx_ownedAffixesIndex[libAffx_affixTypeCurse]; i += 1) {
        affix = libAffx_ownedAffixes[libAffx_affixTypeCurse][i];
        if (libAffx_affixes[affix].ignoredForStats) {
            continue;
        }
        curses += libAffx_affixes[affix].count;
        cursesRarity[libAffx_affixes[affix].rarity] += libAffx_affixes[affix].count;
    }
    for (i = 1; i <= 90; i += 1) {
        heroCounter[libAffx_teamOrderIndex][i] = libAffx_BankGetStats("HeroCounterOrder_" + libCore_gf_GetHeroFromIndex(i)) + libAffx_heroCounter[libAffx_teamOrderIndex][i];
        if (heroCounter[libAffx_teamOrderIndex][i] > mostHeroCounter[libAffx_teamOrderIndex]) {
            mostHeroCounter[libAffx_teamOrderIndex] = heroCounter[libAffx_teamOrderIndex][i];
            mostHeroIndex[libAffx_teamOrderIndex] = i;
        }
    }
    for (i = 1; i <= 90; i += 1) {
        heroCounter[libAffx_teamChaosIndex][i] = libAffx_BankGetStats("HeroCounterChaos_" + libCore_gf_GetHeroFromIndex(i)) + libAffx_heroCounter[libAffx_teamChaosIndex][i];
        if (heroCounter[libAffx_teamChaosIndex][i] > mostHeroCounter[libAffx_teamChaosIndex]) {
            mostHeroCounter[libAffx_teamChaosIndex] = heroCounter[libAffx_teamChaosIndex][i];
            mostHeroIndex[libAffx_teamChaosIndex] = i;
        }
    }
    if (deaths > 0) {
        kda = FixedToInt(takedowns / deaths);
    }
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "M", StringToText(StringCase(libAffx_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[libAffx_player]) + ",HyperlinkId"), true)));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "A", IntToText(boons));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "C", IntToText(boonsRarity[libAffx_rarityCommon]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "D", IntToText(boonsRarity[libAffx_rarityUncommon]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "E", IntToText(boonsRarity[libAffx_rarityRare]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "F", IntToText(boonsRarity[libAffx_rarityEpic]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "G", IntToText(boonsRarity[libAffx_rarityLegendary]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "H", IntToText(boonsRarity[libAffx_rarityStarter]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "I", IntToText(boonsRarity[libAffx_rarityMilestone]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "B", IntToText(curses));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "J", IntToText(cursesRarity[libAffx_rarityCommon] + cursesRarity[libAffx_rarityUncommon] + cursesRarity[libAffx_rarityRare] + cursesRarity[libAffx_rarityEpic] + cursesRarity[libAffx_rarityLegendary]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "K", IntToText(cursesRarity[libAffx_rarityChallenge]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "L", IntToText(cursesRarity[libAffx_rarityMythic]));
    libAffx_SetDialogControlText(libAffx_dialogGameover.leftStats, TextExpressionAssemble("Param/Expression/AffixGameoverStats1"));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "A", IntToText(rerollsUsed));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "B", IntToText(rerollsCurseUsed));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "C", IntToText(bansUsed));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "F", IntToText(minionKills));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "G", IntToText(mercs));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "H", IntToText(regenGlobes));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "I", IntToText(objectivesWon));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "J", IntToText(objectivesLost));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "D", IntToText(cursesSkipped));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "E", IntToText(cursesSwapped));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "K", StringToText(libAffx_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(mostHeroIndex[libAffx_teamOrderIndex]) + ",HyperlinkId")));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "L", StringToText(libAffx_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(mostHeroIndex[libAffx_teamChaosIndex]) + ",HyperlinkId")));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "M", IntToText(mostHeroCounter[libAffx_teamOrderIndex]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "N", IntToText(mostHeroCounter[libAffx_teamChaosIndex]));
    libAffx_SetDialogControlText(libAffx_dialogGameover.middleStats, TextExpressionAssemble("Param/Expression/AffixGameoverStats2"));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "L", StringToText(libAffx_GetTimeString(gameTime)));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "A", IntToText(spellDamage + physicalDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "B", IntToText(spellDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "C", IntToText(physicalDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "D", IntToText(healing));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "E", IntToText(damageTaken));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "F", IntToText(experience));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "G", IntToText(takedowns));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "H", IntToText(kills));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "I", IntToText(assists));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "J", IntToText(deaths));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "K", IntToText(kda));
    libAffx_SetDialogControlText(libAffx_dialogGameover.rightStats, TextExpressionAssemble("Param/Expression/AffixGameoverStats3"));
}
void libAffx_ShowGameoverDialog(bool show) {
    libAffx_UpdateGameoverDialog();
    libAffx_SetDialogVisible(libAffx_dialogGameover.dialog, show);
    libAffx_SetBackdropDark(show);
    libAffx_ShowBackdrop(show);
    libAffx_Pause(show);
}
void libAffx_ShowGameoverExitDialog(bool show) {
    libAffx_SetDialogVisible(libAffx_dialogGameoverExit.dialog, show);
}

void libAffx_CreateOptionsDialog() {
    int i;

    libAffx_dialogOptions.dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libAffx_dialogOptions.dialog, true);
    DialogSetImageVisible(libAffx_dialogOptions.dialog, false);
    libAffx_dialogOptions.label = libAffx_CreateDialogControlLabel(libAffx_dialogOptions.dialog, StringExternal("Label/Name/Options"), "Storm_Map_Large_Bold_Centered", libAffx_optionsLabelWidth, libAffx_optionsLabelHeight, c_anchorTop, libAffx_optionsLabelOffsetX, libAffx_optionsLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogControlOptionsSpeedUpDeath = libAffx_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsSpeedupDeath"));
    libAffx_dialogControlOptionsSpeedUpGates = libAffx_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsSpeedup"));
    libAffx_dialogControlOptionsDisplayPicksBans = libAffx_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsPicksBans"));
    libAffx_dialogControlOptionsAchievementsButton = libAffx_CreateOptionDialogButton(StringExternal("Button/Name/OptionsAchievements"));
    libAffx_dialogControlOptionsRestartButton = libAffx_CreateOptionDialogButton(StringExternal("Button/Name/OptionsRestart"));
    libAffx_dialogControlOptionsReturnButton = libAffx_CreateOptionDialogButton(StringExternal("Button/Name/OptionsReturn"));
    for (i = 1; i <= libAffx_dialogOptions.optionIndex; i += 1) {
        libAffx_SetDialogControlPosition(libAffx_dialogOptions.option[i].label, c_anchorCenter, libAffx_optionsSpacingX, libAffx_optionsSpacingY * (2 * i - libAffx_dialogOptions.optionIndex - 1) / 2);
        libAffx_SetDialogControlPosition(libAffx_dialogOptions.option[i].button, c_anchorCenter, libAffx_optionsButtonSpacingX, libAffx_optionsButtonSpacingY * (2 * i - libAffx_dialogOptions.optionIndex - 1) / 2);
        libAffx_SetDialogControlPosition(libAffx_dialogOptions.option[i].checkbox, c_anchorCenter, libAffx_optionsCheckboxSpacingX, libAffx_optionsSpacingY * (2 * i - libAffx_dialogOptions.optionIndex - 1) / 2);
    }
    libAffx_dialogOptionsRestart.dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libAffx_dialogOptionsRestart.dialog, true);
    DialogSetImageVisible(libAffx_dialogOptionsRestart.dialog, false);
    libAffx_dialogOptionsRestart.frame = DialogControlCreateFromTemplate(libAffx_dialogOptionsRestart.dialog, c_triggerControlTypeImage, "StandardTemplates/StandardContextMenuFrame");
    libAffx_SetDialogControlSize(libAffx_dialogOptionsRestart.frame, libAffx_optionsRestartFrameWidth, libAffx_optionsRestartFrameHeight);
    libAffx_SetDialogControlPosition(libAffx_dialogOptionsRestart.frame, c_anchorCenter, 0, 0);
    libAffx_dialogOptionsRestart.label = libAffx_CreateDialogControlLabel(libAffx_dialogOptionsRestart.dialog, StringExternal("Label/Name/OptionsRestart"), "Affix_Dialog", libAffx_optionsRestartLabelWidth, libAffx_optionsRestartLabelHeight, c_anchorCenter, libAffx_optionsRestartLabelOffsetX, libAffx_optionsRestartLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogOptionsRestart.option[1].button = libAffx_CreateDialogControlButton(libAffx_dialogOptionsRestart.dialog);
    libAffx_SetDialogControlSize(libAffx_dialogOptionsRestart.option[1].button, libAffx_optionsRestartButtonWidth, libAffx_optionsRestartButtonHeight);
    libAffx_SetDialogControlText(libAffx_dialogOptionsRestart.option[1].button, StringExternal("Button/Name/Yes"));
    libAffx_SetDialogControlPosition(libAffx_dialogOptionsRestart.option[1].button, c_anchorCenter, libAffx_optionsRestartButtonYesOffsetX, libAffx_optionsRestartButtonYesOffsetY);
    libAffx_dialogOptionsRestart.option[2].button = libAffx_CreateDialogControlButton(libAffx_dialogOptionsRestart.dialog);
    libAffx_SetDialogControlSize(libAffx_dialogOptionsRestart.option[2].button, libAffx_optionsRestartButtonWidth, libAffx_optionsRestartButtonHeight);
    libAffx_SetDialogControlText(libAffx_dialogOptionsRestart.option[2].button, StringExternal("Button/Name/No"));
    libAffx_SetDialogControlPosition(libAffx_dialogOptionsRestart.option[2].button, c_anchorCenter, libAffx_optionsRestartButtonNoOffsetX, libAffx_optionsRestartButtonNoOffsetY);
}
void libAffx_UpdateOptionsDialog() {
    if (libAffx_IsOwnedAffixesDialogVisible()) {
        libAffx_SetDialogControlEnabled(libAffx_dialogControlOptionsButton, false);
    } else {
        libAffx_SetDialogControlEnabled(libAffx_dialogControlOptionsButton, true);
    }
    if (libAffx_IsOptionsDialogVisible()) {
        libAffx_SetDialogControlEnabled(libAffx_dialogControlOwnedAffixesButton, false);
    } else {
        libAffx_SetDialogControlEnabled(libAffx_dialogControlOwnedAffixesButton, true);
    }
}
void libAffx_ShowOptionsDialog(bool show) {
    libAffx_SetDialogVisible(libAffx_dialogOptions.dialog, show);
    libAffx_ShowBackdrop(show);
    if (!show) {
        libAffx_ShowOptionsRestartDialog(false);
    }
    if (show && libAffx_IsAffixSelectionDialogVisible()) {
        DialogSetTransparency(libAffx_dialogAffixSelection.dialog, 75);
        libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.titleLabel, false);
    } else {
        DialogSetTransparency(libAffx_dialogAffixSelection.dialog, 0);
        libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.titleLabel, true);
    }
    if (show && libAffx_IsGameoverDialogVisible()) {
        DialogSetTransparency(libAffx_dialogGameover.dialog, 75);
    } else {
        DialogSetTransparency(libAffx_dialogGameover.dialog, 0);
    }
    libAffx_UpdateOptionsDialog();
    libAffx_Pause(show);
}
void libAffx_UpdateOptionsRestartDialog() {
    if (libGame_winningTeam == libAffx_teamChaosIndex) {
        libAffx_SetDialogControlText(libAffx_dialogOptionsRestart.label, StringExternal("Label/Name/OptionsRestartEnemyWon"));
    } else {
        libAffx_SetDialogControlText(libAffx_dialogOptionsRestart.label, StringExternal("Label/Name/OptionsRestart"));
    }
}
void libAffx_ShowOptionsRestartDialog(bool show) {
    libAffx_UpdateOptionsRestartDialog();
    libAffx_SetDialogVisible(libAffx_dialogOptionsRestart.dialog, show);
}

void libAffx_CreateAffixSelectionDialogItem(int index, int offsetX, int offsetY) {
    libAffx_dialogAffixSelection.items[index].background = libAffx_CreateDialogControlImage(libAffx_dialogAffixSelection.dialog, libAffx_textureAffixBackground, libAffx_affixItemWidth + libAffx_affixItemBackgroundWidth, libAffx_affixItemHeight + libAffx_affixItemBackgroundHeight, c_anchorTop, offsetX + libAffx_affixItemBackgroundOffsetX, offsetY + libAffx_affixItemBackgroundOffsetY, null);
    libAffx_dialogAffixSelection.items[index].affixBackground = libAffx_CreateDialogControlImage(libAffx_dialogAffixSelection.dialog, null, libAffx_affixItemWidth + libAffx_affixItemAffixBackgroundWidth, libAffx_affixItemHeight + libAffx_affixItemAffixBackgroundHeight, c_anchorTop, offsetX + libAffx_affixItemAffixBackgroundOffsetX, offsetY + libAffx_affixItemAffixBackgroundOffsetY, null);

    libAffx_dialogAffixSelection.items[index].selectButton = libAffx_CreateDialogControlButton(libAffx_dialogAffixSelection.dialog);
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.items[index].selectButton, StringExternal("Button/Name/PickAffix"));
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].selectButton, c_anchorTop, offsetX + libAffx_affixItemSelectButtonOffsetX, offsetY + libAffx_affixItemSelectButtonOffsetY);
    
    libAffx_dialogAffixSelection.items[index].icon = libAffx_CreateDialogControlImage(libAffx_dialogAffixSelection.dialog, null, libAffx_affixItemIconWidth, libAffx_affixItemIconHeight, c_anchorTop, offsetX + libAffx_affixItemIconOffsetX, offsetY + libAffx_affixItemIconOffsetY, null);
    libAffx_dialogAffixSelection.items[index].iconOverlay = libAffx_CreateDialogControlImage(libAffx_dialogAffixSelection.dialog, null, libAffx_affixItemIconOverlayWidth, libAffx_affixItemIconOverlayHeight, c_anchorTop, offsetX + libAffx_affixItemIconOverlayOffsetX, offsetY + libAffx_affixItemIconOverlayOffsetY, null);
    
    libAffx_dialogAffixSelection.items[index].nameLabel = libAffx_CreateDialogControlLabel(libAffx_dialogAffixSelection.dialog, StringToText("Affix" + IntToString(index)), "Storm_Tutorial_Small_Centered", libAffx_affixItemNameWidth, libAffx_affixItemNameHeight, c_anchorTop, offsetX + libAffx_affixItemNameOffsetX, offsetY + libAffx_affixItemNameOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogAffixSelection.items[index].tooltipLabel = libAffx_CreateDialogControlLabel(libAffx_dialogAffixSelection.dialog, null, "TalentDescription", libAffx_affixItemTooltipWidth, libAffx_affixItemTooltipHeight, c_anchorTop, offsetX + libAffx_affixItemTooltipOffsetX, offsetY + libAffx_affixItemTooltipOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogAffixSelection.items[index].rarityLabel = libAffx_CreateDialogControlLabel(libAffx_dialogAffixSelection.dialog, null, "Storm_MapMechanic_MechanicCounterCentered_Small", libAffx_affixItemRarityWidth, libAffx_affixItemRarityHeight, c_anchorTop, offsetX + libAffx_affixItemRarityOffsetX, offsetY + libAffx_affixItemRarityOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
   
    libAffx_dialogAffixSelection.items[index].banButton = libAffx_CreateDialogControlButton(libAffx_dialogAffixSelection.dialog);
    libAffx_SetDialogControlColor(libAffx_dialogAffixSelection.items[index].banButton, Color(100, 50, 50));
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.items[index].banButton, StringExternal("Button/Name/BanAffix"));
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].banButton, c_anchorTop, offsetX + libAffx_affixItemBanButtonOffsetX, offsetY + libAffx_affixItemBanButtonOffsetY);
}

void libAffx_CreateAffixSelectionDialog() {
    int i;
    int span = libAffx_affixItemSpacing * (libAffx_maxAffixSelection - 1);

    DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    libAffx_dialogAffixSelection.dialog = DialogLastCreated();
    DialogSetFullscreen(libAffx_dialogAffixSelection.dialog, true);
    DialogSetImageVisible(libAffx_dialogAffixSelection.dialog, false);
    
    libAffx_dialogAffixSelection.titleLabel = libAffx_CreateDialogControlLabel(libAffx_dialogAffixSelection.dialog, null, "Storm_Map_Large_Bold_Centered", libAffx_affixSelectionTitleWidth, libAffx_affixSelectionTitleHeight, c_anchorTop, libAffx_affixSelectionTitleOffsetX, libAffx_affixSelectionTitleOffsetY, ColorWithAlpha(0, 0, 0, 0), true);

    libAffx_dialogAffixSelection.rerollButton = libAffx_CreateDialogControlButton(libAffx_dialogAffixSelection.dialog);
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.rerollButton, StringExternal("Button/Name/Reroll"));
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.rerollButton, c_anchorTop, libAffx_affixRerollButtonOffsetX, libAffx_affixRerollButtonOffsetY);
    libAffx_SetDialogControlSize(libAffx_dialogAffixSelection.rerollButton, libAffx_affixRerollButtonWidth, libAffx_affixRerollButtonHeight);

    libAffx_dialogAffixSelection.rerollLabel = libAffx_CreateDialogControlLabel(libAffx_dialogAffixSelection.dialog, null, "Storm_Tutorial_Small_Centered", libAffx_affixRerollLabelWidth, libAffx_affixRerollLabelHeight, c_anchorTop, libAffx_affixRerollLabelOffsetX, libAffx_affixRerollLabelOffsetY, ColorWithAlpha(0,0,0,0), false);
    libAffx_dialogAffixSelection.banLabel = libAffx_CreateDialogControlLabel(libAffx_dialogAffixSelection.dialog, null, "Storm_Tutorial_Small_Centered", libAffx_affixBanLabelWidth, libAffx_affixBanLabelHeight, c_anchorTop, libAffx_affixBanLabelOffsetX, libAffx_affixBanLabelOffsetY, ColorWithAlpha(0,0,0,0), false);

    for (i = 1; i <= libAffx_maxAffixSelection; i += 1) {
        libAffx_CreateAffixSelectionDialogItem(i, -span / 2 + libAffx_affixItemSpacing * (i - 1), libAffx_affixItemOffsetY);
    }
}

void libAffx_UpdateAffixSelectionPosDialogItem(int index, int offsetX, int offsetY) {
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].selectButton, c_anchorTop, offsetX + libAffx_affixItemSelectButtonOffsetX, offsetY + libAffx_affixItemSelectButtonOffsetY);
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].background, c_anchorTop, offsetX + libAffx_affixItemBackgroundOffsetX, offsetY + libAffx_affixItemBackgroundOffsetY);
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].affixBackground, c_anchorTop, offsetX + libAffx_affixItemAffixBackgroundOffsetX, offsetY + libAffx_affixItemAffixBackgroundOffsetY);
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].icon, c_anchorTop, offsetX + libAffx_affixItemIconOffsetX, offsetY + libAffx_affixItemIconOffsetY);
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].iconOverlay, c_anchorTop, offsetX + libAffx_affixItemIconOverlayOffsetX, offsetY + libAffx_affixItemIconOverlayOffsetY);
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].nameLabel, c_anchorTop, offsetX + libAffx_affixItemNameOffsetX, offsetY + libAffx_affixItemNameOffsetY); 
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].tooltipLabel, c_anchorTop, offsetX + libAffx_affixItemTooltipOffsetX, offsetY + libAffx_affixItemTooltipOffsetY);
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].banButton, c_anchorTop, offsetX + libAffx_affixItemBanButtonOffsetX, offsetY + libAffx_affixItemBanButtonOffsetY);
}

void libAffx_UpdateAffixSelectionDialogItem(int index) {
    int affix = libAffx_rolledAffixes[index];
    int span = libAffx_affixItemSpacing * (libAffx_GetRolledAffixCount() - 1);
    int offsetX = -span / 2 + libAffx_affixItemSpacing * (index - 1);
    int rarityOffsetY = libAffx_affixItemRarityOffsetY;
    bool bannable = libAffx_IsAffixBannable(affix);

    if (bannable) {
        rarityOffsetY = libAffx_affixItemRarityBanOffsetY;
    }

    libAffx_SetDialogControlImage(libAffx_dialogAffixSelection.items[index].affixBackground, "Assets/Textures/affix_bg" + libAffx_GetAffixTextureSuffix(affix) + ".dds");
    libAffx_SetDialogControlImage(libAffx_dialogAffixSelection.items[index].icon, libAffx_affixes[affix].icon);
    libAffx_SetDialogControlImage(libAffx_dialogAffixSelection.items[index].iconOverlay, "Assets/Textures/icon_overlay_large" + libAffx_GetAffixTextureSuffix(affix) + ".dds");
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.items[index].nameLabel, StringExternal("Affix/Name/" + libAffx_affixes[affix].name) + StringToText(libAffx_GetCountSuffix(libAffx_affixes[affix].count, libAffx_affixes[affix].max)));
    libAffx_SetDialogControlColor(libAffx_dialogAffixSelection.items[index].nameLabel, libAffx_GetAffixColor(affix));
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.items[index].tooltipLabel, libAffx_GetAffixTooltip(affix));
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.items[index].rarityLabel, StringExternal(libAffx_GetAffixRarityLabel(affix)) + StringExternal(libAffx_GetAffixStackLabel(affix)));
    libAffx_SetDialogControlPosition(libAffx_dialogAffixSelection.items[index].rarityLabel, c_anchorTop, offsetX + libAffx_affixItemRarityOffsetX, libAffx_affixItemOffsetY + rarityOffsetY);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].banButton, bannable);
    libAffx_UpdateAffixSelectionPosDialogItem(index, offsetX, libAffx_affixItemOffsetY);
}

void libAffx_UpdateAffixSelectionDialog() {
    int i;
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.titleLabel, libAffx_GetAffixTitleLabel());
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.rerollLabel, libAffx_GetAffixRerollLabel());
    libAffx_SetDialogControlText(libAffx_dialogAffixSelection.banLabel, StringExternal("Label/Name/Bans") + IntToText(libAffx_bans));
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.rerollButton, libAffx_IsCurrentQueueRerollable());
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.rerollLabel, libAffx_IsCurrentQueueRerollable());
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.banLabel, libAffx_IsAnyRolledAffixBannable());

    for (i = 1; i <= libAffx_maxAffixSelection; i += 1) {
        if (i <= libAffx_currentQueue.choiceCount && libAffx_rolledAffixes[i] != 0) {
            libAffx_ShowAffixSelectionDialogItem(i, true);
            libAffx_UpdateAffixSelectionDialogItem(i);
        } else {
            libAffx_ShowAffixSelectionDialogItem(i, false);
        }
    }
}

void libAffx_ShowAffixSelectionDialogItem(int index, bool show) {
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].background, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].affixBackground, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].selectButton, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].icon, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].iconOverlay, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].nameLabel, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].tooltipLabel, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].rarityLabel, show);
    libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.items[index].banButton, show);
}

void libAffx_ShowAffixSelectionDialog(bool show) {
    libAffx_UpdateAffixSelectionDialog();
    libAffx_SetDialogVisible(libAffx_dialogAffixSelection.dialog, show);
    libAffx_UpdateOptionsDialog();
    libAffx_ShowBackdrop(show);
    libAffx_Pause(show);
}

void libAffx_SortOwnedAffixes() {
    int i;
    int j;
    int affix;
    for (i = 2; i <= (libAffx_ownedAffixesIndex[libAffx_affixTypeBoon]); i += 1) {
        affix = libAffx_ownedAffixes[libAffx_affixTypeBoon][i];
        j = i - 1;
        for ( ; j >= 1; j -= 1) {
            if (libAffx_ShouldShowBefore(affix, libAffx_ownedAffixes[libAffx_affixTypeBoon][j])) {
                libAffx_ownedAffixes[libAffx_affixTypeBoon][j + 1] = libAffx_ownedAffixes[libAffx_affixTypeBoon][j];
            } else {
                break;
            }
        } 
        libAffx_ownedAffixes[libAffx_affixTypeBoon][j + 1] = affix;
    }
    for (i = 2; i <= libAffx_ownedAffixesIndex[libAffx_affixTypeCurse]; i += 1) {
        affix = libAffx_ownedAffixes[libAffx_affixTypeCurse][i];
        j = i - 1;
        for ( ; j >= 1; j -= 1) {
            if (libAffx_ShouldShowBefore(affix, libAffx_ownedAffixes[libAffx_affixTypeCurse][j])) {
                libAffx_ownedAffixes[libAffx_affixTypeCurse][j + 1] = libAffx_ownedAffixes[libAffx_affixTypeCurse][j];
            } else {
                break;
            }
        } 
        libAffx_ownedAffixes[libAffx_affixTypeCurse][j + 1] = affix;
    }
}

void libAffx_CreateOwnedAffixesDialogItem(int index) {
    libAffx_dialogOwnedAffixes.items[index].icon = libAffx_CreateDialogControlImage(libAffx_dialogOwnedAffixes.dialog, null, libAffx_ownedAffixesIconWidth, libAffx_ownedAffixesIconHeight, c_anchorCenter, 0, 0, null);
    libAffx_dialogOwnedAffixes.items[index].iconOverlay = libAffx_CreateDialogControlImage(libAffx_dialogOwnedAffixes.dialog, null, libAffx_ownedAffixesIconOverlayWidth, libAffx_ownedAffixesIconOverlayHeight, c_anchorCenter, 0, 0, null);
    libAffx_dialogOwnedAffixes.items[index].nameLabel = libAffx_CreateDialogControlLabel(libAffx_dialogOwnedAffixes.dialog, null, "Affix_Owned", libAffx_ownedAffixesNameWidth, libAffx_ownedAffixesNameHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogOwnedAffixes.items[index].cooldownLabel = libAffx_CreateDialogControlLabel(libAffx_dialogOwnedAffixes.dialog, null, "Storm_Tutorial_Small_Centered", libAffx_ownedAffixesCooldownWidth, libAffx_ownedAffixesCooldownHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
}

void libAffx_CreateOwnedAffixesDialog() {
    int i;
    DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    libAffx_dialogOwnedAffixes.dialog = DialogLastCreated();
    DialogSetFullscreen(libAffx_dialogOwnedAffixes.dialog, true);
    DialogSetImageVisible(libAffx_dialogOwnedAffixes.dialog, false);
    libAffx_dialogOwnedAffixes.label = libAffx_CreateDialogControlLabel(libAffx_dialogOwnedAffixes.dialog, StringExternal("Label/Name/ShowAffixes"), "Storm_Map_Large_Bold_Centered", libAffx_ownedAffixesLabelWidth, libAffx_ownedAffixesLabelHeight, c_anchorTop, libAffx_ownedAffixesLabelOffsetX, libAffx_ownedAffixesLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);

    for (i = 1; i <= libAffx_maxAffixes; i += 1) {
        libAffx_CreateOwnedAffixesDialogItem(i);
    }

    libAffx_dialogOwnedAffixes.previousButton = libAffx_CreateDialogControlButton(libAffx_dialogOwnedAffixes.dialog);
    libAffx_SetDialogControlSize(libAffx_dialogOwnedAffixes.previousButton, libAffx_ownedAffixesPagesButtonWidth, libAffx_ownedAffixesPagesButtonHeight);
    libAffx_SetDialogControlPosition(libAffx_dialogOwnedAffixes.previousButton, c_anchorBottomLeft, 0, 0);
    libAffx_SetDialogControlText(libAffx_dialogOwnedAffixes.previousButton, StringExternal("Button/Name/PreviousPage"));

    libAffx_dialogOwnedAffixes.nextButton = libAffx_CreateDialogControlButton(libAffx_dialogOwnedAffixes.dialog);
    libAffx_SetDialogControlSize(libAffx_dialogOwnedAffixes.nextButton, libAffx_ownedAffixesPagesButtonWidth, libAffx_ownedAffixesPagesButtonHeight);
    libAffx_SetDialogControlPosition(libAffx_dialogOwnedAffixes.nextButton, c_anchorBottomRight, 0, 0);
    libAffx_SetDialogControlText(libAffx_dialogOwnedAffixes.nextButton, StringExternal("Button/Name/NextPage"));
}
void libAffx_UpdateOwnedAffixesDialogItem(int slotIndex, int pageStart, int pageAffixes, int totalRows) {
    int affixIndex;
    int affix;
    int offsetX;
    int offsetY;
    int row = (slotIndex - 1) / libAffx_ownedAffixesPerRow;
    int column = (slotIndex - 1) % libAffx_ownedAffixesPerRow;
    int affixesThisRow;
    string questIcon;
    text cooldownLabel;

    if (row == totalRows - 1) {
        affixesThisRow = pageAffixes - row * libAffx_ownedAffixesPerRow;
    } else {
        affixesThisRow = libAffx_ownedAffixesPerRow;
    }

    offsetX = -(affixesThisRow - 1) * libAffx_ownedAffixesAffixWidth / 2 + column * libAffx_ownedAffixesAffixWidth;
    offsetY = -(totalRows - 1) * libAffx_ownedAffixesAffixHeight / 2 + row * libAffx_ownedAffixesAffixHeight;
    affixIndex = pageStart + slotIndex - 1;
    
    if (affixIndex <= libAffx_ownedAffixesIndex[libAffx_affixTypeBoon]) {
        affix = libAffx_ownedAffixes[libAffx_affixTypeBoon][affixIndex];
    } else {
        affix = libAffx_ownedAffixes[libAffx_affixTypeCurse][affixIndex - libAffx_ownedAffixesIndex[libAffx_affixTypeBoon]];
    }

    if (libAffx_affixes[affix].quest.isQuest) {
        questIcon = "Affix/Quest";
    }

    libAffx_SetDialogControlPosition(libAffx_dialogOwnedAffixes.items[slotIndex].icon, c_anchorCenter, offsetX + libAffx_ownedAffixesIconOffsetX, offsetY + libAffx_ownedAffixesIconOffsetY);
    libAffx_SetDialogControlImage(libAffx_dialogOwnedAffixes.items[slotIndex].icon, libAffx_affixes[affix].icon);
    libAffx_SetDialogControlColor(libAffx_dialogOwnedAffixes.items[slotIndex].icon, ColorWithAlpha(0, 0, 0, 0));
    libAffx_SetDialogControlTooltip(libAffx_dialogOwnedAffixes.items[slotIndex].icon, StringExternal("<c val=\"#TooltipNumbers\">") + StringExternal("Affix/Name/" + libAffx_affixes[affix].name) + StringExternal("</c><n/><n/>") + libAffx_GetAffixTooltip(affix));
    libAffx_SetDialogControlPosition(libAffx_dialogOwnedAffixes.items[slotIndex].iconOverlay, c_anchorCenter, offsetX + libAffx_ownedAffixesIconOverlayOffsetX, offsetY + libAffx_ownedAffixesIconOverlayOffsetY);
    libAffx_SetDialogControlImage(libAffx_dialogOwnedAffixes.items[slotIndex].iconOverlay, "Assets/Textures/icon_overlay" + libAffx_GetAffixTextureSuffix(affix) + ".dds");
    libAffx_SetDialogControlPosition(libAffx_dialogOwnedAffixes.items[slotIndex].nameLabel, c_anchorCenter, offsetX + libAffx_ownedAffixesNameOffsetX, offsetY + libAffx_ownedAffixesNameOffsetY);
    libAffx_SetDialogControlText(libAffx_dialogOwnedAffixes.items[slotIndex].nameLabel, StringExternal(questIcon) + StringExternal("Affix/Name/" + libAffx_affixes[affix].name) + StringToText(libAffx_GetCountSuffix(libAffx_affixes[affix].count, libAffx_affixes[affix].max)));
    libAffx_SetDialogControlColor(libAffx_dialogOwnedAffixes.items[slotIndex].nameLabel, libAffx_GetAffixColor(affix));
    libAffx_SetDialogControlPosition(libAffx_dialogOwnedAffixes.items[slotIndex].cooldownLabel, c_anchorCenter, offsetX + libAffx_ownedAffixesCooldownOffsetX, offsetY + libAffx_ownedAffixesCooldownOffsetY);
    libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.items[slotIndex].cooldownLabel, false);

    if (libAffx_affixes[affix].cooldownLink != null && libAffx_affixes[affix].cooldownLink != "" && UnitGetCooldown(libGame_gv_players[libAffx_player].lv_heroUnit, libAffx_affixes[affix].cooldownLink) > 0) {
        cooldownLabel = StringToText(FixedToString(UnitGetCooldown(libGame_gv_players[libAffx_player].lv_heroUnit, libAffx_affixes[affix].cooldownLink), 0));
    } else if (libAffx_affixes[affix].cooldown > 0 && !libAffx_affixes[affix].cooldownHidden) {
        cooldownLabel = StringToText(FixedToString(libAffx_affixes[affix].cooldown, 0));
    }
    if (cooldownLabel != null) {
        libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.items[slotIndex].cooldownLabel, true);
        libAffx_SetDialogControlColor(libAffx_dialogOwnedAffixes.items[slotIndex].icon, Color(40, 40, 40));
        libAffx_SetDialogControlText(libAffx_dialogOwnedAffixes.items[slotIndex].cooldownLabel, cooldownLabel);
    }
    if (libAffx_affixes[affix].quest.questDone) {
        libAffx_SetDialogControlColor(libAffx_dialogOwnedAffixes.items[slotIndex].icon, Color(40, 40, 40));
        libAffx_SetDialogControlColor(libAffx_dialogOwnedAffixes.items[slotIndex].nameLabel, Color(40, 40, 40));
    }
}
void libAffx_UpdateOwnedAffixesDialog() {
    int i;
    int totalAffixes;
    int pageStart;
    int pageEnd;
    int pageAffixes;
    int totalRows;
    libAffx_CountOwnedAffixes();
    libAffx_SortOwnedAffixes();
    totalAffixes = libAffx_ownedAffixesIndex[libAffx_affixTypeBoon] + libAffx_ownedAffixesIndex[libAffx_affixTypeCurse];
    libAffx_ownedAffixesMaxPages = CeilingI(IntToFixed(libAffx_ownedAffixesIndex[libAffx_affixTypeCurse] + libAffx_ownedAffixesIndex[libAffx_affixTypeBoon]) / IntToFixed(libAffx_ownedAffixesPerPage));
    pageStart = (libAffx_ownedAffixesCurrentPage - 1) * libAffx_ownedAffixesPerPage + 1;
    pageEnd = MinI(totalAffixes, pageStart + libAffx_ownedAffixesPerPage - 1);
    pageAffixes =  pageEnd - pageStart + 1;
    totalRows = CeilingI(IntToFixed(pageAffixes) / IntToFixed(libAffx_ownedAffixesPerRow));

    for (i = 1; i <= libAffx_maxAffixes; i += 1) {
        if (i <= pageAffixes) {
            libAffx_ShowOwnedAffixesDialogItem(i, true);
            libAffx_UpdateOwnedAffixesDialogItem(i, pageStart, pageAffixes, totalRows);
        } else {
            libAffx_ShowOwnedAffixesDialogItem(i, false);
        }
    }
    if (libAffx_ownedAffixesMaxPages > 1) {
        libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.previousButton, true);
        libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.nextButton, true);
        libAffx_SetDialogControlEnabled(libAffx_dialogOwnedAffixes.previousButton, libAffx_ownedAffixesCurrentPage > 1);
        libAffx_SetDialogControlEnabled(libAffx_dialogOwnedAffixes.nextButton, libAffx_ownedAffixesCurrentPage < libAffx_ownedAffixesMaxPages);
        libAffx_SetDialogControlText(libAffx_dialogOwnedAffixes.label, StringExternal("Label/Name/ShowAffixes") + StringToText(" (" + IntToString(libAffx_ownedAffixesCurrentPage) + "/" + IntToString(libAffx_ownedAffixesMaxPages) + ")"));
    } else {
        libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.previousButton, false);
        libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.nextButton, false);
    }
}
void libAffx_ShowOwnedAffixesDialogItem(int index, bool show) {
    libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.items[index].icon, show);
    libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.items[index].iconOverlay, show);
    libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.items[index].nameLabel, show);
    libAffx_SetDialogControlVisible(libAffx_dialogOwnedAffixes.items[index].cooldownLabel, show);
}
void libAffx_ShowOwnedAffixesDialog(bool show) {
    libAffx_UpdateOwnedAffixesDialog();
    libAffx_SetDialogVisible(libAffx_dialogOwnedAffixes.dialog, show);
    libAffx_UpdateOptionsDialog();
    libAffx_ShowBackdrop(show);
    if (show && libAffx_IsAffixSelectionDialogVisible()) {
        DialogSetTransparency(libAffx_dialogAffixSelection.dialog, 75);
        libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.titleLabel, false);
    } else {
        DialogSetTransparency(libAffx_dialogAffixSelection.dialog, 0);
        libAffx_SetDialogControlVisible(libAffx_dialogAffixSelection.titleLabel, true);
    }
    if (show && libAffx_IsGameoverDialogVisible()) {
        DialogSetTransparency(libAffx_dialogGameover.dialog, 75);
    } else {
        DialogSetTransparency(libAffx_dialogGameover.dialog, 0);
    }
    if (show) {
        libAffx_SetDialogControlText(libAffx_dialogControlOwnedAffixesButton, StringExternal("Button/Name/OwnedAffixesHide"));
    } else {
        libAffx_SetDialogControlText(libAffx_dialogControlOwnedAffixesButton, StringExternal("Button/Name/OwnedAffixes"));
    }
    libAffx_Pause(show);
}
void libAffx_CountOwnedAffixes() {
    int i;
    libAffx_ownedAffixesIndex[libAffx_affixTypeBoon] = 0;
    libAffx_ownedAffixesIndex[libAffx_affixTypeCurse] = 0;
    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        if (libAffx_affixes[i].count <= 0) {
            continue;
        }
        if (libAffx_affixes[i].curse) {
            libAffx_ownedAffixesIndex[libAffx_affixTypeCurse] += 1;
            libAffx_ownedAffixes[libAffx_affixTypeCurse][libAffx_ownedAffixesIndex[libAffx_affixTypeCurse]] = i;
        } else {
            libAffx_ownedAffixesIndex[libAffx_affixTypeBoon] += 1;
            libAffx_ownedAffixes[libAffx_affixTypeBoon][libAffx_ownedAffixesIndex[libAffx_affixTypeBoon]] = i;
        }
    }
}

void libAffx_RegisterTriggerAddEventDialogControls() {
    trigger optionsClicked = TriggerCreate("libAffx_OptionsClickedTrigger_Func");
    TriggerAddEventDialogControl(TriggerCreate("libAffx_OwnedAffixesPagesClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_OptionsRestartClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(optionsClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(optionsClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_ShowAffixesClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_AffixSelectedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_AffixBanTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_AffixRerollTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_GameoverButtonsClicked_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libAffx_AchievementsClicked_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}


bool libAffx_AchievementsClicked_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libAffx_dialogControlOptionsAchievementsButton && eventDialog != libPBU2_dialogAchievements && 
            eventDialog != libAffx_dialogAchievements.closeButton && eventDialog != libAffx_dialogAchievementsReset.option[1].button && 
            eventDialog != libAffx_dialogAchievementsReset.option[2].button && eventDialog != libAffx_dialogAchievements.resetButton) {
            return false;
        }
        if (eventDialog == libPBU2_dialogAchievements && libPBU2_heroSelected) {
            return false;
        }
    }
    if (eventDialog == libAffx_dialogControlOptionsAchievementsButton || eventDialog == libPBU2_dialogAchievements || eventDialog == libAffx_dialogAchievements.closeButton) {
        libAffx_ShowAchievementsDialog(!libAffx_IsAchievementsDialogVisible());
    } else if (eventDialog == libAffx_dialogAchievements.resetButton) {
        libAffx_SetDialogVisible(libAffx_dialogAchievementsReset.dialog, true);
    } else if (eventDialog == libAffx_dialogAchievementsReset.option[1].button) {
        libAffx_ResetAllAchievements();
        libAffx_SetDialogVisible(libAffx_dialogAchievementsReset.dialog, false);
    } else if (eventDialog == libAffx_dialogAchievementsReset.option[2].button) {
        libAffx_SetDialogVisible(libAffx_dialogAchievementsReset.dialog, false);
    }

    return true;
}

bool libAffx_GameoverButtonsClicked_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libAffx_dialogGameover.continueButton && eventDialog != libAffx_dialogGameover.restartButton &&
            eventDialog != libAffx_dialogGameover.exitButton && eventDialog != libAffx_dialogGameoverExit.option[1].button &&
            eventDialog != libAffx_dialogGameoverExit.option[2].button) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible() || libAffx_IsOwnedAffixesDialogVisible() || libAffx_IsAchievementsDialogVisible()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (eventDialog == libAffx_dialogGameover.continueButton && !libAffx_IsGameoverExitDialogVisible()) {
        libAffx_ShowGameoverDialog(false);
    } else if (eventDialog == libAffx_dialogGameover.restartButton && !libAffx_IsGameoverExitDialogVisible()) {
        libAffx_ShowOptionsRestartDialog(true);
    } else if (eventDialog == libAffx_dialogGameover.exitButton) {
        libAffx_ShowGameoverExitDialog(true);
    } else if (eventDialog == libAffx_dialogGameoverExit.option[1].button) {
        libAffx_ResetBank();
        libAffx_ResetBankStats();
        KickFromGame(PlayerGroupAll());
    } else if (eventDialog == libAffx_dialogGameoverExit.option[2].button) {
        libAffx_ShowGameoverExitDialog(false);
    }
    return true;
}

bool libAffx_OwnedAffixesPagesClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libAffx_dialogOwnedAffixes.previousButton && eventDialog != libAffx_dialogOwnedAffixes.nextButton) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (eventDialog == libAffx_dialogOwnedAffixes.previousButton) {
        libAffx_ownedAffixesCurrentPage = MaxI(1, libAffx_ownedAffixesCurrentPage - 1);
    } else if (eventDialog == libAffx_dialogOwnedAffixes.nextButton) {
        libAffx_ownedAffixesCurrentPage = MinI(libAffx_ownedAffixesMaxPages, libAffx_ownedAffixesCurrentPage + 1);
    }
    libAffx_UpdateOwnedAffixesDialog();
    return true;
}

bool libAffx_PBU2DifficultyChangedTrigger_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_SavePBUSettingsBank();
    libAffx_difficulty = libPBU2_difficulty;
    libAffx_SetDialogControlText(libAffx_dialogControlRunLabel, StringToText(IntToString(libAffx_currentRun) + libAffx_GetDifficultyLabel(libPBU2_difficulty)));
    return true;
}
void libAffx_PBU2DifficultyChangedTrigger_Init() {
    libAffx_PBU2DifficultyChangedTrigger = TriggerCreate("libAffx_PBU2DifficultyChangedTrigger_Func");
    TriggerAddEventGeneric(libAffx_PBU2DifficultyChangedTrigger, "libPBU2_DifficultyChanged");
}

bool libAffx_SpeedUpDeathUnitDied_Func (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    if (testConds) {
        if (UnitGetOwner(deadUnit) != libAffx_player) {
            return false;
        }
        if (!libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpDeath, libAffx_player)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_Wait(0.0625, c_timeGame);
    TriggerExecute(libAffx_SpeedUpDeathTrigger, true, false);
    return true;
}
void libAffx_SpeedUpDeathUnitDied_Init() {
    libAffx_SpeedUpDeathUnitDiedTrigger = TriggerCreate("libAffx_SpeedUpDeathUnitDied_Func");
    TriggerAddEventUnitDied(libAffx_SpeedUpDeathUnitDiedTrigger, null);
}

bool libAffx_SpeedUpDeathTrigger_Func (bool testConds, bool runActions) {
    unitgroup heroGroup = libGame_gv_players[libAffx_player].lv_heroUnitGroup;
    int groupCount = UnitGroupCount(heroGroup, c_unitCountAlive);
    int i;
    unit heroUnit;
    for (i = 1; i <= groupCount; i += 1) {
        heroUnit = UnitGroupUnit(heroGroup, i);
        if (UnitGetType(heroUnit) == "HeroLostVikingsController") {
            UnitGroupRemove(heroGroup, heroUnit);
        }
    }
    if (testConds) {
        if (groupCount > 0) {
            return false;
        }
        if (!libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpDeath, libAffx_player)) {
            return false;
        }
        if (libGame_gv_gameOver) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpDeath, libAffx_player)) {
        GameSetSpeedValue(4);
        while (groupCount <= 0 && libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpDeath, libAffx_player) && !libGame_gv_gameOver) {
            groupCount = UnitGroupCount(heroGroup, c_unitCountAlive);
            Wait(0.0625, c_timeGame);
        }
        GameSetSpeedValue(2);
    }
    return true;
}

bool libAffx_SpeedUpTrigger_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_GateIsOpen()) {
            return false;
        }
        if (!libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpGates, libAffx_player)) {
            return false;
        }
        if (libGame_gv_gameOver) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpGates, libAffx_player)) {
        GameSetSpeedValue(4);
        while (!libAffx_GateIsOpen() && libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpGates, libAffx_player) && !libGame_gv_gameOver) {
            Wait(0.0625, c_timeGame);
        }
        GameSetSpeedValue(2);
    }
    return true;
}

void libAffx_SpeedUpTrigger_Init() {
    libAffx_SpeedUpTrigger = TriggerCreate("libAffx_SpeedUpTrigger_Func");
    libAffx_SpeedUpDeathTrigger = TriggerCreate("libAffx_SpeedUpDeathTrigger_Func");
}

bool libAffx_OptionsRestartClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libAffx_dialogControlOptionsReturnButton && eventDialog != libAffx_dialogControlOptionsRestartButton && 
            eventDialog != libAffx_dialogOptionsRestart.option[1].button && eventDialog != libAffx_dialogOptionsRestart.option[2].button) {
            return false;
        }
        if (!libAffx_IsOptionsDialogVisible() && !libAffx_IsGameoverDialogVisible()) {
            return false;
        }
        if (libAffx_IsAchievementsDialogVisible()) {
            return false;
        }
    }
    // Actions
    if (!runActions) {
        return true;
    }
    if (eventDialog == libAffx_dialogControlOptionsRestartButton) {
        libAffx_ShowOptionsRestartDialog(true);
    } else if (eventDialog == libAffx_dialogOptionsRestart.option[1].button) {
        libAffx_ResetBank();
        libAffx_ResetBankStats();
        GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialveteran.stormmap");
        KickFromGame(PlayerGroupAll());
    } else if (eventDialog == libAffx_dialogOptionsRestart.option[2].button) {
        libAffx_ShowOptionsRestartDialog(false);
    } else if (eventDialog == libAffx_dialogControlOptionsReturnButton) {
        libAffx_ShowOptionsDialog(false);
    }

    return true;
}
bool libAffx_OptionsClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libAffx_dialogControlOptionsButton && eventDialog != libAffx_dialogControlOptionsSpeedUpGates
        && eventDialog != libAffx_dialogControlOptionsSpeedUpDeath && eventDialog != libAffx_dialogControlOptionsDisplayPicksBans) {
            return false;
        }
    }
    // Actions
    if (!runActions) {
        return true;
    }
    if (eventDialog == libAffx_dialogControlOptionsButton) {
        if (!libAffx_IsOptionsDialogVisible()) {
            libAffx_ShowOptionsRestartDialog(false);
            libAffx_ShowGameoverExitDialog(false);
        }
        libAffx_ShowAchievementsDialog(false);
        libAffx_ShowOptionsDialog(!libAffx_IsOptionsDialogVisible());
    } else if (eventDialog == libAffx_dialogControlOptionsSpeedUpGates && !libAffx_IsAchievementsDialogVisible()) {
        libAffx_SaveSettingsBank();
        if (TriggerActiveCount(libAffx_SpeedUpTrigger) <= 0) {
            TriggerExecute(libAffx_SpeedUpTrigger, true, false);
        }
    } else if (eventDialog == libAffx_dialogControlOptionsSpeedUpDeath && !libAffx_IsAchievementsDialogVisible()) {
        libAffx_SaveSettingsBank();
        if (TriggerActiveCount(libAffx_SpeedUpDeathTrigger) <= 0) {
            TriggerExecute(libAffx_SpeedUpDeathTrigger, true, false);
        }
    } else if (eventDialog == libAffx_dialogControlOptionsDisplayPicksBans && !libAffx_IsAchievementsDialogVisible()) {
        libAffx_SaveSettingsBank();
    }
    return true;
}

bool libAffx_ShowAffixesClickedTrigger_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (EventDialogControl() != libAffx_dialogControlOwnedAffixesButton) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible() || libAffx_IsGameoverExitDialogVisible() || !libAffx_bankLoaded) {
            return false;
        }
    }
    // Actions
    if (!runActions) {
        return true;
    }
    if (libAffx_IsOwnedAffixesDialogVisible()) {
        libAffx_ShowOwnedAffixesDialog(false);
    } else {
        libAffx_ShowOwnedAffixesDialog(true);
    }
    return true;
}

// ============================================================
// Talent functions
// ============================================================

void libAffx_SelectAllTalentsOnTier(int player, int tier) {
    string hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[player]);
    unit heroUnit = libAffx_GetPlayerHeroUnit(player);
    int i;
    int choGallPlayer = 0;
    if ((hero == "Varian" && tier > 2) || (hero != "Varian" && tier > 4)) {
        while ((!UnitHasBehavior2(heroUnit, "Ultimate1Unlocked") && !UnitHasBehavior2(heroUnit, "Ultimate2Unlocked") && !UnitHasBehavior2(heroUnit, "Ultimate3Unlocked"))) {
            libAffx_Wait(0.0625, c_timeGame);
        }
    }
    if (hero == "Tracer" && tier > 4) {
        while (!PlayerHasTalent(player, "TracerQuantumSpike") && !PlayerHasTalent(player, "TracerStickyBomb") && !PlayerHasTalent(player, "TracerPulseRounds")) {
            libAffx_Wait(0.0625, c_timeGame);
        }
    }
    if (libAffx_allTalentsSelected[player][tier]) {
        return;
    }
    if (player == libAffx_choPlayer) {
        choGallPlayer = libAffx_gallPlayer;
    } else if (player == libAffx_gallPlayer) {
        choGallPlayer = libAffx_choPlayer;
    }
    if (hero == "Alarak" && tier == 4) {
        SetTalentEnabled("AlarakMightOfTheHighlord", false);
    }
    libAffx_DisplayDebugMessage("Selecting all tier " + IntToString(tier) + " talents for player " + IntToString(player));
    for (i = 1; i <= libCore_gv_talents_MaxTalentsPerTier_C; i += 1) {
        libGame_gf_TalentsChooseTalentForPlayer(tier, i, player);
        libAffx_allTalentsSelected[player][tier] = true;
        if (choGallPlayer != 0) {
            libGame_gf_TalentsChooseTalentForPlayer(tier, i, choGallPlayer);
            libAffx_allTalentsSelected[choGallPlayer][tier] = true;
        }
    }
}
void libAffx_SelectAllTalents(int player, int level, bool excludeHeroics) {
    string hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[player]);
    if (hero == "Chromie") {
        level += 2;
    }
    
    if (level >= 1) {
        libAffx_SelectAllTalentsOnTier(player, 1);
    } 
    if (level >= 4 && (hero != "Varian" || !excludeHeroics)) {
        libAffx_SelectAllTalentsOnTier(player, 2);
    }
    if (level >= 7) {
        libAffx_SelectAllTalentsOnTier(player, 3);
    }
    if (level >= 10 && (hero == "Varian" || !excludeHeroics)) {
        libAffx_SelectAllTalentsOnTier(player, 4);
    }
    if (level >= 13) {
        libAffx_SelectAllTalentsOnTier(player, 5);
    }
    if (level >= 16) {
        libAffx_SelectAllTalentsOnTier(player, 6);
    }
    if (level >= 20) {
        libAffx_SelectAllTalentsOnTier(player, 7);
    }
}

void libAffx_DummyTalentChoicesFromTalentName(int lp_player, string talent) {
    int lv_itBehavior;
    int lv_itAbilityMod;
    int lv_itAbilityModChange;
    int lv_behaviorCount;
    int lv_numberOfAbilitiesModified;
    int lv_numberOfFieldsModified;
    int lv_catalogInt;
    int lv_changeTypeInt;
    int lv_currentTalentModNumber;

    int auto38B17200_ae;
    int autoDE132AE1_ae;
    libGame_gv_talents_TalentChoices[lp_player][0].lv_numberOfTalentsForThisTier = 1; // tier 0 column 0 as dummy talent data
    libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_talentCatalogLink = (talent);
    if ((CatalogFieldValueCount(c_gameCatalogTalent, talent, "RankArray", c_playerAny) != 0)) {
        libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount = MaxI(libCore_gv_talents_MaxBehaviorsPerTalent_C, CatalogFieldValueCount(c_gameCatalogTalent, talent, "RankArray[" + IntToString(0) + "].BehaviorArray", c_playerAny));
    }
    else {
        libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount = 0;
    }
    if ((libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount != 0)) {
        lv_behaviorCount = libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount;
        lv_itBehavior = 1;
        for ( ; ( (1 >= 0 && lv_itBehavior <= lv_behaviorCount) || (1 < 0 && lv_itBehavior >= lv_behaviorCount) ) ; lv_itBehavior += 1 ) {
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviors[lv_itBehavior] = (CatalogFieldValueGet(c_gameCatalogTalent, talent, "RankArray[" + IntToString(0) + "].BehaviorArray[" + IntToString((lv_itBehavior - 1)) + "]", c_playerAny));
        }
    }
    libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_totalModifications = 0;
    lv_currentTalentModNumber = 0;
    lv_numberOfAbilitiesModified = MaxI(libCore_gv_talents_MaxModificationsPerTalent_C, CatalogFieldValueCount(c_gameCatalogTalent, talent, "AbilityModificationArray", c_playerAny));

    auto38B17200_ae = lv_numberOfAbilitiesModified;
    lv_itAbilityMod = 1;

    for ( ; ( (1 >= 0 && lv_itAbilityMod <= auto38B17200_ae) || (1 < 0 && lv_itAbilityMod >= auto38B17200_ae) ) ; lv_itAbilityMod += 1 ) {
        lv_numberOfFieldsModified = CatalogFieldValueCount(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString(lv_itAbilityMod - 1) + "].Modifications", c_playerAny);
        autoDE132AE1_ae = lv_numberOfFieldsModified;
        lv_itAbilityModChange = 1;
        for ( ; ( (1 >= 0 && lv_itAbilityModChange <= autoDE132AE1_ae) || (1 < 0 && lv_itAbilityModChange >= autoDE132AE1_ae) ) ; lv_itAbilityModChange += 1 ) {
            lv_currentTalentModNumber += 1;
            if ((lv_currentTalentModNumber > libGame_gv_talents_DebugMaxModifedAbilites)) {
                libGame_gv_talents_DebugMaxModifedAbilites = lv_currentTalentModNumber;
            }

            lv_changeTypeInt = CatalogFieldValueGetAsInt(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Type", c_playerAny);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_changeType = lv_changeTypeInt;
            lv_catalogInt = CatalogFieldValueGetAsInt(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Catalog", c_playerAny);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_catalog = lv_catalogInt;
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_field = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Field", c_playerAny);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_fieldIsInteger = (CatalogFieldValueGetAsInt(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].FieldIsInteger", c_playerAny) == 1);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_value = CatalogFieldValueGetAsFixed(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Value", c_playerAny);
            if ((libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_changeType == c_talentModificationCatalogReplacement)) {
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_catalogReplaceFrom = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Entry", c_playerAny);
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_catalogChangeTo = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].StringReplacement", c_playerAny);
            }
            else {
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_entry = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Entry", c_playerAny);
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_stringReplacementValue = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].StringReplacement", c_playerAny);
            }
        }
    }
    if ((lv_numberOfAbilitiesModified > 0)) {
        libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_totalModifications = lv_currentTalentModNumber;
    }
}

void libAffx_AddTalent(int lp_player, string talent) {
    int behavior;
    int behaviorCount;
    unit heroUnit;

    libAffx_DummyTalentChoicesFromTalentName(lp_player, talent);

    heroUnit = libGame_gv_players[lp_player].lv_heroUnit;
    behaviorCount = libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount;
    behavior = 1;
    for ( ; ( (1 >= 0 && behavior <= behaviorCount) || (1 < 0 && behavior >= behaviorCount) ) ; behavior += 1 ) {
        UnitBehaviorAdd(heroUnit, libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviors[behavior], heroUnit, 1);
    }
    libGame_gf_SendEventHeroGainTalent((libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_talentCatalogLink), lp_player);
    libGame_gf_ApplyAbilityModificationsForPlayerAtTalent(lp_player, 0, 0);

    StatEventCreate("TalentChosen");
    StatEventAddDataInt(StatEventLastCreated(), "PlayerID", lp_player);
    StatEventAddDataString(StatEventLastCreated(), "PurchaseName", (libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_talentCatalogLink));
    StatEventSend(StatEventLastCreated());
    PlayerAddTalent(lp_player, libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_talentCatalogLink);
    libGame_gf_TalentsUpdateChoicePanelForPlayer(lp_player);
    libUIUI_gf_UIPartyFrameHeroicTalentUpdate(lp_player, 0);
    ActorSend(libNtve_gf_MainActorofUnit(libGame_gv_players[lp_player].lv_heroUnit), (("Signal " + (libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_talentCatalogLink))));
}

void libAffx_ShowTalent(string talent, bool show) {
    if (show) {
        SetTalentEnabled(talent, true);
        SetTalentHidden(talent, false);
    } else {
        SetTalentEnabled(talent, false);
        SetTalentHidden(talent, true);
    }
}
void libAffx_DisableTalent(string talent, bool disable) {
    if (disable) {
        SetTalentEnabled(talent, false);
    } else {
        SetTalentEnabled(talent, true);
    }
}

void libAffx_CatalogSetForAllPlayers(int type, string entry, string path, string value) {
    int i;
    for (i = 1; i <= libCore_gv_bALMaxEnginePlayerCount; i += 1) {
        CatalogFieldValueSet(type, entry, path, i, value);
    }
}
void libAffx_CatalogSetFixedForAllPlayers(int type, string entry, string path, fixed value) {
    int i;
    for (i = 1; i <= libCore_gv_bALMaxEnginePlayerCount; i += 1) {
        CatalogFieldValueSetFixed(type, entry, path, i, value);
    }
}
void libAffx_CatalogModifyForAllPlayers(string reference, string value) {
    int i;
    for (i = 1; i <= libCore_gv_bALMaxEnginePlayerCount; i += 1) {
        CatalogReferenceModify(reference, i, value, c_upgradeOperationSet);
    }
}

void libAffx_SendAffixAddedEvent (int affix, int amount) {
    DataTableSetInt(false, TriggerEventParamName(libAffx_eventAffixAddedID + libAffx_affixes[affix].name, libAffx_eventAffixAddedParam), affix);
    DataTableSetInt(false, TriggerEventParamName(libAffx_eventAffixAddedID + libAffx_affixes[affix].name, libAffx_eventAffixAddedParam2), amount);
    TriggerSendEvent(libAffx_eventAffixAddedID + libAffx_affixes[affix].name);
    TriggerSendEvent(libAffx_eventAffixAddedID);
}
int libAffx_EventAffix() {
    return DataTableGetInt(false, TriggerEventParamName(EventGenericName(), libAffx_eventAffixAddedParam));
}
int libAffx_EventAffixCountAdded() {
    return DataTableGetInt(false, TriggerEventParamName(EventGenericName(), libAffx_eventAffixAddedParam2));
}
int libAffx_EventAffixCount() {
    return libAffx_affixes[libAffx_EventAffix()].count;
}

void libAffx_CopyFilter(structref<libAffx_Filter> original, structref<libAffx_Filter> copyTo) {
    int i;
    copyTo.unitFilter = original.unitFilter;
    copyTo.requiredPlayer = original.requiredPlayer;
    for (i = 1; i <= libAffx_maxFilters; i += 1) {
        libAffx_AddRequiredUnitTypeFilter(copyTo, original.requiredUnitTypes[i]);
    }
    for (i = 1; i <= libAffx_maxFilters; i += 1) {
        libAffx_AddExcludedUnitTypeFilter(copyTo, original.excludedUnitTypes[i]);
    }
}
void libAffx_AddRequiredUnitTypeFilter(structref<libAffx_Filter> filter, string unitType) {
    if (filter.requiredUnitTypeIndex >= libAffx_maxFilters) {
        libAffx_DisplayDebugMessage("Warning: A filter reached maximum limit!");
        return;
    }
    if (unitType == "") { return; }
    filter.requiredUnitTypeIndex += 1;
    filter.requiredUnitTypes[filter.requiredUnitTypeIndex] = unitType;
}
void libAffx_AddExcludedUnitTypeFilter(structref<libAffx_Filter> filter, string unitType) {
    if (filter.excludedUnitTypeIndex >= libAffx_maxFilters) {
        libAffx_DisplayDebugMessage("Warning: A filter reached maximum limit!");
        return;
    }
    if (unitType == "") { return; }
    filter.excludedUnitTypeIndex += 1;
    filter.excludedUnitTypes[filter.excludedUnitTypeIndex] = unitType;
}
bool libAffx_UnitIsMinion(unit unitVar) {
    string unitType = UnitGetType(unitVar);
    if (unitType == "FootmanMinion" || unitType == "RangedMinion" || (UnitBehaviorCount(unitVar, "IsCatapultMinionOrCatapultReplacement") > 0) || unitType == "WizardMinion") {
        return true;
    }
    return false;
}
bool libAffx_UnitMatchesType(unit unitVar, structref<libAffx_Filter> filter) {
    int i;
    for (i = 1; i <= libAffx_maxFilters; i += 1) {
        if (filter.requiredUnitTypes[i] != null && filter.requiredUnitTypes[i] != "" && UnitGetType(unitVar) == filter.requiredUnitTypes[i]) {
            return true;
        } else if (i == 1 && filter.requiredUnitTypes[i] == "") {
            return true;
        }
    }
    return false;
}
bool libAffx_UnitMatchesCriteria(unit unitVar, structref<libAffx_Filter> filter) {
    int i;
    if (filter.unitFilter != null && !UnitFilterMatch(unitVar, libAffx_player, filter.unitFilter)) {
        return false;
    }
    if (filter.requiredPlayer != 0 && filter.requiredPlayer != c_playerAny && UnitGetOwner(unitVar) != filter.requiredPlayer) {
        return false;
    }
    if (!libAffx_UnitMatchesType(unitVar, filter)) {
        return false;
    }
    for (i = 1; i <= libAffx_maxFilters; i += 1) {
        if (filter.excludedUnitTypes[i] != null && filter.excludedUnitTypes[i] != "" && UnitGetType(unitVar) == filter.excludedUnitTypes[i]) {
            return false;
        }
    }
    return true;
}
void libAffx_AddUnitBehaviorCriteria(unit unitVar, string behavior, int stacks, structref<libAffx_Filter> filter) {
    if (libAffx_UnitMatchesCriteria(unitVar, filter)) {
        libAffx_AddUnitBehavior(unitVar, behavior, unitVar, stacks);
    }
}
void libAffx_UpdateUnitBehaviorCriteria(unit unitVar, string behavior, int stacks, structref<libAffx_Filter> filter) {
    if (libAffx_UnitMatchesCriteria(unitVar, filter)) {
        libAffx_AddUnitBehavior(unitVar, behavior, unitVar, stacks);
    } else {
        UnitBehaviorRemove(unitVar, behavior, stacks);
    }
}
void libAffx_SetUnitPropertyCriteria(unit unitVar, int inProp, fixed value, structref<libAffx_Filter> filter) {
    if (libAffx_UnitMatchesCriteria(unitVar, filter)) {
        UnitSetPropertyFixed(unitVar, inProp, value);
    }
}
void libAffx_SetUnitPropertyCriteriaAll (int inProp, fixed value, structref<libAffx_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (libAffx_UnitMatchesCriteria(unitVar, filter)) {
            UnitSetPropertyFixed(unitVar, inProp, value);
        }
    }
}
void libAffx_AddUnitBehaviorCriteriaAll (string behavior, int stacks, structref<libAffx_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (libAffx_UnitMatchesCriteria(unitVar, filter)) {
            libAffx_AddUnitBehavior(unitVar, behavior, unitVar, stacks);
        }
    }
}
void libAffx_RemoveUnitBehaviorCriteriaAll (string behavior, int stacks, structref<libAffx_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) {
            break;
        }
        if (libAffx_UnitMatchesCriteria(unitVar, filter)) {
            UnitBehaviorRemove(unitVar, behavior, stacks);
        }
    }
}

void libAffx_SetPlayerPropertyFixed (int player, int inProp, fixed value, bool applyToAllUnits) {
    int i;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    unit heroUnit;
    if (applyToAllUnits) {
        for (;; unitGroupCount -= 1) {
            if (unitGroupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(unitGroup, i);
            if (UnitGetType(heroUnit) != "HeroLostVikingsController") {
                UnitSetPropertyFixed(heroUnit, inProp, value);
            }
        }
    } else {
        heroUnit = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
        if (UnitGetType(heroUnit) == "HeroLostVikingsController") {
            UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), inProp, value);
        } else {
            UnitSetPropertyFixed(heroUnit, inProp, value);
        }
    }
}
void libAffx_AddUnitPropertyFixed (unit unitVar, int inProp, fixed value) {
    UnitSetPropertyFixed(unitVar, inProp, UnitGetPropertyFixed(unitVar, inProp, true) + value);
}
void libAffx_AddPlayerPropertyFixed (int player, int inProp, fixed value, bool applyToAllUnits) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    if (applyToAllUnits) {
        for (i = unitGroupCount; i > 0; i -= 1) {
            if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) != "HeroLostVikingsController") {
                UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, i), inProp, UnitGetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, i), inProp, true) + value);
            }
        }
    } else {
        if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, unitGroupCount)) == "HeroLostVikingsController") {
            UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), inProp, UnitGetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), inProp, true) + value);
        } else {
            UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), inProp, UnitGetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), inProp, true) + value);
        }
    }
}
bool libAffx_PlayerHasAffixBehavior(int player, string behavior) {
    int i;
    for (i = 1; i <= libAffx_affixBehaviorIndex[player]; i += 1) {
        if (libAffx_affixBehaviors[player][i] == behavior) {
            return true;
        }
    }
    return false;
}
void libAffx_AddAffixBehavior(int player, string behavior) {
    if (player < 1 || player > 10 || behavior == "" || behavior == null || (libAffx_affixBehaviorIndex[player] + 1) > libAffx_maxAffixBehaviors) {
        return;
    }
    if (UnitBehaviorHasCategoryFlag(behavior, c_behaviorCategoryTemporary) || libAffx_PlayerHasAffixBehavior(player, behavior)) {
        return;
    }

    libAffx_affixBehaviorIndex[player] += 1;
    libAffx_affixBehaviors[player][libAffx_affixBehaviorIndex[player]] = behavior;
}
void libAffx_AddUnitBehavior(unit targetUnit, string behavior, unit casterUnit, int stacks) {
    int player = UnitGetOwner(targetUnit);
    UnitBehaviorAdd(targetUnit, behavior, casterUnit, stacks);
    if (player >= 1 && player <= 10 && behavior != "" && behavior != null) {
        if (libAffx_affixBehaviorIndex[player] <= libAffx_maxAffixBehaviors) {
            if (!UnitTestState(targetUnit, c_unitStateHallucination) && UnitTypeTestAttribute(UnitGetType(targetUnit), c_unitAttributeHeroic)) {
                libAffx_AddAffixBehavior(player, behavior);
            }
        } else {
            libAffx_DisplayDebugMessage("Warning: Too many affix behaviors added!");
        }
    }
}
void libAffx_AddPlayerBehaviorWithExclusion (int player, string behavior, int stacks, bool applyToAllUnits, string excludeUnit) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unit heroUnit;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    if (applyToAllUnits || (libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[player]) == "DVa" && excludeUnit != "HeroDVaMech")) {
        for (i = unitGroupCount; i > 0; i -= 1) {
            heroUnit = UnitGroupUnitFromEnd(unitGroup, i);
            if (UnitGetType(heroUnit) != "HeroLostVikingsController" && UnitGetType(heroUnit) != excludeUnit) {
                if (player == libAffx_choPlayer || player == libAffx_gallPlayer) {
                    libAffx_AddUnitBehavior(libGame_gv_players[libAffx_gallPlayer].lv_heroUnit, behavior, libGame_gv_players[libAffx_gallPlayer].lv_heroUnit, stacks);
                    libAffx_AddUnitBehavior(libGame_gv_players[libAffx_choPlayer].lv_heroUnit, behavior, libGame_gv_players[libAffx_choPlayer].lv_heroUnit, stacks);
                    break;
                } else {
                    libAffx_AddUnitBehavior(heroUnit, behavior, heroUnit, stacks);
                }
            }
        }
    } else {
        heroUnit = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
        if (UnitGetType(heroUnit) == excludeUnit) {
        } else if (UnitGetType(heroUnit) == "HeroLostVikingsController") {
            libAffx_AddUnitBehavior(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), behavior, UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), stacks);
        } else {
            if (player == libAffx_choPlayer || player == libAffx_gallPlayer) {
                libAffx_AddUnitBehavior(libGame_gv_players[libAffx_gallPlayer].lv_heroUnit, behavior, libGame_gv_players[libAffx_gallPlayer].lv_heroUnit, stacks);
                libAffx_AddUnitBehavior(libGame_gv_players[libAffx_choPlayer].lv_heroUnit, behavior, libGame_gv_players[libAffx_choPlayer].lv_heroUnit, stacks);
            } else {
                libAffx_AddUnitBehavior(heroUnit, behavior, heroUnit, stacks);
            }
        }
    }
}
void libAffx_AddPlayerBehavior (int player, string behavior, int stacks, bool applyToAllUnits) {
    libAffx_AddPlayerBehaviorWithExclusion(player, behavior, stacks, applyToAllUnits, null);
}
void libAffx_RemovePlayerBehavior (int player, string behavior, int stacks, bool applyToAllUnits) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    if (applyToAllUnits) {
        for (i = unitGroupCount; i > 0; i -= 1) {
            if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) != "HeroLostVikingsController" && UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, i), behavior)) {
                if (player == libAffx_choPlayer || player == libAffx_gallPlayer) {
                    UnitBehaviorRemove(libGame_gv_players[libAffx_gallPlayer].lv_heroUnit, behavior, stacks);
                    UnitBehaviorRemove(libGame_gv_players[libAffx_choPlayer].lv_heroUnit, behavior, stacks);
                    break;
                } else {
                    UnitBehaviorRemove(UnitGroupUnitFromEnd(unitGroup, i), behavior, stacks);
                }
            }
        }
    } else {
        if (UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), behavior)) {
            if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, unitGroupCount)) == "HeroLostVikingsController") {
                UnitBehaviorRemove(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), behavior, stacks);
            } else {
                if (player == libAffx_choPlayer || player == libAffx_gallPlayer) {
                    UnitBehaviorRemove(libGame_gv_players[libAffx_gallPlayer].lv_heroUnit, behavior, stacks);
                    UnitBehaviorRemove(libGame_gv_players[libAffx_choPlayer].lv_heroUnit, behavior, stacks);
                } else {
                    UnitBehaviorRemove(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), behavior, stacks);
                }
            }
        }
    }
}

void libAffx_ModifyPlayerTokenCount (int player, int tokens, string quest) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        libGame_gf_ModifyTokenCount(tokens, quest, UnitGroupUnitFromEnd(unitGroup, i));
    }
}

void libAffx_AddUnitTokenCount(unit unitToAdd, string tokenBehavior, fixed value) {
    UnitSetTokenCount(unitToAdd, tokenBehavior, UnitGetTokenCount(unitToAdd, tokenBehavior) + value, unitToAdd);
}

bool libAffx_PlayerHasBehavior (int player, string behavior) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        if (UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, i), behavior)) {
            return true;
        }
    }
    return false;
}

int libAffx_PlayerBehaviorCount (int player, string behavior) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        if (UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, i), behavior)) {
            return UnitBehaviorCount(UnitGroupUnitFromEnd(unitGroup, i), behavior);
        }
    }
    return 0;
}

void libAffx_UnitCreateEffectUnit (int player, string effect) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    if (unitGroupCount == 1) {
        UnitCreateEffectUnit(libGame_gv_players[player].lv_heroUnit, effect, libGame_gv_players[player].lv_heroUnit);
    } else {
        for (i = unitGroupCount; i > 0; i -= 1) {
            UnitCreateEffectUnit(UnitGroupUnitFromEnd(unitGroup, i), effect, UnitGroupUnitFromEnd(unitGroup, i));
        }
    }
}

unit libAffx_GetPlayerHeroUnit (int player) {
    unitgroup heroGroup;
    unit heroUnit;
    int unitGroupCount;
    if (libGame_gv_players[player].lv_heroIndex == libCore_gf_GetIndexFromHero("LostVikings")) {
        heroGroup = libGame_gv_players[player].lv_heroUnitGroup;
        unitGroupCount = UnitGroupCount(heroGroup, c_unitCountAll);
        for (;; unitGroupCount -= 1) {
            if (unitGroupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(heroGroup, unitGroupCount);
            if (UnitGetType(heroUnit) == "HeroOlaf") {
                return heroUnit;
            }
        }
        return null;
    } else {
        return libGame_gv_players[player].lv_heroUnit;
    }
}

void libAffx_SetLevelScalingAndValue(string reference, int player, fixed scaling, fixed value) {
    int level = UnitLevel(libGame_gv_players[player].lv_heroUnit);
    if (player == 0) { return; }
    if (level <= 0) { level = 1; }
    CatalogReferenceModify(reference, player, FixedToString(value * Pow(1 + scaling, level), 4), c_upgradeOperationSet);
}

void libAffx_SetLevelScaling(string reference, int player, fixed scaling) {
    libAffx_SetLevelScalingAndValue(reference, player, scaling, StringToFixed(CatalogReferenceGet(reference, 0)));
}

void libAffx_SetDefaultLevelScaling(string reference, int player) {
    libAffx_SetLevelScaling(reference, player, 0.04);
}

string libAffx_GetCatalogDefaultValue(string reference) {
    return CatalogReferenceGet(reference, 0);
}

void libAffx_CatalogFieldValueSetFixed(int catalog, string entry, string fieldPath, int player, fixed value) {
    if (player != 0 && (player == libAffx_choPlayer || player == libAffx_gallPlayer)) {
        CatalogFieldValueSetFixed(catalog, entry, fieldPath, libAffx_gallPlayer, value);
        CatalogFieldValueSetFixed(catalog, entry, fieldPath, libAffx_choPlayer, value);
    } else {
        CatalogFieldValueSetFixed(catalog, entry, fieldPath, player, value);
    }
}
void libAffx_CatalogReferenceModify (string reference, int player, string value, int operation) {
    if (player != 0 && (player == libAffx_choPlayer || player == libAffx_gallPlayer)) {
        CatalogReferenceModify(reference, libAffx_choPlayer, value, operation);
        CatalogReferenceModify(reference, libAffx_gallPlayer, value, operation);
    } else {
        CatalogReferenceModify(reference, player, value, operation);
    }
}
void libAffx_CatalogReferenceSet (string reference, int player, string value) {
    libAffx_CatalogReferenceModify(reference, player, value, c_upgradeOperationSet);
}


// ============================================================
// Affix effects
// ============================================================

void libAffx_ApplyTalents(int affix) {
    int i;
    string addTalent;
    string showTalent;
    string disableTalent;
    if (libAffx_affixes[affix].talentsApplied) {
        return;
    }

    for (i = 1; i <= libAffx_maxTalents; i += 1) {
        addTalent = libAffx_affixes[affix].addTalents[i];
        if (addTalent != "" && addTalent != null) {
            libAffx_AddTalent(libAffx_player, addTalent);
            SetTalentEnabled(addTalent, false);
        }
        disableTalent = libAffx_affixes[affix].disableTalents[i];
        if (disableTalent != "" && disableTalent != null) {
            libAffx_DisableTalent(disableTalent, true);
        }
        showTalent = libAffx_affixes[affix].showTalents[i];
        if (showTalent != "" && showTalent != null) {
            libAffx_ShowTalent(showTalent, true);
        }
    }
    libAffx_affixes[affix].talentsApplied = true;
}
void libAffx_ApplyCatalogModificationBaseMult(string reference, int player, string valueString, fixed value, int stacks, int operation, fixed mult) {
    if (operation == c_upgradeOperationSubtract) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) - (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else if (operation == c_upgradeOperationMultiply) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) * (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else if (operation == c_upgradeOperationDivide) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) / (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) + (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    }
}
void libAffx_ApplyCatalogModificationBase(string reference, int player, string valueString, fixed value, int stacks, int operation) {
    libAffx_ApplyCatalogModificationBaseMult(reference, player, valueString, value, stacks, operation, 0);
}
void libAffx_ApplyCatalogModifications(int affix, int amount) {
    int i;
    int i2;
    int totalAmount = libAffx_affixes[affix].count;
    int catalogAmount;
    string catalogReference;
    int catalogType;
    int catalogPlayer;
    fixed catalogValue;
    string catalogValueString;
    int catalogOperation;
    for (i = 1; i <= libAffx_maxCatalogModifications; i += 1) {
        catalogReference = libAffx_affixes[affix].catalogModifications[i].reference;
        if (catalogReference != "" && catalogReference != null) {
            catalogType = libAffx_affixes[affix].catalogModifications[i].type;
            catalogValue = libAffx_affixes[affix].catalogModifications[i].value;
            catalogPlayer = libAffx_affixes[affix].catalogModifications[i].player;
            catalogOperation = libAffx_affixes[affix].catalogModifications[i].operation;
            if (catalogType == libAffx_catalogTypeFlat) {
                catalogValueString = FixedToString(catalogValue, c_fixedPrecisionAny);
            } else if (catalogType == libAffx_catalogTypePerStack) {
                catalogValueString = FixedToString(catalogValue * totalAmount, c_fixedPrecisionAny);
            } else if (catalogType == libAffx_catalogTypePerStackDelta) {
                catalogValueString = FixedToString(catalogValue * amount, c_fixedPrecisionAny);
            } else if (catalogType == libAffx_catalogTypePerStackDeltaExclFirst) {
                catalogAmount = MaxI(0, totalAmount - 1) - MaxI(0, totalAmount - amount - 1);
                catalogValueString = FixedToString(catalogValue * catalogAmount, c_fixedPrecisionAny);
            } else if (catalogType == libAffx_catalogTypeBase || catalogType == libAffx_catalogTypeBaseDelta || catalogType == libAffx_catalogTypeBaseMult) {
                catalogValueString = CatalogReferenceGet(catalogReference, 0);
            } else {
                catalogValueString = FixedToString(catalogValue, c_fixedPrecisionAny);
            }
            if (catalogPlayer == 0) {
                for (i2 = 1; i2 <= 12; i2 += 1) {
                    if ((i2 == libAffx_choPlayer || i2 == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                        continue;
                    } else {
                        if (catalogType == libAffx_catalogTypeBase) {
                            libAffx_ApplyCatalogModificationBase(catalogReference, i2, catalogValueString, catalogValue, totalAmount, catalogOperation);
                        } else if (catalogType == libAffx_catalogTypeBaseDelta) {
                            libAffx_ApplyCatalogModificationBase(catalogReference, i2, catalogValueString, catalogValue, amount, catalogOperation);
                        } else if (catalogType == libAffx_catalogTypeBaseMult) {
                            libAffx_ApplyCatalogModificationBaseMult(catalogReference, i2, catalogValueString, catalogValue, totalAmount, catalogOperation, 1);
                        } else {
                            CatalogReferenceModify(catalogReference, i2, catalogValueString, catalogOperation);
                        }
                    }
                }
            } else if ((catalogPlayer == libAffx_choPlayer || catalogPlayer == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                continue;
            } else if (catalogPlayer >= 1 && catalogPlayer <= 12) {
                if (catalogType == libAffx_catalogTypeBase) {
                    libAffx_ApplyCatalogModificationBase(catalogReference, catalogPlayer, catalogValueString, catalogValue, totalAmount, catalogOperation);
                } else if (catalogType == libAffx_catalogTypeBaseDelta) {
                    libAffx_ApplyCatalogModificationBase(catalogReference, catalogPlayer, catalogValueString, catalogValue, amount, catalogOperation);
                } else if (catalogType == libAffx_catalogTypeBaseMult) {
                    libAffx_ApplyCatalogModificationBaseMult(catalogReference, catalogPlayer, catalogValueString, catalogValue, totalAmount, catalogOperation, 1);
                } else {
                    CatalogReferenceModify(catalogReference, catalogPlayer, catalogValueString, catalogOperation);
                }
            }
        }
    }
}
void libAffx_RemoveBehaviors(int affix) {
    int i;
    int i2;
    string behavior;
    int behaviorPlayer;
    for (i = 1; i <= libAffx_maxBehaviors; i += 1) {
        behavior = libAffx_affixes[affix].removeBehaviors[i].behavior;
        if (behavior != "" && behavior != null) {
            behaviorPlayer = libAffx_affixes[affix].removeBehaviors[i].player;
            if (behaviorPlayer == 0) {
                for (i2 = 1; i2 <= 10; i2 += 1) {
                    if ((i2 == libAffx_choPlayer || i2 == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                        continue;
                    } else {
                        libAffx_RemovePlayerBehavior(i2, behavior, 1, true);
                    }
                }
            } else if ((behaviorPlayer == libAffx_choPlayer || behaviorPlayer == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                continue;
            } else if (behaviorPlayer >= 1 && behaviorPlayer <= 10) {
                libAffx_RemovePlayerBehavior(behaviorPlayer, behavior, 1, true);
            }
        }
    }
}
void libAffx_ApplyBehaviors(int affix, int amount) {
    int i;
    int i2;
    int i3;
    string behavior;
    int behaviorPlayer;
    unitgroup unitGroup;
    int unitGroupCount;
    int amountToAdd;
    bool affectedByCount;
    for (i = 1; i <= libAffx_maxBehaviors; i += 1) {
        behavior = libAffx_affixes[affix].behaviors[i].behavior;
        if (behavior != "" && behavior != null) {
            behaviorPlayer = libAffx_affixes[affix].behaviors[i].player;
            if (libAffx_affixes[affix].behaviors[i].affectedByCount) {
                amountToAdd = amount;
            } else {
                amountToAdd = 1;
            }
            if (behaviorPlayer == 0) {
                for (i2 = 1; i2 <= 10; i2 += 1) {
                    if ((i2 == libAffx_choPlayer || i2 == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                        continue;
                    } else {
                        if (UnitHasBehavior2(libGame_gv_players[i2].lv_heroUnit, "NotManaUserDummy") && libAffx_affixes[affix].behaviors[i].onlyManaUsers) {
                        } else if (!UnitHasBehavior2(libGame_gv_players[i2].lv_heroUnit, "NotManaUserDummy") && libAffx_affixes[affix].behaviors[i].disallowManaUsers) {
                        } else {
                            libAffx_AddPlayerBehavior(i2, behavior, amountToAdd, true);
                        }
                    }
                }
            } else if ((behaviorPlayer == libAffx_choPlayer || behaviorPlayer == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                continue;
            } else if (behaviorPlayer >= 1 && behaviorPlayer <= 10) {
                if (UnitHasBehavior2(libGame_gv_players[behaviorPlayer].lv_heroUnit, "NotManaUserDummy") && libAffx_affixes[affix].behaviors[i].onlyManaUsers) {
                } else if (!UnitHasBehavior2(libGame_gv_players[behaviorPlayer].lv_heroUnit, "NotManaUserDummy") && libAffx_affixes[affix].behaviors[i].disallowManaUsers) {
                } else {
                    libAffx_AddPlayerBehavior(behaviorPlayer, behavior, amountToAdd, true);
                }
            }
        }
    }
}
void libAffx_ApplyAffixBehaviors(int affix, int amount) {
    int i;
    int i2;
    string behavior;
    int behaviorPlayer;
    for (i = 1; i <= libAffx_maxBehaviors; i += 1) {
        behavior = libAffx_affixes[affix].affixBehaviors[i].behavior;
        if (behavior != "" && behavior != null) {
            behaviorPlayer = libAffx_affixes[affix].affixBehaviors[i].player;
            if (behaviorPlayer == 0) {
                for (i2 = 1; i2 <= 10; i2 += 1) {
                    if ((i2 == libAffx_choPlayer || i2 == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                        continue;
                    } else {
                        libAffx_AddAffixBehavior(i2, behavior);
                    }
                }
            } else if ((behaviorPlayer == libAffx_choPlayer || behaviorPlayer == libAffx_gallPlayer) && libAffx_affixes[affix].excludeChoGall) {
                continue;
            } else if (behaviorPlayer >= 1 && behaviorPlayer <= 10) {
                libAffx_AddAffixBehavior(behaviorPlayer, behavior);
            }
        }
    }
}
void libAffx_ApplyImmediateTriggers() {
    int i;
    int i2;
    int i3;
    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        for (i2 = 1; i2 <= libAffx_maxTriggers; i2 += 1) {
            if (libAffx_affixes[i].triggers[i2].type == libAffx_triggerGameStart) {
                if (libAffx_affixes[i].createdTriggers[i2] == null) {
                    libAffx_affixes[i].createdTriggers[i2] = TriggerCreate(libAffx_affixes[i].triggers[i2].name);
                }
                TriggerExecute(libAffx_affixes[i].createdTriggers[i2], true, false);
            } else if (libAffx_affixes[i].triggers[i2].type == libAffx_triggerScaling) {
                if (libAffx_affixes[i].createdTriggers[i2] == null) {
                    libAffx_affixes[i].createdTriggers[i2] = TriggerCreate(libAffx_affixes[i].triggers[i2].name);
                }
                libGame_gf_HeroLevelUp(libAffx_affixes[i].createdTriggers[i2]);
                for (i3 = 1; i3 <= 10; i3 += 1) {
                    DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Player), i3);
                    DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Level), UnitLevel(libGame_gv_players[i3].lv_heroUnit));
                    TriggerExecute(libAffx_affixes[i].createdTriggers[i2], true, false);
                }
            } 
        }
    }
}
void libAffx_ApplyTriggers(int affix, int amount) {
    int i;
    int i2;
    int triggerType;
    string triggerName;
    string triggerArg1;

    for (i = 1; i <= libAffx_maxTriggers; i += 1) {
        triggerType = libAffx_affixes[affix].triggers[i].type;
        triggerName = libAffx_affixes[affix].triggers[i].name;
        triggerArg1 = libAffx_affixes[affix].triggers[i].arg1;
        if (triggerType != 0) {
            if (!libAffx_affixes[affix].triggers[i].init) {
                libAffx_affixes[affix].triggers[i].init = true;
                if (libAffx_affixes[affix].createdTriggers[i] == null) {
                    libAffx_affixes[affix].createdTriggers[i] = TriggerCreate(triggerName);
                }
                if (triggerType == libAffx_triggerAnyAffixAdded) {
                    TriggerAddEventGeneric(libAffx_affixes[affix].createdTriggers[i], libAffx_eventAffixAddedID);
                } else if (triggerType == libAffx_triggerAffixAdded) {
                    TriggerAddEventGeneric(libAffx_affixes[affix].createdTriggers[i], libAffx_eventAffixAddedID + libAffx_affixes[affix].name);
                } else if (triggerType == libAffx_triggerNPCTakedown) {
                    libGame_gf_HeroParticipatedInNPCTakedown(libAffx_affixes[affix].createdTriggers[i]);
                } else if (triggerType == libAffx_triggerHeroTakedown) {
                    libGame_gf_HeroParticipatedInTakedown(libAffx_affixes[affix].createdTriggers[i]);
                } else if (triggerType == libAffx_triggerUnitCreated) {
                    TriggerAddEventUnitCreated(libAffx_affixes[affix].createdTriggers[i], null, null, null);
                } else if (triggerType == libAffx_triggerHeroRespawn) {
                    libGame_gf_HeroRespawn(libAffx_affixes[affix].createdTriggers[i]);
                } else if (triggerType == libAffx_triggerUnitBehaviorChange) {
                    if (triggerArg1 != "" && triggerArg1 != null) {
                        TriggerAddEventUnitBehaviorChange(libAffx_affixes[affix].createdTriggers[i], null, triggerArg1, c_unitBehaviorChangeActivate);
                    } else {
                        TriggerAddEventUnitBehaviorChange(libAffx_affixes[affix].createdTriggers[i], null, libAffx_affixes[affix].behaviors[i].behavior, c_unitBehaviorChangeActivate);
                    }
                } else if (triggerType == libAffx_triggerUnitBehaviorCreate) {
                    if (triggerArg1 != "" && triggerArg1 != null) {
                        TriggerAddEventUnitBehaviorChange(libAffx_affixes[affix].createdTriggers[i], null, triggerArg1, c_unitBehaviorChangeCreate);
                    } else {
                        TriggerAddEventUnitBehaviorChange(libAffx_affixes[affix].createdTriggers[i], null, libAffx_affixes[affix].behaviors[i].behavior, c_unitBehaviorChangeCreate);
                    }
                } else if (triggerType == libAffx_triggerUnitBehaviorChangeCategory) {
                    if (StringCase(triggerArg1, false) == "blind") {
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryDebuffBlind, c_unitBehaviorChangeCreate);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryDebuffBlind, c_unitBehaviorChangeRefresh);
                    } else if (StringCase(triggerArg1, false) == "cc") {
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategorySlow, c_unitBehaviorChangeCreate);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategorySlow, c_unitBehaviorChangeRefresh);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeCreate);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeRefresh);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryStun, c_unitBehaviorChangeCreate);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryStun, c_unitBehaviorChangeRefresh);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryDebuffSilence, c_unitBehaviorChangeCreate);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, c_behaviorCategoryDebuffSilence, c_unitBehaviorChangeRefresh);
                    } else if (triggerArg1 != "" && triggerArg1 != null) {
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, StringToInt(triggerArg1), c_unitBehaviorChangeCreate);
                        TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_affixes[affix].createdTriggers[i], null, StringToInt(triggerArg1), c_unitBehaviorChangeRefresh);
                    }
                } else if (triggerType == libAffx_triggerPlayerEffectUsed) {
                    if (triggerArg1 != "" && triggerArg1 != null) {
                        TriggerAddEventPlayerEffectUsed(libAffx_affixes[affix].createdTriggers[i], c_playerAny, triggerArg1);
                    }
                } else if (triggerType == libAffx_triggerHeroLevelUp) {
                    libGame_gf_HeroLevelUp(libAffx_affixes[affix].createdTriggers[i]);
                } else if (triggerType == libAffx_triggerUnitDied) {
                    TriggerAddEventUnitDied(libAffx_affixes[affix].createdTriggers[i], null);
                } else if (triggerType == libAffx_triggerHeroKilled) {
                    libGame_gf_HeroKilled(libAffx_affixes[affix].createdTriggers[i]);
                } else if (triggerType == libAffx_triggerHeroGainTalent) {
                    libGame_gf_HeroGainTalent(libAffx_affixes[affix].createdTriggers[i]);
                } else if (triggerType == libAffx_triggerUnitDamaged) {
                    TriggerAddEventUnitDamaged(libAffx_affixes[affix].createdTriggers[i], null, c_unitDamageTypeAny, c_unitDamageEither, null);
                } else if (triggerType == libAffx_triggerQuest) {
                    if (libAffx_affixes[affix].quest.isQuest && !libAffx_affixes[affix].quest.questDone) {
                        TriggerExecute(libAffx_affixes[affix].createdTriggers[i], true, false);
                    }
                } else if (triggerType == libAffx_triggerUnitChangeOwner) {
                    TriggerAddEventUnitChangeOwner(libAffx_affixes[affix].createdTriggers[i], null);
                } else if (triggerType == libAffx_triggerPeriodic) {
                    if (triggerArg1 != "" && triggerArg1 != null) {
                        TriggerAddEventTimePeriodic(libAffx_affixes[affix].createdTriggers[i], StringToFixed(triggerArg1), c_timeGame);
                    } else {
                        TriggerAddEventTimePeriodic(libAffx_affixes[affix].createdTriggers[i], 0.0625, c_timeGame);
                    }
                } else if (triggerType == libAffx_triggerWin) {
                    TriggerAddEventGeneric(libAffx_affixes[affix].createdTriggers[i], "GameWonEvent");
                }
            }
            if (libAffx_affixes[affix].createdTriggers[i] != null && triggerType == libAffx_triggerAffixAdded) {
                libAffx_SendAffixAddedEvent(affix, amount);
            } else if (libAffx_affixes[affix].createdTriggers[i] != null && triggerType == libAffx_triggerExecute) {
                TriggerExecute(libAffx_affixes[affix].createdTriggers[i], true, false);
            } else if (libAffx_affixes[affix].createdTriggers[i] != null && triggerType == libAffx_triggerOneTime && libAffx_affixes[affix].shouldExecute) {
                TriggerExecute(libAffx_affixes[affix].createdTriggers[i], true, false);
            } else if (libAffx_affixes[affix].createdTriggers[i] != null && triggerType == libAffx_triggerOncePerGame && !libAffx_affixes[affix].triggers[i].hasExecuted) {
                libAffx_affixes[affix].triggers[i].hasExecuted = true;
                TriggerExecute(libAffx_affixes[affix].createdTriggers[i], true, false);
            } else if (libAffx_affixes[affix].createdTriggers[i] != null && triggerType == libAffx_triggerHeroLevelUp && !libAffx_affixes[affix].triggers[i].hasExecuted) {
                libAffx_affixes[affix].triggers[i].hasExecuted = true;
                for (i2 = 1; i2 <= 10; i2 += 1) {
                    DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Player), i2);
                    DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Level), UnitLevel(libGame_gv_players[i2].lv_heroUnit));
                    TriggerExecute(libAffx_affixes[affix].createdTriggers[i], true, false);
                }
            }
        }
    }
}
void libAffx_ApplyQuest(int affix) {
    int i;
    for (i = 1; i <= libAffx_maxQuests; i += 1) {
        if (libAffx_affixes[affix].questRetain[i].tokenBehavior != "" && libAffx_affixes[affix].questRetain[i].tokenBehavior != null && libAffx_affixes[affix].questRetain[i].tokenCount > 0) {
            libAffx_ModifyPlayerTokenCount(libAffx_player, RoundI(libAffx_affixes[affix].questRetain[i].tokenCount), libAffx_affixes[affix].questRetain[i].tokenBehavior);
        }
    }
}
void libAffx_ApplyAffix(int affix, int amount) {
    if (libAffx_affixes[affix].count <= 0 || amount <= 0) {
        return;
    }

    libAffx_ApplyTalents(affix);
    libAffx_ApplyCatalogModifications(affix, amount);
    libAffx_ApplyBehaviors(affix, amount);
    libAffx_RemoveBehaviors(affix);
    libAffx_ApplyAffixBehaviors(affix, amount);
    libAffx_ApplyTriggers(affix, amount);
    libAffx_ApplyQuest(affix);

    // AA speed fix for Tassadar
    if (libGame_gv_players[libAffx_player].lv_heroIndex == libCore_gf_GetIndexFromHero("Tassadar") && !UnitHasBehavior2(libGame_gv_players[libAffx_player].lv_heroUnit, "TassadarAAFix")) {
        UnitBehaviorAdd(libGame_gv_players[libAffx_player].lv_heroUnit, "TassadarAAFix", libGame_gv_players[libAffx_player].lv_heroUnit, 1);
    }

    libAffx_affixes[affix].shouldExecute = false;
}
void libAffx_AddAffix(int affix, int count) {
    if (affix == 0) {
        return;
    }
    libAffx_affixes[affix].count += count;
    libAffx_affixes[affix].shouldExecute = true;
    libAffx_skipCurseCounter += libAffx_affixes[affix].skipCurses;
    libAffx_ApplyAffix(affix, count);
}
void libAffx_SetAffix(int affix, int count) {
    if (affix == 0) {
        return;
    }
    libAffx_affixes[affix].count = count;
    libAffx_affixes[affix].shouldExecute = true;
    libAffx_skipCurseCounter += libAffx_affixes[affix].skipCurses;
    libAffx_ApplyAffix(affix, count);
}

// ============================================================
// Bank
// ============================================================

int libAffx_BankGetStats(string key) {
    BankLoad("PlayerSettings", libAffx_player);
    if (BankKeyExists(BankLastCreated(), libAffx_BankSectionStats, key)) {
        return BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, key);
    } else {
        return 0;
    }
}

string libAffx_BankLoadValueString(string key) {
    BankLoad("PlayerSettings", libAffx_player);
    return BankValueGetAsString(BankLastCreated(), libAffx_BankSection, key);
}
int libAffx_BankLoadValueInt(string key) {
    BankLoad("PlayerSettings", libAffx_player);
    return BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, key);
}
fixed libAffx_BankLoadValueFixed(string key) {
    BankLoad("PlayerSettings", libAffx_player);
    return BankValueGetAsFixed(BankLastCreated(), libAffx_BankSection, key);
}
void libAffx_BankSaveValueString(string key, string value) {
    BankLoad("PlayerSettings", libAffx_player);
    BankValueSetFromString(BankLastCreated(), libAffx_BankSection, key, value);
    BankSave(BankLastCreated());
}
void libAffx_BankSaveValueInt(string key, int value) {
    BankLoad("PlayerSettings", libAffx_player);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, key, value);
    BankSave(BankLastCreated());
}
void libAffx_BankSaveValueFixed(string key, fixed value) {
    BankLoad("PlayerSettings", libAffx_player);
    BankValueSetFromFixed(BankLastCreated(), libAffx_BankSection, key, value);
    BankSave(BankLastCreated());
}
void libAffx_SavePBUSettingsBank() {
    BankLoad("PlayerSettings", libAffx_player);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionSettings, "Difficulty", libPBU2_difficulty);
    BankSave(BankLastCreated());
}
void libAffx_SaveSettingsBank() {
    BankLoad("PlayerSettings", libAffx_player);
    if (libAffx_difficulty != 0) {
        BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionSettings, "Difficulty", libAffx_difficulty);
    }
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionSettings, "SpeedUp", BoolToInt(libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpGates, libAffx_player)));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionSettings, "SpeedUpDeath", BoolToInt(libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsSpeedUpDeath, libAffx_player)));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionSettings, "DisplayPicksBans", BoolToInt(libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsDisplayPicksBans, libAffx_player)));
    BankSave(BankLastCreated());
}
void libAffx_LoadSettingsBank() {
    BankLoad("PlayerSettings", libAffx_player);

    if (BankKeyExists(BankLastCreated(), libAffx_BankSectionSettings, "Difficulty")) {
        libAffx_difficulty = BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionSettings, "Difficulty");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSectionSettings, "SpeedUp")) {
        if (BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionSettings, "SpeedUp") == 1) {
            libAffx_SetDialogControlChecked(libAffx_dialogControlOptionsSpeedUpGates, true);
        } else {
            libAffx_SetDialogControlChecked(libAffx_dialogControlOptionsSpeedUpGates, false);
        }
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSectionSettings, "SpeedUpDeath")) {
        if (BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionSettings, "SpeedUpDeath") == 1) {
            libAffx_SetDialogControlChecked(libAffx_dialogControlOptionsSpeedUpDeath, true);
        } else {
            libAffx_SetDialogControlChecked(libAffx_dialogControlOptionsSpeedUpDeath, false);
        }
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSectionSettings, "DisplayPicksBans")) {
        if (BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionSettings, "DisplayPicksBans") == 1) {
            libAffx_SetDialogControlChecked(libAffx_dialogControlOptionsDisplayPicksBans, true);
        } else {
            libAffx_SetDialogControlChecked(libAffx_dialogControlOptionsDisplayPicksBans, false);
        }
    }
    libPBU2_SetDifficulty(libAffx_difficulty);
    libAffx_DisplayDebugMessage("Loaded player settings!");
}
void libAffx_SaveBankAchievements() {
    int i;
    BankLoad("PlayerSettings", libAffx_player);
    for (i = 1; i <= libAffx_maxAchievements; i += 1) {
        if (libAffx_achievements[i].earned) {
            BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarned_" + libAffx_achievements[i].name, libAffx_achievements[i].difficulty);
            BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarnedRound_" + libAffx_achievements[i].name, libAffx_achievements[i].round);
        }
    }
    BankSave(BankLastCreated());
}
void libAffx_SaveBank() {
    string affixName;
    int i;
    int i2;
    unitgroup heroGroup = libGame_gv_players[libAffx_player].lv_heroUnitGroup;
    unit heroUnit;
    int groupCount;
    BankLoad("PlayerSettings", libAffx_player);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "Takedowns", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "Takedowns") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_takedowns));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "Kills", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "Kills") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_kills));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "Assists", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "Assists") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_assists));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "SpellDamage", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "SpellDamage") + libGame_gv_scoreValues[libAffx_player].lv_spellDamage);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "RegenGlobes", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "RegenGlobes") + libGame_gv_scoreValues[libAffx_player].lv_regenGlobes);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "PhysicalDamage", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "PhysicalDamage") + libGame_gv_scoreValues[libAffx_player].lv_physicalDamage);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "MinionKills", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "MinionKills") + libGame_gv_scoreValues[libAffx_player].lv_minionKills);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "Experience", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "Experience") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_individualXPEarned));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "Healing", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "Healing") + libGame_gv_scoreValues[libAffx_player].lv_healing);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "Deaths", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "Deaths") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_deaths));
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "DamageTaken", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "DamageTaken") + libGame_gv_scoreValues[libAffx_player].lv_damageTaken);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "MercCaptures", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "MercCaptures") + libGame_gv_scoreValues[libAffx_player].lv_creepCampsCaptured);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "ObjectivesWon", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "ObjectivesWon") + libAffx_objectivesWonThisGame);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "ObjectivesLost", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "ObjectivesLost") + libAffx_objectivesLostThisGame);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "RerollsUsed", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "RerollsUsed") + libAffx_rerollsUsed);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "RerollsCurseUsed", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "RerollsCurseUsed") + libAffx_rerollsCurseUsed);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "BansUsed", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "BansUsed") + libAffx_bansUsed);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "CursesSkipped", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "CursesSkipped") + libAffx_cursesSkipped);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "CursesSwapped", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "CursesSwapped") + libAffx_cursesSwapped);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "GameTime", BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "GameTime") + FixedToInt(TimerGetElapsed(libGame_gv_gameTimer)));
    for (i = 1; i <= 90; i += 1) {
        BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "HeroCounterOrder_" + libCore_gf_GetHeroFromIndex(i), BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "HeroCounterOrder_" + libCore_gf_GetHeroFromIndex(i)) + libAffx_heroCounter[libAffx_teamOrderIndex][i]);
    }
    for (i = 1; i <= 90; i += 1) {
        BankValueSetFromInt(BankLastCreated(), libAffx_BankSectionStats, "HeroCounterChaos_" + libCore_gf_GetHeroFromIndex(i), BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionStats, "HeroCounterChaos_" + libCore_gf_GetHeroFromIndex(i)) + libAffx_heroCounter[libAffx_teamChaosIndex][i]);
    }
    BankValueSetFromString(BankLastCreated(), libAffx_BankSection, "Map", libAffx_nextMap);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "CurrentRun", libAffx_currentRun);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "Hero", libAffx_playersHeroIndex[libAffx_player]);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "ObjectiveCounter", libAffx_objectivesWonCounter);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "SkipCurseCounter", libAffx_skipCurseCounter);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "Rerolls", libAffx_rerolls);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "RerollsCurse", libAffx_rerollsCurse);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "Bans", libAffx_bans);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "CursesNextGame", libAffx_cursesNextGame);
    BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, "BoonsNextGame", libAffx_boonsNextGame);
    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        affixName = libAffx_affixes[i].name;
        if (libAffx_affixes[i].quest.isQuest) {
            if (libAffx_affixes[i].quest.questDone) {
                BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, affixName + "_QuestDone", 1);
            }
            if (libAffx_affixes[i].quest.questProgressPersists && libAffx_affixes[i].quest.questProgress > 0) {
                BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, affixName + "_QuestProgress", libAffx_affixes[i].quest.questProgress);
            }
        }
        for (i2 = 1; i2 <= libAffx_maxQuests; i2 += 1) {
            if (libAffx_affixes[i].questRetain[i2].tokenBehavior != "" && libAffx_affixes[i].questRetain[i2].tokenBehavior != null) {
                groupCount = UnitGroupCount(heroGroup, c_unitCountAll);
                for (;; groupCount -= 1) {
                    heroUnit = UnitGroupUnitFromEnd(heroGroup, groupCount);
                    if (groupCount <= 0) { break; }
                    if (heroUnit == null) { continue; }
                    if (UnitGetTokenCount(heroUnit, libAffx_affixes[i].questRetain[i2].tokenBehavior) > 0) {
                        BankValueSetFromFixed(BankLastCreated(), libAffx_BankSection, libAffx_affixes[i].questRetain[i2].tokenBehavior, UnitGetTokenCount(heroUnit, libAffx_affixes[i].questRetain[i2].tokenBehavior) * libAffx_affixes[i].questRetain[i2].retainModifier);
                    }
                }
            }
        }
        if (libAffx_affixes[i].count > 0) {
            BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, affixName + "_Count", libAffx_affixes[i].count);
        }
        if (libAffx_affixes[i].banned) {
            BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, affixName + "_Banned", 1);
        } else if (!libAffx_affixes[i].banned && BankKeyExists(BankLastCreated(), libAffx_BankSection, affixName + "_Banned")) {
            BankValueSetFromInt(BankLastCreated(), libAffx_BankSection, affixName + "_Banned", 0);
        }
    }
    BankSave(BankLastCreated());
}
void libAffx_LoadBank() {
    string affixName;
    int i;
    int i2;
    BankLoad("PlayerSettings", libAffx_player);

    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "Map")) {
        libAffx_currentMap = libAffx_GetMapID(BankValueGetAsString(BankLastCreated(), libAffx_BankSection, "Map"));
    } else {
        libAffx_currentMap = libAffx_startingMap;
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "CurrentRun")) {
        libAffx_currentRun = BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "CurrentRun");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "Hero")) {
        libAffx_playerHeroIndexLoaded = BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "Hero");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "ObjectiveCounter")) {
        libAffx_objectivesWonCounter = BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "ObjectiveCounter");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "SkipCurseCounter")) {
        libAffx_skipCurseCounter = BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "SkipCurseCounter");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "Rerolls")) {
        libAffx_rerolls += BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "Rerolls");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "RerollsCurse")) {
        libAffx_rerollsCurse += BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "RerollsCurse");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "Bans")) {
        libAffx_bans += BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "Bans");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "CursesNextGame")) {
        libAffx_cursesQueued += BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "CursesNextGame");
    }
    if (BankKeyExists(BankLastCreated(), libAffx_BankSection, "BoonsNextGame")) {
        libAffx_boonsQueued += BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, "BoonsNextGame");
    }
    for (i = 1; i <= libAffx_maxAchievements; i += 1) {
        if (BankKeyExists(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarned_" + libAffx_achievements[i].name)) {
            libAffx_achievements[i].earned = libAffx_IntToBoolean(BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarned_" + libAffx_achievements[i].name));
            libAffx_achievements[i].difficulty = BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarned_" + libAffx_achievements[i].name);
        }
        if (BankKeyExists(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarnedRound_" + libAffx_achievements[i].name)) {
            libAffx_achievements[i].round = BankValueGetAsInt(BankLastCreated(), libAffx_BankSectionAchievements, "AchievementEarnedRound_" + libAffx_achievements[i].name);
        }
    }

    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        affixName = libAffx_affixes[i].name;
        if (BankKeyExists(BankLastCreated(), libAffx_BankSection, affixName + "_Count")) {
            libAffx_affixes[i].count = BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, affixName + "_Count");
        } else {
            libAffx_affixes[i].count = 0;
        }
        if (libAffx_affixes[i].quest.isQuest) {
            if (BankKeyExists(BankLastCreated(), libAffx_BankSection, affixName + "_QuestDone")) {
                if (BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, affixName + "_QuestDone") == 1) {
                    libAffx_affixes[i].quest.questDone = true;
                } else {
                    libAffx_affixes[i].quest.questDone = false;
                }
            }
            if (libAffx_affixes[i].quest.questProgressPersists) {
                libAffx_affixes[i].quest.questProgress = BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, affixName + "_QuestProgress");
            }
        }
        for (i2 = 1; i2 <= libAffx_maxQuests; i2 += 1) {
            if (BankKeyExists(BankLastCreated(), libAffx_BankSection, libAffx_affixes[i].questRetain[i2].tokenBehavior)) {
                libAffx_affixes[i].questRetain[i2].tokenCount = BankValueGetAsFixed(BankLastCreated(), libAffx_BankSection, libAffx_affixes[i].questRetain[i2].tokenBehavior);
            }
        }
        if (BankKeyExists(BankLastCreated(), libAffx_BankSection, affixName + "_Banned")) {
            if (BankValueGetAsInt(BankLastCreated(), libAffx_BankSection, affixName + "_Banned") == 1) {
                libAffx_affixes[i].banned = true;
            } else {
                libAffx_affixes[i].banned = false;
            }
        }
    }
    while (!libAffx_playersFirstSpawnIn[libAffx_player]) {
        libAffx_Wait(0.0625, c_timeGame);
    }
    libAffx_Wait(libAffx_gameStartDelay, c_timeGame);
    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        if (libAffx_affixes[i].count > 0) {
            libAffx_ApplyAffix(i, libAffx_affixes[i].count);
        }
    }
    libAffx_bankLoaded = true;
    libAffx_DisplayDebugMessage("Boons & Curses loaded!");
}
void libAffx_ResetBank() {
    BankLoad("PlayerSettings", libAffx_player);
    BankSectionRemove(BankLastCreated(), libAffx_BankSection);
    BankSave(BankLastCreated());
}
void libAffx_ResetBankStats() {
    BankLoad("PlayerSettings", libAffx_player);
    libAffx_DisplayDebugMessage("Resetting stats...");
    BankSectionRemove(BankLastCreated(), libAffx_BankSectionStats);
    BankSave(BankLastCreated());
}
void libAffx_ResetBankAchievements() {
    BankLoad("PlayerSettings", libAffx_player);
    BankSectionRemove(BankLastCreated(), libAffx_BankSectionAchievements);
    BankSave(BankLastCreated());
}


bool libAffx_GameOverCallbackTrigger_Func (bool testConds, bool runActions) {
    int winningTeam;
    int map;
    // Actions
    if (!runActions) {
        return true;
    }
    winningTeam = libGame_winningTeam;
    map = libAffx_GetMapID(libCore_gv_mAPMapStringID);

    libAffx_EvaluateAllAchievements();
    if (winningTeam == libAffx_teamOrderIndex) {
        if (map == libAffx_map1) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialmapmechanics.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map2);
        } else if (map == libAffx_map2) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorial01.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map3);
        } else if (map == libAffx_map3) {
            GameSetNextMap("heroes/singleplayermaps/(10)trymemode.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map4);
        } else if (map == libAffx_map4) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialveteran.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map1);
        }
        if (libAffx_currentRun == libAffx_winningRound) {
            libAffx_SetDialogControlText(libAffx_dialogGameover.label, StringExternal("Label/Name/Victory"));
            libAffx_SetDialogControlEnabled(libAffx_dialogGameover.continueButton, true);
            libAffx_SetDialogControlVisible(libAffx_dialogGameover.continueButton, true);
            libAffx_ShowGameoverDialog(true);
        }
        libAffx_SaveBank();
    } else {
        libAffx_ResetBank();
        libAffx_SetDialogControlText(libAffx_dialogGameover.label, StringExternal("Label/Name/GameOver"));
        libAffx_SetDialogControlEnabled(libAffx_dialogGameover.continueButton, false);
        libAffx_SetDialogControlVisible(libAffx_dialogGameover.continueButton, false);
        libAffx_ShowGameoverDialog(true);
        Wait(1, c_timeGame);
        libAffx_ResetBankStats();
    }

    return true;
}
void libAffx_GameOverCallbackTrigger_Init () {
    libAffx_GameOverCallbackTrigger = TriggerCreate("libAffx_GameOverCallbackTrigger_Func");
    libGame_gv_gameOverCallback = libAffx_GameOverCallbackTrigger;
}


// ============================================================
// Logic when player spawns
// ============================================================

bool libAffx_AffixLogicPlayerSpawned_Func (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int player = UnitGetOwner(createdUnit);
    if (!runActions) {
        return true;
    }
    if (player == libAffx_player && !libAffx_playersFirstSpawnIn[libAffx_player]) {
        libAffx_playersFirstSpawnIn[libAffx_player] = true;
        if (libCore_gv_mAPMapStringID == libAffx_GetMapString(libAffx_mapTowersofDoom)) {
            libAffx_AddExcludedUnitTypeFilter(libAffx_filterDifficulty, "KingsCore");
            libAffx_AddExcludedUnitTypeFilter(libAffx_filterAlliedStructures, "KingsCore");
            libAffx_AddExcludedUnitTypeFilter(libAffx_filterEnemyStructures, "KingsCore");
        }
        DialogSetVisible(libAffx_dialogControls, PlayerGroupAll(), true);
        libGame_gv_players[libAffx_player].lv_heroIndex = libAffx_playersHeroIndex[libAffx_player];
        if (libAffx_currentRun <= 1) {
            libAffx_difficulty = libPBU2_difficulty;
            libAffx_SaveSettingsBank();
        }

        if (libGame_gv_players[libAffx_player].lv_heroIndex == libCore_gf_GetIndexFromHero("Gall")) {
            libAffx_gallPlayer = 1;
            libAffx_choPlayer = 2;
        } else if (libGame_gv_players[libAffx_player].lv_heroIndex == libCore_gf_GetIndexFromHero("Cho")) {
            libAffx_choPlayer = 1;
            libAffx_gallPlayer = 2;
        }
        libAffx_ApplyImmediateTriggers();
    }
    if (player >= 2 && player <= 10 && !libAffx_playersFirstSpawnIn[player]) {
        libAffx_playersFirstSpawnIn[player] = true;
        libGame_gv_players[player].lv_heroIndex = libAffx_playersHeroIndex[player];
    }

    return true;
}
void libAffx_AffixLogicUnitCreatedTrigger_Init () {
    libAffx_AffixLogicPlayerSpawned = TriggerCreate("libAffx_AffixLogicPlayerSpawned_Func");
    TriggerAddEventUnitCreated(libAffx_AffixLogicPlayerSpawned, null, null, null);
}

int libAffx_RollRarity(int baseRarity, bool curse) {
    int result = baseRarity;
    fixed roll = RandomFixed(0, 1.0);
    fixed modifier = 1.0;
    fixed modifierHigh = 0;
    if (curse) {
        return baseRarity;
    } else if (baseRarity == libAffx_rarityCommon) {
        if (roll <= libAffx_commonToLegendary * (modifier + modifierHigh)) {
            result = libAffx_rarityLegendary;
        } else if (roll <= (libAffx_commonToLegendary + libAffx_commonToEpic) * (modifier + modifierHigh)) {
            result = libAffx_rarityEpic;
        } else if (roll <= (libAffx_commonToLegendary + libAffx_commonToEpic + libAffx_commonToRare) * modifier) {
            result = libAffx_rarityRare;
        } else if (roll <= (libAffx_commonToLegendary + libAffx_commonToEpic + libAffx_commonToRare + libAffx_commonToUncommon) * modifier) {
            result = libAffx_rarityUncommon;
        }
    } else if (baseRarity == libAffx_rarityUncommon) {
        if (roll <= libAffx_uncommonToLegendary * (modifier + modifierHigh)) {
            result = libAffx_rarityLegendary;
        } else if (roll <= (libAffx_uncommonToLegendary + libAffx_uncommonToEpic) * (modifier + modifierHigh)) {
            result = libAffx_rarityEpic;
        } else if (roll <= (libAffx_uncommonToLegendary + libAffx_uncommonToEpic + libAffx_uncommonToRare) * modifier) {
            result = libAffx_rarityRare;
        }
    } else if (baseRarity == libAffx_rarityRare) {
        if (roll <= libAffx_rareToLegendary * (modifier + modifierHigh)) {
            result = libAffx_rarityLegendary;
        } else if (roll <= (libAffx_rareToLegendary + libAffx_rareToEpic) * (modifier + modifierHigh)) {
            result = libAffx_rarityEpic;
        }
    } else if (baseRarity == libAffx_rarityEpic) {
        if (roll <= libAffx_epicToLegendary * (modifier + modifierHigh)) {
            result = libAffx_rarityLegendary;
        }
    }
    return result;
}

bool libAffx_AffixFailsRequirements(int affix) {
    int i;
    int affixToCheck;
    int count;
    int max;
    string requiredTalent;

    for (i = 1; i <= libAffx_currentAffixSelection; i += 1) {
        if (libAffx_rolledAffixes[i] == affix) {
            return true;
        }
    }
    for (i = 1; i <= libAffx_affixes[affix].excludedCount; i += 1) {
        affixToCheck = libAffx_affixes[affix].excludedAffixes[i];
        if (libAffx_affixes[affixToCheck].count > 0) {
            return true;
        }
    }
    for (i = 1; i <= libAffx_affixes[affix].requiredCount; i+= 1) {
        affixToCheck = libAffx_affixes[affix].requiredAffixes[i];
        count = libAffx_affixes[affixToCheck].count;
        max = libAffx_affixes[affixToCheck].max;
        if (libAffx_affixes[affixToCheck].requiresMaxStacks && max != 0) {
            if (count < max) {
                return true;
            }
        } else if (count < 1) {
            return true;
        }
    }
    for (i = 1; i <= libAffx_affixes[affix].requiredTalentsCount; i += 1) {
        requiredTalent = libAffx_affixes[affix].requiredTalents[i];
        if (!PlayerHasTalent(libAffx_player, requiredTalent)) {
            return true;
        }
    }
    return false;
}

int libAffx_RollAffix(int rarity, bool curse, int level, bool lockRarity) {
    int[libAffx_maxEligibleAffixes + 1] eligibleAffixes;
    int[libAffx_maxEligibleAffixes + 1] eligibleWeights;
    int totalWeight;
    int cumulativeWeight;
    int randomWeight;
    int slotRarity;
    int slotAffixCount;
    int i;
    int random;
    bool rarityHasUpgraded;
    int repeat = 3;
    int currentMap = libAffx_GetMapID(libCore_gv_mAPMapStringID);

    slotRarity = rarity;

    while (true) {
        slotAffixCount = 0;
        totalWeight = 0;
        cumulativeWeight = 0;
        
        // Search for eligible affixes
        for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
            // Is blank, is disabled, cannot roll, or is banned
            if (libAffx_affixes[i].name == "" || !libAffx_affixes[i].enabled || libAffx_affixes[i].cannotRoll || libAffx_affixes[i].banned) {
                continue;
            }

            // Check if it has already been seen previously
            if (libAffx_affixes[i].lastSeen > 0) {
                libAffx_affixes[i].lastSeen -= 1;
                continue;
            }

            // Check maximum count
            if ((libAffx_affixes[i].count >= libAffx_affixes[i].max) && libAffx_affixes[i].max != 0) {
                continue;
            }

            // Check boon/curse and rarity requirement
            if ((curse && !libAffx_affixes[i].curse) || (!curse && libAffx_affixes[i].curse) || (libAffx_affixes[i].rarity != slotRarity && !curse)) {
                continue;
            }

            // Check difficulty and round requirements
            if ((libAffx_affixes[i].minDifficulty != 0 && libAffx_affixes[i].minDifficulty > libAffx_difficulty) || (libAffx_affixes[i].minRound != 0 && libAffx_affixes[i].minRound > libAffx_currentRun)) {
                continue;
            }
            
            // Check for map and hero requirements
            if (!libAffx_affixes[i].allowedMap[currentMap] || !libAffx_affixes[i].allowedHero[libAffx_playersHeroIndex[libAffx_player]]) {
                continue;
            }

            // Check min and max level requirement
            if ((libAffx_affixes[i].minLevel > 0 && level < libAffx_affixes[i].minLevel) || (libAffx_affixes[i].maxLevel > 0 && level > libAffx_affixes[i].maxLevel)) {
                continue;
            }

            // Check for affix exclusions, requirements, talent requirements, and whether it has already rolled
            if (libAffx_AffixFailsRequirements(i)) {
                continue;
            }

            slotAffixCount += 1;
            eligibleAffixes[slotAffixCount] = i;
            if (curse) {
                if (libAffx_affixes[i].rarity == libAffx_rarityChallenge) {
                    eligibleWeights[slotAffixCount] = FixedToInt(libAffx_affixes[i].weight / (1 + (libAffx_rarityLegendary - 1) * (libAffx_rarityLegendary - 1) * 0.25));
                } else {
                    eligibleWeights[slotAffixCount] = FixedToInt(libAffx_affixes[i].weight / (1 + (libAffx_affixes[i].rarity - 1) * (libAffx_affixes[i].rarity - 1) * 0.25));
                }
            } else {
                eligibleWeights[slotAffixCount] = libAffx_affixes[i].weight;
            }
            totalWeight += eligibleWeights[slotAffixCount];
        }

        // Shuffle
        if (slotAffixCount > 0) {
            randomWeight = RandomInt(1, MaxI(totalWeight, 1));
            for (i = 1; i <= slotAffixCount; i += 1) {
                cumulativeWeight += eligibleWeights[i];
                if (randomWeight <= cumulativeWeight) {
                    libAffx_affixes[eligibleAffixes[i]].lastSeen = 3;
                    return eligibleAffixes[i];
                }
            }
            random = RandomInt(1, slotAffixCount);
            libAffx_affixes[eligibleAffixes[random]].lastSeen = 3;
            return eligibleAffixes[random];
        }

        // Upgrade rarity if no affixes are found, and then downgrade if no upgraded rarity affixes are found
        if (curse) {
            return 0;
        } else if (!lockRarity) {
            if (slotRarity < libAffx_rarityLegendary && !rarityHasUpgraded) {
                slotRarity += 1;
                rarityHasUpgraded = true;
            } else if (!rarityHasUpgraded) {
                rarityHasUpgraded = true;
                slotRarity = MaxI(rarity - 1, libAffx_rarityCommon);
            } else if (slotRarity > libAffx_rarityCommon) {
                slotRarity -= 1;
            } else {
                if (repeat > 0) {
                    repeat -= 1;
                } else {
                    return 0;
                }
            }
        } else if (lockRarity && slotRarity > libAffx_rarityCommon && slotRarity != libAffx_rarityStarter) {
            slotRarity -= 1;
        } else {
            if (repeat > 0) {
                repeat -= 1;
            } else {
                return 0;
            }
        } 
    }

    return 0;
}

bool libAffx_ProcessQueueTimeElapsed_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (!libAffx_processingQueue || libAffx_processQueueTimeElapsed > 60) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_processQueueTimeElapsed += 0.0625;
    return true;
}
void libAffx_ProcessQueueTimeElapsed_Init() {
    libAffx_ProcessQueueTimeElapsedTrigger = TriggerCreate("libAffx_ProcessQueueTimeElapsed_Func");
    TriggerAddEventTimePeriodic(libAffx_ProcessQueueTimeElapsedTrigger, 0.0625, c_timeGame);
}


void libAffx_ShowRolledAffixes() {
    SoundPlayOnUnit(SoundLink("UI_Game_LevelUp_Talent", -1), PlayerGroupSingle(1), libGame_gv_players[libAffx_player].lv_heroUnit, 8.0, 100.0, 0.0);
    libAffx_ShowAffixSelectionDialog(true);
}

void libAffx_RollForSlot(int slot) {
    int rolledRarity;
    if (libAffx_currentQueue.lockRarity) {
        rolledRarity = libAffx_currentQueue.rarity;
    } else {
        rolledRarity = libAffx_RollRarity(libAffx_currentQueue.rarity, libAffx_currentQueue.curse);
    }
    libAffx_rolledAffixes[slot] = libAffx_RollAffix(rolledRarity, libAffx_currentQueue.curse, libAffx_currentQueue.level, libAffx_currentQueue.lockRarity);
}

void libAffx_RollAffixChoices() {
    bool anyRolled = false;
    int rolledRarity;
    int i;
    libAffx_processQueueTimeElapsed = 0;
    if (libAffx_currentQueue.overrideAffix != 0) {
        libAffx_rolledAffixes[1] = libAffx_currentQueue.overrideAffix;
        libAffx_ShowRolledAffixes();
    } else if (libAffx_currentQueue.rarity == libAffx_rarityMythic) {
        if (libAffx_currentRun <= 4) {
            libAffx_rolledAffixes[1] = libAffx_GetAffixId("Sappers");
        } else if (libAffx_currentRun <= 8) {
            libAffx_rolledAffixes[1] = libAffx_GetAffixId("ArmoredUp");
        } else if (libAffx_currentRun <= 12) {
            libAffx_rolledAffixes[1] = libAffx_GetAffixId("WeakPoint");
        } else if (libAffx_currentRun <= 16) {
            libAffx_rolledAffixes[1] = libAffx_GetAffixId("Invasion");
        } else {
            libAffx_rolledAffixes[1] = libAffx_GetAffixId("Eternal");
        }
        libAffx_ShowRolledAffixes();
    } else {
        for (i = 1; i <= libAffx_currentQueue.choiceCount; i += 1) {
            libAffx_RollForSlot(i);
            if (libAffx_rolledAffixes[i] != 0) {
                anyRolled = true;
            }
        }
        if (!anyRolled) {
            libAffx_processingQueue = false;
            libAffx_AdvanceQueue();
            libAffx_ProcessQueue();
        } else {
            libAffx_ShowRolledAffixes();
        }
    }
}

void libAffx_AdvanceQueue() {
    int i;
    for (i = 1; i <= libAffx_queueCount; i += 1) {
        libAffx_queue[i].choiceCount = libAffx_queue[i + 1].choiceCount;
        libAffx_queue[i].curse = libAffx_queue[i + 1].curse;
        libAffx_queue[i].level = libAffx_queue[i + 1].level;
        libAffx_queue[i].lockRarity = libAffx_queue[i + 1].lockRarity;
        libAffx_queue[i].overrideAffix = libAffx_queue[i + 1].overrideAffix;
        libAffx_queue[i].rarity = libAffx_queue[i + 1].rarity;
        libAffx_queue[i].rerollDisabled = libAffx_queue[i + 1].rerollDisabled;
    }
    libAffx_currentQueue.choiceCount = libAffx_queue[1].choiceCount;
    libAffx_currentQueue.curse = libAffx_queue[1].curse;
    libAffx_currentQueue.level = libAffx_queue[1].level;
    libAffx_currentQueue.lockRarity = libAffx_queue[1].lockRarity;
    libAffx_currentQueue.overrideAffix = libAffx_queue[1].overrideAffix;
    libAffx_currentQueue.rarity = libAffx_queue[1].rarity;
    libAffx_currentQueue.rerollDisabled = libAffx_queue[1].rerollDisabled;
    
    libAffx_queueCount = MaxI(0, libAffx_queueCount - 1);
}

void libAffx_ProcessCurrentEntry() {
    libAffx_processingQueue = true;
    libAffx_RollAffixChoices();
}

void libAffx_SwapCurseToBoon() {
    libAffx_processingQueue = true;
    libAffx_objectivesWonCounter -= 1;
    libAffx_cursesSwapped += 1;
    libAffx_DisplayChatMessage(StringExternal("Message/CurseSwap"));
    libAffx_currentQueue.curse = false;
    libAffx_RollAffixChoices();
}

void libAffx_SkipCurse() {
    libAffx_processingQueue = false;
    libAffx_skipCurseCounter -= 1;
    libAffx_cursesSkipped += 1;
    libAffx_DisplayChatMessage(StringExternal("Message/CurseSkipped"));
    libAffx_AdvanceQueue();
    libAffx_ProcessQueue();
}

void libAffx_ProcessQueue() {
    int i;
    if (libAffx_processingQueue || libAffx_queueCount <= 0 || libGame_gv_gameOver) {
        return;
    }
    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        libAffx_affixes[i].lastSeen = 0;
    }

    if (libAffx_currentQueue.rarity == libAffx_rarityMythic || libAffx_currentQueue.rarity == libAffx_rarityMilestone || libAffx_debugCommandAddAll) {
        libAffx_ProcessCurrentEntry();
    } else if (libAffx_objectivesWonCounter > 0 && libAffx_currentQueue.curse) {
        libAffx_SwapCurseToBoon();
    } else if (libAffx_skipCurseCounter > 0 && libAffx_currentQueue.curse) {
        libAffx_SkipCurse();
    } else {
        libAffx_ProcessCurrentEntry();
    }
}

void libAffx_EnqueueAffix(structref<libAffx_QueuedAffix> queued, int amountToQueue) {
    int i;
    if (libAffx_debug_disableAffixQueue) {
        return;
    }
    if (amountToQueue > 0) {
        for (i = 1; i <= amountToQueue; i += 1) {
            if (libAffx_queueCount >= libAffx_maxQueue) {
                break;
            }
            libAffx_queueCount += 1;
            libAffx_queue[libAffx_queueCount].choiceCount = queued.choiceCount;
            libAffx_queue[libAffx_queueCount].curse = queued.curse;
            libAffx_queue[libAffx_queueCount].level = queued.level;
            libAffx_queue[libAffx_queueCount].lockRarity = queued.lockRarity;
            libAffx_queue[libAffx_queueCount].overrideAffix = queued.overrideAffix;
            libAffx_queue[libAffx_queueCount].rarity = queued.rarity;
            libAffx_queue[libAffx_queueCount].rerollDisabled = queued.rerollDisabled;
        }
        libAffx_currentQueue.choiceCount = libAffx_queue[1].choiceCount;
        libAffx_currentQueue.curse = libAffx_queue[1].curse;
        libAffx_currentQueue.level = libAffx_queue[1].level;
        libAffx_currentQueue.lockRarity = libAffx_queue[1].lockRarity;
        libAffx_currentQueue.overrideAffix = libAffx_queue[1].overrideAffix;
        libAffx_currentQueue.rarity = libAffx_queue[1].rarity;
        libAffx_currentQueue.rerollDisabled = libAffx_queue[1].rerollDisabled;
    }
    libAffx_ProcessQueue();
}
void libAffx_Enqueue(int choiceCount, int amountToQueue, int rarity, int level, bool curse, bool lockRarity, bool rerollDisabled) {
    libAffx_QueuedAffix queued;
    queued.choiceCount = choiceCount;
    queued.curse = curse;
    queued.level = level;
    queued.lockRarity = lockRarity;
    queued.overrideAffix = 0;
    queued.rarity = rarity;
    queued.rerollDisabled = rerollDisabled;
    libAffx_EnqueueAffix(queued, amountToQueue);
}

void libAffx_QueueBoon(int rarity, int amountToQueue, bool rerollDisabled, bool lockRarity) {
    libAffx_Enqueue(libAffx_currentAffixSelection, amountToQueue, rarity, UnitLevel(libGame_gv_players[libAffx_player].lv_heroUnit), false, lockRarity, rerollDisabled);
}
void libAffx_QueueBoonWithChoiceCount(int choiceCount, int rarity, int amountToQueue, bool rerollDisabled, bool lockRarity) {
    libAffx_Enqueue(choiceCount, amountToQueue, rarity, UnitLevel(libGame_gv_players[libAffx_player].lv_heroUnit), false, lockRarity, rerollDisabled);
}
void libAffx_QueueMythicCurse(int amountToQueue) {
    libAffx_Enqueue(1, amountToQueue, libAffx_rarityMythic, UnitLevel(libGame_gv_players[libAffx_enemy].lv_heroUnit), true, true, true);
}
void libAffx_QueueCurse(int amountToQueue, bool rerollDisabled) {
    libAffx_Enqueue(libAffx_currentAffixSelection, amountToQueue, libAffx_rarityCommon, UnitLevel(libGame_gv_players[libAffx_enemy].lv_heroUnit), true, false, rerollDisabled);
}

void libAffx_RerollAffixes() {
    if (libAffx_rerolls <= 0 && !libAffx_currentQueue.curse) {
        return;
    }
    if (libAffx_rerollsCurse <= 0 && libAffx_currentQueue.curse) {
        return;
    }
    if (!libAffx_processingQueue) {
        return;
    }

    if (libAffx_currentQueue.curse) {
        libAffx_rerollsCurse -= 1;
        libAffx_rerollsCurseUsed += 1;
        libAffx_RollAffixChoices();
    } else {
        libAffx_rerolls -= 1;
        libAffx_rerollsUsed += 1;
        libAffx_RollAffixChoices();
    }
}

void libAffx_BanAffix(int selectionIndex) {
    int rolledRarity;
    if (libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsDisplayPicksBans, libAffx_player)) {
        libAffx_DisplayChatMessage(StringExternal("Message/Ban") + TextWithColor(StringExternal("Affix/Name/" + libAffx_affixes[libAffx_rolledAffixes[selectionIndex]].name), libAffx_GetAffixColor(libAffx_rolledAffixes[selectionIndex])) + StringToText("."));
    }
    
    libAffx_bans -= 1;
    libAffx_bansUsed += 1;
    libAffx_affixes[libAffx_rolledAffixes[selectionIndex]].banned = true;
    libAffx_rolledAffixes[selectionIndex] = 0;
    libAffx_RollForSlot(selectionIndex);
    libAffx_ShowAffixSelectionDialog(true);
}

void libAffx_SelectAffix(int selectionIndex) {
    int i;
    if (libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsDisplayPicksBans, libAffx_player) && libAffx_currentQueue.choiceCount > 1) {
        libAffx_DisplayChatMessage(StringExternal("Message/Pick") + TextWithColor(StringExternal("Affix/Name/" + libAffx_affixes[libAffx_rolledAffixes[selectionIndex]].name), libAffx_GetAffixColor(libAffx_rolledAffixes[selectionIndex])) + StringToText("."));
    }
    
    libAffx_ShowAffixSelectionDialog(false);
    libAffx_AddAffix(libAffx_rolledAffixes[selectionIndex], 1);
    if (!libAffx_showingOwnedAffixes) {
        libAffx_Pause(false);
    }
    libAffx_processingQueue = false;
    libAffx_AdvanceQueue();
    libAffx_ProcessQueue();
    libAffx_UpdateOwnedAffixesDialog();
}

bool libAffx_AffixHotkeyPressedTrigger_Func (bool testConds, bool runActions) {
    int hotkeyPressed = EventKeyPressed() - 3;
    if (testConds) {
        if (!libAffx_processingQueue){
            return false;
        }
        if (libAffx_processQueueTimeElapsed < libAffx_disableHotkeysDuration) {
            return false;
        }
        if (hotkeyPressed > libAffx_currentAffixSelection) {
            return false;
        }
        if (hotkeyPressed > libAffx_currentQueue.choiceCount) {
            return false;
        }
        if (libAffx_IsOwnedAffixesDialogVisible()) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    if (libAffx_rolledAffixes[hotkeyPressed] == 0) {
        return true;
    }

    libAffx_SelectAffix(hotkeyPressed);
    SoundPlayForPlayer(SoundLink("UI_Game_Click", -1), libAffx_player, PlayerGroupSingle(libAffx_player), 100.0, 0.0);

    return true;
}
void libAffx_AffixHotkeyPressedTrigger_Init() {
    libAffx_AffixHotkeyPressedTrigger = TriggerCreate("libAffx_AffixHotkeyPressedTrigger_Func");
    TriggerAddEventKeyPressed(libAffx_AffixHotkeyPressedTrigger, libAffx_player, c_key1, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libAffx_AffixHotkeyPressedTrigger, libAffx_player, c_key2, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libAffx_AffixHotkeyPressedTrigger, libAffx_player, c_key3, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libAffx_AffixHotkeyPressedTrigger, libAffx_player, c_key4, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libAffx_AffixHotkeyPressedTrigger, libAffx_player, c_key5, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
}
bool libAffx_AffixHotkeyRerollPressed_Func (bool testConds, bool runActions) {
    int hotkeyPressed = EventKeyPressed();
    if (testConds) {
        if (!libAffx_processingQueue){
            return false;
        }
        if (libAffx_processQueueTimeElapsed < libAffx_disableHotkeysDuration) {
            return false;
        }
        if (hotkeyPressed != c_keyR) {
            return false;
        }
        if (libAffx_IsOwnedAffixesDialogVisible()) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_RerollAffixes();

    return true;
}
void libAffx_AffixHotkeyRerollPressed_Init() {
    TriggerAddEventKeyPressed(TriggerCreate("libAffx_AffixHotkeyRerollPressed_Func"), libAffx_player, c_keyR, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
}
int libAffx_GetSelectButtonIndex(int dialogControl) {
    int i;
    for (i = 1; i <= libAffx_maxAffixSelection; i += 1) {
        if (dialogControl == libAffx_dialogAffixSelection.items[i].selectButton) {
            return i;
        }
    }
    return 0;
}
bool libAffx_AffixSelectedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    int selectedButton = libAffx_GetSelectButtonIndex(eventDialog);

    if (testConds) {
        if (libAffx_processQueueTimeElapsed < libAffx_disableDialogControlDuration) {
            return false;
        }
        if (selectedButton == 0 || libAffx_rolledAffixes[selectedButton] == 0) {
            return false;
        }
        if (!libAffx_processingQueue){
            return false;
        }
        if (libAffx_IsOwnedAffixesDialogVisible()) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_SelectAffix(selectedButton);

    return true;
}

int libAffx_GetBanButtonIndex(int dialog) {
    int i;
    for (i = 1; i <= libAffx_maxAffixSelection; i += 1) {
        if (dialog == libAffx_dialogAffixSelection.items[i].banButton) {
            return i;
        }
    }
    return 0;
}

bool libAffx_AffixBanTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    int selectedButton = libAffx_GetBanButtonIndex(eventDialog);

    if (testConds) {
        if (libAffx_processQueueTimeElapsed < libAffx_disableDialogControlDuration) {
            return false;
        }
        if (libAffx_bans <= 0) {
            return false;
        }
        if (selectedButton == 0 || libAffx_rolledAffixes[selectedButton] == 0) {
            return false;
        }
        if (!libAffx_processingQueue) {
            return false;
        }
        if (libAffx_IsOwnedAffixesDialogVisible()) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_BanAffix(selectedButton);

    return true;
}

bool libAffx_AffixRerollTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();

    if (testConds) {
        if (eventDialog != libAffx_dialogAffixSelection.rerollButton){
            return false;
        }
        if (!libAffx_processingQueue) {
            return false;
        }
        if (libAffx_IsOwnedAffixesDialogVisible()) {
            return false;
        }
        if (libAffx_IsOptionsDialogVisible()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_RerollAffixes();

    return true;
}

bool libAffx_ObjectiveWonTrigger_Func (bool testConds, bool runActions) {
    if (libAffx_objectivesWonThisGame < libAffx_maxAffixesFromObjectives) {
        libAffx_objectivesWonCounter += 1;
        libAffx_DisplayChatMessage(StringExternal("Message/CurseToBoon"));
    }
    libAffx_objectivesWonThisGame += 1;
    return true;
}
bool libAffx_ObjectiveLostTrigger_Func (bool testConds, bool runActions) {
    libAffx_objectivesLostThisGame += 1;
    return true;
}
void libAffx_ObjectiveTriggers_Init() {
    libAffx_ObjectiveWonTrigger = TriggerCreate("libAffx_ObjectiveWonTrigger_Func");
    libAffx_ObjectiveLostTrigger = TriggerCreate("libAffx_ObjectiveLostTrigger_Func");
    TriggerAddEventGeneric(libAffx_ObjectiveWonTrigger, "AffixObjectiveWon");
    TriggerAddEventGeneric(libAffx_ObjectiveLostTrigger, "AffixObjectiveLost");
}

bool libAffx_ResetCommandTrigger_Func (bool testConds, bool runActions) {

    // Conditions
    if (testConds) {
        if (StringWord(EventChatMessage(false), 1) != "resetgame") {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libAffx_DisplayChatMessage(StringExternal("Message/ResetCommand"));
    libAffx_ResetBank();
    libAffx_ResetBankStats();
    GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialveteran.stormmap");
    KickFromGame(PlayerGroupAll());

    return true;
}
void libAffx_ResetCommandTrigger_Init () {
    libAffx_ResetCommandTrigger = TriggerCreate("libAffx_ResetCommandTrigger_Func");
    TriggerAddEventChatMessage(libAffx_ResetCommandTrigger, c_playerAny, "resetgame", false);
}

bool libAffx_TestCommandTrigger_Func (bool testConds, bool runActions) {
    int i;
    int i2;
    string chatMessage;
    string argument1;
    string argument2;
    string argument3;
    int afxaddallAffixes;
    int afxaddallAmount;
    int nextmapValue;
    int rerollsAmount;
    int cooldownId;
    int boonCurseAmount;
    int boonCurseRarity;
    int boonCurseId;
    string unitType;
    if (testConds) {
        if (!libAffx_debug_enableCheatCommands) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    chatMessage = StringWord(EventChatMessage(false), 1);
    argument1 = StringWord(EventChatMessage(false), 2);
    argument2 = StringWord(EventChatMessage(false), 3);
    argument3 = StringWord(EventChatMessage(false), 4);

    if (chatMessage == "help" || chatMessage == "h") {
        if (argument1 == "affixaddall" || argument1 == "afxaddall" || argument1 == "aaa") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/AffixAddAll"));
        } else if (argument1 == "nextmap" || argument1 == "nm") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/NextMap"));
        } else if (argument1 == "rerolls" || argument1 == "r") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Rerolls"));
        } else if (argument1 == "bans" || argument1 == "b") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Bans"));
        } else if (argument1 == "cooldown" || argument1 == "cd") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Cooldown"));
        } else if (argument1 == "boon" || argument1 == "b") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Boon"));
        } else if (argument1 == "curse" || argument1 == "c") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Curse"));
        } else if (argument1 == "affixadd" || argument1 == "afxadd" || argument1 == "affix" || argument1 == "afx") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/AffixAdd"));
        } else if (argument1 == "teleport" || argument1 == "tp") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Teleport"));
        } else {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Commands"));
        }
    } else if (chatMessage == "boon" || chatMessage == "b") {
        if (argument1 != "") {
            boonCurseAmount = StringToInt(argument1);
        } else {
            boonCurseAmount = 1;
        }
        if (argument2 != "") {
            boonCurseRarity = libAffx_GetRarityID(argument2);
            if (boonCurseRarity == 0) {
                boonCurseRarity = StringToInt(argument2);
            }
        } else {
            boonCurseRarity = libAffx_rarityCommon;
        }

        libAffx_QueueBoon(MaxI(boonCurseRarity, libAffx_rarityCommon), boonCurseAmount, false, false);
    } else if (chatMessage == "curse" || chatMessage == "c") {
        if (argument1 != "") {
            boonCurseAmount = StringToInt(argument1);
        } else {
            boonCurseAmount = 1;
        }
        libAffx_QueueCurse(boonCurseAmount, false);
    } else if (chatMessage == "affix" || chatMessage == "afx" || chatMessage == "affixadd" || chatMessage == "afxadd") {
        if (argument1 == "") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/AffixAdd"));
        } else {
            if (argument2 != "") {
                boonCurseAmount = StringToInt(argument2);
            } else {
                boonCurseAmount = 1;
            }
            boonCurseId = libAffx_GetAffixId(argument1);
            if (boonCurseId == 0) {
                TextExpressionSetToken("Message/TestCommand/CouldNotFind", "A", StringToText(argument1));
                libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CouldNotFind"));
            } else {
                libAffx_AddAffix(boonCurseId, boonCurseAmount);
                TextExpressionSetToken("Message/TestCommand/Added", "A", StringToText(IntToString(boonCurseAmount)));
                TextExpressionSetToken("Message/TestCommand/Added", "B", StringToText(libAffx_affixes[boonCurseId].name));
                libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/Added"));
            }
        }
        libAffx_UpdateOwnedAffixesDialog();
    } else if (chatMessage == "affixaddall" || chatMessage == "afxaddall" || chatMessage == "aaa") {
        if (argument1 != "") {
            afxaddallAmount = StringToInt(argument1);
        } else {
            afxaddallAmount = 1;
        }
        libAffx_debugCommandAddAll = true;
        for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
            if (((libAffx_affixes[i].enabled && libAffx_affixes[i].allowedHero[libAffx_playersHeroIndex[libAffx_player]]) || argument2 == "ignore") && ((libAffx_affixes[i].max > 0 && libAffx_affixes[i].count <= libAffx_affixes[i].max) || (libAffx_affixes[i].max <= 0))) {
                if (argument2 == "hero" && !libAffx_affixes[i].heroExclusive) {
                    continue;
                }
                if (((argument2 == "boons" || argument2 == "boon") && libAffx_affixes[i].curse) || ((argument2 == "curses" || argument2 == "curse") && !libAffx_affixes[i].curse)) {
                    continue;
                }
                if (libAffx_affixes[i].max <= 0) {
                    afxaddallAffixes += afxaddallAmount;
                    libAffx_AddAffix(i, afxaddallAmount);
                } else if (libAffx_affixes[i].count < libAffx_affixes[i].max) {
                    afxaddallAffixes += libAffx_affixes[i].max - libAffx_affixes[i].count;
                    libAffx_AddAffix(i, libAffx_affixes[i].max - libAffx_affixes[i].count);
                }
            }
        }
        libAffx_debugCommandAddAll = false;
        libAffx_UpdateOwnedAffixesDialog();
        TextExpressionSetToken("Message/TestCommand/AddedTotal", "A", StringToText(IntToString(afxaddallAffixes)));
        libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/AddedTotal"));
    } else if (chatMessage == "nextmap" || chatMessage == "nm") {
        libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/NextMapLoading"));
        if (argument1 != "") {
            nextmapValue = StringToInt(argument1);
            libAffx_currentRun = nextmapValue - 1;
        } else {
            nextmapValue = libAffx_currentRun + 1;
        }
        if ((nextmapValue - 1) % 4 == 0) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialveteran.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map1);
        } else if ((nextmapValue - 1) % 4 == 1) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialmapmechanics.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map2);
        } else if ((nextmapValue - 1) % 4 == 2) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorial01.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map3);
        } else {
            GameSetNextMap("heroes/singleplayermaps/(10)trymemode.stormmap");
            libAffx_nextMap = libAffx_GetMapString(libAffx_map4);
        }
        libAffx_SaveBank();
        Wait(1, c_timeGame);
        KickFromGame(PlayerGroupAll());
    } else if (chatMessage == "rerolls" || chatMessage == "r") {
        if (argument1 != "") {
            rerollsAmount = StringToInt(argument1);
        } else {
            rerollsAmount = 999;
        }
        TextExpressionSetToken("Message/TestCommand/AddingRerolls", "A", StringToText(IntToString(rerollsAmount)));
        libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/AddingRerolls"));
        libAffx_rerolls += rerollsAmount;
        libAffx_rerollsCurse += rerollsAmount;
    } else if (chatMessage == "bans" || chatMessage == "b") {
        if (argument1 != "") {
            rerollsAmount = StringToInt(argument1);
        } else {
            rerollsAmount = 999;
        }
        TextExpressionSetToken("Message/TestCommand/AddingBans", "A", StringToText(IntToString(rerollsAmount)));
        libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/AddingBans"));
        libAffx_bans += rerollsAmount;
    } else if (chatMessage == "cooldown" || chatMessage == "cd") {
        if (argument1 == "") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Cooldown"));
        } else {
            cooldownId = libAffx_GetAffixId(argument1);
            if (cooldownId == 0) {
                TextExpressionSetToken("Message/TestCommand/CouldNotFind", "A", StringToText(argument1));
                libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CouldNotFind"));
            } else if (argument2 == "") {
                libAffx_affixes[cooldownId].cooldown = 0;
            } else {
                libAffx_affixes[cooldownId].cooldown = StringToFixed(argument2);
            }
            TextExpressionSetToken("Message/TestCommand/CooldownSet", "A", StringToText(libAffx_affixes[cooldownId].name));
            TextExpressionSetToken("Message/TestCommand/CooldownSet", "B", StringToText(FixedToString(libAffx_affixes[cooldownId].cooldown, 0)));
            libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CooldownSet"));
        }
    } else if (chatMessage == "forcepause") {
        libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/ForcedPause"));
        libAffx_Pause(true);
    } else if (chatMessage == "forceunpause") {
        libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/ForcedUnpause"));
        libAffx_Pause(false);
    } else if (chatMessage == "camera" || chatMessage == "c") {
        if (argument1 == "" || argument2 == "") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Camera"));
        }
        if (argument3 == "") {
            CameraSetValue(libAffx_player, StringToInt(argument1), StringToFixed(argument2), 0, -1, 10);
        } else {
            CameraSetValue(libAffx_player, StringToInt(argument1), StringToFixed(argument2), StringToFixed(argument3), -1, 10);
        }
    } else if (chatMessage == "ravencurse" || chatMessage == "rc") {
        if (argument1 == "") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/RavenCurse"));
        } else {
            libMapM_gf_MMRavenTributeCollectionThresholdReached(StringToInt(argument1));
        }
    } else if (chatMessage == "skytemple" || chatMessage == "st") {
        TriggerExecute(TriggerCreate("libMLCP_gt_MMSkyTempleDebugStart1_Func"), false, false);
    } else if (chatMessage == "printheroindex") {
        for (i = 1; i <= 10; i += 1) {
            TextExpressionSetToken("Message/TestCommand/PrintHeroIndex", "A", StringToText(IntToString(i)));
            TextExpressionSetToken("Message/TestCommand/CooldowPrintHeroIndexnSet", "B", StringToText(libCore_gf_GetHeroFromIndex(libGame_gv_players[i].lv_heroIndex)));
            libAffx_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/PrintHeroIndex"));
        }
    } else if (chatMessage == "battleroyale") {
        for (i = 1; i <= 10; i += 1) {
            for (i2 = 1; i2 <= 10; i2 += 1) {
                PlayerSetAlliance(i, c_allianceIdGiveHelp, i2, false);
                PlayerSetAlliance(i, c_allianceIdPassive, i2, false);
                PlayerSetAlliance(i, c_allianceIdPower, i2, false);
                PlayerSetAlliance(i, c_allianceIdSeekHelp, i2, false);
                PlayerSetAlliance(i, c_allianceIdControl, i2, false);
                PlayerSetAlliance(i, c_allianceIdDefeat, i2, false);
                unitType = (CatalogFieldValueGet(c_gameCatalogHero, CatalogFieldValueGet(c_gameCatalogConfig, "Config", "HeroArray[" + IntToString(i * 10 + i2 - 1) + "]", 1), "Unit", c_playerAny));;
                libNtve_gf_CreateUnitsWithDefaultFacing(1, unitType, 0, i2, CameraGetTarget(EventPlayer()), null);
            }
        }
        libAffx_DisplayChatMessage(StringToText("Fight!"));
    } else if (chatMessage == "teleport" || chatMessage == "tp") {
        if (argument1 == "" || argument2 == "") {
            libAffx_DisplayChatMessage(StringExternal("Message/TestCommand/Teleport"));
        } else {
            UnitSetPosition(libAffx_GetPlayerHeroUnit(libAffx_player), Point(StringToFixed(argument1), StringToFixed(argument2)), false);
        }
    } else if (chatMessage == "showgameover") {
        libAffx_ShowGameoverDialog(!libAffx_IsGameoverDialogVisible());
    } else if (chatMessage == "achievement") {
        libAffx_GrantAchievement(libAffx_GetAchievementId(argument1));
    } else if (chatMessage == "resetachievements") {
        libAffx_ResetAllAchievements();
    } else if (chatMessage == "displaytime") {
        libAffx_DisplayChatMessage(StringToText("gameTimer: ") + FixedToText(TimerGetElapsed(libGame_gv_gameTimer), 2));
        libAffx_DisplayChatMessage(StringToText("totalTime: ") + FixedToText(TimerGetElapsed(libGame_gv_totalTime), 2));
        libAffx_DisplayChatMessage(StringToText("matchGameplayTimer: ") + FixedToText(TimerGetElapsed(libGame_gv_matchGameplayTimer), 2));
        libAffx_DisplayChatMessage(StringToText("gobalTimer: ") + FixedToText(TimerGetElapsed(libGame_gv_gobalTimer), 2));
    } else if (chatMessage == "test") {
    }
    return true;
}
