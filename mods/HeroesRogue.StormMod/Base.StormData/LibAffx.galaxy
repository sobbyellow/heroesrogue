}

void libAffx_CreateUI() {
    text versionLabel = StringToText("v" + libAffx_version);

    libAffx_dialogBackdrop = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libAffx_dialogBackdrop, true);
    DialogSetImageVisible(libAffx_dialogBackdrop, false);
    libAffx_dialogControlBackdrop = libAffx_CreateDialogControlImageWithColor(libAffx_dialogBackdrop, libAffx_textureBlackout, 3000, 3000, c_anchorTop, 0, 0, null, ColorWithAlpha(0, 0, 0, 0));

    libAffx_CreateAffixSelectionDialog();
    libAffx_CreateGameoverDialog();
    libAffx_CreateOwnedAffixesDialog();
    libAffx_CreateOptionsDialog();
    libAffx_CreateAchievementsDialog();
    
    libAffx_dialogControls = DialogCreate(500, 500, c_anchorTopRight, 0, 0, true);
    DialogSetFullscreen(libAffx_dialogControls, true);
    DialogSetImageVisible(libAffx_dialogControls, false);

    libAffx_dialogControlOptionsButton = libAffx_CreateDialogControlButton(libAffx_dialogControls);
    libAffx_SetDialogControlSize(libAffx_dialogControlOptionsButton, libAffx_optionsCogButtonWidth, libAffx_optionsCogButtonHeight);
    libAffx_SetDialogControlPosition(libAffx_dialogControlOptionsButton, c_anchorTopRight, libAffx_optionsCogButtonOffsetX, libAffx_optionsCogButtonOffsetY);
    libAffx_CreateDialogControlImage(libAffx_dialogControls, libAffx_textureSettingsCog, libAffx_optionsCogButtonWidth, libAffx_optionsCogButtonHeight, c_anchorTopRight, libAffx_optionsCogButtonOffsetX, libAffx_optionsCogButtonOffsetY, null);

    libAffx_dialogControlOwnedAffixesButton = libAffx_CreateDialogControlButton(libAffx_dialogControls);
    libAffx_SetDialogControlSize(libAffx_dialogControlOwnedAffixesButton, libAffx_ownedAffixesButtonWidth, libAffx_ownedAffixesButtonHeight);
    libAffx_SetDialogControlPosition(libAffx_dialogControlOwnedAffixesButton, c_anchorTopRight, libAffx_ownedAffixesButtonOffsetX, libAffx_ownedAffixesButtonOffsetY);
    libAffx_SetDialogControlText(libAffx_dialogControlOwnedAffixesButton, StringExternal("Button/Name/OwnedAffixes"));
    
    libAffx_dialogInfo = DialogCreate(500, 500, c_anchorTopLeft, 0, 0, true);
    DialogSetImageVisible(libAffx_dialogInfo, false);
    libAffx_SetDialogVisible(libAffx_dialogInfo, true);

    libAffx_dialogControlRunLabel = libAffx_CreateDialogControlLabel(libAffx_dialogInfo, null, "HeroSelectPanelHeaderLabel", libAffx_runAndDifficultyLabelWidth, libAffx_runAndDifficultyLabelHeight, c_anchorTopLeft, libAffx_runAndDifficultyLabelOffsetX, libAffx_runAndDifficultyLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), true);
    libAffx_CreateDialogControlLabel(libAffx_dialogInfo, versionLabel, "Affix_Version", libAffx_versionLabelWidth, libAffx_versionLabelHeight, c_anchorTopLeft, libAffx_versionLabelOffsetX, libAffx_versionLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), true);
}

void libAffx_CreateAchievementsDialogItem(int achievement) {
    int column = (achievement - 1) % libAffx_achievementsColumns;
    int row = (achievement - 1) / libAffx_achievementsColumns;
    int rows = (libAffx_maxAchievements + libAffx_achievementsColumns - 1) / libAffx_achievementsColumns;
    int gridWidth = libAffx_achievementsColumns * libAffx_achievementsItemWidth + (libAffx_achievementsColumns - 1) * libAffx_achievementsItemSpacingX;
    int gridHeight = rows * libAffx_achievementsItemHeight + (rows - 1) * libAffx_achievementsItemSpacingY;
    int x = -gridWidth / 2 + libAffx_achievementsItemWidth / 2 + column * (libAffx_achievementsItemWidth + libAffx_achievementsItemSpacingX);
    int y = (-gridHeight / 2 + libAffx_achievementsItemHeight / 2 + row * (libAffx_achievementsItemHeight + libAffx_achievementsItemSpacingY)) + libAffx_achievementsItemsOffsetY;

    libAffx_dialogAchievements.achievement[achievement].button = libAffx_CreateDialogControlImage(libAffx_dialogAchievements.dialog,
        null, libAffx_achievementsItemWidth, libAffx_achievementsItemHeight, c_anchorCenter, x, y, null);
    libAffx_dialogAchievements.achievement[achievement].label = libAffx_CreateDialogControlLabel(libAffx_dialogAchievements.dialog,
        null, "Affix_Owned", libAffx_achievementsItemLabelWidth, libAffx_achievementsItemLabelHeight, c_anchorCenter, x, y + libAffx_achievementsItemLabelSpacingY, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogAchievements.achievement[achievement].overlay = libAffx_CreateDialogControlImage(libAffx_dialogAchievements.dialog,
        libAffx_textureAchievementNoneOverlay, libAffx_achievementsItemOverlayWidth, libAffx_achievementsItemOverlayHeight, c_anchorCenter, x, y, null);

}

