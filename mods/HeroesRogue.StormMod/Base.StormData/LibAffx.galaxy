text libAffx_GetAffixTitleLabel() {
    int rarity = libAffx_currentQueue.rarity;
    bool curse = libAffx_currentQueue.curse;
    if (rarity == libAffx_rarityStarter) {
        return StringExternal("Label/Name/PickAffixStarter");
    } else if (rarity == libAffx_rarityMythic) {
        return StringExternal("Label/Name/PickAffixCurseMythic");
    } else if (rarity == libAffx_rarityMilestone) {
        return StringExternal("Label/Name/PickAffixMilestone");
    } else if (curse) {
        return StringExternal("Label/Name/PickAffixCurse");
    }
    return StringExternal("Label/Name/PickAffix");
}
text libAffx_GetAffixRerollLabel() {
    int rarity = libAffx_currentQueue.rarity;
    bool curse = libAffx_currentQueue.curse;
    if (rarity == libAffx_rarityStarter) {
        return StringExternal("Label/Name/RerollStarter");
    } else if (curse) {
        return StringExternal("Label/Name/RerollCurse") + IntToText(libAffx_rerollsCurse);
    }
    return StringExternal("Label/Name/Reroll") + IntToText(libAffx_rerolls);
}
string libAffx_GetDifficultyLabel(int difficulty) {
    if (difficulty == libAffx_difficultyNormal) {
        return " (Normal)";
    } else if (difficulty == libAffx_difficultyHeroic) {
        return " (Heroic)";
    } else if (difficulty == libAffx_difficultyMythic) {
        return " (Mythic)";
    }
    return "";
}
text libAffx_GetAffixTooltip(int affix) {
    string name = libAffx_affixes[affix].name;
    int count = libAffx_affixes[affix].count;
    int max = libAffx_affixes[affix].max;
    int skipCurses = libAffx_affixes[affix].skipCurses;
    text tooltip = StringExternal("Affix/Tooltip/" + name);
    
    if (libAffx_affixes[affix].customTooltipForHero[libAffx_playersHeroIndex[libAffx_player]]) {
        tooltip = StringExternal("Affix/Tooltip/" + name + "/" + libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[libAffx_player]));
    } else if (libAffx_affixes[affix].customTooltipForNonManaUsers && UnitHasBehavior2(libAffx_GetPlayerHeroUnit(libAffx_player), "NotManaUserDummy")) {
        tooltip = StringExternal("Affix/Tooltip/" + name + "/NoMana");
    }

    // Tooltip - Total stacking values
    if ((count > 0 && max != 1) || (count > 0 && libAffx_affixes[affix].alwaysAppendTooltip)) {
        tooltip += StringExternal("Affix/Tooltip/Append/" + name);
    }

    // Tooltip - Stacks up to X
    if (max > 1) {
        TextExpressionSetToken("Param/Expression/AffixStacksUpTo", "A", IntToText(max));
        tooltip += TextExpressionAssemble("Param/Expression/AffixStacksUpTo");
    }

    // Tooltip - Skips the next X curses
    if (max == 1) {
        if (skipCurses == 1) {
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkips");
        } else if (skipCurses > 1) {
            TextExpressionSetToken("Param/Expression/AffixCurseSkipsMultiple", "A", IntToText(skipCurses));
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkipsMultiple");
        }
    } else {
        if (skipCurses == 1) {
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkipsEachStack");
        } else if (skipCurses > 1) {
            TextExpressionSetToken("Param/Expression/AffixCurseSkipsMultiple", "A", IntToText(skipCurses));
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkipsMultipleEachStack");
        }
    }
    return tooltip;
}

bool libAffx_IsAffixBannable(int affix) {
    int rarity = libAffx_affixes[affix].rarity;
    int max = libAffx_affixes[affix].max;
    if (max <= 0 || rarity == libAffx_rarityStarter || rarity == libAffx_rarityMythic || rarity == libAffx_rarityMilestone) {
        return false;
    }
    return true;
}

bool libAffx_IsCurrentQueueBannable() {
    int rarity = libAffx_currentQueue.rarity;
    if (rarity == libAffx_rarityStarter || rarity == libAffx_rarityMythic || rarity == libAffx_rarityMilestone) {
        return false;
    }
    return true;
}
bool libAffx_IsCurrentQueueRerollable() {
    int rarity = libAffx_currentQueue.rarity;
    if (libAffx_currentQueue.rerollDisabled || rarity == libAffx_rarityMythic || rarity == libAffx_rarityMilestone || rarity == libAffx_rarityStarter) {
        return false;
    }
    return true;
}
int libAffx_GetRolledAffixCount() {
    int count;
    int i;
    for (i = 1; i <= libAffx_currentQueue.choiceCount; i += 1) {
        if (libAffx_rolledAffixes[i] != 0) {
            count += 1;
        }
    }
    return count;
}
bool libAffx_IsAnyRolledAffixBannable() {
    int i;
    for (i = 1; i <= libAffx_currentQueue.choiceCount; i += 1) {
        if (libAffx_rolledAffixes[i] != 0 && libAffx_IsAffixBannable(libAffx_rolledAffixes[i])) {
            return true;
        }
    }
    return false;
}
bool libAffx_ShouldShowBefore(int affix1, int affix2) {
    if (libAffx_affixes[affix1].rarity < libAffx_affixes[affix2].rarity) {
        return true;
    }
    if (libAffx_affixes[affix1].rarity > libAffx_affixes[affix2].rarity) {
        return false;
    }
    if (libAffx_affixes[affix1].heroExclusive && !libAffx_affixes[affix2].heroExclusive) {
        return true;
    }
    if (!libAffx_affixes[affix1].heroExclusive && libAffx_affixes[affix2].heroExclusive) {
        return false;
    }
    return false;
}
bool libAffx_IsAffixSelectionDialogVisible() {
    if (DialogIsVisible(libAffx_dialogAffixSelection.dialog, libAffx_player)) {
        return true;
    }
    return false;
}
bool libAffx_IsOwnedAffixesDialogVisible() {
    if (DialogIsVisible(libAffx_dialogOwnedAffixes.dialog, libAffx_player)) {
        return true;
    }
    return false;
}
bool libAffx_IsOptionsDialogVisible() {
    if (DialogIsVisible(libAffx_dialogOptions.dialog, libAffx_player)) {
        return true;
    }
    return false;
}
bool libAffx_IsGameoverDialogVisible() {
    if (DialogIsVisible(libAffx_dialogGameover.dialog, libAffx_player)) {
        return true;
    }
    return false;
}
bool libAffx_IsGameoverExitDialogVisible() {
    if (DialogIsVisible(libAffx_dialogGameoverExit.dialog, libAffx_player)) {
        return true;
    }
    return false;
}
bool libAffx_IsAchievementsDialogVisible() {
    if (DialogIsVisible(libAffx_dialogAchievements.dialog, libAffx_player)) {
        return true;
    }
    return false;
}
bool libAffx_IntToBoolean(int value) {
    if (value >= 1) {
        return true;
    }
    return false;
}
unit libAffx_GetPlayerDVaMech (int player) { 
    unitgroup heroUnitGroup;
    unit heroUnit;
    unit mechUnit;
    int groupCount;

    heroUnitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    groupCount = UnitGroupCount(heroUnitGroup, c_unitCountAll);

    for (;; groupCount -= 1) {
        if (groupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(heroUnitGroup, groupCount);
        if (UnitGetType(heroUnit) == "HeroDVaMech") {
            mechUnit = heroUnit;
        }
    }
    return mechUnit;
}

