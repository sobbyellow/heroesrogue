    lv_row = libPBU2_ge_CurateHeroSelectionRole_RangedAssassin2;
    libPBU2_gv_curateHeroSelections[lv_row][1] = "WitchDoctor";
    libPBU2_gv_curateHeroSelections[lv_row][2] = "Nova";
