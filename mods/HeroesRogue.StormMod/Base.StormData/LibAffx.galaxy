// ============================================================
// Chen
// ============================================================

bool libAffx_ChenStormEarthFireTrigger_Func (bool testConds, bool runActions) {
    unit caster = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int player = UnitGetOwner(caster);
    unitgroup pandas = libGDHL_gv_heroChenStormEarthFireUnits[player].lv_stormEarthFireUnits;
    int pandaCount;
    unit pandaUnit;
    if (!runActions) {
        return true;
    }
    libAffx_Wait(0.0625, c_timeGame);
    pandaCount = UnitGroupCount(pandas, c_unitCountAll);
    for (;; pandaCount -= 1) {
        if (pandaCount <= 0) { break; }
        pandaUnit = UnitGroupUnitFromEnd(pandas, pandaCount);
        libAffx_DisplayDebugMessage("Syncing behaviors from " + UnitGetType(caster) + " to " + UnitGetType(pandaUnit));
        libAffx_SyncBehaviors(caster, pandaUnit);
    }
    return true;
}

void libAffx_ChenTriggers_Init() {
    libAffx_ChenStormEarthFireTrigger = TriggerCreate("libAffx_ChenStormEarthFireTrigger_Func");
    TriggerAddEventPlayerEffectUsed(libAffx_ChenStormEarthFireTrigger, c_playerAny, "ChenStormEarthFireCreateFinishSet");
}

