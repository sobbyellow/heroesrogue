    libAffx_SetDialogControlPosition(libAffx_dialogAchievementsReset.frame, c_anchorCenter, 0, 0);
    libAffx_dialogAchievementsReset.label = libAffx_CreateDialogControlLabel(libAffx_dialogAchievementsReset.dialog,
        StringExternal("Label/Name/ResetAchievements"), "Affix_Dialog", libAffx_achievementsResetLabelWidth, libAffx_achievementsResetLabelHeight,
        c_anchorCenter, libAffx_achievementsResetLabelOffsetX, libAffx_achievementsResetLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogAchievementsReset.option[1].button = libAffx_CreateDialogControlButton(libAffx_dialogAchievementsReset.dialog);
    libAffx_SetDialogControlSize(libAffx_dialogAchievementsReset.option[1].button, libAffx_optionsRestartButtonWidth, libAffx_optionsRestartButtonHeight);
    libAffx_SetDialogControlText(libAffx_dialogAchievementsReset.option[1].button, StringExternal("Button/Name/Yes"));
    libAffx_SetDialogControlPosition(libAffx_dialogAchievementsReset.option[1].button, c_anchorCenter, libAffx_optionsRestartButtonYesOffsetX, libAffx_optionsRestartButtonYesOffsetY);
    libAffx_dialogAchievementsReset.option[2].button = libAffx_CreateDialogControlButton(libAffx_dialogAchievementsReset.dialog);
    libAffx_SetDialogControlSize(libAffx_dialogAchievementsReset.option[2].button, libAffx_optionsRestartButtonWidth, libAffx_optionsRestartButtonHeight);
    libAffx_SetDialogControlText(libAffx_dialogAchievementsReset.option[2].button, StringExternal("Button/Name/No"));
    libAffx_SetDialogControlPosition(libAffx_dialogAchievementsReset.option[2].button, c_anchorCenter, libAffx_optionsRestartButtonNoOffsetX, libAffx_optionsRestartButtonNoOffsetY);

}
void libAffx_UpdateAchievementsDialog() {
    int i;
    color labelColor;
    string overlayImage;
    text appendTooltip;
    for (i = 1; i <= libAffx_maxAchievements; i += 1) {
        appendTooltip = null;
        if (libAffx_achievements[i].earned) {
            if (libAffx_achievements[i].difficulty == libAffx_difficultyHeroic) {
                labelColor = Color(100, 84, 20);
                overlayImage = libAffx_textureAchievementHeroicOverlay;
                appendTooltip += StringExternal("Achievement/Tooltip/HighestDifficultyHeroic");
            } else if (libAffx_achievements[i].difficulty == libAffx_difficultyMythic) {
                labelColor = Color(66, 29, 53);
                overlayImage = libAffx_textureAchievementMythicOverlay;
                appendTooltip += StringExternal("Achievement/Tooltip/HighestDifficultyMythic");
            } else {
                labelColor = Color(100, 100, 100);
                overlayImage = libAffx_textureAchievementNormalOverlay;
                appendTooltip += StringExternal("Achievement/Tooltip/HighestDifficultyNormal");
            }
            if (libAffx_achievements[i].type == libAffx_achievementTypeWinOnHero && libAffx_achievements[i].round > 0) {
                TextExpressionSetToken("Achievement/Tooltip/RoundNumber", "A", IntToText(libAffx_achievements[i].round));
                appendTooltip += TextExpressionAssemble("Achievement/Tooltip/RoundNumber");
            }
            libAffx_SetDialogControlColor(libAffx_dialogAchievements.achievement[i].button, Color(100, 100, 100));
            libAffx_SetDialogControlColor(libAffx_dialogAchievements.achievement[i].label, labelColor);
            libAffx_SetDialogControlImage(libAffx_dialogAchievements.achievement[i].overlay, overlayImage);
        } else {
            libAffx_SetDialogControlColor(libAffx_dialogAchievements.achievement[i].button, Color(8, 8, 8));
            libAffx_SetDialogControlColor(libAffx_dialogAchievements.achievement[i].label, Color(50, 50, 50));
            libAffx_SetDialogControlImage(libAffx_dialogAchievements.achievement[i].overlay, libAffx_textureAchievementNoneOverlay);
        }
        libAffx_SetDialogControlImage(libAffx_dialogAchievements.achievement[i].button, libAffx_achievements[i].icon);
        libAffx_SetDialogControlTooltip(libAffx_dialogAchievements.achievement[i].button, StringExternal("Achievement/Tooltip/" + libAffx_achievements[i].name) + appendTooltip);
        libAffx_SetDialogControlText(libAffx_dialogAchievements.achievement[i].label, StringExternal("Achievement/Name/" + libAffx_achievements[i].name));
    }
}

void libAffx_ShowAchievementsDialog(bool show) {
    libAffx_UpdateAchievementsDialog();
    libAffx_SetDialogVisible(libAffx_dialogAchievements.dialog, show);
    libAffx_ShowBackdrop(show);
    if (show && libAffx_IsOptionsDialogVisible()) {
        DialogSetTransparency(libAffx_dialogOptions.dialog, 75);
    } else {
        DialogSetTransparency(libAffx_dialogOptions.dialog, 0);
    }
    if (!libPBU2_heroSelected && libAffx_currentRun == 1 && !libAffx_debug_disableHeroSelection) {
        libAffx_SetDialogVisible(libPBU2_gv_curateHeroSelectionUI.lv_dialog, !show);
        libAffx_SetDialogVisible(libPBU2_informationDialog, false);
    }
    libAffx_SetDialogVisible(libAffx_dialogAchievementsReset.dialog, false);
}


