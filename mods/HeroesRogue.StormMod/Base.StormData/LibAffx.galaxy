bool libAffx_DifficultyUnitCreated_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_difficulty <= libAffx_difficultyHeroic) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_AddUnitBehaviorCriteria(EventUnitCreatedUnit(), "AffixDifficultyBehavior", 1, libAffx_filterDifficulty);
    return true;
}
bool libAffx_DifficultyUnitChangeOwner_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_difficulty <= libAffx_difficultyHeroic) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_UpdateUnitBehaviorCriteria(EventUnit(), "AffixDifficultyBehavior", 1, libAffx_filterDifficulty);
    return true;
}
void libAffx_Difficulty_Init() {
    libAffx_DifficultyUnitCreatedTrigger = TriggerCreate("libAffx_DifficultyUnitCreated_Func");
    libAffx_DifficultyUnitChangeOwner = TriggerCreate("libAffx_DifficultyUnitChangeOwner_Func");
    TriggerAddEventUnitCreated(libAffx_DifficultyUnitCreatedTrigger, null, null, null);
    TriggerAddEventUnitChangeOwner(libAffx_DifficultyUnitChangeOwner, null);
}

void libAffx_ApplyDifficulty () {
    fixed modifier;
    fixed scaledModifier;
    int i;

    if (libAffx_difficulty == libAffx_difficultyMythic) {
        modifier = 0.04;
        libAffx_mythicDifficultyXPModifier = 0.01 * libAffx_currentRun;
        libGame_xpModifier[libGame_gv_teamChaosIndex_C] += libAffx_mythicDifficultyXPModifier;
        scaledModifier = (modifier + 0.01 * libAffx_currentRun) * libAffx_currentRun;
        libAffx_SetAffix(libAffx_GetAffixId("DifficultyMythic"), libAffx_currentRun);
        libAffx_AddUnitBehaviorCriteriaAll("AffixDifficultyBehavior", 1, libAffx_filterDifficulty);
    } else if (libAffx_difficulty == libAffx_difficultyHeroic) {
        modifier = 0.04;
        scaledModifier = Pow((1 + modifier), libAffx_currentRun) - 1;
        libAffx_SetAffix(libAffx_GetAffixId("DifficultyHeroic"), libAffx_currentRun);
    } else {
        modifier = 0;
        scaledModifier = 0;
        libAffx_SetAffix(libAffx_GetAffixId("DifficultyNormal"), 1);
    }
    if (scaledModifier < 0) {
        scaledModifier = 0;
    }
    if (libAffx_difficulty == libAffx_difficultyHeroic || libAffx_difficulty == libAffx_difficultyMythic) {
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.DamageDealtFraction[Ability]", FixedToString(scaledModifier, c_fixedPrecisionAny));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.DamageDealtFraction[Basic]", FixedToString(scaledModifier, c_fixedPrecisionAny));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Life]", FixedToString(scaledModifier, c_fixedPrecisionAny));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Life]", FixedToString(scaledModifier, c_fixedPrecisionAny));
        for (i = 6; i <= 10; i += 1) {
            if (!UnitHasBehavior2(libGame_gv_players[i].lv_heroUnit, "NotManaUserDummy")) {
                libAffx_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Energy]", i, FixedToString(scaledModifier, c_fixedPrecisionAny));
                libAffx_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Energy]", i, FixedToString(scaledModifier, c_fixedPrecisionAny));
            } else {
                libAffx_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Energy]", i, "0");
                libAffx_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Energy]", i, "0");
            }
            libAffx_AddPlayerBehavior(i, "AffixDifficultyBehavior", 1, true);
        }
    }
}

bool libAffx_PlayerHasAffix(string affixName) {
    if (libAffx_affixes[libAffx_GetAffixId(affixName)].count > 0) {
        return true;
    }
    return false;
}

bool libAffx_IsCurseLevel(int level) {
    return level == 4 || level == 7 || level == 10 || level == 13 || level == 16 || level == 20 || level == 24 || level == 27 || level == 30;
}
bool libAffx_IsQueueAffixNextGameLevel(int level) {
    return level == 4 || level == 7 || level == 10;
}

bool libAffx_BoonsCursesLevelUp_Func (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player && player != libAffx_enemy) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (player == libAffx_player) {
        if (level == 1) {
            libAffx_Wait(libAffx_gameStartDelay, c_timeGame);
            if ((libAffx_currentRun - 1) % 4 == 0 && libAffx_difficulty == libAffx_difficultyMythic) {
                libAffx_QueueMythicCurse(1);
            }
            if (libAffx_currentRun == 10) {
                libAffx_QueueBoon(libAffx_rarityMilestone, 1, true, true);
                libAffx_DisplayChatMessage(StringExternal("Message/MilestoneReached"));
            }
            if (libAffx_currentRun <= 1) {
                libAffx_QueueBoon(libAffx_rarityStarter, 1, true, true);
            } else {
                if ((libAffx_currentRun - 1) % 4 == 0) {
                    libAffx_QueueBoon(libAffx_rarityLegendary, 1, false, false);
                } else {
                    libAffx_QueueBoon(libAffx_rarityRare, 1, false, false);
                }
            }
            if (libAffx_boonsQueued > 0) {
                libAffx_DisplayChatMessage(StringExternal("Message/BoonNextGame" + IntToString(MinI(libAffx_boonsQueued, 3))));
                libAffx_QueueBoon(libAffx_rarityCommon, libAffx_boonsQueued, false, false);
                libAffx_boonsQueued = 0;
            }
        } else if (libAffx_IsQueueAffixNextGameLevel(level)) {
            libAffx_QueueBoon(libAffx_rarityCommon, 1, false, false);
            libAffx_boonsNextGame -= 1;
        }
        libAffx_startingBoonsQueued = true;
    } else if (player == libAffx_enemy) {
        if (level == 1) {
            libAffx_Wait(libAffx_gameStartDelay, c_timeGame);
            while (!libAffx_startingBoonsQueued) {
                libAffx_Wait(0.0625, c_timeGame);
            }
            libAffx_ApplyDifficulty();
            libAffx_QueueCurse(1, false);
            if (libAffx_cursesQueued > 0) {
                libAffx_DisplayChatMessage(StringExternal("Message/CurseNextGame" + IntToString(MinI(libAffx_cursesQueued, 3))));
                libAffx_QueueCurse(libAffx_cursesQueued, false);
                libAffx_cursesQueued = 0;
            }
        } else if (libAffx_IsQueueAffixNextGameLevel(level)) {
            while (!libAffx_startingBoonsQueued) {
                libAffx_Wait(0.0625, c_timeGame);
            }
            if (level == 4 || level == 7 || level == 10) {
                libAffx_cursesNextGame -= 1;
            }
            libAffx_QueueCurse(1, false);
        } else if (libAffx_IsCurseLevel(level)) {
            while (!libAffx_startingBoonsQueued) {
                libAffx_Wait(0.0625, c_timeGame);
            }
            libAffx_QueueCurse(1, false);
        }
    }
    return true;
}
void libAffx_BoonsCursesLevelUp_Init () {
    libGame_gf_HeroLevelUp(TriggerCreate("libAffx_BoonsCursesLevelUp_Func"));
}

// ============================================================
// Map init
// ============================================================

bool libAffx_MapInitLoadBankTrigger_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }
    libAffx_LoadBank();
    TriggerExecute(libAffx_SpeedUpTrigger, true, false);

    return true;
}
void libAffx_MapInitLoadBankTrigger_Init () {
    libAffx_MapInitLoadBankTrigger = TriggerCreate("libAffx_MapInitLoadBankTrigger_Func");
}

bool libAffx_MapInitTrigger_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    SetTalentsEnabled(false);

    TriggerExecute(libAffx_MapInitLoadBankTrigger, false, false);
    libAffx_LoadSettingsBank();

    libAffx_currentRun += 1;
    libPBU2_timerExpired = libAffx_HeroSelectedTrigger;

    libAffx_ShowTalent("DoNothing", false);
    libAffx_ShowTalent("DoNothing4", false);
    libAffx_ShowTalent("DoNothing7", false);
    libAffx_ShowTalent("DoNothing10", false);
    libAffx_ShowTalent("DoNothing13", false);
    libAffx_ShowTalent("DoNothing16", false);
    libAffx_ShowTalent("DoNothing20", false);

    libAffx_SetDialogControlText(libAffx_dialogControlRunLabel, StringToText(IntToString(libAffx_currentRun) + libAffx_GetDifficultyLabel(libAffx_difficulty)));
    if (libAffx_currentRun > libAffx_winningRound) {
        libAffx_SetDialogControlColor(libAffx_dialogControlRunLabel, Color(100, 84, 20));
        if (libAffx_difficulty == libAffx_difficultyMythic) {
            libAffx_maxAffixesFromObjectives = 0;
        }
    }
    
    if (libAffx_debug_disableHeroSelection) {
        if (libAffx_debug_player1Hero == "") {
            libAffx_debug_player1Hero = libCore_gf_GetHeroFromIndex(libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(libAffx_player, true, true));
        }
        libGame_gv_players[libAffx_player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player1Hero);
        libCore_gf_DataLoadHeroDataIntoIndex(libCore_gf_GetHeroFromIndex(libGame_gv_players[libAffx_player].lv_heroIndex), libAffx_player);
        libGame_gf_HeroSelectionRandomlyPickSkin(libAffx_player);
        libGame_gf_HeroSelectionRandomlyPickMount(libAffx_player);
        PlayerSetSpray(libAffx_player, "RandomSpray");
        libAffx_playersHeroIndex[libAffx_player] = libCore_gf_GetIndexFromHero(libAffx_debug_player1Hero);
        libGame_gv_pickingHeroesCallback = libAffx_HeroSelectionTrigger;
    } else if (libAffx_playerHeroIndexLoaded == 0) {
        libGame_gv_pickingHeroesCallback = libAffx_CurateHeroesTrigger;
    } else {
        libGame_gv_players[libAffx_player].lv_heroIndex = libAffx_playerHeroIndexLoaded;
        libAffx_playersHeroIndex[libAffx_player] = libAffx_playerHeroIndexLoaded;
        libCore_gf_DataLoadHeroDataIntoIndex(libCore_gf_GetHeroFromIndex(libGame_gv_players[libAffx_player].lv_heroIndex), libAffx_player);
        libGame_gf_HeroSelectionRandomlyPickSkin(libAffx_player);
        libGame_gf_HeroSelectionRandomlyPickMount(libAffx_player);
        PlayerSetSpray(libAffx_player, "RandomSpray");
        libGame_gv_pickingHeroesCallback = libAffx_HeroSelectionTrigger;
    }
    libAffx_DisplayChatMessage(StringToText("Version " + libAffx_version));

    if (libAffx_currentRun == 1) {
        libAffx_rerolls += libAffx_rerollsStart;
        libAffx_rerollsCurse += libAffx_rerollsStart;
        libAffx_bans += libAffx_bansStart;
    } else {
        libAffx_rerolls += libAffx_rerollsPerGame;
        libAffx_rerollsCurse += libAffx_rerollsPerGame;
        libAffx_bans += libAffx_bansPerGame;
    }

    if (libAffx_DEBUG || libAffx_debug_enableTryMeMode2 || libAffx_debug_enableCheatCommands) {
        libAffx_DisplayChatMessage(StringExternal("Message/DebugEnabled"));
    }
    

    Wait(0.0625, c_timeGame);
    if (libAffx_currentMap != libAffx_GetMapID(libCore_gv_mAPMapStringID) && !libAffx_debug_ignoreMap) {
        if (libAffx_currentMap == libAffx_map1) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialveteran.stormmap");
            KickFromGame(PlayerGroupAll());
        } else if (libAffx_currentMap == libAffx_map2) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorialmapmechanics.stormmap");
            KickFromGame(PlayerGroupAll());
        } else if (libAffx_currentMap == libAffx_map3) {
            GameSetNextMap("heroes/singleplayermaps/startingexperience/tutorial01.stormmap");
            KickFromGame(PlayerGroupAll());
        } else if (libAffx_currentMap == libAffx_map4) {
            GameSetNextMap("heroes/singleplayermaps/(10)trymemode.stormmap");
            KickFromGame(PlayerGroupAll());
        }
    }
    
    while (!libAffx_playersFirstSpawnIn[libAffx_player]) {
        libAffx_Wait(0.0625, c_timeGame);
    }
    if (libAffx_currentMap == libAffx_mapTowersofDoom) {
        libAffx_AddUnitBehaviorCriteriaAll("TowersOfDoomMax1DamageClampBehavior", 1, libAffx_filterAlliedCore);
        libAffx_AddUnitBehaviorCriteriaAll("TowersOfDoomMax1DamageClampBehavior", 1, libAffx_filterEnemyCore);
    }

    libAffx_DisplayDebugMessage("Map loaded: " + libCore_gv_mAPMapStringID + " (" + libAffx_GetMapString(libAffx_currentMap) + ")");

    return true;
}
void libAffx_MapInitTrigger_Init () {
    libAffx_MapInitTrigger = TriggerCreate("libAffx_MapInitTrigger_Func");
    TriggerAddEventMapInit(libAffx_MapInitTrigger);
}

