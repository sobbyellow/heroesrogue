// ============================================================
// Lost Vikings
// ============================================================

bool libAffx_LostVikingsRaidboatTrigger_Func (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int player = UnitGetOwner(createdUnit);
    unitgroup heroGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int heroGroupCount = UnitGroupCount(heroGroup, c_unitCountAll);
    unit heroUnit;
    if (testConds) {
        if (UnitGetType(createdUnit) != "LongboatRaidBoat") {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_Wait(0.0625, c_timeGame);
    libAffx_SyncBehaviors(libGame_gv_players[player].lv_heroUnit, createdUnit);
    for (;; heroGroupCount -= 1) {
        if (heroGroupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(heroGroup, heroGroupCount);
        libAffx_DisplayDebugMessage(UnitGetType(heroUnit));
        if (UnitGetType(heroUnit) != "HeroLostVikingsController") {
            libAffx_DisplayDebugMessage("Syncing " + UnitGetType(heroUnit) + " behaviors with " + UnitGetType(createdUnit));
            libAffx_SyncBehaviors(heroUnit, createdUnit);
            break;
        }
    }
    return true;
}

void libAffx_LostVikingsTriggers_Init() {
    libAffx_LostVikingsRaidboatTrigger = TriggerCreate("libAffx_LostVikingsRaidboatTrigger_Func");
    TriggerAddEventUnitCreated(libAffx_LostVikingsRaidboatTrigger, null, null, null);
}


void libAffx_Wait(fixed duration, int inTimeType) {
    fixed elapsed = 0.0;
    while (elapsed < duration) {
        if (libAffx_gamePaused) {
            Wait(0.0625, inTimeType);
        } else {
            Wait(0.0625, inTimeType);
            elapsed += 0.0625;
        }
    }
}

bool libAffx_GateIsOpen() {
    if (TimerGetElapsed(libGame_gv_openTheGatesTimer) > 0.0 && TimerGetRemaining(libGame_gv_openTheGatesTimer) <= 0.0) {
        return true;
    }
    return false;
}

bool libAffx_TimerFinished(timer checkTimer) {
    if (TimerGetElapsed(checkTimer) > 0.0 && TimerGetRemaining(checkTimer) <= 0.0) {
        return true;
    }
    return false;
}

string libAffx_GetTimeString(int time) {
    int hours = time / 3600;
    int minutes = (time % 3600) / 60;
    int seconds = time % 60;
    string hoursText;
    string minutesText;
    string secondsText;
    if (hours < 10) {
        hoursText = "0" + IntToString(hours);
    } else {
        hoursText = IntToString(hours);
    }
    if (minutes < 10) {
        minutesText = "0" + IntToString(minutes);
    } else {
        minutesText = IntToString(minutes);
    }
    if (seconds < 10) {
        secondsText = "0" + IntToString(seconds);
    } else {
        secondsText = IntToString(seconds);
    }

    return hoursText + ":" + minutesText + ":" + secondsText;
}

// ============================================================
// Pause system
// ============================================================

void libAffx_Pause(bool pause) {
    int i;

    if (libAffx_debug_ignoreMap) {
        return;
    }

    if (pause && !libAffx_gamePaused) {
        libAffx_gamePaused = true;
        // Freeze units and make player uncommandable
        libNtve_gf_MakeUnitUncommandable(libGame_gv_players[libAffx_player].lv_heroUnit, true);
        libStEx_gf_FreezeUnfreezeAllUnits(libStEx_ge_FreezeOptions_Freeze); 
        GameSetGlobalTimeScale(0);
        SetTalentsEnabled(false);

        if (TimerGetRemaining(libGame_gv_openTheGatesTimer) > 0.0) {
            TimerPause(libGame_gv_openTheGatesTimer, true);
        } else if (libAffx_TimerFinished(libGame_gv_openTheGatesTimer)) {
            libGame_paused = true;
            TriggerEnable(libGame_gt_CapturePointLogic, false); // Capture logic for watch towers, mercs, etc.
        }
        
        if (TimerGetRemaining(libGame_gv_scalingTimer) > 0.0) {
            TimerPause(libGame_gv_scalingTimer, true); // Minion stats scaling
        }

        // Mercenary spawn/respawn timers
        for (i = 1; i <= libMapM_gv_jungleNumberOfCreepCamps; i += 1) {
            if (TimerGetRemaining(libMapM_gv_jungleCreepCamps[i].lv_stateCreepBirthTimer) > 0.0) {
                TimerPause(libMapM_gv_jungleCreepCamps[i].lv_stateCreepBirthTimer, true);
            }
            if (TimerGetRemaining(libMapM_gv_jungleCreepCamps[i].lv_stateCreepRespawnTimer) > 0.0) {
                TimerPause(libMapM_gv_jungleCreepCamps[i].lv_stateCreepRespawnTimer, true);
            }
        }
        for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
            // Respawn timers
            if (TimerGetRemaining(libGame_gv_players[i].lv_respawnTimer) > 0.0) {
                TimerPause(libGame_gv_players[i].lv_respawnTimer, true);
            }
            if (libAffx_playersHeroIndex[i] == libCore_gf_GetIndexFromHero("LostVikings")) {
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_erikDeathTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_erikDeathTimer, true);
                }
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_olafDeathTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_olafDeathTimer, true);
                }
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_baleogDeathTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_baleogDeathTimer, true);
                }
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_checkpointReachedCarinRespawnTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_checkpointReachedCarinRespawnTimer, true);
                }
            } else if (libAffx_playersHeroIndex[i] == libCore_gf_GetIndexFromHero("Rexxar")) {
                if (TimerGetRemaining(libGDHL_gv_mishaDeathTimer[i]) > 0.0) {
                    TimerPause(libGDHL_gv_mishaDeathTimer[i], true);
                }
            }
            if (TimerGetRemaining(libGame_gv_players[i].lv_respawnSoundCueTimer) > 0.0) {
                TimerPause(libGame_gv_players[i].lv_respawnSoundCueTimer, true);
            }
            if (TimerGetRemaining(libGame_gv_players[i].lv_multikillTimer) > 0.0) {
                TimerPause(libGame_gv_players[i].lv_multikillTimer, true);
            }
        }
        // Pause map specific logic
        if (libCore_gv_mAPMapStringID == "Volskaya" && libAffx_pauseVLSK != null) {
            TriggerExecute(libAffx_pauseVLSK, false, false);
        } else if (libCore_gv_mAPMapStringID == "CursedHollow") {
            libMapM_gf_PauseUnpauseCurseHollowTimers(true);
        } else if (libCore_gv_mAPMapStringID == "Shrines" && libAffx_pauseMSHE != null) {
            TriggerExecute(libAffx_pauseMSHE, false, false);
        } else if (libCore_gv_mAPMapStringID == "Crypts" && libAffx_pauseMSOC != null) {
            TriggerExecute(libAffx_pauseMSOC, false, false);
        } else if (libCore_gv_mAPMapStringID == "HauntedMines" && libAffx_pauseMHTM != null) {
            TriggerExecute(libAffx_pauseMHTM, false, false);
        } else if (libCore_gv_mAPMapStringID == "TowersOfDoom" && libAffx_pauseMTOD != null) {
            TriggerExecute(libAffx_pauseMTOD, false, false);
        } else if (libCore_gv_mAPMapStringID == "HauntedWoods" && libAffx_pauseGRDN != null) {
            TriggerExecute(libAffx_pauseGRDN, false, false);
        } else if (libCore_gv_mAPMapStringID == "BlackheartsBay" && libAffx_pauseBBAY != null) {
            TriggerExecute(libAffx_pauseBBAY, false, false);
        } else if (libCore_gv_mAPMapStringID == "ControlPoints" && libAffx_pauseMLCP != null) {
            TriggerExecute(libAffx_pauseMLCP, false, false);
        } else if (libCore_gv_mAPMapStringID == "DragonShire") {
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerStartTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerStartTimer, true);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerRespawnTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerRespawnTimer, true);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerWarningTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerWarningTimer, true);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonStatueActiveReminderTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonStatueActiveReminderTimer, true);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerGoalActivationTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerGoalActivationTimer, true);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonKnightLifeTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonKnightLifeTimer, true);
            }
        }
    } else if (!pause && libAffx_gamePaused) {
        if (libAffx_IsAffixSelectionDialogVisible() || libAffx_IsOwnedAffixesDialogVisible() || libAffx_IsOptionsDialogVisible() || libAffx_IsGameoverDialogVisible() || libAffx_IsAchievementsDialogVisible()) {
            return;
        }
        libAffx_gamePaused = false;
        if (!libGame_gv_gameOver) {
            libNtve_gf_MakeUnitUncommandable(libGame_gv_players[libAffx_player].lv_heroUnit, false);
            libStEx_gf_FreezeUnfreezeAllUnits(libStEx_ge_FreezeOptions_Unfrezze);
            GameSetGlobalTimeScale(1);
            SetTalentsEnabled(true);
        }

        if (TimerGetRemaining(libGame_gv_openTheGatesTimer) > 0.0) {
            TimerPause(libGame_gv_openTheGatesTimer, false);
        } else if (libAffx_TimerFinished(libGame_gv_openTheGatesTimer)) {
            libGame_paused = false;
            TriggerEnable(libGame_gt_CapturePointLogic, true); 
        }
        if (TimerGetRemaining(libGame_gv_scalingTimer) > 0.0) {
            TimerPause(libGame_gv_scalingTimer, false);
        }

        for (i = 1; i <= libMapM_gv_jungleNumberOfCreepCamps; i += 1) {
            if (TimerGetRemaining(libMapM_gv_jungleCreepCamps[i].lv_stateCreepBirthTimer) > 0.0) {
                TimerPause(libMapM_gv_jungleCreepCamps[i].lv_stateCreepBirthTimer, false);
            }
            if (TimerGetRemaining(libMapM_gv_jungleCreepCamps[i].lv_stateCreepRespawnTimer) > 0.0) {
                TimerPause(libMapM_gv_jungleCreepCamps[i].lv_stateCreepRespawnTimer, false);
            }
        }

        if (libCore_gv_mAPMapStringID == "Volskaya" && libAffx_pauseVLSK != null) {
            TriggerExecute(libAffx_pauseVLSK, false, false);
        } else if (libCore_gv_mAPMapStringID == "CursedHollow") {
            libMapM_gf_PauseUnpauseCurseHollowTimers(false);
        } else if (libCore_gv_mAPMapStringID == "Shrines" && libAffx_pauseMSHE != null) {
            TriggerExecute(libAffx_pauseMSHE, false, false);
        } else if (libCore_gv_mAPMapStringID == "Crypts" && libAffx_pauseMSOC != null) {
            TriggerExecute(libAffx_pauseMSOC, false, false);
        } else if (libCore_gv_mAPMapStringID == "HauntedMines" && libAffx_pauseMHTM != null) {
            TriggerExecute(libAffx_pauseMHTM, false, false);
        } else if (libCore_gv_mAPMapStringID == "TowersOfDoom" && libAffx_pauseMTOD != null) {
            TriggerExecute(libAffx_pauseMTOD, false, false);
        } else if (libCore_gv_mAPMapStringID == "HauntedWoods" && libAffx_pauseGRDN != null) {
            TriggerExecute(libAffx_pauseGRDN, false, false);
        } else if (libCore_gv_mAPMapStringID == "BlackheartsBay" && libAffx_pauseBBAY != null) {
            TriggerExecute(libAffx_pauseBBAY, false, false);
        } else if (libCore_gv_mAPMapStringID == "ControlPoints" && libAffx_pauseMLCP != null) {
            TriggerExecute(libAffx_pauseMLCP, false, false);
        } else if (libCore_gv_mAPMapStringID == "DragonShire") {
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerStartTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerStartTimer, false);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerRespawnTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerRespawnTimer, false);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerWarningTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerWarningTimer, false);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonStatueActiveReminderTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonStatueActiveReminderTimer, false);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonTowerGoalActivationTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonTowerGoalActivationTimer, false);
            }
            if (TimerGetRemaining(libMapM_gv_mMGardensDragonDragonKnightLifeTimer) > 0.0) {
                TimerPause(libMapM_gv_mMGardensDragonDragonKnightLifeTimer, false);
            }
        }
        for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
            if (TimerGetRemaining(libGame_gv_players[i].lv_respawnTimer) > 0.0) {
                TimerPause(libGame_gv_players[i].lv_respawnTimer, false);
            }
            if (libAffx_playersHeroIndex[i] == libCore_gf_GetIndexFromHero("LostVikings")) {
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_erikDeathTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_erikDeathTimer, false);
                }
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_olafDeathTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_olafDeathTimer, false);
                }
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_baleogDeathTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_baleogDeathTimer, false);
                }
                if (TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[i].lv_checkpointReachedCarinRespawnTimer) > 0.0) {
                    TimerPause(libGDHL_gv_lostVikingsPlayer[i].lv_checkpointReachedCarinRespawnTimer, false);
                }
            } else if (libAffx_playersHeroIndex[i] == libCore_gf_GetIndexFromHero("Rexxar")) {
                if (TimerGetRemaining(libGDHL_gv_mishaDeathTimer[i]) > 0.0) {
                    TimerPause(libGDHL_gv_mishaDeathTimer[i], false);
                }
            }
            if (TimerGetRemaining(libGame_gv_players[i].lv_respawnSoundCueTimer) > 0.0) {
                TimerPause(libGame_gv_players[i].lv_respawnSoundCueTimer, false);
            }
            if (TimerGetRemaining(libGame_gv_players[i].lv_multikillTimer) > 0.0) {
                TimerPause(libGame_gv_players[i].lv_multikillTimer, false);
            }
        }
    }
}

