int libAffx_CreateDialogControlImage(int dialog, string image, int width, int height, int anchor, int offsetX, int offsetY, text tooltip) {
    if (dialog == c_invalidDialogId) { return 0; }
    return libNtve_gf_CreateDialogItemImage(dialog, width, height, anchor, offsetX, offsetY, tooltip, image, c_triggerImageTypeNormal, false, Color(100, 100, 100), c_triggerBlendModeNormal);
}
int libAffx_CreateDialogControlImageWithColor(int dialog, string image, int width, int height, int anchor, int offsetX, int offsetY, text tooltip, color imageColor) {
    if (dialog == c_invalidDialogId) { return 0; }
    return libNtve_gf_CreateDialogItemImage(dialog, width, height, anchor, offsetX, offsetY, tooltip, image, c_triggerImageTypeNormal, false, imageColor, c_triggerBlendModeNormal);
}
int libAffx_CreateDialogControlButton(int dialog) {
    if (dialog == c_invalidDialogId) { return 0; }
    return DialogControlCreateFromTemplate(dialog, c_triggerControlTypeButton, "StandardTemplates/StandardButtonTemplate");
}
int libAffx_CreateDialogControlLabel(int dialog, text label, string style, int width, int height, int anchor, int offsetX, int offsetY, color labelColor, bool writeOut) {
    if (dialog == c_invalidDialogId) { return 0; }
    libNtve_gf_CreateDialogItemLabel(dialog, width, height, anchor, offsetX, offsetY, label, labelColor, writeOut, libAffx_globalTextWriteoutDuration);
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), style, PlayerGroupAll());
    return DialogControlLastCreated();
}
int libAffx_CreateDialogControlCheckbox(int dialog) {
    if (dialog == c_invalidDialogId) { return 0; }
    return DialogControlCreateFromTemplate(dialog, c_triggerControlTypeCheckBox, "StandardTemplates/StandardCheckBoxTemplate");
