// External Library Initialization
void libAffx_InitLibraries () {
    libNtve_InitVariables();
    libCore_InitVariables();
    libGame_InitVariables();
    libMapM_InitVariables();
    libStEx_InitVariables();
    libPBU2_InitLib();
}

void libAffx_DisplayDebugMessage(string printText) {
    if (libAffx_debug_enableDebugLogging) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(printText));
    }
}
void libAffx_DisplayChatMessage(text printText) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, printText);
}

int libAffx_GetAffixId(string affixName) {
    int i;
    for (i = 1; i <= libAffx_registeredAffixes; i += 1) {
        if (libAffx_affixes[i].name == affixName) {
            return i;
        }
    }
    return 0;
}

// ============================================================
// Hero selection
// ============================================================

bool libAffx_HeroSelectionTrigger_Func (bool testConds, bool runActions) {
    int player;
    int choIndex = libCore_gf_GetIndexFromHero("Cho");
    int gallIndex = libCore_gf_GetIndexFromHero("Gall");

    if (!runActions) {
        return true;
    }
    player = 1;
    for (; player <= libCore_gv_bALMaxPlayers; player += 1 ) {
        if (PlayerStatus(player) == c_playerStatusUnused || PlayerType(player) == c_playerTypeHostile) {
            continue;
        }

        if (libGame_gv_players[player].lv_heroIndex == 0) {
            if (player != libAffx_player) {
                if (player == 2 && libGame_gv_players[libAffx_player].lv_heroIndex == choIndex) {
                    libGame_gv_players[player].lv_heroIndex = gallIndex;
                    libAffx_choPlayer = libAffx_player;
                    libAffx_gallPlayer = player;
                } else if (player == 2 && libGame_gv_players[libAffx_player].lv_heroIndex == gallIndex) {
                    libGame_gv_players[player].lv_heroIndex = choIndex;
                    libAffx_gallPlayer = libAffx_player;
                    libAffx_choPlayer = player;
                } else {
                    libGame_gv_players[player].lv_heroIndex = libGame_gf_HeroSelectionRandomlyPickMetaUnusedHero(player);
                    if (libGame_gv_players[player].lv_heroIndex == 0) {
                        libGame_gv_players[player].lv_heroIndex = libGame_gf_HeroSelectionRandomlyPickUnusedHeroWithRole(player, true, true, true, true, true, false);
                    }
                    if (libGame_gv_players[player].lv_heroIndex == 0) {
                        libGame_gv_players[player].lv_heroIndex = libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(player, false, false);
                    }
                    if (libGame_gv_players[player].lv_heroIndex == 0) {
                        libGame_gv_players[player].lv_heroIndex = libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(player, true, false);
                    }
                    if (libGame_gv_players[player].lv_heroIndex == 0) {
                        libGame_gv_players[player].lv_heroIndex = libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(player, true, true);
                    }

                    if (player == 2 && libAffx_debug_player2Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player2Hero);
                    } else if (player == 3 && libAffx_debug_player3Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player3Hero);
                    } else if (player == 4 && libAffx_debug_player4Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player4Hero);
                    } else if (player == 5 && libAffx_debug_player5Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player5Hero);
                    } else if (player == 6 && libAffx_debug_player6Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player6Hero);
                    } else if (player == 7 && libAffx_debug_player7Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player7Hero);
                    } else if (player == 8 && libAffx_debug_player8Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player8Hero);
                    } else if (player == 9 && libAffx_debug_player9Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player9Hero);
                    } else if (player == 10 && libAffx_debug_player10Hero != "") {
                        libGame_gv_players[player].lv_heroIndex = libCore_gf_GetIndexFromHero(libAffx_debug_player10Hero);
                    }
                    libAffx_playersHeroIndex[player] = libGame_gv_players[player].lv_heroIndex;
                    if (player >= 2 && player <= 5) {
                        libAffx_heroCounter[libAffx_teamOrderIndex][libAffx_playersHeroIndex[player]] += 1;
                    } else {
                        libAffx_heroCounter[libAffx_teamChaosIndex][libAffx_playersHeroIndex[player]] += 1;
                    }
                }
            }

            libCore_gf_DataLoadHeroDataIntoIndex(libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex), player);
            if ((PlayerType(player) != c_playerTypeComputer)) {
                libGame_gf_HeroSelectionRandomlyPickSkin(player);
                libGame_gf_HeroSelectionRandomlyPickMount(player);
                PlayerSetSpray(player, "RandomSpray");
            }
        }
    }
    libGame_gv_heroPickDone = true;

    return true;
}
void libAffx_HeroSelectionTrigger_Init () {
    libAffx_HeroSelectionTrigger = TriggerCreate("libAffx_HeroSelectionTrigger_Func");
}

// ============================================================
// Cooldown reduction
// ============================================================

void libAffx_ModifyAllCooldowns (unit targetUnit, fixed cooldownChange, bool includeTrait, bool includeHeroic, bool includeMount) {
    string abilLink;
    string cooldownLink;
    string chargeLink;
    int heroIndex = libCore_gf_GetHeroIndexForUnitType(UnitGetType(targetUnit));
    int player = UnitGetOwner(targetUnit);
    int ability = 1;
    int maxAbilities = libGame_gv_players[heroIndex].lv_heroData.lv_numberOfAbilities;
    
    for (; ability <= maxAbilities; ability += 1) {
        if ((libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_isAffectedByCooldownReduction) ||
            (libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_ability == "AbathurSpawnLocusts")) {
            if ((libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_isHeroic && includeHeroic == false) ||
                (libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_isTrait && includeTrait == false) ||
                ((libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_isMountReplacement || 
                libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_ability == "Mount") && includeTrait == false)) {
                continue;
            }
            abilLink = libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_ability;
            cooldownLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Cooldown.Link", player);
            chargeLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Charge.Link", player);
            if (StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Cooldown.TimeUse", player)) <= 0 &&
                StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Charge.TimeUse", player)) <= 0) {
                continue;
            }
            UnitModifyCooldown(targetUnit, cooldownLink, cooldownChange, c_cooldownOperationAdd);
            if (libGame_gv_players[heroIndex].lv_heroData.lv_abilities[ability].lv_usesCharges) {
                UnitAddChargeRegenRemaining(targetUnit, chargeLink, cooldownChange);
            } else if (chargeLink != "") {
                UnitAddChargeRegenRemaining(targetUnit, chargeLink, cooldownChange);
            }
        }
    }
}

void libAffx_ResetCooldowns(unit playerUnit) {
    int i;
    int ability;
    int heroIndex;
    int player;
    string abilLink;
    string cooldownLink;
    string chargeLink;
    int chargeCount;
    unitgroup unitGroup;
    unit unitVar;
    int unitGroupCount;
    int abilityNumber = libCore_gv_dataHeroesMaxAbilitiesPerHero;

    player = UnitGetOwner(playerUnit);
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; unitGroupCount -= 1) {
        unitVar = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
        if (unitVar == null) { break; }
        libAffx_DisplayDebugMessage(UnitGetType(unitVar));
        cooldownLink = "";
        chargeLink = "";
        heroIndex = libCore_gf_GetHeroIndexForUnitType(UnitGetType(unitVar));
        abilityNumber = UnitAbilityCount(unitVar);
        ability = 1;

        for ( ; ability <= abilityNumber ; ability += 1 ) {
            abilLink = UnitAbilityGet(unitVar, ability);
            if ((libGame_gf_HeroAbilityCooldownCanBeReset(heroIndex, abilLink) == true)) {
                cooldownLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[" + IntToString(0) + "].Cooldown.Link", player);
                libNtve_gf_UnitRemoveCooldown(unitVar, cooldownLink);
                libNtve_gf_PlayerRemoveCooldown(player, cooldownLink);
                chargeLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[" + IntToString(0) + "].Charge.Link", player);
                chargeCount = CatalogFieldValueGetAsInt(c_gameCatalogAbil, abilLink, "Cost[" + IntToString(0) + "].Charge.CountMax", player);
                UnitAddChargeUsed(unitVar, chargeLink, (-1));
                PlayerAddChargeUsed(player, chargeLink, (-1));
            }
        }
    }
}

void libAffx_MuteAllChannelsExcept(playergroup pg, bool mute, int except) {
    int i;

    for (i = 0; i < except; i += 1) {
        SoundChannelMute(pg, i, mute);
    }
    for (i = except + 1; i < 30; i += 1) {
        SoundChannelMute(pg, i, mute);
    }
}

// ============================================================
// Sync boons and curses
// ============================================================

void libAffx_SyncBehaviors(unit sourceUnit, unit targetUnit) {
    int i;
    int player = UnitGetOwner(sourceUnit); 
    int totalBehaviors = UnitBehaviorCountAll(sourceUnit);
    int behaviorStacksSource;
    string behavior;
    int behaviorStacks;
    fixed behaviorDuration;
    string debug_behaviors;

    Wait(0.0625, c_timeGame);
    for (i = 1; i <= libAffx_maxAffixBehaviors; i += 1) {
        behavior = libAffx_affixBehaviors[player][i];
        if (behavior == "") { break; }
        if (!UnitHasBehavior2(sourceUnit, behavior)) {
            libAffx_DisplayDebugMessage("Tried to add behavior " + behavior + " to unit " +
             UnitGetType(targetUnit) + " (player " + IntToString(player) + ") but source did not have the behavior.");
        }
        behaviorStacks = 1;
        behaviorStacksSource = UnitBehaviorCount(sourceUnit, behavior);
        if (behaviorStacksSource > 0) {
            behaviorStacks = behaviorStacksSource;
        }
        behaviorDuration = UnitBehaviorDuration(sourceUnit, behavior);
        UnitModifyCooldown(targetUnit, "Abil/" + behavior, UnitGetCooldown(sourceUnit, "Abil/" + behavior), c_cooldownOperationSet);
        if (UnitHasBehavior2(targetUnit, behavior) && UnitBehaviorCount(targetUnit, behavior) == UnitBehaviorCount(sourceUnit, behavior)) {
            continue;
        }
        libAffx_DisplayDebugMessage("Adding " + IntToString(behaviorStacks) + "x " + behavior + " (" + 
        FixedToString(behaviorDuration, 2) + "s)" + " to unit " + UnitGetType(targetUnit) + " (player " + IntToString(player) + ")");
        UnitBehaviorAdd(targetUnit, behavior, targetUnit, behaviorStacks);
        UnitBehaviorSetDuration(targetUnit, behavior, behaviorDuration);
    }
}

// ============================================================
// D.Va
// ============================================================

bool libAffx_DVaRespawnTrigger_Func (bool testConds, bool runActions) {
    int player = libGame_gf_HeroRespawnPlayer();
    unit respawnUnit = libGame_gf_HeroRespawnUnit();
    if (testConds) {
        if (libAffx_playersHeroIndex[player] != libCore_gf_GetIndexFromHero("DVa")) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_SyncBehaviors(respawnUnit, libAffx_GetPlayerDVaMech(player));
    return true;
}

bool libAffx_DVaCallMechCompletedTrigger_Func (bool testConds, bool runActions) {
    unit dvaPilot = EventUnit();
    int dvaPlayer = UnitGetOwner(dvaPilot);

    if (!runActions) {
        return true;
    }

    libAffx_SyncBehaviors(dvaPilot, libHDVA_gv_dVaCallMechMechBeingSummoned[dvaPlayer]);
    
    return true;
}
bool libAffx_DVaEjectTrigger_Func (bool testConds, bool runActions) {
    unit dvaPilot = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    unit dvaMech = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int dvaPlayer = UnitGetOwner(dvaPilot);
    if (!runActions) {
        return true;
    }
    libAffx_SyncBehaviors(dvaMech, dvaPilot);
    return true;
}
void libAffx_DVaTriggers_Init () {
    libAffx_DVaCallMechCompletedTrigger = TriggerCreate("libAffx_DVaCallMechCompletedTrigger_Func");
    libAffx_DVaRespawnTrigger = TriggerCreate("libAffx_DVaRespawnTrigger_Func");
    libAffx_DVaEjectTrigger = TriggerCreate("libAffx_DVaEjectTrigger_Func");
    TriggerAddEventUnitAbility(libAffx_DVaCallMechCompletedTrigger, null, AbilityCommand("DVaPilotCallMech", 0), c_abilEffectStageFinish, false);
    TriggerAddEventGeneric(libAffx_DVaRespawnTrigger, libGame_gv_eventID_HeroRespawn_C);
    TriggerAddEventPlayerEffectUsed(libAffx_DVaEjectTrigger, c_playerAny, "DVaMechPilotUnloadSet");
}

