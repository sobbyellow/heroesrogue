bool libAffx_InitAffixes_completed = false;

void libAffx_InitAffixes () {
    int i;
    int i2;
    int affixCountLoaded;
    string affixInstance;
    string cooldownLink;
    string heroTooltip;
    string heroTooltipLowerCase;
    string questRetain;
    string questRetainBehavior;
    string questRetainModifier;
    string heroSpecific;
    string heroTags;
    string heroExclusion;
    string mapSpecific;
    string mapExclusion;
    string talentsAdd;
    string talentsDisable;
    string talentsShow;
    string talentsRequired;
    string catalogModification;
    int catalogModificationPlayer;
    int catalogModificationType;
    string catalogModificationOperation;
    string catalogModificationReference;
    string catalogModificationValue;
    string behavior;
    int behaviorPlayer;
    int behaviorAffectedByCount;
    string behaviorName;
    string behaviorTags;
    string triggerAffix;
    string triggerType;
    string triggerName;
    string triggerArg1;
    int excludeChoGall;
    string affixExcluded;
    string affixRequired;

    if (libAffx_InitAffixes_completed) {
        return;
    }
    
    libAffx_InitBlankAffix();

    affixCountLoaded = UserDataInstanceCount("Affix");
    libAffx_DisplayDebugMessage("Total number of registered boons and curses: " + IntToString(affixCountLoaded));
    if (affixCountLoaded > libAffx_maxAffixes) {
        libAffx_DisplayDebugMessage("Registered affix count exceeds the maximum! Limitting to " + IntToString(libAffx_maxAffixes));
        affixCountLoaded = libAffx_maxAffixes;
    }

    for (i = 1; i <= affixCountLoaded; i += 1) {
        affixInstance = UserDataInstance("Affix", i);

        libAffx_affixes[i].count = 0;
        libAffx_affixes[i].name = affixInstance;
        libAffx_affixes[i].rarity = libAffx_GetRarityID(UserDataGetString("Affix", affixInstance, "Rarity", 1));
        libAffx_affixes[i].icon = UserDataGetString("Affix", affixInstance, "Icon", 1);
        libAffx_affixes[i].weight = UserDataGetInt("Affix", affixInstance, "Weight", 1);
        libAffx_affixes[i].minLevel = UserDataGetInt("Affix", affixInstance, "LevelMin", 1);
        libAffx_affixes[i].maxLevel = UserDataGetInt("Affix", affixInstance, "LevelMax", 1);
        libAffx_affixes[i].max = UserDataGetInt("Affix", affixInstance, "Max", 1);
        libAffx_affixes[i].skipCurses = UserDataGetInt("Affix", affixInstance, "SkipCurses", 1);
        libAffx_affixes[i].minDifficulty = UserDataGetInt("Affix", affixInstance, "MinimumDifficulty", 1);
        libAffx_affixes[i].minRound = UserDataGetInt("Affix", affixInstance, "MinimumRound", 1);
        libAffx_affixes[i].alwaysAppendTooltip = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "AlwaysAppendTooltip", 1));
        libAffx_affixes[i].ignoredForStats = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "IgnoredForStats", 1));
        libAffx_affixes[i].quest.isQuest = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "Quest", 1));
        libAffx_affixes[i].quest.questProgressPersists = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "QuestPersists", 1));
        libAffx_affixes[i].enabled = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "Enabled", 1));
        libAffx_affixes[i].curse = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "Curse", 1));
        libAffx_affixes[i].cooldownHidden = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "CooldownHidden", 1));
        libAffx_affixes[i].excludeChoGall = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "ExcludeChoGall", 1));
        libAffx_affixes[i].cannotRoll = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "NoRoll", 1));
        libAffx_affixes[i].requiresMaxStacks = libAffx_IntToBoolean(UserDataGetInt("Affix", affixInstance, "AffixesRequiredMax", 1));

        cooldownLink = UserDataGetString("Affix", affixInstance, "CooldownLink", 1);
        if (cooldownLink != "" && cooldownLink != null) {
            libAffx_affixes[i].cooldownLink = cooldownLink;
        }
        for (i2 = 1; i2 <= libAffx_maxHeroes; i2 += 1) {
            heroTooltip = UserDataGetString("Affix", affixInstance, "HeroTooltip", i2);
            heroTooltipLowerCase = StringCase(heroTooltip, false);
            if (heroTooltip != "" && heroTooltip != null) {
                if (heroTooltipLowerCase == "nomana") {
                    libAffx_affixes[i].customTooltipForNonManaUsers = true;
                } else {
                    if (heroTooltipLowerCase == "chogall" || heroTooltipLowerCase == "cho'gall") {
                        libAffx_affixes[i].customTooltipForHero[libCore_gf_GetIndexFromHero("Cho")] = true;
                        libAffx_affixes[i].customTooltipForHero[libCore_gf_GetIndexFromHero("Gall")] = true;
                    } else {
                        libAffx_affixes[i].customTooltipForHero[libCore_gf_GetIndexFromHero(heroTooltip)] = true;
                    }
                }
            }
        }
        for (i2 = 1; i2 <= libAffx_maxQuests; i2 += 1) {
            questRetain = UserDataGetString("Affix", affixInstance, "QuestRetain", i2);
            if (questRetain != "" && questRetain != null) {
                questRetainBehavior = StringWord(questRetain, 1);
                questRetainModifier = StringWord(questRetain, 2);
                libAffx_affixes[i].questRetain[i2].tokenBehavior = questRetainBehavior;
                libAffx_affixes[i].questRetain[i2].retainModifier = 1;
                if (questRetainModifier != "" && questRetainModifier != null) {
                    libAffx_affixes[i].questRetain[i2].retainModifier = StringToFixed(questRetainModifier);
                }
            }
        }
        heroSpecific = UserDataGetString("Affix", affixInstance, "HeroSpecific", 1);
        heroTags = UserDataGetString("Affix", affixInstance, "HeroTags", 1);
        libAffx_AffixSetHeroAll(i, true);
        if (heroSpecific != "" && heroSpecific != null) {
            libAffx_AffixSetHeroSpecific(i, heroSpecific);
            libAffx_affixes[i].weight *= 2;
        } else {
            if (heroTags != "" && heroTags != null) {
                heroTags = ";" + heroTags + ";";
                if (StringContains(heroTags, ";mana;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAll(i, false);
                    libAffx_AffixSetHeroUsesMana(i, true);
                } else if (StringContains(heroTags, ";!mana;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAll(i, true);
                    libAffx_AffixSetHeroUsesMana(i, false);
                }
                if (StringContains(heroTags, ";melee;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAllMelee(i, true);
                } else if (StringContains(heroTags, ";!melee;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAllMelee(i, false);
                }
                if (StringContains(heroTags, ";ranged;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAllRanged(i, true);
                } else if (StringContains(heroTags, ";!ranged;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAllRanged(i, false);
                }
                if (StringContains(heroTags, ";all;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAll(i, true);
                } else if (StringContains(heroTags, ";!all;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAll(i, false);
                }
                if (StringContains(heroTags, ";starter;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAll(i, false);
                    libAffx_AffixSetHeroStartersOnly(i, true);
                } else if (StringContains(heroTags, ";!starter;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_AffixSetHeroAll(i, true);
                    libAffx_AffixSetHeroStartersOnly(i, false);
                }
            }
            for (i2 = 1; i2 <= libAffx_maxHeroes; i2 += 1) {
                heroExclusion = UserDataGetString("Affix", affixInstance, "HeroesExcluded", i2);
                if (heroExclusion != "" && heroExclusion != null) {
                    libAffx_AffixSetHero(i, heroExclusion, false);
                }
            }
        }
        libAffx_AffixSetMapAll(i, true);
        mapSpecific = UserDataGetString("Affix", affixInstance, "MapSpecific", 1);
        if (mapSpecific != "" && mapSpecific != null) {
            libAffx_AffixSetMapSpecific(i, libAffx_GetMapID(mapSpecific));
        } else {
            for (i2 = 1; i2 <= libAffx_maxMaps; i2 += 1) {
                mapExclusion = UserDataGetString("Affix", affixInstance, "MapsExcluded", i2);
                if (mapExclusion != "" && mapExclusion != null) {
                    libAffx_AffixSetMap(i, libAffx_GetMapID(mapExclusion), false);
                }
            }
        }
        for (i2 = 1; i2 <= libAffx_maxTalents; i2 += 1) {
            talentsAdd = UserDataGetString("Affix", affixInstance, "TalentsAdd", i2);
            talentsDisable = UserDataGetString("Affix", affixInstance, "TalentsDisable", i2);
            talentsShow = UserDataGetString("Affix", affixInstance, "TalentsShow", i2);
            talentsRequired = UserDataGetString("Affix", affixInstance, "TalentsRequired", i2);
            if (talentsAdd != "" && talentsAdd != null) {
                libAffx_affixes[i].addTalents[i2] = talentsAdd;
            }
            if (talentsDisable != "" && talentsDisable != null) {
                libAffx_affixes[i].disableTalents[i2] = talentsDisable;
            }
            if (talentsShow != "" && talentsShow != null) {
                libAffx_affixes[i].showTalents[i2] = talentsShow;
                libAffx_ShowTalent(talentsShow, false);
            }
            if (talentsRequired != "" && talentsRequired != null) {
                libAffx_affixes[i].requiredTalents[i2] = talentsRequired;
                libAffx_affixes[i].requiredTalentsCount += 1;
            }
        }
        for (i2 = 1; i2 <= libAffx_maxCatalogModifications; i2 += 1) {
            catalogModification = UserDataGetString("Affix", affixInstance, "CatalogModification", i2);
            if (catalogModification != "" && catalogModification != null) {
                catalogModificationPlayer = StringToInt(StringWord(catalogModification, 1));
                catalogModificationType = StringToInt(StringWord(catalogModification, 2));
                catalogModificationOperation = StringCase(StringWord(catalogModification, 3), false);
                catalogModificationReference = StringWord(catalogModification, 4);
                catalogModificationValue = StringWord(catalogModification, 5);
                if (catalogModificationOperation != "" && catalogModificationOperation != null && catalogModificationReference != "" && catalogModificationReference != null && catalogModificationValue != "" && catalogModificationValue != null) {
                    libAffx_affixes[i].catalogModifications[i2].player = 0;
                    libAffx_affixes[i].catalogModifications[i2].type = libAffx_catalogTypeFlat;
                    libAffx_affixes[i].catalogModifications[i2].operation = c_upgradeOperationSet;
                    libAffx_affixes[i].catalogModifications[i2].reference = catalogModificationReference;
                    libAffx_affixes[i].catalogModifications[i2].value = StringToFixed(catalogModificationValue);
                    if (catalogModificationPlayer <= 12 && catalogModificationPlayer >= 0) {
                        libAffx_affixes[i].catalogModifications[i2].player = catalogModificationPlayer;
                    }
                    if (catalogModificationType != 0) {
                        libAffx_affixes[i].catalogModifications[i2].type = catalogModificationType;
                    }
                    if (catalogModificationOperation == "add" || catalogModificationOperation == "+") {
                        libAffx_affixes[i].catalogModifications[i2].operation = c_upgradeOperationAdd;
                    } else if (catalogModificationOperation == "subtract" || catalogModificationOperation == "-") {
                        libAffx_affixes[i].catalogModifications[i2].operation = c_upgradeOperationSubtract;
                    } else if (catalogModificationOperation == "multiply" || catalogModificationOperation == "mult" || catalogModificationOperation == "*" || catalogModificationOperation == "x") {
                        libAffx_affixes[i].catalogModifications[i2].operation = c_upgradeOperationMultiply;
                    } else if (catalogModificationOperation == "divide" || catalogModificationOperation == "/") {
                        libAffx_affixes[i].catalogModifications[i2].operation = c_upgradeOperationDivide;
                    }
                }
            }
        }
        for (i2 = 1; i2 <= libAffx_maxBehaviors; i2 += 1) {
            behavior = UserDataGetString("Affix", affixInstance, "Behavior", i2);
            if (behavior != "" && behavior != null) {
                behaviorPlayer = StringToInt(StringWord(behavior, 1));
                behaviorAffectedByCount = StringToInt(StringWord(behavior, 2));
                behaviorName = StringWord(behavior, 3);
                behaviorTags = ";" + StringWord(behavior, 4) + ";";

                libAffx_affixes[i].behaviors[i2].player = 0;
                libAffx_affixes[i].behaviors[i2].behavior = behaviorName;
                libAffx_affixes[i].behaviors[i2].affectedByCount = false;
                if (behaviorPlayer <= 12 && behaviorPlayer >= 0) {
                    libAffx_affixes[i].behaviors[i2].player = behaviorPlayer;
                }
                if (behaviorAffectedByCount >= 1) {
                    libAffx_affixes[i].behaviors[i2].affectedByCount = true;
                }
                if (StringContains(behaviorTags, ";mana;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_affixes[i].behaviors[i2].onlyManaUsers = true;
                } else if (StringContains(behaviorTags, ";!mana;", c_stringAnywhere, c_stringNoCase)) {
                    libAffx_affixes[i].behaviors[i2].disallowManaUsers = true;
                }
            }
            behavior = UserDataGetString("Affix", affixInstance, "RemoveBehavior", i2);
            if (behavior != "" && behavior != null) {
                behaviorPlayer = StringToInt(StringWord(behavior, 1));
                behaviorName = StringWord(behavior, 2);

                libAffx_affixes[i].removeBehaviors[i2].player = 0;
                libAffx_affixes[i].removeBehaviors[i2].behavior = behaviorName;
                if (behaviorPlayer <= 12 && behaviorPlayer >= 0) {
                    libAffx_affixes[i].removeBehaviors[i2].player = behaviorPlayer;
                }
            }
            behavior = UserDataGetString("Affix", affixInstance, "AffixBehavior", i2);
            if (behavior != "" && behavior != null) {
                behaviorPlayer = StringToInt(StringWord(behavior, 1));
                behaviorName = StringWord(behavior, 2);

                libAffx_affixes[i].affixBehaviors[i2].player = 0;
                libAffx_affixes[i].affixBehaviors[i2].behavior = behaviorName;
                if (behaviorPlayer <= 12 && behaviorPlayer >= 0) {
                    libAffx_affixes[i].affixBehaviors[i2].player = behaviorPlayer;
                }
            }
        }
        for (i2 = 1; i2 <= libAffx_maxTriggers; i2 += 1) {
            triggerAffix = UserDataGetString("Affix", affixInstance, "Trigger", i2);
            if (triggerAffix != "" && triggerAffix != null) {
                triggerType = StringCase(StringWord(triggerAffix, 1), false);
                triggerName = StringWord(triggerAffix, 2);
                triggerArg1 = StringWord(triggerAffix, 3);
                if (triggerType != "" && triggerType != null && triggerName != "" && triggerName != null) {
                    libAffx_affixes[i].triggers[i2].type = 0;
                    libAffx_affixes[i].triggers[i2].name = triggerName;
                    libAffx_affixes[i].triggers[i2].arg1 = triggerArg1;
                    if (triggerType == "anyaffixadded" || triggerType == "aaa" || triggerType == "affixaddedany") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerAnyAffixAdded;
                    } else if (triggerType == "affixadded" || triggerType == "aa" || triggerType == "execute" || triggerType == "e") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerAffixAdded;
                    } else if (triggerType == "npctakedown" || triggerType == "nt") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerNPCTakedown;
                    } else if (triggerType == "onetime" || triggerType == "ot" || triggerType == "executeonce" || triggerType == "eo") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerOneTime;
                    } else if (triggerType == "oncepergame" || triggerType == "opg" || triggerType == "executeoncepergame" || triggerType == "eopg") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerOncePerGame;
                    } else if (triggerType == "gamestart" || triggerType == "gs" || triggerType == "immediate" || triggerType == "i" || triggerType == "executeimmediate" || triggerType == "ei") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerGameStart;
                    } else if (triggerType == "herotakedown" || triggerType == "ht") { 
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerHeroTakedown;
                    } else if (triggerType == "unitcreated" || triggerType == "uc") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitCreated;
                    } else if (triggerType == "unitbehaviorchange" || triggerType == "ubc" || triggerType == "behaviorchange" || triggerType == "bc") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitBehaviorChange;
                    } else if (triggerType == "unitbehaviorcreate" || triggerType == "ubcreate" || triggerType == "behaviorcreate" || triggerType == "bcreate") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitBehaviorCreate;
                    } else if (triggerType == "unitbehaviorchangecategory" || triggerType == "ubcc" || triggerType == "behaviorchangecategory" || triggerType == "bcc") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitBehaviorChangeCategory;
                    } else if (triggerType == "effectused" || triggerType == "eu" || triggerType == "playereffectused" || triggerType == "peu") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerPlayerEffectUsed;
                    } else if (triggerType == "levelup" || triggerType == "lu" || triggerType == "herolevelup" || triggerType == "hlu") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerHeroLevelUp;
                    } else if (triggerType == "scaling" || triggerType == "s") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerScaling;
                    } else if (triggerType == "unitdied" || triggerType == "ud") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitDied;
                    } else if (triggerType == "quest" || triggerType == "q") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerQuest;
                    } else if (triggerType == "unitchangeowner" || triggerType == "uco") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitChangeOwner;
                    } else if (triggerType == "periodic" || triggerType == "p") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerPeriodic;
                    } else if (triggerType == "win" || triggerType == "w") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerWin;
                    } else if (triggerType == "herorespawn" || triggerType == "hr" || triggerType == "respawn" || triggerType == "r") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerHeroRespawn;
                    } else if (triggerType == "herokilled" || triggerType == "herokill" || triggerType == "hk") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerHeroKilled;
                    } else if (triggerType == "talentgained" || triggerType == "herotalentgain" || triggerType == "herogaintalent" || triggerType == "herotalent" || triggerType == "hgt" || triggerType == "htg" || triggerType == "tg") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerHeroGainTalent;
                    } else if (triggerType == "unitdamaged") {
                        libAffx_affixes[i].triggers[i2].type = libAffx_triggerUnitDamaged;
                    }
                }
            }
        }
        for (i2 = 1; i2 <= libAffx_maxAffixes; i2 += 1) {
            affixExcluded = UserDataGetUserInstance("Affix", affixInstance, "AffixesExcluded", i2);
            affixRequired = UserDataGetUserInstance("Affix", affixInstance, "AffixesRequired", i2);
            if (affixExcluded != "" && affixExcluded != "[Default]" && affixExcluded != null) {
                libAffx_AffixAddExclusion(i, libAffx_GetAffixId(affixExcluded));
            }
            if (affixRequired != "" && affixRequired != "[Default]" && affixRequired != null) {
                libAffx_AffixAddRequirement(i, libAffx_GetAffixId(affixRequired));
            }
        }
        libAffx_registeredAffixes += 1;
    }
    
    libAffx_InitAffixes_completed = true;
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libAffx_InitLib_completed = false;

void libAffx_InitLib () {
    if (libAffx_InitLib_completed) {
        return;
    }

    libAffx_InitLib_completed = true;

    libAffx_InitLibraries();
    libAffx_InitVariables();
    libAffx_InitAffixes();
    libAffx_InitAchievements();
    libAffx_InitTriggers();
}

include "AffixTriggers"