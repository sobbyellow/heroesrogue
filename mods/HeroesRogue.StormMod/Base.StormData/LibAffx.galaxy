void libAffx_ShowBackdrop(bool show) {
    if (show) {
        libAffx_SetDialogVisible(libAffx_dialogBackdrop, true);
    } else {
        if (!libAffx_IsAffixSelectionDialogVisible() && !libAffx_IsOwnedAffixesDialogVisible() && !libAffx_IsOptionsDialogVisible() && !libAffx_IsGameoverDialogVisible() && !libAffx_IsAchievementsDialogVisible()) {
            libAffx_SetDialogVisible(libAffx_dialogBackdrop, false);
        }
    }
}

void libAffx_SetBackdropDark(bool dark) {
    if (dark) {
        libAffx_SetDialogControlImage(libAffx_dialogControlBackdrop, libAffx_textureBlackoutDark);
    } else {
        libAffx_SetDialogControlImage(libAffx_dialogControlBackdrop, libAffx_textureBlackout);
    }
}

int libAffx_CreateOptionDialogCheckbox(text optionText) {
    libAffx_dialogOptions.optionIndex += 1;
    libAffx_dialogOptions.option[libAffx_dialogOptions.optionIndex].label = libAffx_CreateDialogControlLabel(libAffx_dialogOptions.dialog, optionText, "Affix_DialogLeft", libAffx_optionsCheckboxLabelWidth, libAffx_optionsCheckboxLabelHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
    libAffx_dialogOptions.option[libAffx_dialogOptions.optionIndex].checkbox = libAffx_CreateDialogControlCheckbox(libAffx_dialogOptions.dialog);
    return libAffx_dialogOptions.option[libAffx_dialogOptions.optionIndex].checkbox;
