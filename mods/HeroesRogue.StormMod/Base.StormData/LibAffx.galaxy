int libAffx_GetAchievementId(string achievementName) {
    int i;
    for (i = 1; i <= libAffx_maxAchievements; i += 1) {
        if (libAffx_achievements[i].name == achievementName) {
            return i;
        }
    }
    return 0;
}

void libAffx_ResetAllAchievements() {
    int i;
    libAffx_ResetBankAchievements();
    for (i = 1; i <= libAffx_maxAchievements; i += 1) {
        libAffx_achievements[i].earned = false;
        libAffx_achievements[i].difficulty = 0;
    }
    if (libAffx_IsAchievementsDialogVisible()) {
        libAffx_UpdateAchievementsDialog();
    }
    libAffx_DisplayChatMessage(StringExternal("Message/AchievementsReset"));
}

void libAffx_GrantAchievement(int achievement) {
    if (libAffx_achievements[achievement].difficulty >= libAffx_difficulty) {
        return;
    }
    libAffx_achievements[achievement].earned = true;
    libAffx_achievements[achievement].difficulty = libAffx_difficulty;
    libAffx_achievements[achievement].round = libAffx_currentRun;
    TextExpressionSetToken("Param/Expression/AchievementEarned", "A", StringExternal("Achievement/Name/" + libAffx_achievements[achievement].name));
    TextExpressionSetToken("Param/Expression/AchievementEarned", "B", StringToText(libAffx_GetDifficultyLabel(libAffx_achievements[achievement].difficulty)));
    libAffx_DisplayChatMessage(TextExpressionAssemble("Param/Expression/AchievementEarned"));
    libAffx_SaveBankAchievements();
}

void libAffx_UpdateAchievementRoundNumber(int achievement) {
    libAffx_achievements[achievement].round = libAffx_currentRun;
    libAffx_SaveBankAchievements();
}

void libAffx_EvaluateAchievement(int achievement) {
    if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinOnHero && libAffx_achievements[achievement].hero == libAffx_playersHeroIndex[libAffx_player]) {
        if (libGame_winningTeam == libAffx_teamOrderIndex && libAffx_currentRun == libAffx_winningRound) {
            libAffx_GrantAchievement(achievement);
        }
        if (libAffx_achievements[achievement].round < libAffx_currentRun) {
            libAffx_UpdateAchievementRoundNumber(achievement);
        }
    } else if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinNoDeaths && libGame_winningTeam == libAffx_teamOrderIndex &&
        libAffx_currentRun == libAffx_winningRound && (libAffx_BankGetStats("Deaths") + FixedToInt(libGame_gv_scoreValues[libAffx_player].lv_deaths) <= 0)) {
        libAffx_GrantAchievement(achievement);
    } else if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinNoObjLost && libGame_winningTeam == libAffx_teamOrderIndex &&
        libAffx_currentRun == libAffx_winningRound && (libAffx_BankGetStats("ObjectivesLost") + libAffx_objectivesLostThisGame) <= 0) {
        libAffx_GrantAchievement(achievement);
    } else if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinNoRerolls && libGame_winningTeam == libAffx_teamOrderIndex &&
        libAffx_currentRun == libAffx_winningRound && (libAffx_BankGetStats("RerollsUsed") + libAffx_rerollsUsed + libAffx_BankGetStats("RerollsCurseUsed") + libAffx_rerollsCurseUsed) <= 0) {
        libAffx_GrantAchievement(achievement);
    } else if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinNoBans && libGame_winningTeam == libAffx_teamOrderIndex &&
        libAffx_currentRun == libAffx_winningRound && (libAffx_BankGetStats("BansUsed") + libAffx_bansUsed) <= 0) {
        libAffx_GrantAchievement(achievement);
    } else if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinTimer && libGame_winningTeam == libAffx_teamOrderIndex &&
        libAffx_currentRun == libAffx_winningRound && (libAffx_BankGetStats("GameTime") + FixedToInt(TimerGetElapsed(libGame_gv_gameTimer))) <= libAffx_achievements[achievement].timeRequired) {
        libAffx_GrantAchievement(achievement);
    } else if (libAffx_achievements[achievement].type == libAffx_achievementTypeWinRound && libGame_winningTeam == libAffx_teamOrderIndex &&
        libAffx_currentRun >= libAffx_achievements[achievement].roundRequired) {
        libAffx_GrantAchievement(achievement);
    }
}

void libAffx_EvaluateAllAchievements() {
    int i;
    for (i = 1; i <= libAffx_maxAchievements; i += 1) {
        libAffx_EvaluateAchievement(i);
    }
}
int libAffx_LastRegisteredAchievement() {
    return libAffx_lastRegisteredAchievement;
}

int libAffix_RegisterAchievement(string name, int achievementType) {
    if (libAffx_achievementsIndex >= libAffx_maxAchievements) {
        return 0;
    }
    libAffx_achievementsIndex += 1;
    libAffx_achievements[libAffx_achievementsIndex].name = name;
    libAffx_achievements[libAffx_achievementsIndex].type = achievementType;
    libAffx_achievements[libAffx_achievementsIndex].icon = "Assets/Textures/Achievements/" + name + ".dds";
    libAffx_lastRegisteredAchievement = libAffx_achievementsIndex;
    return libAffx_achievementsIndex;
}

void libAffx_InitAchievements() {
    int i;
    int achievement;
    for (i = 1; i <= 90; i += 1) {
        libAffix_RegisterAchievement(libAffx_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(i) + ",HyperlinkId"), libAffx_achievementTypeWinOnHero);
        libAffx_achievements[libAffx_LastRegisteredAchievement()].hero = i;
    }
    libAffix_RegisterAchievement("Deathless", libAffx_achievementTypeWinNoDeaths);
    libAffix_RegisterAchievement("Objective", libAffx_achievementTypeWinNoObjLost);
    libAffix_RegisterAchievement("NoRerolls", libAffx_achievementTypeWinNoRerolls);
    libAffix_RegisterAchievement("NoBans", libAffx_achievementTypeWinNoBans);
    libAffix_RegisterAchievement("Speedrun1", libAffx_achievementTypeWinTimer);
    libAffx_achievements[libAffx_LastRegisteredAchievement()].timeRequired = 3600;
    libAffix_RegisterAchievement("Speedrun2", libAffx_achievementTypeWinTimer);
    libAffx_achievements[libAffx_LastRegisteredAchievement()].timeRequired = 7200;
    libAffix_RegisterAchievement("Round30", libAffx_achievementTypeWinRound);
    libAffx_achievements[libAffx_LastRegisteredAchievement()].roundRequired = 30;
    libAffix_RegisterAchievement("Round40", libAffx_achievementTypeWinRound);
    libAffx_achievements[libAffx_LastRegisteredAchievement()].roundRequired = 40;
}

void libAffx_InitBlankAffix() {
    int i;
    libAffx_affixes[0].name = "AffixNone";
    libAffx_affixes[0].rarity = 0;
    libAffx_affixes[0].icon = "Assets/Textures/affix_icon_question_mark.dds";
    libAffx_affixes[0].weight = 0;
    libAffx_affixes[0].minLevel = 0;
    libAffx_affixes[0].maxLevel = 0;
    libAffx_affixes[0].curse = false;
    libAffx_affixes[0].enabled = true;
    libAffx_affixes[0].count = 0;
    libAffx_affixes[0].max = 0;
    for (i = 1; i <= libAffx_maxHeroes; i += 1) {
        libAffx_affixes[0].allowedHero[i] = true;
    }
    for (i = 1; i <= libAffx_maxMaps; i += 1) {
        libAffx_affixes[0].allowedHero[i] = true;
    }
}

void libAffx_AffixAddExclusion(int affix, int excludeAffix) {
    if (libAffx_affixes[affix].excludedCount >= libAffx_maxRequirements) {
        libAffx_DisplayDebugMessage("Reached maximum exclusion requirements for affix " + libAffx_affixes[affix].name);
        return;
    }
    libAffx_affixes[affix].excludedCount += 1;
    libAffx_affixes[affix].excludedAffixes[libAffx_affixes[affix].excludedCount] = excludeAffix;
}
void libAffx_AffixAddRequirement(int affix, int requireAffix) {
    if (libAffx_affixes[affix].requiredCount >= libAffx_maxRequirements) {
        libAffx_DisplayDebugMessage("Reached maximum requirements for affix " + libAffx_affixes[affix].name);
        return;
    }
    libAffx_affixes[affix].requiredCount += 1;
    libAffx_affixes[affix].requiredAffixes[libAffx_affixes[affix].requiredCount] = requireAffix;
}
void libAffx_AffixSetInfinite(int affix, bool infinite) {
    if (infinite) {
        libAffx_affixes[affix].max = 0;
        libAffx_affixes[affix].weight = 10;
    } else {
        libAffx_affixes[affix].max = 1;
    }
}
void libAffx_AffixSetMax(int affix, int maxCount) {
    libAffx_affixes[affix].max = maxCount;
}
void libAffx_AffixSetLevel(int affix, int minLevel, int maxLevel) {
    libAffx_affixes[affix].minLevel = minLevel;
    libAffx_affixes[affix].maxLevel = maxLevel;
}
void libAffx_AffixSetHero(int affix, string hero, bool allowed) {
    int index = libCore_gf_GetIndexFromHero(hero);
    if (index > libAffx_maxHeroes || index <= 0) {
        return;
    }
    libAffx_affixes[affix].allowedHero[index] = allowed;
}

