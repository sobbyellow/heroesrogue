bool libAffx_ExplosiveEnd (bool testConds, bool runActions) {
    int i;
    if (!runActions) {
        return true;
    }
    for (i = 6; i <= 10; i += 1) {
        libAffx_CatalogFieldValueSetFixed(c_gameCatalogEffect, "JunkratTotalMayhemDamage", "Amount", i, StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "JunkratTotalMayhemDamage", "Amount", 0)) * Pow(1.04, UnitLevel(libGame_gv_players[i].lv_heroUnit)));
    }

    return true;
}
bool libAffx_ExplosiveEndScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player < 6) {
            return false;
        }
        if (player > 10) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_SetDefaultLevelScaling("Effect,JunkratTotalMayhemDamage,Amount", player);

    return true;
}
