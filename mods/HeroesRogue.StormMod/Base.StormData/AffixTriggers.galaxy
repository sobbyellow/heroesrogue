bool libAffx_DivineInterventionAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_DivineInterventionIndex = libAffx_EventAffix();
    libAffx_DivineInterventionCooldownCurrent = libAffx_DivineInterventionCooldown - (libAffx_DivineInterventionCDRPerStack * (libAffx_EventAffixCount() - 1));
    return true;
