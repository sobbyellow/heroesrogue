// ---------------------------------------------------------------
bool libAffx_RarityBoostExecuteOnce (bool testConds, bool runActions) {
    fixed modifier = 4;
    if (!runActions) {
        return true;
    }
    libAffx_commonToRare *= modifier;
    libAffx_commonToEpic *= modifier;
    libAffx_commonToLegendary *= modifier;
    libAffx_uncommonToRare *= modifier;
    libAffx_uncommonToEpic *= modifier;
    libAffx_uncommonToLegendary *= modifier;
    libAffx_rareToEpic *= modifier;
    libAffx_rareToLegendary *= modifier;
    libAffx_epicToLegendary *= modifier;
    return true;
}
