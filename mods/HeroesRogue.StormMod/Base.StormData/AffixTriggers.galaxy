void libAffx_FortificationsCreateTower(string unitName, point location, fixed rotation) {
    if (libAffx_FortificationsIndexID >= libAffx_FortificationsMax) {
        return;
    }
    libAffx_FortificationsIndexID += 1;
    if (libAffx_FortificationsSpawned[libAffx_FortificationsIndexID] == false) {
        libAffx_FortificationsSpawned[libAffx_FortificationsIndexID] = true;
        UnitCreate(1, unitName, c_unitCreateIgnorePlacement, libAffx_teamChaos, location, rotation, null);
        UnitBehaviorAdd(UnitLastCreated(), "AffixFortificationsTowerReveal", UnitLastCreated(), 1);
        ActorSend(libNtve_gf_MainActorofUnit(UnitLastCreated()), "Signal PlayBuild");
        libAffx_FortificationsTotal += 1;
    }
}
