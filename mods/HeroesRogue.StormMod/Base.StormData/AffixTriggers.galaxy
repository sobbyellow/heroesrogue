    if (testConds) {
        if (libAffx_SecondWindIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_affixes[libAffx_SecondWindIndex].cooldown = libAffx_SecondWindCooldownCurrent;

    return true;
}
