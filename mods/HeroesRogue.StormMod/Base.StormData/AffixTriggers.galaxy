// ============================================================
// Weak Point
// ============================================================

int libAffx_GetWeakPointHeroIndex(unit hero) {
    if (UnitGetType(hero) == "HeroErik" || UnitGetType(hero) == "HeroChenEarth") {
        return 3;
    } else if (UnitGetType(hero) == "HeroBaleog" || UnitGetType(hero) == "RexxarMisha" || UnitGetType(hero) == "HeroChenFire" || UnitGetType(hero) == "HeroDVaMech") {
        return 2;
    } else {
        return 1;
    }
}

bool libAffx_WeakPointUnitDamaged (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    unit damagingUnit = EventUnitDamageSourceUnit();
    fixed damageValue = EventUnitDamageAmount();
    int player = UnitGetOwner(eventUnit);
    int i;
    int index = libAffx_GetWeakPointHeroIndex(eventUnit);
    if (testConds) {
        if (!UnitHasBehavior2(eventUnit, "AffixWeakPointController")) {
            return false;
        }
        if (damagingUnit == eventUnit) {
            return false;
        }
        if (damageValue <= 0) {
            return false;
        }
        if (UnitTestState(eventUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    for (i = 1; i <= libAffx_WeakPointDuration; i += 1) {
        libAffx_WeakPointDamageStored[player][index][i] = MinF(libAffx_WeakPointDamageStored[player][index][i] + damageValue / 4, 500000);
    }

    return true;
}
bool libAffx_HasAnyWeakPointDamage(int player, int heroIndex) {
    int i;
    for (i = 1; i <= libAffx_WeakPointDuration; i += 1) {
        if (libAffx_WeakPointDamageStored[player][heroIndex][i] > 0) {
            return true;
        }
    }
    return false;
}

bool libAffx_WeakPointUnitBehaviorChange (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    int player = UnitGetOwner(heroUnit);
    int index = 1;
    int heroIndex = libAffx_GetWeakPointHeroIndex(heroUnit);
    if (!runActions) {
        return true;
    }
    while (UnitHasBehavior2(heroUnit, "AffixWeakPointController")) {
        while (UnitHasBehaviorWithCategoryFlag(heroUnit, c_behaviorCategoryTimeStop) || libAffx_gamePaused || !libAffx_HasAnyWeakPointDamage(player, heroIndex)) {
            Wait(0.0625, c_timeGame);
        }
        libAffx_Wait(1, c_timeGame);
        UnitDamage(heroUnit, "AffixWeakPointDamage", heroUnit, libAffx_WeakPointDamageStored[player][heroIndex][index]);
        libAffx_WeakPointDamageStored[player][heroIndex][index] = 0;
        index += 1;
        if (index > libAffx_WeakPointDuration) {
            index = 1;
        }
    }
    return true;
}

// ============================================================
// Invasion
// ============================================================

bool libAffx_InvasionAffixAdded (bool testConds, bool runActions) {
    int level = UnitLevel(libAffx_GetPlayerHeroUnit(libAffx_enemy));
    libAffx_InvasionIndex = libAffx_EventAffix();
    
    libCore_minionWaveInterval[libGame_gv_teamChaosIndex_C] = libCore_gv_bALMinionWaveInterval / (1 + (0.25 + (0.75 * (MinI(level, 20) - 1) / 19)));
    libAffx_InvasionSpawnRateDisplay = (libCore_gv_bALMinionWaveInterval / libCore_minionWaveInterval[libGame_gv_teamChaosIndex_C]) - 1;
    libGame_xpModifierMinion[libGame_gv_teamOrderIndex_C] = -0.2 + (-0.3 * (MinI(level, 20) - 1) / 19);
    libAffx_InvasionExpDisplay = -libGame_xpModifierMinion[libGame_gv_teamOrderIndex_C];
    libAffx_AddUnitBehaviorCriteriaAll("AffixInvasionBehavior", 1, libAffx_filterEnemyMinions);
    return true;
}
bool libAffx_InvasionUnitCreated (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    if (!runActions) {
        return true;
    }
    libAffx_AddUnitBehaviorCriteria(eventUnit, "AffixInvasionBehavior", 1, libAffx_filterEnemyMinions);
    return true;
}
bool libAffx_InvasionUnitChangeOwner (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    if (!runActions) {
        return true;
    }
    libAffx_UpdateUnitBehaviorCriteria(eventUnit, "AffixInvasionBehavior", 1, libAffx_filterEnemyMinions);
    return true;
}
bool libAffx_InvasionLevelUp (bool testConds, bool runActions) {
    int level = libGame_gf_HeroLevelUpLevel();
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_enemy) {
            return false;
        }
    }
    libCore_minionWaveInterval[libGame_gv_teamChaosIndex_C] = libCore_gv_bALMinionWaveInterval / (1 + (0.25 + (0.75 * (MinI(level, 20) - 1) / 19)));
    libAffx_InvasionSpawnRateDisplay = (libCore_gv_bALMinionWaveInterval / libCore_minionWaveInterval[libGame_gv_teamChaosIndex_C]) - 1;
    libGame_xpModifierMinion[libGame_gv_teamOrderIndex_C] = -0.2 + (-0.3 * (MinI(level, 20) - 1) / 19);
    libAffx_InvasionExpDisplay = -libGame_xpModifierMinion[libGame_gv_teamOrderIndex_C];
    if (level >= 20 && !libAffx_InvasionActive) {
        libAffx_InvasionActive = true;
    }
    return true;
}
bool libAffx_InvasionPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_InvasionIndex == 0) {
            return false;
        }
        if (libAffx_gamePaused) {
            return false;
        }
        if (!libAffx_InvasionActive) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    if (libAffx_affixes[libAffx_InvasionIndex].cooldown <= 0) {
        libAffx_InvasionCount += 1;
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.HealDealtAdditiveMultiplier[Life]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.HealDealtAdditiveMultiplier[Shields]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.DamageDealtFraction[Ability]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.DamageDealtFraction[Basic]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalMaxFractionArray[Life]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalMaxFractionArray[Energy]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalRegenMultiplier[Life]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalRegenMultiplier[Energy]", FixedToString(libAffx_InvasionStatsModifier * libAffx_InvasionCount, 2));
        libAffx_affixes[libAffx_InvasionIndex].cooldown = 60;
    } else {
        libAffx_affixes[libAffx_InvasionIndex].cooldown -= 0.0625;
    }

    return true;
}

// ============================================================
// Unyielding Defense
// ============================================================

void libAffx_ScaleUnyieldingDefense(unit unitVar, string behavior, fixed health) {
    int player = UnitGetOwner(unitVar);
    libAffx_CatalogReferenceModify("Behavior," + behavior + ",DamageResponse.ClampMaximum", player, FixedToString(health * libAffx_UnyieldingDefenseModifier, 2), c_upgradeOperationSet);
}
void libAffx_AddUnyieldingDefense(unit unitVar) {
    string unitType = UnitGetType(unitVar);
    if (UnitTypeTestFlag(unitType, c_unitFlagTownStructureWall)) {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorWall", unitVar, 1);
    } else if (UnitTypeTestFlag(unitType, c_unitFlagTownStructureGate)) {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorGate", unitVar, 1);
    } else if (UnitTypeTestFlag(unitType, c_unitFlagTownStructureCore)) {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorCore", unitVar, 1);
    } else if (unitType == "TownTownHallL2") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorFort", unitVar, 1);
    } else if (unitType == "TownTownHallL3") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorKeep", unitVar, 1);
    } else if (unitType == "TownCannonTowerL2") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorFortTower", unitVar, 1);
    } else if (unitType == "TownCannonTowerL3") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorKeepTower", unitVar, 1);
    }
}
bool libAffx_UnyieldingDefenseUnitCreated (bool testConds, bool runActions) {
    if (UnitGetOwner(EventUnitCreatedUnit()) == libAffx_teamOrder) {
        libAffx_AddUnyieldingDefense(EventUnitCreatedUnit());
    }
    return true;
}
bool libAffx_UnyieldingDefenseAffixAdded (bool testConds, bool runActions) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, libAffx_teamOrder, RegionEntireMap(), libAffx_filterAlliedStructures.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        libAffx_AddUnyieldingDefense(unitVar);
    }
    return true;
}
bool libAffx_UnyieldingDefenseUnitDied (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    if (testConds) {        
        if (player != libAffx_teamOrder) {
            return false;
        }
        if (UnitGetType(eventUnit) != "TownTownHallL2" && UnitGetType(eventUnit) != "TownTownHallL3") {
            return false;
        }
    }
    libAffx_Wait(0.0625, c_timeGame); // Wait for fallback towers to die before applying protected
    libAffx_AddUnitBehaviorCriteriaAll("AffixUnyieldingDefenseProtected", 1, libAffx_filterAlliedStructures);
    return true;
}
bool libAffx_UnyieldingDefenseUnitBehaviorChange1 (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    fixed lastMaxHealth;
    while (UnitHasBehavior2(eventUnit, "AffixUnyieldingDefenseBehaviorCore")) {
        while (libAffx_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        if (lastMaxHealth != UnitGetPropertyFixed(eventUnit, c_unitPropLifeMax, true)) {
            lastMaxHealth = UnitGetPropertyFixed(eventUnit, c_unitPropLifeMax, true);
            libAffx_ScaleUnyieldingDefense(eventUnit, "AffixUnyieldingDefenseBehaviorCore", lastMaxHealth);
        }
        libAffx_Wait(0.0625, c_timeGame);
    }
    return true;
}
