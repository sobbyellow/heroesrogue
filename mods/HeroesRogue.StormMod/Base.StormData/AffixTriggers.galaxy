    if (!runActions) {
        return true;
    }
    libAffx_AutoMULEIndex = libAffx_EventAffix();
    libAffx_AutoMULECooldownCurrent = libAffx_AutoMULECooldown - (libAffx_AutoMULECDRPerStack * (libAffx_EventAffixCount() - 1));

    return true;
