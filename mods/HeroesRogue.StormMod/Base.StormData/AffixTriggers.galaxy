bool libAffx_DivineInterventionEffectUsed (bool testConds, bool runActions) {
    unit target = EventPlayerEffectUsedUnit(c_effectUnitSource);
    if (testConds) {
        if (libAffx_DivineInterventionIndex == 0) {
            return false;
        }
        if (libAffx_affixes[libAffx_DivineInterventionIndex].cooldown > 0) {
            return false;
        }
        if (UnitTestState(target, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    UnitCreateEffectUnit(target, "MonkDivinePalmInitialSet", target);
    libAffx_affixes[libAffx_DivineInterventionIndex].cooldown = libAffx_DivineInterventionCooldownCurrent;
    return true;
}
bool libAffx_DivineInterventionPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_DivineInterventionIndex == 0) {
            return false;
        }
        if (libAffx_gamePaused || libGame_gv_gameOver) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (libAffx_affixes[libAffx_DivineInterventionIndex].cooldown > 0) {
        libAffx_affixes[libAffx_DivineInterventionIndex].cooldown -= 0.0625;
    }
    return true;
}
bool libAffx_DivineInterventionScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player < 6) {
