// ---------------------------------------------------------------
// Path of the Assassin
// ---------------------------------------------------------------
void libAffx_PathoftheAssassinInit() {
    string hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[libAffx_player]);

    if (hero == "Tracer") {
        libAffx_PathoftheAssassinInitialValue = libAffx_PathoftheAssassinInitialValueTracer;
        libAffx_PathoftheAssassinStackingValue = libAffx_PathoftheAssassinStackingValueTracer;
    } else if (hero == "DVa" || hero == "Tassadar" || hero == "Tychus" || hero == "Zarya" || hero == "Lucio" || hero == "Genji") {
        libAffx_PathoftheAssassinInitialValue = libAffx_PathoftheAssassinInitialValueFastAA;
        libAffx_PathoftheAssassinStackingValue = libAffx_PathoftheAssassinStackingValueFastAA;
    }
}
bool libAffx_PathoftheAssassinExecuteImmediate (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_PathoftheAssassinInit();
    return true;
}
bool libAffx_PathoftheAssassinAffixAdded (bool testConds, bool runActions) {
    int level;
    if (!runActions) {
        return true;
    }
    libAffx_PathoftheAssassinIndex = libAffx_EventAffix();
    level = UnitLevel(libGame_gv_players[libAffx_player].lv_heroUnit);
    libAffx_PathoftheAssassinInit();
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheAssassinBehavior", "Modification.DamageDealtScaled[Basic]", libAffx_player, (libAffx_PathoftheAssassinInitialValue + libAffx_PathoftheAssassinStackingValue * (libAffx_affixes[libAffx_PathoftheAssassinIndex].count - 1)) * level);
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheAssassinSpell", "Modification.DamageDealtScaled[Ability]", libAffx_player, (libAffx_PathoftheAssassinInitialValue + libAffx_PathoftheAssassinStackingValue * (libAffx_affixes[libAffx_PathoftheAssassinIndex].count - 1)) * level);
    
    return true;
}
bool libAffx_PathoftheAssassinLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player && !UnitHasBehavior2(libGame_gv_players[player].lv_heroUnit, "AffixPathoftheAssassinBehavior")) {
            return false;
        }
        if (libAffx_PathoftheAssassinIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheAssassinBehavior", "Modification.DamageDealtScaled[Basic]", player, (libAffx_PathoftheAssassinInitialValue + libAffx_PathoftheAssassinStackingValue * (libAffx_affixes[libAffx_PathoftheAssassinIndex].count - 1)) * level);
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheAssassinSpell", "Modification.DamageDealtScaled[Ability]", player, (libAffx_PathoftheAssassinInitialValue + libAffx_PathoftheAssassinStackingValue * (libAffx_affixes[libAffx_PathoftheAssassinIndex].count - 1)) * level);
    return true;
}

// ---------------------------------------------------------------
// Army of BUDDYs
// ---------------------------------------------------------------
bool libAffx_ArmyofBUDDYsOncePerGame (bool testConds, bool runActions) {
    int i;
    if (!runActions) {
        return true;
    }
    for (i = 2; i <= 5; i += 1) {
        libAffx_AddPlayerBehaviorWithExclusion(i, "AffixBuddyDroneSpawnBehavior", 1, true, "HeroDVaMech");
        if (i == libAffx_choPlayer || i == libAffx_gallPlayer) {
            libAffx_BuddyCount[i] += 1;
        }
    }
    for (i = 1; i <= 5; i += 1) {
        libAffx_SetLevelScalingAndValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", i, 0.04, StringToFixed(libAffx_GetCatalogDefaultValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate")) * 0.75);
        libAffx_SetLevelScalingAndValue("Effect,AffixBuddyDroneMissileDamage,Amount", i, 0.04, StringToFixed(libAffx_GetCatalogDefaultValue("Effect,AffixBuddyDroneMissileDamage,Amount")) * 0.75);
    }
    return true;
}
bool libAffx_ArmyofBUDDYsAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_ArmyofBUDDYsIndex = libAffx_EventAffix();
    libAffx_BuddyCount[libAffx_player] += libAffx_EventAffixCountAdded();
    libAffx_BuddyCountPlayer1 = libAffx_BuddyCount[libAffx_player];
    return true;
}
bool libAffx_ArmyofBUDDYsLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player < 1 || player > 5) {
            return false;
        }
        if (player == libAffx_choPlayer || player == libAffx_gallPlayer) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_SetLevelScalingAndValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", player, 0.04, StringToFixed(libAffx_GetCatalogDefaultValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate")) * 0.75);
    libAffx_SetLevelScalingAndValue("Effect,AffixBuddyDroneMissileDamage,Amount", player, 0.04, StringToFixed(libAffx_GetCatalogDefaultValue("Effect,AffixBuddyDroneMissileDamage,Amount")) * 0.75);
    return true;
}
