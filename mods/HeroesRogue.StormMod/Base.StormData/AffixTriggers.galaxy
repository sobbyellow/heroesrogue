bool libAffx_AutoMULEPeriodic (bool testConds, bool runActions) {
    unitgroup unitGroup;
    unitgroup structures;
    int i;
    unit unitVar;
    if (testConds) {
        if (libAffx_gamePaused) {
            return false;
        }
        if (libAffx_AutoMULEIndex == 0) {
            return false;
        }
        if (!libAffx_GateIsOpen()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    if (libAffx_affixes[libAffx_AutoMULEIndex].cooldown <= 0) {
        unitGroup = UnitGroup(null, libAffx_teamOrder, RegionEntireMap(), libCore_gv_filtersStructure, 0);
        i = UnitGroupCount(unitGroup, c_unitCountAll);
        structures = UnitGroupEmpty();
        for (;; i -= 1) {
            unitVar = UnitGroupUnitFromEnd(unitGroup, i);
            if (unitVar == null) { break; }
            if (UnitGetType(unitVar) == "TownCannonTowerL2" || UnitGetType(unitVar) == "TownCannonTowerL3" || UnitGetType(unitVar) == "TownCannonTowerL2Standalone" || UnitGetType(unitVar) == "TownCannonTowerL3Standalone" || UnitGetType(unitVar) == "TownTownHallL2" || UnitGetType(unitVar) == "TownTownHallL3" || ( UnitGetType(unitVar) == "KingsCore" && libAffx_currentMap != libAffx_mapTowersofDoom) ) {
                if (UnitGetPropertyFixed(unitVar, c_unitPropLife, true) < UnitGetPropertyFixed(unitVar, c_unitPropLifeMax, true)) {
                    UnitGroupAdd(structures, unitVar);
                }
            }
        }
        if (UnitGroupCount(structures, c_unitCountAlive) > 0) {
            PlayerCreateEffectPoint(libAffx_teamOrder, "CalldownMULEDummySet", UnitGetPosition(UnitGroupRandomUnit(structures, c_unitCountAlive)));
            libAffx_affixes[libAffx_AutoMULEIndex].cooldown = libAffx_AutoMULECooldownCurrent;
        }
        libAffx_Wait(1, c_timeGame);
    } else {
        libAffx_affixes[libAffx_AutoMULEIndex].cooldown -= 0.0625;
    }

    return true;
}
