    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheWizardBehavior", "Modification.VitalMaxArray[Energy]", libAffx_player, 10 * libAffx_affixes[libAffx_PathoftheWizardIndex].count * level);
