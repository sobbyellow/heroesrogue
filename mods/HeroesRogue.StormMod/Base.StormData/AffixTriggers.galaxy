// ---------------------------------------------------------------
// Chrono Boost
// ---------------------------------------------------------------
bool libAffx_ChronoBoostAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_CopyFilter(libAffx_filterAllEnemies, libAffx_filterChronoBoost);
    libAffx_AddExcludedUnitTypeFilter(libAffx_filterChronoBoost, "ArtanisSpearofAdunPurifierBeamInvisibleTrackingUnit");

    libAffx_ChronoBoostIndex = libAffx_EventAffix();
    libAffx_ChronoBoostCDRModifierCurrent = libAffx_ChronoBoostCDRModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_ChronoBoostBehaviorChange (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    if (testConds) {
        if (libAffx_ChronoBoostIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    while ((UnitHasBehavior2(eventUnit, "AffixChronoBoostBehavior") == true)) {
        while ((UnitHasBehaviorWithCategoryFlag(eventUnit, c_behaviorCategoryTimeStop) == true) || libAffx_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libAffx_ModifyAllCooldowns(eventUnit, -(libAffx_ChronoBoostCDRModifierCurrent) / 16, true, true, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}
bool libAffx_ChronoBoostUnitCreated (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_AddUnitBehaviorCriteria(EventUnitCreatedUnit(), "AffixChronoBoostBehavior", 1, libAffx_filterChronoBoost);
    return true;
}
