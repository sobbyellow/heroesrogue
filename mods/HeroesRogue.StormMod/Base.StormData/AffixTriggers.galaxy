// ---------------------------------------------------------------
// Prepared
// ---------------------------------------------------------------
bool libAffx_PreparedOncePerGame (bool testConds, bool runActions) {
    int i;
    unitgroup heroGroup;
    int groupCount;
    unit heroUnit;
    if (!runActions) {
        return true;
    }
    for (i = 6; i <= 10; i += 1) {
        heroGroup = libGame_gv_players[i].lv_heroUnitGroup;
        groupCount = UnitGroupCount(heroGroup, c_unitCountAll);
        for (;; groupCount -= 1) {
            if (groupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(heroGroup, groupCount);
            if (heroUnit == null) { continue; }
            UnitBehaviorAdd(heroUnit, "PreparedShieldBehavior", heroUnit, 1);
        }
    }
    return true;
}
// ---------------------------------------------------------------
// Slivan
// ---------------------------------------------------------------
int slivanIndex;
bool slivanSuppressRewards;
bool[3] slivanSpawned;
bool libAffx_SlivanAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    slivanIndex = libAffx_EventAffix();
    return true;
}
bool libAffx_SlivanQuest (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_AddPlayerBehavior(libAffx_player, "SlivanQuest", 1, false);
    if (!slivanSpawned[libAffx_teamChaosIndex]) {
        UnitCreate(1, "SlivanBoss", c_unitCreateIgnorePlacement, libAffx_teamChaos, libGame_gv_players[libAffx_enemy].lv_spawnPoint, 0, null);
        slivanSpawned[libAffx_teamChaosIndex] = true;
    }
    
    return true;
}
bool libAffx_SlivanUnitDied (bool testConds, bool runActions) {
    unit slivan = EventUnit();
    int player = UnitGetOwner(slivan);

    if (testConds) {
        if (UnitGetType(slivan) != "SlivanBoss") {
            return false;
        }
        if (player != libAffx_teamChaos) {
            return false;
        }
        if (slivanIndex == 0) {
            return false;
        }
        if (libAffx_affixes[slivanIndex].quest.questDone) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_UnitCreateEffectUnit(libAffx_player, "SlivanQuestIncrementToken");
    libAffx_affixes[slivanIndex].quest.questProgress += 1;
    
    return true;
}
bool libAffx_SlivanQuestComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (slivanIndex == 0) {
            return false;
        }
        if (libAffx_affixes[slivanIndex].quest.questDone) {
            return false;
        }
        if (player != libAffx_player) {
            return false;
        }
        if (slivanSuppressRewards) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_affixes[slivanIndex].quest.questDone = true;
    libAffx_AddAffix(libAffx_GetAffixId("SlivanReward"), 1);
    
    return true;
}
bool libAffx_SlivanUnitBehaviorCreate (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    if (testConds) {
        if (!UnitHasBehavior2(heroUnit, "SlivanQuest")) {
            return false;
        }
        if (slivanIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    slivanSuppressRewards = true;
    UnitSetTokenCount(heroUnit, "SlivanQuest", libAffx_affixes[slivanIndex].quest.questProgress, heroUnit);
    libAffx_Wait(0.125, c_timeGame);
    slivanSuppressRewards = false;

    return true;
}
