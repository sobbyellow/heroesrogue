    }
    libAffx_TalentDisadvantageIndex = libAffx_EventAffix();
    for (i = 6; i <= 10; i += 1) {
        libAffx_ApplyTalentDisadvantage(i, UnitLevel(libGame_gv_players[i].lv_heroUnit));
        libAffx_Wait(0.0625, c_timeGame);
    }
    return true;
}
