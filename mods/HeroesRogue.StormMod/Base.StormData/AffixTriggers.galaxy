bool libAffx_LastMomentsEffectUsed (bool testConds, bool runActions) {
    unit targetUnit = EventPlayerEffectUsedUnit(c_effectUnitSource);
    if (testConds) {
        if (libAffx_LastMomentsIndex == 0) {
            return false;
        }
        if (libAffx_affixes[libAffx_LastMomentsIndex].cooldown > 0) {
            return false;
        }
        if (UnitTestState(targetUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    UnitCreateEffectUnit(libGame_gv_teams[libAffx_teamChaosIndex].lv_core, "MalthaelLastRitesInitialSet", targetUnit);
    libAffx_affixes[libAffx_LastMomentsIndex].cooldown = libAffx_LastMomentsCooldownCurrent;
    return true;
}

bool libAffx_LastMomentsPeriodic (bool testConds, bool runActions) {
    fixed behaviorDuration;
    unit heroUnit = libAffx_GetPlayerHeroUnit(libAffx_player);
	string heroUnitType = UnitGetType(heroUnit);

    if (testConds) {
        if (libAffx_LastMomentsIndex == 0) {
            return false;
        }
        if (libAffx_gamePaused || libGame_gv_gameOver) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (libAffx_affixes[libAffx_LastMomentsIndex].cooldown > 0) {
        libAffx_affixes[libAffx_LastMomentsIndex].cooldown -= 0.0625;
    }

    return true;
}
// ---------------------------------------------------------------
// Bad Mannerism
// ---------------------------------------------------------------
bool libAffx_BadMannerismHeroTakedown (bool testConds, bool runActions) {
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit killerUnit = libGame_gv_players[player].lv_heroUnit;
    unit deadUnit = libGame_gf_HeroParticipatedInTakedownKilledHero();
    int i;
    if (testConds) {
        if (player < 6 || player > 10) {
            return false;
        }
        if (UnitGetOwner(deadUnit) != libAffx_player) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_Wait(RandomFixed(0.25, 1.25), c_timeGame);
    for (i = 1; i <= RandomInt(6, 12); i += 1) {
        UnitIssueOrder(killerUnit, Order(AbilityCommand("Hearthstone", 0)), c_orderQueueReplace);
        libAffx_Wait(RandomFixed(0.0625, 0.1875), c_timeGame);
        UnitIssueOrder(killerUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        libAffx_Wait(0.0625, c_timeGame);
    }
    return true;
}
bool libAffx_BadMannerismPeriodic (bool testConds, bool runActions) {
    int random = RandomInt(6, 10);
    unitgroup nearbyUnits;
    unit bmUnit = libGame_gv_players[random].lv_heroUnit;
    unit playerUnit;
    int nearbyUnitsCount;
    int i;
    if (testConds) {
        if (!UnitIsAlive(bmUnit)) {
            return false;
        }
        if (UnitHasBehavior2(bmUnit, "Mounted")) {
            return false;
        }
        if (libAffx_gamePaused || libGame_gv_gameOver) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    
    nearbyUnits = UnitGroup(null, libAffx_player, RegionCircle(UnitGetPosition(bmUnit), 12), null, 0);
    nearbyUnitsCount = UnitGroupCount(nearbyUnits, c_unitCountAll);
    for (;; nearbyUnitsCount -= 1) {
        if (nearbyUnitsCount <= 0) { break; }
        playerUnit = UnitGroupUnitFromEnd(nearbyUnits, nearbyUnitsCount);
        if (UnitTypeTestAttribute(UnitGetType(bmUnit), c_unitAttributeHeroic)) {
            random = RandomInt(1, 100);
            if (random <= 66) {
                UnitIssueOrder(bmUnit, Order(AbilityCommand("LootSpray", 0)), c_orderQueueReplace);
            } else if (random <= 100) {
                UnitIssueOrder(bmUnit, Order(AbilityCommand("LootYellVoiceLine", 0)), c_orderQueueReplace);
            }
        }
    }
    return true;
}
bool libAffx_BadMannerism (bool testConds, bool runActions) {
    int i;
    if (!runActions) {
        return true;
    }
    for (i = 6; i <= 10; i += 1) {
        PlayerSetSpray(i, "RandomSpray");
        libGame_gf_HeroSelectionRandomlyPickSpray(i);
    }
    
    return true;
}
// ---------------------------------------------------------------
// Sabotage
// ---------------------------------------------------------------
libAffx_Filter libAffx_filterSabotage;
bool libAffx_SabotageOncePerGame (bool testConds, bool runActions) {
    unitgroup structures = UnitGroup(null, libAffx_teamOrder, RegionEntireMap(), libCore_gv_filtersStructure, 0);
    int structureCount = UnitGroupCount(structures, c_unitCountAll);
    unit structure;
    if (!runActions) {
        return true;
    }
    libAffx_CopyFilter(libAffx_filterAlliedStructures, libAffx_filterSabotage);
    libAffx_AddExcludedUnitTypeFilter(libAffx_filterSabotage, "TownMoonwellL3");
    libAffx_AddExcludedUnitTypeFilter(libAffx_filterSabotage, "TownMoonwellL2");
    libAffx_AddExcludedUnitTypeFilter(libAffx_filterSabotage, "ItemMULE");
    if (libAffx_currentMap == libAffx_mapTowersofDoom) {
        libAffx_AddExcludedUnitTypeFilter(libAffx_filterSabotage, "KingsCore");
    }
    for (;; structureCount -= 1) {
        if (structureCount <= 0) { break; }
        structure = UnitGroupUnitFromEnd(structures, structureCount);

        if (libAffx_UnitMatchesCriteria(structure, libAffx_filterSabotage)) {
            UnitSetPropertyFixed(structure, c_unitPropLife, UnitGetPropertyFixed(structure, c_unitPropLife, true) * 0.5);
            UnitBehaviorAdd(structure, "SabotageDebuff", structure, 1);
        }
    }

    return true;
}
bool libAffx_SabotageUnitCreated (bool testConds, bool runActions) {
    unit created = EventUnitCreatedUnit();
    if (testConds) {
        if (UnitGetOwner(created) != libAffx_teamOrder) {
            return false;
        }
        if (!libAffx_UnitMatchesCriteria(created, libAffx_filterSabotage)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    while (UnitHasBehavior2(created, "StructureOwnershipChangeRepairBehavior")) {
        libAffx_Wait(0.0625, c_timeGame);
    }
    UnitSetPropertyFixed(created, c_unitPropLife, UnitGetPropertyFixed(created, c_unitPropLife, true) * 0.5);
    UnitBehaviorAdd(created, "SabotageDebuff", created, 1);
    return true;
}
bool libAffx_SabotageUnitChangeOwner (bool testConds, bool runActions) {
    unit changed = EventUnit();
    if (!runActions) {
        return true;
    }
    while (UnitHasBehavior2(changed, "StructureOwnershipChangeRepairBehavior")) {
        libAffx_Wait(0.0625, c_timeGame);
    }
    libAffx_UpdateUnitBehaviorCriteria(changed, "SabotageDebuff", 1, libAffx_filterSabotage);
    if (libAffx_UnitMatchesCriteria(changed, libAffx_filterSabotage)) {
        UnitSetPropertyFixed(changed, c_unitPropLife, UnitGetPropertyFixed(changed, c_unitPropLife, true) * 0.5);
    } else {
        UnitSetPropertyFixed(changed, c_unitPropLife, UnitGetPropertyFixed(changed, c_unitPropLife, true));
    }
    return true;
}
