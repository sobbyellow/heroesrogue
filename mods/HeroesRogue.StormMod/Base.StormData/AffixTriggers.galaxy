        return true;
    }
    libAffx_KillContractIndex = libAffx_EventAffix();
    return true;
}
bool libAffx_KillContract (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_AddPlayerBehavior(libAffx_player, "AffixKillContractQuestToken", 1, false);
    
    return true;
}
bool libAffx_KillContractQuestComplete (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_KillContractIndex == 0) {
            return false;
        }
        if (libAffx_KillContractSuppressRewards) {
            return false;
        }
        if (libAffx_affixes[libAffx_KillContractIndex].quest.questDone) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_QueueBoon(libAffx_rarityCommon, 1, false, true);
    libAffx_QueueBoon(libAffx_rarityUncommon, 1, false, true);
    libAffx_affixes[libAffx_KillContractIndex].quest.questDone = true;
    
    return true;
}
bool libAffx_KillContractHeroTakedown (bool testConds, bool runActions) {
    int maxStacks = 25;
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit playerUnit = libGame_gv_players[player].lv_heroUnit;
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (!libAffx_PlayerHasBehavior(player, "AffixKillContractQuestToken")) {
            return false;
        }
        if (!(libAffx_PlayerBehaviorCount(player, "AffixKillContractQuestToken") < maxStacks)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_UnitCreateEffectUnit(player, "AffixKillContractIncrementToken");
    libAffx_affixes[libAffx_KillContractIndex].quest.questProgress += 1;
    
    return true;
}
bool libAffx_KillContractUnitBehaviorCreate (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    if (testConds) {
        if (!UnitHasBehavior2(heroUnit, "AffixKillContractQuestToken")) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_KillContractSuppressRewards = true;
    UnitSetTokenCount(heroUnit, "AffixKillContractQuestToken", libAffx_affixes[libAffx_KillContractIndex].quest.questProgress, heroUnit);
    libAffx_KillContractSuppressRewards = false;
    return true;
}

// ---------------------------------------------------------------
// Destruction
// ---------------------------------------------------------------
bool libAffx_DestructionAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    libAffx_DestructionIndex = libAffx_EventAffix();
    return true;
}
bool libAffx_DestructionQuest (bool testConds, bool runActions) {
    int quest;
    if (!runActions) {
        return true;
    }
    quest = libAffx_affixes[libAffx_DestructionIndex].quest.questProgress;
    libAffx_AddPlayerBehavior(libAffx_player, "AffixDestructionToken", 1, false);
    
    if (quest > 0) {
        libAffx_DestructionSuppressRewards = true;
        libAffx_ModifyPlayerTokenCount(libAffx_player, quest, "AffixDestructionToken");
        libAffx_Wait(0.125, c_timeGame);
        libAffx_DestructionSuppressRewards = false;
    }
    
    return true;
}
bool libAffx_DestructionUnitDied (bool testConds, bool runActions) {
    int maxStacks = 24;
    unit dyingStructure;
    int victimTeam;
    unit playerUnit;

    dyingStructure = EventUnit();
    victimTeam = libGame_gf_TeamNumberOfPlayer(UnitGetOwner(dyingStructure));
    playerUnit = libGame_gv_players[libAffx_player].lv_heroUnit;

    if (testConds) {
        if (!UnitTypeTestAttribute(UnitGetType(dyingStructure), c_unitAttributeStructure)) {
            return false;
        }
        if (UnitGetType(dyingStructure) != "TownTownHallL2" && UnitGetType(dyingStructure) != "TownTownHallL3") {
            return false;
        }
        if (victimTeam != libGame_gv_teamChaosIndex_C) {
            return false;
        }
        if (!libAffx_PlayerHasBehavior(libAffx_player, "AffixDestructionToken")) {
            return false;
        }
        if (!(libAffx_PlayerBehaviorCount(libAffx_player, "AffixDestructionToken") < maxStacks)) {
            return false;
        }
        if (libAffx_DestructionIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_UnitCreateEffectUnit(libAffx_player, "AffixDestructionIncrementToken");
    libAffx_affixes[libAffx_DestructionIndex].quest.questProgress += 1;
    
    return true;
}
bool libAffx_DestructionComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (libAffx_DestructionSuppressRewards) {
            return false;
        }
        if (libAffx_DestructionIndex == 0) {
            return false;
        }
        if (libAffx_affixes[libAffx_DestructionIndex].quest.questDone) {
            return false;
        }
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_QueueBoon(libAffx_rarityRare, 1, false, true);
    libAffx_affixes[libAffx_DestructionIndex].quest.questDone = true;
    
    return true;
}
bool libAffx_Destruction6StacksComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (libAffx_DestructionSuppressRewards) {
            return false;
        }
        if (libAffx_DestructionFinished[1]) {
            return false;
        }
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_QueueBoon(libAffx_rarityCommon, 1, false, true);
    libAffx_DestructionFinished[1] = true;
    
    return true;
}
bool libAffx_Destruction12StacksComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (libAffx_DestructionSuppressRewards) {
            return false;
        }
        if (libAffx_DestructionFinished[2]) {
            return false;
        }
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_QueueBoon(libAffx_rarityUncommon, 1, false, true);
    libAffx_DestructionFinished[2] = true;
    
    return true;
}
bool libAffx_DestructionUnitBehaviorCreate (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    if (testConds) {
        if (!UnitHasBehavior2(heroUnit, "AffixDestructionToken")) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_DestructionSuppressRewards = true;
    UnitSetTokenCount(heroUnit, "AffixDestructionToken", libAffx_affixes[libAffx_DestructionIndex].quest.questProgress, heroUnit);
    libAffx_Wait(0.125, c_timeGame);
    libAffx_DestructionSuppressRewards = false;

    return true;
}
