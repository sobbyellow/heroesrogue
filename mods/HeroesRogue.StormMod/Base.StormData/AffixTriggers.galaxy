// Slivan Reward
// ---------------------------------------------------------------
bool libAffx_SlivanRewardAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!slivanSpawned[libAffx_teamOrderIndex]) {
        slivanSpawned[libAffx_teamOrderIndex] = true;
        UnitCreate(1, "SlivanBoss", c_unitCreateIgnorePlacement, libAffx_teamOrder, libGame_gv_players[libAffx_player].lv_spawnPoint, 0, null);
    }
    return true;
}
