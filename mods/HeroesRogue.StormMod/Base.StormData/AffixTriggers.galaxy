// ---------------------------------------------------------------
// Backdoor Protection
// ---------------------------------------------------------------
bool libAffx_AlteracsLegacy (bool testConds, bool runActions) {
    int fortCount = UnitCount("TownTownHallL2", libAffx_teamChaos, RegionEntireMap(), libCore_gv_filtersStructure, 0);
    if (!runActions) {
        return true;
    }
    libAffx_CopyFilter(libAffx_filterEnemyStructures, libAffx_filterAlteracsLegacy);
    libAffx_AddRequiredUnitTypeFilter(libAffx_filterAlteracsLegacy, "TownCannonTowerL3");
    libAffx_AddRequiredUnitTypeFilter(libAffx_filterAlteracsLegacy, "TownTownHallL3");

    libAffx_AddUnitBehaviorCriteriaAll("AffixBackdoorProtection", fortCount, libAffx_filterAlteracsLegacy);

    return true;
}
bool libAffx_AlteracsLegacyUnitDied (bool testConds, bool runActions) {
    unit dyingStructure;
    int townIndex;
    int victimTeam;
    int town;

    dyingStructure = EventUnit();

    if (testConds) {
        if (!UnitTypeTestAttribute(UnitGetType(dyingStructure), c_unitAttributeStructure)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    townIndex = libGame_gf_TownGetTownForUnit(dyingStructure);
    victimTeam = libGame_gf_TeamNumberOfPlayer(UnitGetOwner(dyingStructure));
    if (UnitGetType(dyingStructure) == "TownTownHallL2" && victimTeam == libGame_gv_teamChaosIndex_C) {
        libAffx_RemoveUnitBehaviorCriteriaAll("AffixBackdoorProtection", 1, libAffx_filterAlteracsLegacy);
    }

    return true;
}
