    }

    libGame_xpModifierTrickle[libGame_gv_teamChaosIndex_C] += 0.25;

    return true;
}
// ---------------------------------------------------------------
// Convenient Portals
// ---------------------------------------------------------------
bool libAffx_ConvenientPortals (bool testConds, bool runActions) {
    point topPortal;
    point bottomPortal;
    if (!runActions) {
        return true;
    }
    CatalogFieldValueModify(c_gameCatalogBehavior, "MedivhPortalTimedLife", "Duration", libAffx_teamOrder, "-1", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "MedivhPortalDirectionSearch", "AreaArray[0].Radius", libAffx_teamOrder, "500", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "MedivhPortalCreationDirectionSearch", "AreaArray[0].Radius", libAffx_teamOrder, "500", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "MedivhPortalDirectionDummy", "Chance", libAffx_teamOrder, "0", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "MedivhPortalRealUnit", "CustomUnitStatusFrame", libAffx_teamOrder, "", c_upgradeOperationSet);
    while (!libAffx_GateIsOpen()) {
        Wait(1, c_timeGame);
    }
    if (libAffx_currentMap == libAffx_mapCursedHollow) {
        topPortal = Point(122.0, 166.0);
        bottomPortal = Point(125.0, 49.0);
    } else if (libAffx_currentMap == libAffx_mapShrines) {
        topPortal = Point(124.3, 151.26);
        bottomPortal = Point(124.05, 40.19);
    } else if (libAffx_currentMap == libAffx_mapCrypts) {
        topPortal = Point(124.08, 140);
        bottomPortal = Point(124.14, 45.11);
    } else if (libAffx_currentMap == libAffx_mapDragonShire) {
        topPortal = Point(124.15, 146.24);
        bottomPortal = Point(123.96, 53.97);
    } else if (libAffx_currentMap == libAffx_mapHauntedMines) {
        topPortal = Point(127.96, 227.73);
        bottomPortal = Point(128.08, 140.25);
    } else if (libAffx_currentMap == libAffx_mapTowersofDoom) {
        topPortal = Point(123.91, 150.03);
        bottomPortal = Point(123.84, 19.45);
    } else if (libAffx_currentMap == libAffx_mapGardenofTerror) {
        topPortal = Point(120.92, 166.88);
        bottomPortal = Point(127.97, 49.20);
    } else if (libAffx_currentMap == libAffx_mapBlackheartsBay) {
        topPortal = Point(126.85, 181.00);
        bottomPortal = Point(126.91, 55.40);
    } else if (libAffx_currentMap == libAffx_mapSkyTemple) {
        topPortal = Point(123.99, 163.20);
        bottomPortal = Point(123.98, 48.5);
    }

    UnitCreate(1, "MedivhPortalCreation", c_unitCreateIgnorePlacement, libAffx_teamOrder, topPortal, 0, null);
    UnitCreate(1, "MedivhPortalCreation", c_unitCreateIgnorePlacement, libAffx_teamOrder, bottomPortal, 0, null);

    return true;
}
// ---------------------------------------------------------------
// Globe Huffer
// ---------------------------------------------------------------
bool libAffx_GlobeHufferAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_GlobeHufferIndex = libAffx_EventAffix();
    libAffx_GlobeHufferCooldownCurrent = libAffx_GlobeHufferCooldown - libAffx_GlobeHufferCDRPerStack * (libAffx_EventAffixCount() - 1);

    CatalogFieldValueModify(c_gameCatalogBehavior, "RegenGlobeTimedLifeInitial", "Duration", libAffx_teamOrder, "6", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogBehavior, "RegenGlobeTimedLifeInitial", "Period", libAffx_teamOrder, "4.5", c_upgradeOperationSet);

    return true;
}
bool libAffx_GlobeHufferPeriodic (bool testConds, bool runActions) {
    int unitCount;
    int random;
    unit unitVar;
    if (testConds) {
        if (libAffx_gamePaused) {
            return false;
        }
        if (libAffx_GlobeHufferIndex == 0) {
            return false;
        }
        if (!libAffx_GateIsOpen()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    if (libAffx_affixes[libAffx_GlobeHufferIndex].cooldown <= 0) {
        random = RandomInt(1, 6);
        if (random == 6) {
            random = 1;
        }
        unitCount = UnitGroupCount(libGame_gv_players[random].lv_heroUnitGroup, c_unitCountAll);
        for (;; unitCount -= 1) {
            if (unitCount <= 0) { break; }
            unitVar = UnitGroupUnitFromEnd(libGame_gv_players[random].lv_heroUnitGroup, unitCount);
            if (UnitHasBehaviorWithCategoryFlag(unitVar, c_behaviorCategoryTimeStop) == true || UnitHasBehavior2(unitVar, "LongboatRaidHideVikings") ||
                UnitHasBehavior2(unitVar, "HallOfStormsProtectionBuff")) {
                return true;
            }
            if (UnitIsAlive(unitVar) && UnitGetType(unitVar) != "HeroLostVikingsController" && UnitGetType(unitVar) != "HeroDVaMech") {
                UnitCreate(1, "RegenGlobe", 0, libAffx_teamOrder, PointWithOffset(UnitGetPosition(unitVar), 2 * (RandomInt(0, 1) * 2) - 1, 2 * (RandomInt(0, 1) * 2) - 1), 0, null);
                libAffx_affixes[libAffx_GlobeHufferIndex].cooldown = libAffx_GlobeHufferCooldownCurrent;
            }
        }
    } else {
        libAffx_affixes[libAffx_GlobeHufferIndex].cooldown -= 0.0625;
    }

    return true;
}
