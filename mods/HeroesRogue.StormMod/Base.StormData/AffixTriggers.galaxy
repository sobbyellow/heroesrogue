bool libAffx_SecondWindPeriodic (bool testConds, bool runActions) {
    fixed behaviorDuration = UnitBehaviorDuration(libAffx_GetPlayerHeroUnit(libAffx_player), "AffixSecondWindCooldown");
    if (testConds) {
        if (libAffx_gamePaused) {
            return false;
        }
        if (libAffx_SecondWindIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if (behaviorDuration > 0) {
        libAffx_affixes[libAffx_SecondWindIndex].cooldown = behaviorDuration;
    } else {
        libAffx_affixes[libAffx_SecondWindIndex].cooldown -= 1;
    }

    return true;
}
