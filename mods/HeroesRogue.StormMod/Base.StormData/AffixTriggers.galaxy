    return true;
}

// ---------------------------------------------------------------
// Many Heroics
// ---------------------------------------------------------------

void libAffx_ApplyManyHeroics(int player, int level) {
    string hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[player]);
    if (hero == "Chromie") {
        level += 2;
    }
    if (level >= 10 && hero != "Varian"){
        libAffx_SelectAllTalentsOnTier(player, 4);
    } else if (hero == "Varian" && level >= 4) {
        libAffx_SelectAllTalentsOnTier(player, 2);
    }
}
bool libAffx_ManyHeroics (bool testConds, bool runActions) {
    int i;
    int level;
    if (!runActions) {
        return true;
    }
    for (i = 6; i <= 10; i += 1) {
        level = UnitLevel(libAffx_GetPlayerHeroUnit(i));
        libAffx_ApplyManyHeroics(i, level);
    }
    return true;
}
bool libAffx_ManyHeroicsLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (libGame_gf_HeroLevelUpPlayer() < 6 || libGame_gf_HeroLevelUpPlayer() > 10) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_ApplyManyHeroics(player, level);
    return true;
}
// ---------------------------------------------------------------
// Chained Down
// ---------------------------------------------------------------
bool libAffx_ChainedDownAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_ChainedDownModifierCurrent = libAffx_ChainedDownModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_ChainedDownBehaviorChangeCategory (bool testConds, bool runActions) {
    unit unitVar = EventUnit();
    string behavior = EventUnitBehavior();
    fixed behaviorDuration;
    fixed newDuration;
    fixed percentIncrease;
    if (testConds) {
        if (!(UnitGetOwner(unitVar) > 0)) {
            return false;
        }
        if (!(UnitGetOwner(unitVar) <= 5)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    behaviorDuration = UnitBehaviorDuration(unitVar, behavior);
    percentIncrease = 0.25 * UnitBehaviorCount(unitVar, "AffixChainedDownBehavior");

    if ((behaviorDuration > 0.0 && percentIncrease > 0.0)) {
        newDuration = (behaviorDuration * (1.0 + percentIncrease));
        UnitBehaviorSetDuration(unitVar, behavior, newDuration);
    }
    
    return true;
}
// ---------------------------------------------------------------
// Relentless
// ---------------------------------------------------------------
bool libAffx_RelentlessAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_RelentlessModifierCurrent = libAffx_RelentlessModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_RelentlessBehaviorChangeCategory (bool testConds, bool runActions) {
    unit unitVar = EventUnit();
    string behavior = EventUnitBehavior();
    fixed behaviorDuration;
    fixed newDuration;
    fixed percentDecrease;
    if (testConds) {
        if (!((UnitGetOwner(unitVar) > 5))) {
            return false;
        }

        if (!((UnitGetOwner(unitVar) <= 10))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    behaviorDuration = UnitBehaviorDuration(unitVar, behavior);
    percentDecrease = 0.15 * UnitBehaviorCount(unitVar, "AffixRelentlessController");

    if ((behaviorDuration > 0.0 && percentDecrease > 0.0)) {
        newDuration = (behaviorDuration * (1.0 - percentDecrease));
        UnitBehaviorSetDuration(unitVar, behavior, newDuration);
    }
    
    return true;
}
// ---------------------------------------------------------------
// Overleveled
// ---------------------------------------------------------------
bool libAffx_OverleveledAffixAdded (bool testConds, bool runActions) {
    int stacks = libAffx_EventAffixCountAdded();
    int currentLevel;
    int i;
    if (!runActions) {
        return true;
    }
    for (i = 6; i <= 10; i += 1) {
        UnitXPAddXP(libGame_gv_players[i].lv_heroUnit, null, StringToFixed(CatalogReferenceGet("Behavior,HeroXPCurve,VeterancyLevelArray[" + IntToString(UnitLevel(libGame_gv_players[i].lv_heroUnit)) +"].MinVeterancyXP", i)) + 1);
    }

    return true;
}
