// ---------------------------------------------------------------
// Critical Mass
// ---------------------------------------------------------------
bool libAffx_CriticalMassHT (bool testConds, bool runActions) {
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit killerUnit = libGame_gv_players[player].lv_heroUnit;
    unit deadUnit = libGame_gf_HeroParticipatedInTakedownKilledHero();

    if (testConds) {
        if (!UnitIsAlive(killerUnit)) {
            return false;
        }
        if ((player != libAffx_player) && libAffx_choPlayer == 0) {
            return false;
        }
        if ((player != libAffx_choPlayer && player != libAffx_gallPlayer) && libAffx_choPlayer != 0) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_ResetCooldowns(killerUnit);
    
    return true;
}
// ---------------------------------------------------------------
// ToxicField
// ---------------------------------------------------------------
bool libAffx_ToxicFieldExecuteOncePerGame (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libGame_AddAbilityEffectMapping("AbathurToxicNest", "ToxicNestDamage");

    return true;
}
bool libAffx_ToxicFieldAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_ToxicFieldIndex = libAffx_EventAffix();
    libAffx_ToxicFieldCount = 2 * libAffx_EventAffixCount();
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogEffect, "ToxicNestDamage", "Amount", libAffx_teamChaos, StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "ToxicNestDamage", "Amount", 0)) * Pow(1.04, UnitLevel(libGame_gv_players[6].lv_heroUnit)));
    return true;
}
bool libAffx_ToxicFieldPeriodic (bool testConds, bool runActions) {
    int i;
    int random;
    point trapPoint;
    int trapAmount;
    if (testConds) {
        if (!libAffx_GateIsOpen() || libAffx_gamePaused) {
            return false;
        }
        if (libAffx_ToxicFieldIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    trapAmount = 2 * libAffx_affixes[libAffx_ToxicFieldIndex].count;
    for (i = 1; i <= trapAmount; i += 1) {
        trapPoint = RegionRandomPoint(RegionEntireMap());
        random = RandomInt(1, 100);
        UnitCreateEffectPoint(libGame_gv_teams[libAffx_teamChaosIndex].lv_core, "AbathurToxicNestInitialSet", trapPoint);
    }
    return true;
}
bool libAffx_ToxicFieldLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_enemy) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogEffect, "ToxicNestDamage", "Amount", libAffx_teamChaos, StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "ToxicNestDamage", "Amount", 0)) * Pow(1.04, level));

    return true;
}
// ---------------------------------------------------------------
// Resurgence of the Storm
// ---------------------------------------------------------------
bool libAffx_ResurgenceoftheStormAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_ResurgenceoftheStormIndex = libAffx_EventAffix();
    libAffx_ResurgenceoftheStormCooldownCurrent = libAffx_ResurgenceoftheStormCooldown - (libAffx_ResurgenceoftheStormCDRPerStack * (libAffx_EventAffixCount() - 1));
    if (libAffx_playersHeroIndex[libAffx_player] == libCore_gf_GetIndexFromHero("LostVikings")) {
        libAffx_ResurgenceoftheStormCooldownCurrent = libAffx_ResurgenceoftheStormCooldownLostVikings - (libAffx_ResurgenceoftheStormCDRPerStack * (libAffx_EventAffixCount() - 1));
    }
    return true;
}
bool libAffx_ResurgenceoftheStormUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = UnitGetOwner(deadUnit);
    if (testConds) {
        if (libAffx_ResurgenceoftheStormIndex == 0) {
            return false;
        }
        if (deadPlayer != libAffx_player || libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown > 0) {
            return false;
        }
        if (UnitGetType(deadUnit) != "RexxarMisha") {
            return false;
        }
    }
    if (!runActions) {
        return true;
    } 
    libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown = libAffx_ResurgenceoftheStormCooldownCurrent / 2;
    libNtve_gf_StopTimer(libGDHL_gv_mishaDeathTimer[deadPlayer]);
    TimerStart(libGDHL_gv_mishaDeathTimer[deadPlayer], 5, false, c_timeGame);
    UnitBehaviorSetDuration(libGame_gv_players[deadPlayer].lv_heroUnit, "RexxarSpiritBondCooldown", 5);
    UnitModifyCooldown(libGame_gv_players[deadPlayer].lv_heroUnit, "Abil/RexxarMishaFocus", 5, c_cooldownOperationSet);
    return true;
}
bool libAffx_ResurgenceoftheStormHeroKilled (bool testConds, bool runActions) {
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    fixed lifeModifier;

    if (testConds) {
        if (libAffx_ResurgenceoftheStormIndex == 0) {
            return false;
        }
        if (deadPlayer != libAffx_player || libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown > 0) {
            return false;
        }
        if (deadUnit != libGame_gv_players[libAffx_player].lv_heroUnit && UnitGetType(libGame_gv_players[libAffx_player].lv_heroUnit) != "HeroLostVikingsController") {
            return false;
        }
        if (libGame_diabloUsedSouls[libAffx_player]) {
            return false;
        }
        if (UnitGetType(deadUnit) == "HeroMurky" && !((UnitIsAlive(libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer]) == false) || (libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer] == null))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libGame_gv_players[libAffx_player].lv_suppressReviveVOSound = true;
    libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown = libAffx_ResurgenceoftheStormCooldownCurrent;
    libGame_gf_HeroDeathUpdateRespawnTimer(libAffx_player, 5);
    if (UnitGetType(deadUnit) == "HeroLeoric") {
        UnitBehaviorSetDuration(deadUnit, "LeoricUndying", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
        UnitBehaviorSetDuration(deadUnit, "Dead", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
        libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] = UnitBehaviorDurationTotal(deadUnit, "LeoricUndying");
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "LeoricUndyingLifeRegenModifyUnit", "VitalArray[" + IntToString(0) + "].ChangeFraction", deadPlayer, (0.5 / (libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer])));
    } else if (UnitGetType(deadUnit) == "HeroOlaf") {
        libNtve_gf_StopTimer(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer);
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer, 5, false, c_timeGame);
    } else if (UnitGetType(deadUnit) == "HeroBaleog") {
        libNtve_gf_StopTimer(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer);
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer, 5, false, c_timeGame);
    } else if (UnitGetType(deadUnit) == "HeroErik") {
        libNtve_gf_StopTimer(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer);
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer, 5, false, c_timeGame);
    }
    return true;
}
bool libAffx_ResurgenceoftheStormPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_ResurgenceoftheStormIndex == 0 ) {
            return false;
        }
        if (libAffx_gamePaused || libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown <= 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown -= 0.0625;

    return true;
}
// ---------------------------------------------------------------
// Bribery
// ---------------------------------------------------------------
bool libAffx_BriberyCampIsBoss(int unitType) {
    if (unitType == libMapM_ge_JungleCampDefenderTypes_GraveGolem || unitType == libMapM_ge_JungleCampDefenderTypes_BossCamp1 || unitType == libMapM_ge_JungleCampDefenderTypes_BossCamp2 || unitType == libMapM_ge_JungleCampDefenderTypes_BossCamp3) {
        return true;
    }
    return false;
}
bool libAffx_BriberyAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_BriberyIndex = libAffx_EventAffix();
    libAffx_BriberyCooldownCurrent = libAffx_BriberyCooldown - (libAffx_EventAffixCount() - 1) * libAffx_BriberyCDRPerStack;
    return true;
}
bool libAffx_BriberyPeriodic (bool testConds, bool runActions) {
    int i;
    int i2;
    int unitCount;
    int campType;
    int targetCamp;
    if (testConds) {
        if (libAffx_gamePaused) {
            return false;
        }
        if (libAffx_BriberyIndex == 0) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    if (libAffx_affixes[libAffx_BriberyIndex].cooldown > 0) {
        libAffx_affixes[libAffx_BriberyIndex].cooldown -= libAffx_BriberyCooldownRate;
    } else {
        if (libAffx_BriberyAllowBosses) {
            for (i = 1; i <= libMapM_gv_jungleMaxCamps; i += 1) {
                campType = libMapM_gv_jungleCreepCamps[i].lv_mapDataCampDefenderType;
                if (!libAffx_BriberyCampIsBoss(campType)) {
                    continue;
                }
                unitCount = UnitGroupCount(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, c_unitCountAlive);
                if (unitCount > 0 && !libNtve_gf_UnitIsInvulnerable(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1)) && !UnitHasBehavior2(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1), "JungleMercDefenderBirthInvulnerability")) {
                    targetCamp = i;
                }
            }
        }
        if (targetCamp <= 0) {
            for (i = 1; i <= libMapM_gv_jungleMaxCamps; i += 1) {
                campType = libMapM_gv_jungleCreepCamps[i].lv_mapDataCampDefenderType;
                if (libAffx_BriberyCampIsBoss(campType) && !libAffx_BriberyAllowBosses) {
                    continue;
                }
                unitCount = UnitGroupCount(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, c_unitCountAlive);
                if (unitCount > 0 && !libNtve_gf_UnitIsInvulnerable(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1)) && !UnitHasBehavior2(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1), "JungleMercDefenderBirthInvulnerability") && UnitGetType(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1)) != "SkeletalPirate") {
                    targetCamp = i;
                }
            }
        }
        if (targetCamp > 0) {
            libAffx_affixes[libAffx_BriberyIndex].cooldown = libAffx_BriberyCooldownCurrent;
            unitCount = UnitGroupCount(libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderUnitGroup, c_unitCountAlive);

            for (i2 = unitCount; i2 > 0; i2 -= 1) {
                UnitCreateEffectUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "BribeSetAffix", UnitGroupUnitFromEnd(libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderUnitGroup, i2));
                libAffx_DisplayDebugMessage("Trying to bribe " + UnitGetType(UnitGroupUnitFromEnd(libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderUnitGroup, i2)));
            }
            libMapM_gv_jungleCreepCamps[targetCamp].customRespawnTime = libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderRespawnTime / 2;
            Wait(0.125, c_timeGame);
            libGame_gv_capturePoints[libMapM_gv_jungleCreepCamps[targetCamp].lv_captureCapturePointIndex].lv_captureCounter = 999;
        }
        Wait(1, c_timeGame);
    }

    return true;
}
