    int level = UnitLevel(libGame_gv_players[player].lv_heroUnit);
    int count = libHRGE_GetAffixCount(libHRGE_instancePathoftheAssassin);
    libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheAssassinBehavior", "Modification.DamageDealtScaled[Basic]", player, (libHRGE_PathoftheAssassinInitialValue[player] + libHRGE_PathoftheAssassinStackingValue[player] * (count - 1)) * (level + libHRGE_PathoftheFighterBonus));
}
bool libHRGE_PathoftheAssassinExecuteImmediate (bool testConds, bool runActions) {
    int i;
    string hero;
    for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
        hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[i].lv_heroIndex);

        if (hero == "Tracer") {
            libHRGE_PathoftheAssassinInitialValue[i] = 1;
            libHRGE_PathoftheAssassinStackingValue[i] = 1;
        } else if (hero == "DVa" || hero == "Tassadar" || hero == "Tychus" || hero == "Zarya" || hero == "Lucio" || hero == "Genji") {
            libHRGE_PathoftheAssassinInitialValue[i] = 2;
            libHRGE_PathoftheAssassinStackingValue[i] = 1;
        } else {
            libHRGE_PathoftheAssassinInitialValue[i] = 4;
            libHRGE_PathoftheAssassinStackingValue[i] = 2;
        }
    }
    libHRGE_PathoftheAssassinInitialValueTooltip = libHRGE_PathoftheAssassinInitialValue[libHRGE_player];
    libHRGE_PathoftheAssassinStackingValueTooltip = libHRGE_PathoftheAssassinStackingValue[libHRGE_player];
    return true;
}
