// ============================================================
// Weak Point
// ============================================================

int libHRGE_AffixWeakPointGetHeroIndex(unit hero) {
    if (UnitGetType(hero) == "HeroErik" || UnitGetType(hero) == "HeroChenEarth") {
        return 3;
    } else if (UnitGetType(hero) == "HeroBaleog" || UnitGetType(hero) == "RexxarMisha" || UnitGetType(hero) == "HeroChenFire" || UnitGetType(hero) == "HeroDVaMech") {
        return 2;
    } else {
        return 1;
    }
}
bool libHRGE_WeakPointOncePerGame (bool testConds, bool runActions) {
    unitgroup unitGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    unit heroUnit;
    int groupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; groupCount -= 1) {
        if (groupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(unitGroup, groupCount);
        if (UnitGetType(heroUnit) == "HeroLostVikingsController") { continue; }
        libHRGE_AddUnitBehavior(heroUnit, "AffixWeakPointTokenCounter" + IntToString(libHRGE_AffixWeakPointGetHeroIndex(heroUnit)), heroUnit, 1, true);
    }
    return true;
}

bool libHRGE_WeakPointUnitDamaged (bool testConds, bool runActions) {
    int i;
    unit eventUnit = EventUnit();
    unit damagingUnit = EventUnitDamageSourceUnit();
    fixed damageValue = EventUnitDamageAmount();
    string damageEffect = EventUnitDamageEffect();
    int player = UnitGetOwner(eventUnit);
    int heroIndex;
    int durationIterator;
    string tokenBehavior;
    if (testConds) {
        if (!UnitHasBehavior2(eventUnit, "AffixWeakPointController")) {
            return false;
        }
        if (UnitTestState(eventUnit, c_unitStateHallucination)) {
            return false;
        }
        if (damagingUnit == eventUnit || damageValue <= 0 || damageEffect == ("AffixWeakPointDamage" + IntToString(heroIndex))) {
            return false;
        }
    }
    heroIndex = libHRGE_AffixWeakPointGetHeroIndex(eventUnit);
    tokenBehavior = "AffixWeakPointTokenCounter" + IntToString(heroIndex);
    durationIterator = FixedToInt(libHRGE_CatalogReferenceGetAsFixed("Behavior,AffixWeakPointDoT" + IntToString(heroIndex) + ",Duration", player));
    libGame_gf_ModifyTokenCount(FixedToInt(damageValue), tokenBehavior, eventUnit);
    UnitCreateEffectUnit(eventUnit, "AffixWeakPointSet" + IntToString(heroIndex), eventUnit);
    libHRGE_Wait(1.0, c_timeGame);
    while ((UnitIsAlive(eventUnit) == true) && (durationIterator > 0) && UnitHasBehavior2(eventUnit, "AffixWeakPointDoT" + IntToString(heroIndex))) {
        while (UnitHasBehaviorWithCategoryFlag(eventUnit, c_behaviorCategoryTimeStop) || libHRGE_gamePaused) {
            libHRGE_Wait(0.0625, c_timeGame);
        }

        durationIterator -= 1;
        libHRGE_Wait(1.0, c_timeGame);
    }
    libGame_gf_ModifyTokenCount(FixedToInt(-1 * damageValue), tokenBehavior, eventUnit);

    return true;
}

// ============================================================
// Invasion
// ============================================================
void libHRGE_AffixInvasionUpdate(int level) {
    libHRGE_InvasionSpawnRate = libCore_gv_bALMinionWaveInterval / (1 + (0.25 + (0.75 * (MinI(level, 20) - 1) / 19)));
    libCore_minionWaveInterval[libGame_gv_teamChaosIndex_C] = libHRGE_InvasionSpawnRate;
    libHRGE_InvasionExp = -0.2 + (-0.3 * (MinI(level, 20) - 1) / 19);
    libGame_xpModifierMinion[libGame_gv_teamOrderIndex_C] = libHRGE_InvasionExp;
}

bool libHRGE_InvasionAffixAdded (bool testConds, bool runActions) {
    int level = UnitLevel(libHRGE_GetPlayerHeroUnit(libHRGE_enemy));
    libHRGE_AffixInvasionUpdate(level);
    return true;
}
bool libHRGE_InvasionLevelUp (bool testConds, bool runActions) {
    int level = libGame_gf_HeroLevelUpLevel();
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libHRGE_enemy) {
            return false;
        }
    }
    libHRGE_AffixInvasionUpdate(level);
    if (level >= 20 && !libHRGE_invasionActive) {
        libHRGE_invasionActive = true;
        TimerStart(libHRGE_GetAffixPrimaryTimer(libHRGE_instanceInvasion), 60, true, c_timeGame);
    }
    return true;
}
bool libHRGE_InvasionTimerElapsed (bool testConds, bool runActions) {
    fixed modifier;
    libHRGE_invasionModifier += 1;
    modifier = libHRGE_InvasionStatsModifier * libHRGE_invasionModifier;
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.HealDealtAdditiveMultiplier[Life]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.HealDealtAdditiveMultiplier[Shields]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.DamageDealtFraction[Ability]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.DamageDealtFraction[Basic]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalMaxFractionArray[Life]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalMaxFractionArray[Energy]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalRegenMultiplier[Life]", FixedToString(modifier, 2));
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixInvasionBehavior,Modification.VitalRegenMultiplier[Energy]", FixedToString(modifier, 2));

    return true;
}

// ============================================================
// Unyielding Defense
// ============================================================

void libHRGE_ScaleUnyieldingDefense(unit unitVar, string behavior, fixed health) {
    int player = UnitGetOwner(unitVar);
    libHRGE_CatalogReferenceModify("Behavior," + behavior + ",DamageResponse.ClampMaximum", player, FixedToString(health * libHRGE_UnyieldingDefenseModifier, 2), c_upgradeOperationSet);
}
void libHRGE_AddUnyieldingDefense(unit unitVar) {
    string unitType = UnitGetType(unitVar);
    if (UnitTypeTestFlag(unitType, c_unitFlagTownStructureWall)) {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorWall", unitVar, 1);
    } else if (UnitTypeTestFlag(unitType, c_unitFlagTownStructureGate)) {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorGate", unitVar, 1);
    } else if (UnitTypeTestFlag(unitType, c_unitFlagTownStructureCore)) {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorCore", unitVar, 1);
    } else if (unitType == "TownTownHallL2") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorFort", unitVar, 1);
    } else if (unitType == "TownTownHallL3") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorKeep", unitVar, 1);
    } else if (unitType == "TownCannonTowerL2") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorFortTower", unitVar, 1);
    } else if (unitType == "TownCannonTowerL3") {
        UnitBehaviorAdd(unitVar, "AffixUnyieldingDefenseBehaviorKeepTower", unitVar, 1);
    }
}
bool libHRGE_UnyieldingDefenseUnitCreated (bool testConds, bool runActions) {
    if (UnitGetOwner(EventUnitCreatedUnit()) == libHRGE_teamOrder) {
        libHRGE_AddUnyieldingDefense(EventUnitCreatedUnit());
    }
    return true;
}
bool libHRGE_UnyieldingDefenseAffixAdded (bool testConds, bool runActions) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, libHRGE_teamOrder, RegionEntireMap(), libHRGE_filterAlliedStructures.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        libHRGE_AddUnyieldingDefense(unitVar);
    }
    return true;
}
bool libHRGE_UnyieldingDefenseUnitDied (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    if (testConds) {        
        if (player != libHRGE_teamOrder) {
            return false;
        }
        if (UnitGetType(eventUnit) != "TownTownHallL2" && UnitGetType(eventUnit) != "TownTownHallL3") {
            return false;
        }
    }
    libHRGE_Wait(0.0625, c_timeGame); // Wait for fallback towers to die before applying protected
    libHRGE_AddUnitBehaviorToAllFilter("AffixUnyieldingDefenseProtected", 1, libHRGE_filterAlliedStructures);
    return true;
}
bool libHRGE_UnyieldingDefenseUnitBehaviorChange1 (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    fixed lastMaxHealth;
    while (UnitHasBehavior2(eventUnit, "AffixUnyieldingDefenseBehaviorCore")) {
        while (libHRGE_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        if (lastMaxHealth != UnitGetPropertyFixed(eventUnit, c_unitPropLifeMax, true)) {
            lastMaxHealth = UnitGetPropertyFixed(eventUnit, c_unitPropLifeMax, true);
            libHRGE_ScaleUnyieldingDefense(eventUnit, "AffixUnyieldingDefenseBehaviorCore", lastMaxHealth);
        }
        libHRGE_Wait(0.0625, c_timeGame);
    }
    return true;
}
