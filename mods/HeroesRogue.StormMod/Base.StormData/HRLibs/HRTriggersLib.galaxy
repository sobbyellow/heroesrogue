// ============================================================
// Resurgence of the Storm
// ============================================================
bool libHRGE_ResurgenceoftheStormAffixAdded (bool testConds, bool runActions) {
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[libHRGE_player].lv_heroIndex);
    if (hero == "LostVikings") {
        libHRGE_ResurgenceoftheStormCurrentCooldown = libHRGE_ResurgenceoftheStormCooldownLostVikings - (libHRGE_ResurgenceoftheStormCDRPerStack * (libHRGE_EventAffixCount() - 1));
    } else {
        libHRGE_ResurgenceoftheStormCurrentCooldown = libHRGE_ResurgenceoftheStormCooldown - (libHRGE_ResurgenceoftheStormCDRPerStack * (libHRGE_EventAffixCount() - 1));
    }
    return true;
}
bool libHRGE_ResurgenceoftheStormUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = UnitGetOwner(deadUnit);
    if (testConds) {
        if (UnitGetType(deadUnit) != "RexxarMisha" || deadPlayer != libHRGE_player) {
            return false;
        }
        if (!libHRGE_AffixCooldownReady(libHRGE_instanceResurgenceoftheStorm)) {
            return false;
        }
    }

    libNtve_gf_StopTimer(libGDHL_gv_mishaDeathTimer[deadPlayer]);
    TimerStart(libGDHL_gv_mishaDeathTimer[deadPlayer], 5, false, c_timeGame);
    UnitBehaviorSetDuration(libGame_gv_players[deadPlayer].lv_heroUnit, "RexxarSpiritBondCooldown", 5);
    UnitModifyCooldown(libGame_gv_players[deadPlayer].lv_heroUnit, "Abil/RexxarMishaFocus", 5, c_cooldownOperationSet);
    TimerStart(libHRGE_GetAffixPrimaryTimer(libHRGE_instanceResurgenceoftheStorm), libHRGE_ResurgenceoftheStormCurrentCooldown / 2, false, c_timeGame);
    return true;
}
bool libHRGE_ResurgenceoftheStormHeroKilled (bool testConds, bool runActions) {
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    unit heroUnit = libGame_gv_players[libHRGE_player].lv_heroUnit;
    string unitType = UnitGetType(deadUnit);

    if (testConds) {
        if (deadPlayer != libHRGE_player) {
            return false;
        }
        if (deadUnit != heroUnit && UnitGetType(heroUnit) != "HeroLostVikingsController" && (unitType == "HeroOlaf" || unitType == "HeroBaleog" || unitType == "HeroErik")) {
            return false;
        }
        if (libGame_diabloUsedSouls[libHRGE_player] && unitType == "HeroDiablo") {
            return false;
        }
        if (unitType == "HeroMurky" && !((UnitIsAlive(libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer]) == false) || (libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer] == null))) {
            return false;
        }
        if (unitType == "HeroUther" && PlayerHasTalent(deadPlayer, "UtherMasteryRedemption") && libGame_UtherRedemptionIsReady(deadUnit)) {
            return false;
        }
        if (!libHRGE_AffixCooldownReady(libHRGE_instanceResurgenceoftheStorm)) {
            return false;
        }
    }

    libGame_gv_players[libHRGE_player].lv_suppressReviveVOSound = true;
    if (unitType == "HeroUther") {
        libGame_gf_HeroDeathUpdateRespawnTimer(libHRGE_player, CatalogFieldValueGetAsFixed(c_gameCatalogBehavior, "UtherEternalVanguardRezDelay", "Duration", deadPlayer) + CatalogFieldValueGetAsFixed(c_gameCatalogBehavior, "SpiritOfRedemptionSpiritFormBuff", "Duration", deadPlayer) + libHRGE_ResurgenceoftheStormDeathTimer);
    } else {
        libGame_gf_HeroDeathUpdateRespawnTimer(libHRGE_player, libHRGE_ResurgenceoftheStormDeathTimer);
    }
    if (unitType == "HeroLeoric") {
        UnitBehaviorSetDuration(deadUnit, "LeoricUndying", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
        UnitBehaviorSetDuration(deadUnit, "Dead", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
        libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] = UnitBehaviorDurationTotal(deadUnit, "LeoricUndying");
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "LeoricUndyingLifeRegenModifyUnit", "VitalArray[0].ChangeFraction", deadPlayer, (0.5 / (libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer])));
    } else if (unitType == "HeroOlaf") {
        libNtve_gf_StopTimer(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer);
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer, 5, false, c_timeGame);
    } else if (unitType == "HeroBaleog") {
        libNtve_gf_StopTimer(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer);
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer, 5, false, c_timeGame);
    } else if (unitType == "HeroErik") {
        libNtve_gf_StopTimer(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer);
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer, 5, false, c_timeGame);
    }
    TimerStart(libHRGE_GetAffixPrimaryTimer(libHRGE_instanceResurgenceoftheStorm), libHRGE_ResurgenceoftheStormCurrentCooldown, false, c_timeGame);
    return true;
}

// ============================================================
// Bribery
// ============================================================
bool libHRGE_BriberyAffixAdded (bool testConds, bool runActions) {
    libHRGE_BriberyCurrentCooldown = libHRGE_BriberyCooldown - (libHRGE_EventAffixCount() - 1) * libHRGE_BriberyCDRPerStack;
    return true;
}

bool libHRGE_BriberyTimerElapsed (bool testConds, bool runActions) {
    int i;
    int unitCount;
    int campType;
    int targetCamp;
    while (true) {
        if (libHRGE_BriberyAllowBosses) {
            for (i = 1; i <= libMapM_gv_jungleMaxCamps; i += 1) {
                campType = libMapM_gv_jungleCreepCamps[i].lv_mapDataCampDefenderType;
                if (!libHRGE_CampIsBoss(campType)) {
                    continue;
                }
                unitCount = UnitGroupCount(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, c_unitCountAlive);
                if (unitCount > 0 && !libNtve_gf_UnitIsInvulnerable(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1)) && !UnitHasBehavior2(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1), "JungleMercDefenderBirthInvulnerability")) {
                    targetCamp = i;
                }
            }
        }
        if (targetCamp <= 0) {
            for (i = 1; i <= libMapM_gv_jungleMaxCamps; i += 1) {
                campType = libMapM_gv_jungleCreepCamps[i].lv_mapDataCampDefenderType;
                if (libHRGE_CampIsBoss(campType) && !libHRGE_BriberyAllowBosses) {
                    continue;
                }
                unitCount = UnitGroupCount(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, c_unitCountAlive);
                if (unitCount > 0 && !libNtve_gf_UnitIsInvulnerable(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1)) && !UnitHasBehavior2(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1), "JungleMercDefenderBirthInvulnerability") && UnitGetType(UnitGroupUnit(libMapM_gv_jungleCreepCamps[i].lv_defenderUnitGroup, 1)) != "SkeletalPirate") {
                    targetCamp = i;
                }
            }
        }
        if (targetCamp > 0) {
            unitCount = UnitGroupCount(libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderUnitGroup, c_unitCountAlive);

            for (i = unitCount; i > 0; i -= 1) {
                UnitCreateEffectUnit(libGame_gv_players[libHRGE_player].lv_heroUnit, "BribeSetAffix", UnitGroupUnitFromEnd(libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderUnitGroup, i));
                libHRGE_DisplayDebugMessage("Trying to bribe " + UnitGetType(UnitGroupUnitFromEnd(libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderUnitGroup, i)));
            }
            libMapM_gv_jungleCreepCamps[targetCamp].customRespawnTime = libMapM_gv_jungleCreepCamps[targetCamp].lv_defenderRespawnTime / 2;
            libHRGE_Wait(0.125, c_timeGame);
            libGame_gv_capturePoints[libMapM_gv_jungleCreepCamps[targetCamp].lv_captureCapturePointIndex].lv_captureCounter = 999;
            TimerStart(libHRGE_GetCurrentAffixTimer(), libHRGE_BriberyCurrentCooldown, false, c_timeGame);
            return true;
        }
        libHRGE_Wait(1, c_timeGame);
    }
    return true;
}

