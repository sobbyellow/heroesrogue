    libHRGE_MacGuffinCurrentModifier = libHRGE_MacGuffinModifier + (libHRGE_MacGuffinModifierPerStack * (libHRGE_EventAffixCount() - 1));

    for (i = 1; i <= 5; i += 1) {
        libHRGE_CatalogReferenceModify("Effect,CaptureMacGuffin,PeriodCount", i, FixedToString(original * (1 - libHRGE_MacGuffinCurrentModifier), 0), c_upgradeOperationSet);
        libHRGE_CatalogReferenceModify("Effect,UseVehiclePersistent,PeriodCount", i, FixedToString(originalVehicle * (1 - libHRGE_MacGuffinCurrentModifier), 0), c_upgradeOperationSet);
    }

    return true;
}

