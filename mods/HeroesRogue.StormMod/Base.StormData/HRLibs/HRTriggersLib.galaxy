// ============================================================
// Slivan
// ============================================================
bool libHRGE_SlivanQuest (bool testConds, bool runActions) {
    libHRGE_AddPlayerBehavior(libHRGE_player, "SlivanQuest", 1, false);
    if (!libHRGE_SlivanSpawned[libHRGE_teamChaosIndex]) {
        UnitCreate(1, "SlivanBoss", c_unitCreateIgnorePlacement, libHRGE_teamChaos, libGame_gv_players[libHRGE_enemy].lv_spawnPoint, 0, null);
        libHRGE_SlivanSpawned[libHRGE_teamChaosIndex] = true;
    }
    
    return true;
}
bool libHRGE_SlivanUnitDied (bool testConds, bool runActions) {
    unit slivan = EventUnit();
    int player = UnitGetOwner(slivan);

    if (testConds) {
        if (UnitGetType(slivan) != "SlivanBoss") {
            return false;
        }
        if (player != libHRGE_teamChaos) {
            return false;
        }
        if (libHRGE_AffixQuestDone(libHRGE_instanceSlivan)) {
            return false;
        }
    }
    libHRGE_UnitCreateEffectUnit(libHRGE_player, "SlivanQuestIncrementToken");
    libHRGE_AddAffixQuestProgress(libHRGE_instanceSlivan, 1);
    
    return true;
}
bool libHRGE_SlivanQuestComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
        if (libHRGE_AffixQuestDone(libHRGE_instanceSlivan)) {
            return false;
        }
        if (libHRGE_SlivanSuppressRewards) {
            return false;
        }
    }
    libHRGE_SetAffixQuestDone(libHRGE_instanceSlivan, true);
    libHRGE_AddAffix(libHRGE_GetAffixIndex("SlivanReward"), 1);
    
    return true;
}
bool libHRGE_SlivanUnitBehaviorCreate (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    if (testConds) {
        if (!UnitHasBehavior2(heroUnit, "SlivanQuest")) {
            return false;
        }
    }
    libHRGE_SlivanSuppressRewards = true;
    UnitSetTokenCount(heroUnit, "SlivanQuest", libHRGE_GetAffixQuestProgress(libHRGE_instanceSlivan), heroUnit);
    libHRGE_Wait(0.125, c_timeGame);
    libHRGE_SlivanSuppressRewards = false;

    return true;
}
