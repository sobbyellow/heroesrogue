// ============================================================
bool libHRGE_ConvenientPortals (bool testConds, bool runActions) {
    point topPortal;
    point bottomPortal;
    CatalogFieldValueModify(c_gameCatalogBehavior, "MedivhPortalTimedLife", "Duration", libHRGE_teamOrder, "-1", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "MedivhPortalDirectionSearch", "AreaArray[0].Radius", libHRGE_teamOrder, "500", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "MedivhPortalCreationDirectionSearch", "AreaArray[0].Radius", libHRGE_teamOrder, "500", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "MedivhPortalDirectionDummy", "Chance", libHRGE_teamOrder, "0", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "MedivhPortalRealUnit", "CustomUnitStatusFrame", libHRGE_teamOrder, "", c_upgradeOperationSet);
    while (!libHRGE_GateIsOpen()) {
        libHRGE_Wait(1, c_timeGame);
    }
    if (libCore_gv_mAPMapStringID == "CursedHollow") {
        topPortal = Point(122.0, 166.0);
        bottomPortal = Point(125.0, 49.0);
    } else if (libCore_gv_mAPMapStringID == "Shrines") {
        topPortal = Point(124.3, 151.26);
        bottomPortal = Point(124.05, 40.19);
    } else if (libCore_gv_mAPMapStringID == "Crypts") {
        topPortal = Point(124.08, 140);
        bottomPortal = Point(124.14, 45.11);
    } else if (libCore_gv_mAPMapStringID == "DragonShire") {
        topPortal = Point(124.15, 146.24);
        bottomPortal = Point(123.96, 53.97);
    } else if (libCore_gv_mAPMapStringID == "HauntedMines") {
        topPortal = Point(127.96, 227.73);
        bottomPortal = Point(128.08, 140.25);
    } else if (libCore_gv_mAPMapStringID == "TowersOfDoom") {
        topPortal = Point(123.91, 150.03);
        bottomPortal = Point(123.84, 19.45);
    } else if (libCore_gv_mAPMapStringID == "HauntedWoods") {
        topPortal = Point(120.92, 166.88);
        bottomPortal = Point(127.97, 49.20);
    } else if (libCore_gv_mAPMapStringID == "BlackheartsBay") {
        topPortal = Point(126.85, 181.00);
        bottomPortal = Point(126.91, 55.40);
    } else if (libCore_gv_mAPMapStringID == "ControlPoints") {
        topPortal = Point(123.99, 163.20);
        bottomPortal = Point(123.98, 48.5);
    } else if (libCore_gv_mAPMapStringID == "Hanamura") {
        topPortal = Point(131.08, 178.40);
        bottomPortal = Point(125.12, 78.28);
    } else if (libCore_gv_mAPMapStringID == "BattlefieldOfEternity") {
        topPortal = Point(119.23, 153.06);
        bottomPortal = Point(128.45, 54.74);
    } else if (libCore_gv_mAPMapStringID == "BraxisHoldout") {
        topPortal = Point(119.12, 160.94);
        bottomPortal = Point(128.59, 55.37);
    }

    UnitCreate(1, "MedivhPortalCreation", c_unitCreateIgnorePlacement, libHRGE_teamOrder, topPortal, 0, null);
    UnitCreate(1, "MedivhPortalCreation", c_unitCreateIgnorePlacement, libHRGE_teamOrder, bottomPortal, 0, null);

    return true;
}
// ============================================================
// Globe Huffer
// ============================================================
bool libHRGE_GlobeHufferAffixAdded (bool testConds, bool runActions) {
    libHRGE_GlobeHufferCurrentCooldown = libHRGE_GlobeHufferCooldown - libHRGE_GlobeHufferCDRPerStack * (libHRGE_EventAffixCount() - 1);

    return true;
}

bool libHRGE_GlobeHufferTimerElapsed (bool testConds, bool runActions) {
    int unitCount;
    int random;
    unit unitVar;
    unitgroup heroGroup;
    timer cooldownTimer = libHRGE_GetCurrentAffixTimer();

    while (!libHRGE_GateIsOpen()) {
        libHRGE_Wait(1, c_timeGame);
    }

    while (true) {
        random = RandomInt(1, 6);
        if (random == 6) { random = 1; }
        heroGroup = libGame_gv_players[random].lv_heroUnitGroup;
        unitCount = UnitGroupCount(heroGroup, c_unitCountAll);
        for (;; unitCount -= 1) {
            if (unitCount <= 0) { break; }
            unitVar = UnitGroupUnitFromEnd(heroGroup, unitCount);
            if (UnitHasBehaviorWithCategoryFlag(unitVar, c_behaviorCategoryTimeStop) == true || UnitHasBehavior2(unitVar, "LongboatRaidHideVikings") ||
                UnitHasBehavior2(unitVar, "HallOfStormsProtectionBuff")) {
                continue;
            } else if (UnitIsAlive(unitVar) && UnitGetType(unitVar) != "HeroLostVikingsController" && UnitGetType(unitVar) != "HeroDVaMech") {
                UnitCreate(1, "RegenGlobe", 0, libHRGE_teamOrder, PointWithOffset(UnitGetPosition(unitVar), 2 * (RandomInt(0, 1) * 2) - 1, 2 * (RandomInt(0, 1) * 2) - 1), 0, null);
                TimerStart(libHRGE_GetCurrentAffixTimer(), libHRGE_GlobeHufferCurrentCooldown, false, c_timeGame);
                return true;
            }
        }
        libHRGE_Wait(1, c_timeGame);
    }
    return true;
}
