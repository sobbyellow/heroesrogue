// Very Bad Bargain
// ============================================================
bool libHRGE_VeryBadBargainTimerElapsed (bool testConds, bool runActions) {
    int count = libHRGE_GetAffixCount(libHRGE_instanceVeryBadBargain);
    fixed modifier = libHRGE_VeryBadBargainModifier * count;
    libHRGE_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.HealDealtAdditiveMultiplier[Life]", libHRGE_player, FixedToString(modifier, 2), c_upgradeOperationAdd);
    libHRGE_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.HealDealtAdditiveMultiplier[Shields]", libHRGE_player, FixedToString(modifier, 2), c_upgradeOperationAdd);
    libHRGE_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.DamageDealtFraction[Ability]", libHRGE_player, FixedToString(modifier, 2), c_upgradeOperationAdd);
    libHRGE_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.DamageDealtFraction[Basic]", libHRGE_player, FixedToString(modifier, 2), c_upgradeOperationAdd);

    return true;
}
// ============================================================
// Purification Protocol
// ============================================================
void libHRGE_AffixPurificationProtocolCastBeam() {
    unit casterUnit = libGame_gv_teams[libHRGE_teamChaosIndex].lv_core;
    unitgroup heroGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    int groupCount = UnitGroupCount(heroGroup, c_unitCountAll);
    unit heroUnit;
    unit beamUnit;
    bool applied;
    
    while (!applied) {
        for (;; groupCount -= 1) {
            if (groupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(heroGroup, groupCount);
            if (UnitGetType(heroUnit) == "HeroLostVikingsController") { continue; }
            
            while (!UnitIsAlive(heroUnit) || UnitHasBehavior2(heroUnit, "HallOfStormsProtectionBuff")) {
                libHRGE_Wait(0.0625, c_timeGame);
            }
    
            libHRGE_PurificationProtocolTargetUnit = heroUnit;
            UnitCreateEffectUnit(casterUnit, "ArtanisSpearofAdunPurifierBeamInitialSet", libHRGE_PurificationProtocolTargetUnit);
            UnitBehaviorAdd(heroUnit, "PurificationProtocol", heroUnit, 1);
            beamUnit = UnitGroupUnit(UnitGroup("ArtanisSpearofAdunPurifierBeamInvisibleTrackingUnit", UnitGetOwner(casterUnit), RegionEntireMap(), null, 0), 1);
            libNtve_gf_SendActorMessageToUnit(beamUnit, "SetMinimapVisibility 1");
            libNtve_gf_SendActorMessageToUnit(beamUnit, "SetMinimapVisibilityAlways 1");
            libNtve_gf_SendActorMessageToUnit(beamUnit, "MinimapIcon Assets/Textures/affix_minimap_icon_red_circle.dds");
            libNtve_gf_SendActorMessageToUnit(beamUnit, "MinimapIconScale 0.4");
            applied = true;
            break;
        }
        libHRGE_Wait(0.25, c_timeGame);
    }
}
bool libHRGE_PurificationProtocolOncePerGame (bool testConds, bool runActions) {
    TriggerEnable(libGDHL_gt_HeroArtanisSpearofAdunPurifierBeamSetTarget, true);
    TriggerEnable(libGDHL_gt_HeroArtanisSpearofAdunPurifierBeamRedirectTarget2ElectricBoogaloo, true);
    TriggerEnable(libGDHL_gt_HeroArtanisSpearofAdunPurifierBeamUnitCreated, true);
    while (!libHRGE_GateIsOpen()) {
        libHRGE_Wait(0.0625, c_timeGame);
    }
    libHRGE_AffixPurificationProtocolCastBeam();
    return true;
}

