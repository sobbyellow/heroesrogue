            libHRGE_FortificationsCreateTower("TownCannonTowerL2", Point(142, 92), 90);
            libHRGE_FortificationsCreateTower("TownCannonTowerL2", Point(136, 47), 90);
        }
        if (count >= 3) {
            libHRGE_FortificationsCreateTower("TownCannonTowerL2", Point(172, 61), 270);
            libHRGE_FortificationsCreateTower("TownCannonTowerL2", Point(172, 162), 90);
            libHRGE_FortificationsCreateTower("TownCannonTowerL2", Point(164, 109), 0);
            libHRGE_FortificationsCreateTower("TownCannonTowerL2", Point(140, 126), 0);
        }
    }
    return true;
}

