// ============================================================
// Many Heroics
// ============================================================

void libHRGE_ApplyManyHeroics(int player, int level) {
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    if (hero == "Chromie") {
        level += 2;
    }
    if (level >= 10 && hero != "Varian"){
        libHRGE_SelectAllTalentsOnTier(player, 4);
    } else if (hero == "Varian" && level >= 4) {
        libHRGE_SelectAllTalentsOnTier(player, 2);
    }
}
bool libHRGE_ManyHeroics (bool testConds, bool runActions) {
    int i;
    int level;
    for (i = 6; i <= 10; i += 1) {
        level = UnitLevel(libHRGE_GetPlayerHeroUnit(i));
        libHRGE_ApplyManyHeroics(i, level);
    }
    return true;
}
bool libHRGE_ManyHeroicsLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (libGame_gf_TeamNumberOfPlayer(player) != libHRGE_teamChaosIndex) {
            return false;
        }
    }
    libHRGE_ApplyManyHeroics(player, level);
    return true;
}
// ============================================================
// Chained Down
// ============================================================
bool libHRGE_ChainedDownAffixAdded (bool testConds, bool runActions) {
    libHRGE_ChainedDownCurrentModifier = libHRGE_ChainedDownModifier * libHRGE_EventAffixCount();
    return true;
}
bool libHRGE_ChainedDownBehaviorChangeCategory (bool testConds, bool runActions) {
    unit unitVar = EventUnit();
    string behavior = EventUnitBehavior();
    fixed behaviorDuration;
    fixed newDuration;
    fixed percentIncrease;
    if (testConds) {
        if (!UnitHasBehavior2(unitVar, "AffixChainedDownBehavior")) {
            return false;
        }
    }

    behaviorDuration = UnitBehaviorDuration(unitVar, behavior);
    percentIncrease = 0.25 * UnitBehaviorCount(unitVar, "AffixChainedDownBehavior");

    if ((behaviorDuration > 0.0 && percentIncrease > 0.0)) {
        newDuration = (behaviorDuration * (1.0 + percentIncrease));
        UnitBehaviorSetDuration(unitVar, behavior, newDuration);
    }
    
    return true;
}
// ============================================================
// Relentless
// ============================================================
bool libHRGE_RelentlessAffixAdded (bool testConds, bool runActions) {
    libHRGE_RelentlessCurrentModifier = libHRGE_RelentlessModifier * libHRGE_EventAffixCount();
    return true;
}
bool libHRGE_RelentlessBehaviorChangeCategory (bool testConds, bool runActions) {
    unit unitVar = EventUnit();
    string behavior = EventUnitBehavior();
    fixed behaviorDuration;
    fixed newDuration;
    fixed percentDecrease;
    if (testConds) {
        if (!UnitHasBehavior2(unitVar, "AffixRelentlessController")) {
            return false;
        }
    }
    behaviorDuration = UnitBehaviorDuration(unitVar, behavior);
    percentDecrease = 0.15 * UnitBehaviorCount(unitVar, "AffixRelentlessController");

    if ((behaviorDuration > 0.0 && percentDecrease > 0.0)) {
        newDuration = (behaviorDuration * (1.0 - percentDecrease));
        UnitBehaviorSetDuration(unitVar, behavior, newDuration);
    }
    
    return true;
}
// ============================================================
// Overleveled
// ============================================================
bool libHRGE_OverleveledAffixAdded (bool testConds, bool runActions) {
    int stacks = libHRGE_EventAffixCountAdded();
    int currentLevel;
    int i;
    for (i = 6; i <= 10; i += 1) {
        UnitXPAddXP(libGame_gv_players[i].lv_heroUnit, null, StringToFixed(CatalogReferenceGet("Behavior,HeroXPCurve,VeterancyLevelArray[" + IntToString(UnitLevel(libGame_gv_players[i].lv_heroUnit)) +"].MinVeterancyXP", i)) + 1);
    }

    return true;
}

// ============================================================
// Critical Mass
// ============================================================
bool libHRGE_CriticalMassHT (bool testConds, bool runActions) {
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit killerUnit = libGame_gv_players[player].lv_heroUnit;
    unit deadUnit = libGame_gf_HeroParticipatedInTakedownKilledHero();

    if (testConds) {
        if (!UnitIsAlive(killerUnit)) {
            return false;
        }
        if (!libHRGE_PlayerIsHumanOrChoGallPair(player)) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }

    libHRGE_ResetCooldowns(killerUnit);
    
    return true;
}
