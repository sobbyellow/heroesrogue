// ============================================================
// Bad Mannerism
// ============================================================
bool libHRGE_BadMannerismHeroTakedown (bool testConds, bool runActions) {
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit killerUnit = libGame_gv_players[player].lv_heroUnit;
    unit deadUnit = libGame_gf_HeroParticipatedInTakedownKilledHero();
    int team = libGame_gf_TeamNumberOfPlayer(player);
    int i;
    if (testConds) {
        if (team != libHRGE_teamChaosIndex) {
            return false;
        }
        if (UnitGetOwner(deadUnit) != libHRGE_player) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    libHRGE_Wait(RandomFixed(0.25, 1.25), c_timeGame);
    for (i = 1; i <= RandomInt(6, 12); i += 1) {
        UnitIssueOrder(killerUnit, Order(AbilityCommand("Hearthstone", 0)), c_orderQueueReplace);
        libHRGE_Wait(RandomFixed(0.0625, 0.1875), c_timeGame);
        UnitIssueOrder(killerUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        libHRGE_Wait(0.0625, c_timeGame);
    }
    return true;
}
bool libHRGE_BadMannerismPeriodic (bool testConds, bool runActions) {
    int random = RandomInt(6, 10);
    unitgroup nearbyUnits;
    unit bmUnit = libGame_gv_players[random].lv_heroUnit;
    unit playerUnit;
    int nearbyUnitsCount;
    int i;
    if (testConds) {
        if (!UnitIsAlive(bmUnit)) {
            return false;
        }
        if (UnitHasBehavior2(bmUnit, "Mounted")) {
            return false;
        }
        if (libHRGE_gamePaused || libGame_gv_gameOver) {
            return false;
        }
    }
    
    nearbyUnits = UnitGroup(null, libHRGE_player, RegionCircle(UnitGetPosition(bmUnit), 12), null, 0);
    nearbyUnitsCount = UnitGroupCount(nearbyUnits, c_unitCountAll);
    for (;; nearbyUnitsCount -= 1) {
        if (nearbyUnitsCount <= 0) { break; }
        playerUnit = UnitGroupUnitFromEnd(nearbyUnits, nearbyUnitsCount);
        if (UnitTypeTestAttribute(UnitGetType(bmUnit), c_unitAttributeHeroic)) {
            random = RandomInt(1, 100);
            if (random <= 66) {
                UnitIssueOrder(bmUnit, Order(AbilityCommand("LootSpray", 0)), c_orderQueueReplace);
            } else if (random <= 100) {
                UnitIssueOrder(bmUnit, Order(AbilityCommand("LootYellVoiceLine", 0)), c_orderQueueReplace);
            }
        }
    }
    return true;
}
bool libHRGE_BadMannerism (bool testConds, bool runActions) {
    int i;
    for (i = 6; i <= 10; i += 1) {
        PlayerSetSpray(i, "RandomSpray");
        libGame_gf_HeroSelectionRandomlyPickSpray(i);
    }
    
    return true;
}
// ============================================================
// Sabotage
// ============================================================
bool libHRGE_SabotageOncePerGame (bool testConds, bool runActions) {
    unitgroup structures = UnitGroup(null, libHRGE_teamOrder, RegionEntireMap(), libCore_gv_filtersStructure, 0);
    int structureCount = UnitGroupCount(structures, c_unitCountAll);
    unit structure;
    libHRGE_CopyFilter(libHRGE_filterAlliedStructures, libHRGE_filterSabotage);
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterSabotage, "TownMoonwellL3");
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterSabotage, "TownMoonwellL2");
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterSabotage, "ItemMULE");
    if (libCore_gv_mAPMapStringID == "TowersOfDoom") {
        libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterSabotage, "KingsCore");
    }
    for (;; structureCount -= 1) {
        if (structureCount <= 0) { break; }
        structure = UnitGroupUnitFromEnd(structures, structureCount);

        if (libHRGE_UnitMatchesFilter(structure, libHRGE_filterSabotage)) {
            UnitSetPropertyFixed(structure, c_unitPropLife, UnitGetPropertyFixed(structure, c_unitPropLife, true) * 0.5);
            UnitBehaviorAdd(structure, "SabotageDebuff", structure, 1);
        }
    }

    return true;
}
bool libHRGE_SabotageUnitCreated (bool testConds, bool runActions) {
    unit created = EventUnitCreatedUnit();
    if (testConds) {
        if (UnitGetOwner(created) != libHRGE_teamOrder) {
            return false;
        }
        if (!libHRGE_UnitMatchesFilter(created, libHRGE_filterSabotage)) {
            return false;
        }
    }
    while (UnitHasBehavior2(created, "StructureOwnershipChangeRepairBehavior")) {
        libHRGE_Wait(0.0625, c_timeGame);
    }
    UnitSetPropertyFixed(created, c_unitPropLife, UnitGetPropertyFixed(created, c_unitPropLife, true) * 0.5);
    UnitBehaviorAdd(created, "SabotageDebuff", created, 1);
    return true;
}
bool libHRGE_SabotageUnitChangeOwner (bool testConds, bool runActions) {
    unit changed = EventUnit();
    while (UnitHasBehavior2(changed, "StructureOwnershipChangeRepairBehavior")) {
        libHRGE_Wait(0.0625, c_timeGame);
    }
    libHRGE_UpdateUnitBehaviorFilter(changed, "SabotageDebuff", 1, libHRGE_filterSabotage);
    if (libHRGE_UnitMatchesFilter(changed, libHRGE_filterSabotage)) {
        UnitSetPropertyFixed(changed, c_unitPropLife, UnitGetPropertyFixed(changed, c_unitPropLife, true) * 0.5);
    } else {
        UnitSetPropertyFixed(changed, c_unitPropLife, UnitGetPropertyFixed(changed, c_unitPropLife, true));
    }
    return true;
}

