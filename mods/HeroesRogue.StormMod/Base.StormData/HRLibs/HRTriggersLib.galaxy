// Experience Hoarder
// ============================================================
bool libHRGE_ExperienceHoarderAffixAdded (bool testConds, bool runActions) {
    fixed xp = StringToFixed(libHRGE_GetAffixCustomValue(libHRGE_instanceExperienceHoarder));
    int player;
    playergroup playerGroup;
    if (xp > 0) {
        if (libGame_sharedXPDisabled[libGame_gv_teamOrderIndex_C]) {
            libGame_gf_GrantXPToPlayer(xp, libHRGE_player, libGame_ge_XPSources_External);
        } else {
            playerGroup = PlayerGroupCopy(libGame_gf_AlliedPlayerGroupOfPlayer(libHRGE_player));
            while (true) {
                player = PlayerGroupNextPlayer(playerGroup, player);
                if (player<0) { break; }
                libGame_gf_GrantXPToPlayer(xp, player, libGame_ge_XPSources_External);
            }
        }
    }

    return true;
}
bool libHRGE_ExperienceHoarderWin (bool testConds, bool runActions) {
    libHRGE_SetAffixCustomValue(libHRGE_instanceExperienceHoarder, FixedToString(UnitXPTotal(libGame_gv_players[libHRGE_player].lv_heroUnit) * libHRGE_ExperienceHoarderModifier, 2));
    return true;
}
