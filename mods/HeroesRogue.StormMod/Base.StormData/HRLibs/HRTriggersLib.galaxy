bool libHRGE_LevelDisadvantageOncePerGame (bool testConds, bool runActions) {
    int i;
    int i2;
    int heroLevel;
    unit heroUnit;
    for (i = 1; i <= 4; i += 1) {
        for (i2 = 6; i2 <= 10; i2 += 1) {
            heroUnit = libGame_gv_players[i2].lv_heroUnit;
            heroLevel = UnitLevel(heroUnit);
            if (heroLevel < 4) {
                UnitXPAddXP(heroUnit, null, StringToFixed(CatalogReferenceGet("Behavior,HeroXPCurve,VeterancyLevelArray[" + IntToString(heroLevel) +"].MinVeterancyXP", i2)) + 1);
            }
        }
    }
    libGame_xpModifier[libGame_gv_teamChaosIndex_C] += 0.25;

    return true;
}
// ============================================================
// Cursed
// ============================================================

bool libHRGE_CursedHeroKilled (bool testConds, bool runActions) {
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    int killingPlayer = libGame_gf_HeroKilledKillingPlayer();
    int i;
    if (testConds) {
        if (libGame_gv_gameOver) {
            return false;
        }
        if (deadPlayer != libHRGE_player) {
            return false;
        }
        if (!(UnitTestState(deadUnit, c_unitStateHallucination) == false)) {
            return false;
        }
        if (!UnitTypeTestAttribute(UnitGetType(deadUnit), c_unitAttributeHeroic)) {
            return false;
        }
    }
    libHRGE_cursedDeaths += 1;
    if (libHRGE_cursedDeaths >= 3) {
        libHRGE_cursedDeaths = 0;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Message/CurseCursed"));
        libHRGE_QueueCurse(1, false);
    }
    return true;
}
bool libHRGE_CursedLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
        if (level < 20) {
            return false;
        }
    }
    TimerStart(libHRGE_GetAffixPrimaryTimer(libHRGE_instanceCursed), 60, true, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), false);
    
    return true;
}
bool libHRGE_CursedTimerElapsed (bool testConds, bool runActions) {
    int i;
    int level = UnitLevel(libGame_gv_players[libHRGE_player].lv_heroUnit);
    fixed modifier;
    if (level < 30) {
        modifier = -5;
    } else {
        modifier = -100;
    }
    for (i = 1; i <= 5; i += 1) {
        libHRGE_CatalogReferenceModify("Behavior,CursedDebuff,ArmorModification.AllArmorBonus", i, FixedToString(modifier, 0), c_upgradeOperationAdd);
    }
    return true;
}

