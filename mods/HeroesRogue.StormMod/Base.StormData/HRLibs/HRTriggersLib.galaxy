
include "HRLibs/HeroesRogueLib_h"
include "HRLibs/HRTriggersLib_h"

// ============================================================
// Nano Boost
// ============================================================
bool libHRGE_NanoBoostAffixAdded (bool testConds, bool runActions) {
    libHRGE_NanoBoostCurrentCDRModifier = libHRGE_NanoBoostCDRModifier * libHRGE_EventAffixCount();
    return true;
}
bool libHRGE_NanoBoostBehaviorChange (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    while (UnitHasBehavior2(heroUnit, "AffixNanoBoost")) {
        while ((UnitHasBehaviorWithCategoryFlag(heroUnit, c_behaviorCategoryTimeStop) == true) || libHRGE_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libHRGE_ModifyAllCooldowns(heroUnit, -(libHRGE_NanoBoostCurrentCDRModifier / 16), false, false, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}
// ============================================================
// Blessing of the Dragons
// ============================================================
bool libHRGE_BlessingoftheDragonsAffixAdded (bool testConds, bool runActions) {
    libHRGE_BlessingoftheDragonsCurrentCDRModifier = libHRGE_BlessingoftheDragonsCDRModifier * libHRGE_EventAffixCount();
    return true;
}
bool libHRGE_BlessingoftheDragonsBehaviorChange (bool testConds, bool runActions) {
    while ((UnitHasBehavior2(EventUnit(), "AffixBlessingoftheDragons") == true)) {
        while ((UnitHasBehaviorWithCategoryFlag(EventUnit(), c_behaviorCategoryTimeStop) == true) || libHRGE_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libHRGE_ModifyAllCooldowns(EventUnit(), -(libHRGE_BlessingoftheDragonsCurrentCDRModifier / 16), false, false, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}
// ============================================================
// BUDDY
// ============================================================
void libHRGE_AddBuddy(int player, unit ownerUnit, int count) {
    if (UnitGetType(ownerUnit) == "HeroErik") {
        libHRGE_CurrentBuddyCount3[player] += count;
    } else if (UnitGetType(ownerUnit) == "HeroBaleog" || UnitGetType(ownerUnit) == "RexxarMisha") {
        libHRGE_CurrentBuddyCount2[player] += count;
    } else {
        libHRGE_CurrentBuddyCount1[player] += count;
    }
}
int libHRGE_GetBuddyCount(int player, unit ownerUnit) {
    if (UnitGetType(ownerUnit) == "HeroErik") {
        return libHRGE_CurrentBuddyCount3[player];
    } else if (UnitGetType(ownerUnit) == "HeroBaleog" || UnitGetType(ownerUnit) == "RexxarMisha") {
        return libHRGE_CurrentBuddyCount2[player];
    } else {
        return libHRGE_CurrentBuddyCount1[player];
    }
}
bool libHRGE_BuddyAI (bool testConds, bool runActions) {
    const int buddyIdleState = 1;
    const int buddyLeashingState = 2;
    const int buddyMovingState = 3;
    const int buddyCirclingState = 4;

    fixed buddyFollowRange = 8;
    fixed buddyTeleportRange = buddyFollowRange * 3;

    unit ownerUnit = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    unit buddyUnit;
    int ownerPlayer = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    int currentState = buddyIdleState;
    fixed circleAngle;
    unit activeUnit;
    if (testConds) {
        if (UnitGetType(ownerUnit) == "HeroLostVikingsController") {
            return false;
        }
        if (UnitGetType(ownerUnit) == "LongboatRaidBoat") {
            return false;
        }
        if (libHRGE_CurrentBuddyCount1[ownerPlayer] >= libHRGE_BuddyCount[ownerPlayer]) {
            return false;
        }
    }

    libNtve_gf_CreateUnitsAtPoint2(1, "AffixBuddyDrone", 0, ownerPlayer, PointWithOffsetPolar(UnitGetPosition(ownerUnit), 1.5, libNtve_gf_RandomAngle()), ownerUnit);
    buddyUnit = UnitLastCreated();
    UnitGroupAdd(libGame_gv_players[ownerPlayer].lv_summonedUnitGroup, buddyUnit);
    libHRGE_AddBuddy(ownerPlayer, ownerUnit, 1);
    circleAngle = RandomFixed(0, 360);
    while ((UnitIsAlive(buddyUnit) == true) && (UnitIsAlive(ownerUnit) == true) && (UnitHasBehavior2(ownerUnit, "Dead") == false)) {
        circleAngle += 2.15;
        if (circleAngle >= 360) {
            circleAngle -= 360;
        }
        if (UnitGetType(ownerUnit) == "HeroAbathur" && UnitHasBehavior2(ownerUnit, "SymbioteCasterDummyBehavior")) { 
            activeUnit = libGDHL_gv_heroAbathurSymbioteUnit[ownerPlayer];
        } else if (UnitGetType(ownerUnit) == "HeroAbathur" && UnitHasBehavior2(ownerUnit, "AbathurUltimateEvolutionVehicleCasterBehavior")) { 
            activeUnit = libGame_gv_players[ownerPlayer].lv_activeVehicle;
        } else if (libGame_gv_players[ownerPlayer].lv_activeVehicle != null && libNtve_gf_UnitIsInsideTransport(ownerUnit)) {
            activeUnit = UnitTransport(ownerUnit);
        } else if (UnitGetType(ownerUnit) == "HeroDVaPilot" && libNtve_gf_UnitIsInsideTransport(ownerUnit)) {
            activeUnit = UnitTransport(ownerUnit);
        } else if (UnitHasBehavior2(ownerUnit, "LongboatRaidHideVikings")) {
            activeUnit = libGDHL_gv_lostVikingsPlayer[ownerPlayer].lv_boat;
        } else {
            activeUnit = ownerUnit;
        }
        
        while (UnitHasBehaviorWithCategoryFlag(activeUnit, c_behaviorCategoryTimeStop)) {
            UnitGroupRemove(libGame_gv_players[ownerPlayer].lv_summonedUnitGroup, buddyUnit);
            UnitKill(buddyUnit);
            Wait(0.0625, c_timeGame);
        }
        // Heal owner
        if (UnitGroupCount(UnitGetTrackedUnitGroup(buddyUnit, "AffixBuddyHealUnitTracker"), c_unitCountAll) <= 0) {
            if (UnitHasBehavior2(activeUnit, "StormEarthFireCasterBehavior")) {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), UnitGroupUnit(libGDHL_gv_heroChenStormEarthFireUnits[ownerPlayer].lv_stormEarthFireUnits, 1)), c_orderQueueReplace);
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), UnitGroupUnit(libGDHL_gv_heroChenStormEarthFireUnits[ownerPlayer].lv_stormEarthFireUnits, 2)), c_orderQueueReplace);
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), UnitGroupUnit(libGDHL_gv_heroChenStormEarthFireUnits[ownerPlayer].lv_stormEarthFireUnits, 3)), c_orderQueueReplace);
            } else if (ownerPlayer == libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_gallPlayer) {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), libGame_gv_players[libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_choPlayer].lv_heroUnit), c_orderQueueReplace);
            } else if (UnitGetType(activeUnit) == "AbathurSymbiote" && UnitTypeTestAttribute(UnitGetType(libGDHL_gv_heroAbathurSymbioteHost[ownerPlayer]), c_unitAttributeHeroic)) {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), libGDHL_gv_heroAbathurSymbioteHost[ownerPlayer]), c_orderQueueReplace);
            } else {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), activeUnit), c_orderQueueReplace);
            }
        }
        // Movement
        if (UnitOrderCount(buddyUnit) <= 1) {
            if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) >= buddyTeleportRange)) {
                UnitSetPosition(buddyUnit, PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.5, libNtve_gf_RandomAngle()), false);
                UnitIssueOrder(buddyUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                currentState = buddyIdleState;
            }
            else if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) >= buddyFollowRange) && (currentState != buddyLeashingState)) {
                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), -1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                currentState = buddyLeashingState;
            }

            if (currentState == buddyIdleState && UnitOrderCount(buddyUnit) != 0 && OrderGetAbilityCommand(UnitOrder(activeUnit, 0)) == AbilityCommand("move", 0)) {
                if ((DistanceBetweenPoints(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), UnitGetPosition(buddyUnit)) > buddyFollowRange)) {
                    UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                    currentState = buddyMovingState;
                }
            }
            
            if (currentState == buddyIdleState && UnitOrderCount(buddyUnit) == 0) {
                currentState = buddyCirclingState;
                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), buddyFollowRange / 1.75, circleAngle)), c_orderQueueReplace);
            } else if (currentState == buddyCirclingState) {
                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), buddyFollowRange / 1.75, circleAngle)), c_orderQueueReplace);
            } else if (currentState == buddyMovingState) {
                if ((UnitOrderCount(buddyUnit) == 0)) {
                    currentState = buddyIdleState;
                } else {
                    if ((UnitOrderCount(activeUnit) == 0)) {
                        if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) <= buddyFollowRange)) {
                            UnitIssueOrder(buddyUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                            currentState = buddyIdleState;
                        }
                    }
                    else if ((OrderGetAbilityCommand(UnitOrder(activeUnit, 0)) == AbilityCommand("move", 0))) {
                        if ((DistanceBetweenPoints(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), OrderGetTargetPosition(UnitOrder(buddyUnit, 0))) > buddyFollowRange / 2)) {
                            UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                            currentState = buddyMovingState;
                        }
                    }
                }
            } else if (currentState == buddyLeashingState) {
                if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) <= buddyFollowRange)) {
                    UnitIssueOrder(buddyUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                    currentState = buddyIdleState;
                }
                else {
                    if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) <= buddyFollowRange) && (UnitOrderCount(buddyUnit) == 0)) {
                        if ((UnitOrderCount(activeUnit) == 0)) {
                            currentState = buddyIdleState;
                        }
                        else {
                            UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                            currentState = buddyLeashingState;
                        }
                    }
                    else {
                        if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) > buddyFollowRange) && (UnitOrderCount(buddyUnit) == 0)) {
                            UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                            currentState = buddyLeashingState;
                        }
                        else {
                            if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), OrderGetTargetPoint(UnitOrder(buddyUnit, 0))) <= buddyFollowRange) && (DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) > buddyFollowRange)) {
                                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                                currentState = buddyLeashingState;
                            }
                        }
                    }
                }
            }
        }
        libHRGE_Wait(0.0625, c_timeGame);
    }
    libHRGE_AddBuddy(ownerPlayer, ownerUnit, -1);
    UnitGroupRemove(libGame_gv_players[ownerPlayer].lv_summonedUnitGroup, buddyUnit);
    UnitKill(buddyUnit);
    UnitBehaviorRemove(ownerUnit, "AffixBuddyDroneOwner", 1);

    return true;
}
bool libHRGE_BuddyCheck (bool testConds, bool runActions) {
    unit user = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    int i;
    int totalBuddies = libHRGE_CurrentBuddyCount1[player] + libHRGE_CurrentBuddyCount2[player] + libHRGE_CurrentBuddyCount3[player];
    if (testConds) {
        if (totalBuddies >= libHRGE_BuddyCount[player]) {
            return false;
        }
        if (!UnitIsAlive(user)) {
            return false;
        }
    }
    for (i = 1; i <= (libHRGE_BuddyCount[player] - totalBuddies); i += 1) {
        totalBuddies = libHRGE_CurrentBuddyCount1[player] + libHRGE_CurrentBuddyCount2[player] + libHRGE_CurrentBuddyCount3[player];
        if (totalBuddies >= libHRGE_BuddyCount[player]) {
            break;
        }
        if (UnitGetType(user) == "HeroErik") {
            if (libHRGE_CurrentBuddyCount3[player] < libHRGE_CurrentBuddyCount1[player] && libHRGE_CurrentBuddyCount3[player] < libHRGE_CurrentBuddyCount2[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "HeroBaleog") {
            if (libHRGE_CurrentBuddyCount2[player] < libHRGE_CurrentBuddyCount1[player] && libHRGE_CurrentBuddyCount2[player] <= libHRGE_CurrentBuddyCount3[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "HeroOlaf") {
            if (libHRGE_CurrentBuddyCount1[player] <= libHRGE_CurrentBuddyCount2[player] && libHRGE_CurrentBuddyCount1[player] <= libHRGE_CurrentBuddyCount3[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "RexxarMisha") {
            if (libHRGE_CurrentBuddyCount2[player] < libHRGE_CurrentBuddyCount1[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "HeroRexxar") {
            if (libHRGE_CurrentBuddyCount1[player] <= libHRGE_CurrentBuddyCount2[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else {
            UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
        }
        libHRGE_Wait(0.0625, c_timeGame);
    }

    return true;
}
bool libHRGE_BuddyScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int count = libHRGE_GetAffixCount(libHRGE_instanceBuddy);
    if (testConds) {
        if (libGame_gf_TeamNumberOfPlayer(player) != libHRGE_teamOrderIndex) {
            return false;
        }
    }
    if (count > 0) {
        libHRGE_SetLevelScalingAndValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", player, 0.04, StringToFixed(libHRGE_GetCatalogDefaultValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate")) * 0.75);
        libHRGE_SetLevelScalingAndValue("Effect,AffixBuddyDroneMissileDamage,Amount", player, 0.04, StringToFixed(libHRGE_GetCatalogDefaultValue("Effect,AffixBuddyDroneMissileDamage,Amount")) * 0.75);
    } else {
        libHRGE_SetDefaultLevelScaling("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", player);
        libHRGE_SetDefaultLevelScaling("Effect,AffixBuddyDroneMissileDamage,Amount", player);
    }

    return true;
}
bool libHRGE_BuddyAffixAdded (bool testConds, bool runActions) {
    int count = libHRGE_EventAffixCount();
    libHRGE_CatalogModifyForAllPlayers("Behavior,AffixBuddyDroneController,Period", FixedToString(4 - (count - 1), 2));
    libHRGE_CatalogModifyForAllPlayers("Effect,AffixBuddyHealCreatePersistent,PeriodicPeriodArray[0]", FixedToString(3 - 0.25 * (count - 1), 2));
    return true;
}
bool libHRGE_BuddyOncePerGame (bool testConds, bool runActions) {
    string hero;
    int i;
    for (i = 1; i <= 5; i += 1) {
        hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[i].lv_heroIndex);
        if (hero == "LostVikings") {
            libHRGE_BuddyCount[i] = 3;
        } else if (hero == "Rexxar") {
            libHRGE_BuddyCount[i] = 2;
        } else {
            libHRGE_BuddyCount[i] = 1;
        }
    }
    libHRGE_AddPlayerBehaviorWithExclusion(libHRGE_player, "AffixBuddyDroneSpawnBehavior", 1, true, "HeroDVaMech");
    return true;
}

// ============================================================
// Memory Shortage
// ============================================================
bool libHRGE_MemoryShortage (bool testConds, bool runActions) {
    int amount = libHRGE_EventAffixCount();
    int difficulty;
    int i;
    
    if (amount == 1) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIVeryHard;
    } else if (amount == 2) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIMedium;
    } else if (amount == 3) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIEasy;
    } else if (amount == 4) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIVeryEasy;
    } else {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIElite;
    }
    libHRGE_Wait(1.25, c_timeGame);
    for (i = 2; i <= 5; i += 1) {
        libAIAI_gf_HeroAISetAIDifficultyLevel(i, difficulty);
        UnitIssueOrder(libAIAI_gv_aIHeroes[i].lv_currentHeroUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        AIEnableForPlayer(i, (libAIAI_gv_aIHeroes[i].lv_difficulty));
        DialogControlHookupStandard(c_triggerControlTypeLabel, ("UIContainer/FullscreenUpperContainer/HeroLeaderPanel/HeroLeaderPanelContainer/TabControl/PlayerFrame" + IntToString(i - 1) + "/PlayerNameFrame/PlayerNameLabel"));
        libNtve_gf_SetDialogItemText(DialogControlLastCreated(), StringToText("AI - ") + libAIAI_gf_HeroAIDifficultyDisplayText(i), PlayerGroupAll());
    }

    return true;
}
// ============================================================
// No Fountain
// ============================================================
bool libHRGE_NoFountain (bool testConds, bool runActions) {
    unitgroup unitGroup = UnitGroup(null, libHRGE_teamOrder, RegionEntireMap(), libCore_gv_filtersStructure, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    unit unitvar;
    for (;; i -= 1) {
        unitvar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitvar == null) { break; }
        if (UnitGetType(unitvar) == "TownMoonwellL3" || UnitGetType(unitvar) == "TownMoonwellL2" || UnitGetType(unitvar) == "TownMoonwell") {
            UnitKill(unitvar);
        }
    }
    return true;
}
// ============================================================
// Bad Bargain
// ============================================================
bool libHRGE_BadBargainAffixAdded (bool testConds, bool runActions) {
    libHRGE_BadBargainCurrentModifier = libHRGE_BadBargainModifier * libHRGE_EventAffixCount();
    return true;
}
bool libHRGE_BadBargainUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = UnitGetOwner(deadUnit);
    fixed deathDuration;
    if (testConds) {
        if (libGame_gv_gameOver) {
            return false;
        }
        if (!(deadPlayer >= 1 && deadPlayer <= 5)) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
        if (libHRGE_AffixCooldownReady(libHRGE_instanceResurgenceoftheStorm)) {
            return false;
        }
        if (UnitGetType(deadUnit) != "RexxarMisha") {
            return false;
        }
    }
    deathDuration = TimerGetRemaining(libGDHL_gv_mishaDeathTimer[deadPlayer]);
    libNtve_gf_StopTimer(libGDHL_gv_mishaDeathTimer[deadPlayer]);
    TimerStart(libGDHL_gv_mishaDeathTimer[deadPlayer], deathDuration * (1 + libHRGE_BadBargainCurrentModifier), false, c_timeGame);
    UnitBehaviorSetDuration(libGame_gv_players[deadPlayer].lv_heroUnit, "RexxarSpiritBondCooldown", deathDuration * (1 + libHRGE_BadBargainCurrentModifier));
    UnitModifyCooldown(libGame_gv_players[deadPlayer].lv_heroUnit, "Abil/RexxarMishaFocus", deathDuration * (1 + libHRGE_BadBargainCurrentModifier), c_cooldownOperationSet);
    return true;
}
bool libHRGE_BadBargainHeroKilled (bool testConds, bool runActions) {
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    int killingPlayer = libGame_gf_HeroKilledKillingPlayer();
    fixed deathTime;
    fixed deathDuration;
    string unitType = UnitGetType(deadUnit);
    if (testConds) {
        if (libGame_gv_gameOver) {
            return false;
        }
        if (!(deadPlayer >= 1 && deadPlayer <= 5)) {
            return false;
        }
        if (deadUnit != libGame_gv_players[deadPlayer].lv_heroUnit && UnitGetType(libGame_gv_players[deadPlayer].lv_heroUnit) != "HeroLostVikingsController") {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
        if (libGame_diabloUsedSouls[deadPlayer] && unitType == "HeroDiablo") {
            return false;
        }
        if (libHRGE_AffixCooldownReady(libHRGE_instanceResurgenceoftheStorm)) {
            return false;
        }
    }
    if (unitType == "HeroMurky" && !((UnitIsAlive(libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer]) == false) || (libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer] == null))) {
        deathTime = libCore_gv_bALMurkyWithEggDeathTime * (1 + libHRGE_BadBargainCurrentModifier);
    } else {
        deathTime = libCore_gf_HeroDeathTime(deadPlayer, UnitLevel(libGame_gv_players[deadPlayer].lv_heroUnit)) * (1 + libHRGE_BadBargainCurrentModifier);
    }
    if (unitType == "HeroLeoric") {
        libGame_gf_HeroDeathStartRespawnTimer(deadPlayer, deathTime);
        libNtve_gf_SendActorMessageToUnit(deadUnit, "SetShowStatusBar 1");
        if ((TimerGetDuration(libGame_gv_players[deadPlayer].lv_respawnTimer) > 0.0)) {
            UnitBehaviorSetDuration(deadUnit, "LeoricUndying", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
            UnitBehaviorSetDuration(deadUnit, "Dead", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
            libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] = UnitBehaviorDurationTotal(deadUnit, "LeoricUndying");
        }
        else {
            UnitBehaviorSetDuration(deadUnit, "LeoricUndying", 0.0);
            UnitBehaviorSetDuration(deadUnit, "Dead", 0.0);
            libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] = UnitBehaviorDurationTotal(deadUnit, "LeoricUndying");
        }
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "LeoricUndyingLifeRegenModifyUnit", "VitalArray[" + IntToString(0) + "].ChangeFraction", deadPlayer, (0.5 / (libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] - 2.0)));
    } else if (unitType == "HeroOlaf") {
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer, TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer) * (1 + libHRGE_BadBargainCurrentModifier), false, c_timeGame);
    } else if (unitType == "HeroBaleog") {
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer, TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer) * (1 + libHRGE_BadBargainCurrentModifier), false, c_timeGame);
    } else if (unitType == "HeroErik") {
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer, TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer) * (1 + libHRGE_BadBargainCurrentModifier), false, c_timeGame);
    } else {
        libGame_gf_HeroDeathStartRespawnTimer(deadPlayer, deathTime);
        libGame_gf_HeroDeathUpdateUIElementsForDeath(true, true, true, deadPlayer, killingPlayer);
        libGame_gf_HeroDeathEnableDisableDeadSoundStateForPlayer(true, deadPlayer);
        libGame_gf_HeroDeathPortHeroBackAndSetDeathState(deadPlayer, libGame_gv_players[deadPlayer].lv_spawnPoint);
    }
    return true;
}

// ============================================================
// Chrono Boost
// ============================================================
bool libHRGE_ChronoBoostAffixAdded (bool testConds, bool runActions) {
    libHRGE_ChronoBoostCurrentCDRModifier = libHRGE_ChronoBoostCDRModifier * libHRGE_EventAffixCount();
    return true;
}
bool libHRGE_ChronoBoostBehaviorChange (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    while ((UnitHasBehavior2(eventUnit, "AffixChronoBoostBehavior") == true)) {
        while ((UnitHasBehaviorWithCategoryFlag(eventUnit, c_behaviorCategoryTimeStop) == true) || libHRGE_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libHRGE_ModifyAllCooldowns(eventUnit, -(libHRGE_ChronoBoostCurrentCDRModifier) / 16, true, true, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}

// ============================================================
// Experienced
// ============================================================
bool libHRGE_Experienced (bool testConds, bool runActions) {
    int affixCount = libHRGE_EventAffixCount();
    fixed modifier = 0.15 + 0.10 * (affixCount - 1);
    fixed difference = modifier - libHRGE_ExperiencedCurrentModifier;

    libGame_xpModifier[libGame_gv_teamOrderIndex_C] += difference;
    libHRGE_ExperiencedCurrentModifier = modifier;

    return true;
}
// ============================================================
// Backdoor Protection
// ============================================================
bool libHRGE_AlteracsLegacy (bool testConds, bool runActions) {
    int fortCount = UnitCount("TownTownHallL2", libHRGE_teamChaos, RegionEntireMap(), libCore_gv_filtersStructure, 0);
    libHRGE_CopyFilter(libHRGE_filterEnemyStructures, libHRGE_filterAlteracsLegacy);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlteracsLegacy, "TownCannonTowerL3");
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlteracsLegacy, "TownTownHallL3");

    libHRGE_AddUnitBehaviorToAllFilter("AffixBackdoorProtection", fortCount, libHRGE_filterAlteracsLegacy);

    return true;
}
bool libHRGE_AlteracsLegacyUnitDied (bool testConds, bool runActions) {
    unit dyingStructure = EventUnit();
    int townIndex = libGame_gf_TownGetTownForUnit(dyingStructure);
    int victimTeam = libGame_gf_TeamNumberOfPlayer(UnitGetOwner(dyingStructure));

    if (testConds) {
        if (!UnitTypeTestAttribute(UnitGetType(dyingStructure), c_unitAttributeStructure)) {
            return false;
        }
        if (UnitGetType(dyingStructure) != "TownTownHallL2") {
            return false;
        }
        if (victimTeam != libHRGE_teamChaosIndex) {
            return false;
        }
    }
    libHRGE_RemoveUnitBehaviorFromAllFilter("AffixBackdoorProtection", 1, libHRGE_filterAlteracsLegacy);

    return true;
}
