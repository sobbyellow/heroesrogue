// ============================================================
// Auto MULE
// ============================================================
bool libHRGE_AutoMULEAffixAdded (bool testConds, bool runActions) {
    libHRGE_AutoMULECurrentCooldown = libHRGE_AutoMULECooldown - (libHRGE_AutoMULECDRPerStack * (libHRGE_EventAffixCount() - 1));

    return true;
}
bool libHRGE_AutoMULETimerElapsed (bool testConds, bool runActions) {
    unitgroup unitGroup;
    unitgroup structures;
    int i;
    unit unitVar;

    while (!libHRGE_GateIsOpen()) {
        libHRGE_Wait(0.0625, c_timeGame);
    }

    while (true) {
        unitGroup = UnitGroup(null, libHRGE_teamOrder, RegionEntireMap(), libCore_gv_filtersStructure, 0);
        i = UnitGroupCount(unitGroup, c_unitCountAll);
        structures = UnitGroupEmpty();
        for (;; i -= 1) {
            unitVar = UnitGroupUnitFromEnd(unitGroup, i);
            if (unitVar == null) { break; }
            if (UnitGetType(unitVar) == "TownCannonTowerL2" || UnitGetType(unitVar) == "TownCannonTowerL3" || UnitGetType(unitVar) == "TownCannonTowerL2Standalone" || UnitGetType(unitVar) == "TownCannonTowerL3Standalone" || UnitGetType(unitVar) == "TownTownHallL2" || UnitGetType(unitVar) == "TownTownHallL3" || ( UnitGetType(unitVar) == "KingsCore" && libCore_gv_mAPMapStringID != "TowersOfDoom") ) {
                if (UnitGetPropertyFixed(unitVar, c_unitPropLife, true) < UnitGetPropertyFixed(unitVar, c_unitPropLifeMax, true)) {
                    UnitGroupAdd(structures, unitVar);
                }
            }
        }
        if (UnitGroupCount(structures, c_unitCountAlive) > 0) {
            PlayerCreateEffectPoint(libHRGE_teamOrder, "CalldownMULEDummySet", UnitGetPosition(UnitGroupRandomUnit(structures, c_unitCountAlive)));
            TimerStart(libHRGE_GetCurrentAffixTimer(), libHRGE_AutoMULECurrentCooldown, false, c_timeGame);
            return true;
        }
        libHRGE_Wait(1, c_timeGame);
    }

    return true;
}
