// ============================================================
// Kill Contract
// ============================================================
bool libHRGE_KillContractQuest (bool testConds, bool runActions) {
    libHRGE_AddPlayerBehavior(libHRGE_player, "AffixKillContractQuestToken", 1, false);
    return true;
}
bool libHRGE_KillContractQuestComplete (bool testConds, bool runActions) {
    if (testConds) {
        if (libHRGE_KillContractSuppressRewards) {
            return false;
        }
        if (libHRGE_AffixQuestDone(libHRGE_instanceKillContract)) {
            return false;
        }
    }
    libHRGE_QueueBoon(libHRGE_rarityCommon, 1, false, true);
    libHRGE_QueueBoon(libHRGE_rarityUncommon, 1, false, true);
    libHRGE_SetAffixQuestDone(libHRGE_instanceKillContract, true);
    
    return true;
}
bool libHRGE_KillContractHeroTakedown (bool testConds, bool runActions) {
    int maxStacks = 25;
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit playerUnit = libGame_gv_players[player].lv_heroUnit;
    if (testConds) {
        if (!libHRGE_PlayerHasBehavior(player, "AffixKillContractQuestToken")) {
            return false;
        }
        if (!(libHRGE_PlayerBehaviorCount(player, "AffixKillContractQuestToken") < maxStacks)) {
            return false;
        }
    }

    libHRGE_UnitCreateEffectUnit(player, "AffixKillContractIncrementToken");
    libHRGE_AddAffixQuestProgress(libHRGE_instanceKillContract, 1);
    
    return true;
}
bool libHRGE_KillContractUnitBehaviorCreate (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    if (testConds) {
        if (!UnitHasBehavior2(heroUnit, "AffixKillContractQuestToken")) {
            return false;
        }
    }
    libHRGE_KillContractSuppressRewards = true;
    UnitSetTokenCount(heroUnit, "AffixKillContractQuestToken", libHRGE_GetAffixQuestProgress(libHRGE_instanceKillContract), heroUnit);
    libHRGE_Wait(0.125, c_timeGame);
    libHRGE_KillContractSuppressRewards = false;
    return true;
}

// ============================================================
// Destruction
// ============================================================

bool libHRGE_DestructionQuest (bool testConds, bool runActions) {
    fixed questProgress = libHRGE_GetAffixQuestProgress(libHRGE_instanceDestruction);
    libHRGE_AddPlayerBehavior(libHRGE_player, "AffixDestructionToken", 1, false);
    
    if (questProgress > 0) {
        libHRGE_DestructionSuppressRewards = true;
        libHRGE_ModifyPlayerTokenCount(libHRGE_player, FixedToInt(questProgress), "AffixDestructionToken");
        libHRGE_Wait(0.125, c_timeGame);
        libHRGE_DestructionSuppressRewards = false;
    }
    
    return true;
}
bool libHRGE_DestructionUnitDied (bool testConds, bool runActions) {
    int maxStacks = 24;
    unit dyingStructure = EventUnit();
    int victimTeam = libGame_gf_TeamNumberOfPlayer(UnitGetOwner(dyingStructure));
    unit playerUnit = libGame_gv_players[libHRGE_player].lv_heroUnit;

    if (testConds) {
        if (!UnitTypeTestAttribute(UnitGetType(dyingStructure), c_unitAttributeStructure)) {
            return false;
        }
        if (UnitGetType(dyingStructure) != "TownTownHallL2" && UnitGetType(dyingStructure) != "TownTownHallL3") {
            return false;
        }
        if (victimTeam != libGame_gv_teamChaosIndex_C) {
            return false;
        }
        if (!libHRGE_PlayerHasBehavior(libHRGE_player, "AffixDestructionToken")) {
            return false;
        }
        if (!(libHRGE_PlayerBehaviorCount(libHRGE_player, "AffixDestructionToken") < maxStacks)) {
            return false;
        }
    }
    libHRGE_UnitCreateEffectUnit(libHRGE_player, "AffixDestructionIncrementToken");
    libHRGE_AddAffixQuestProgress(libHRGE_instanceDestruction, 1);
    
    return true;
}
bool libHRGE_DestructionComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (libHRGE_DestructionSuppressRewards) {
            return false;
        }
        if (libHRGE_AffixQuestDone(libHRGE_instanceDestruction)) {
            return false;
        }
        if (player != libHRGE_player) {
            return false;
        }
    }
    libHRGE_QueueBoon(libHRGE_rarityRare, 1, false, true);
    libHRGE_SetAffixQuestDone(libHRGE_instanceDestruction, true);
    
    return true;
}
bool libHRGE_Destruction6StacksComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (libHRGE_DestructionSuppressRewards) {
            return false;
        }
        if (libHRGE_DestructionFinished[1]) {
            return false;
        }
        if (player != libHRGE_player) {
            return false;
        }
    }
    libHRGE_QueueBoon(libHRGE_rarityCommon, 1, false, true);
    libHRGE_DestructionFinished[1] = true;
    
    return true;
}
bool libHRGE_Destruction12StacksComplete (bool testConds, bool runActions) {
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if (testConds) {
        if (libHRGE_DestructionSuppressRewards) {
            return false;
        }
        if (libHRGE_DestructionFinished[2]) {
            return false;
        }
        if (player != libHRGE_player) {
            return false;
        }
    }
    libHRGE_QueueBoon(libHRGE_rarityUncommon, 1, false, true);
    libHRGE_DestructionFinished[2] = true;
    
    return true;
}
bool libHRGE_DestructionUnitBehaviorCreate (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    if (testConds) {
        if (!UnitHasBehavior2(heroUnit, "AffixDestructionToken")) {
            return false;
        }
    }
    libHRGE_DestructionSuppressRewards = true;
    UnitSetTokenCount(heroUnit, "AffixDestructionToken", libHRGE_GetAffixQuestProgress(libHRGE_instanceDestruction), heroUnit);
    libHRGE_Wait(0.125, c_timeGame);
    libHRGE_DestructionSuppressRewards = false;

    return true;
}
// ============================================================
// Fortifications
// ============================================================
void libHRGE_FortificationsCreateTower(string unitType, point location, fixed rotation) {
    unit tower;
    if (libHRGE_FortificationsTotal >= libHRGE_FortificationsMax) {
        return;
    }
    libHRGE_FortificationsTotal += 1;
    if (libHRGE_FortificationsSpawned[libHRGE_FortificationsTotal] == false) {
        libHRGE_FortificationsSpawned[libHRGE_FortificationsTotal] = true;
        UnitCreate(1, unitType, c_unitCreateIgnorePlacement, libHRGE_teamChaos, location, rotation, null);
        tower = UnitLastCreated();
        UnitBehaviorAdd(tower, "AffixFortificationsTowerReveal", tower, 1);
        ActorSend(libNtve_gf_MainActorofUnit(tower), "Signal PlayBuild");
    }
}
