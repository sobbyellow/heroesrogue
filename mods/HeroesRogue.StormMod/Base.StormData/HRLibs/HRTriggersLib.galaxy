// ============================================================
bool libHRGE_PacifismAffixAdded (bool testConds, bool runActions) {
    if (libHRGE_GetAffixCustomValue(libHRGE_instancePacifism) == "RewardsReady") {
        libHRGE_DisplayChatMessage(StringExternal("Message/Pacifism"));
        libHRGE_QueueBoon(libHRGE_rarityUncommon, 1, false, true);
        libHRGE_QueueBoon(libHRGE_rarityRare, 1, false, true);
        libHRGE_QueueBoon(libHRGE_rarityEpic, 1, false, true);
        libHRGE_SetAffixCustomValue(libHRGE_instancePacifism, "");
    }
    
    return true;
}
bool libHRGE_PacifismWin (bool testConds, bool runActions) {
    fixed takedowns = libGame_gv_scoreValues[libHRGE_player].lv_takedowns;
    fixed kills = libGame_gv_scoreValues[libHRGE_player].lv_kills;
    fixed assists = libGame_gv_scoreValues[libHRGE_player].lv_assists;
    if (testConds) {
        if (libHRGE_AffixQuestDone(libHRGE_instancePacifism)) {
            return false;
        }
    }
    if ((takedowns + kills + assists) <= 0) {
        libUIUI_gf_KillLogAnnounceQuestCompletion(libHRGE_player, "AffixPacifismToken", 1.0);
        libHRGE_SetAffixQuestDone(libHRGE_instancePacifism, true);
        libHRGE_SetAffixCustomValue(libHRGE_instancePacifism, "RewardsReady");
    }
    
    return true;
}
