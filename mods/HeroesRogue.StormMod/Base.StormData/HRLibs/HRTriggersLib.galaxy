// ============================================================
// Talent Disadvantage
// ============================================================

void libHRGE_ApplyTalentDisadvantage(int player, int level) {
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    int stacks = libHRGE_GetAffixCount(libHRGE_instanceTalentDisadvantage);
    int levelChromie;
    if (hero == "Chromie") {
        levelChromie = 2;
    }
    if (hero == "Varian") {
        if (stacks >= 1 && level < 7) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 2 && level < 10) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 3 && level < 13) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 4 && level < 16) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 5 && level < 20) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 6) {
            libHRGE_SelectAllTalents(player, level, true);
        }
    } else {
        if (stacks >= 1 && (level + levelChromie) < 4) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 2 && (level + levelChromie) < 7) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 3 && (level + levelChromie) < 13) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 4 && (level + levelChromie) < 16) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 5 && (level + levelChromie) < 20) {
            libHRGE_SelectAllTalents(player, level, true);
        }
        if (stacks >= 6) {
            libHRGE_SelectAllTalents(player, level, true);
        }
    }
}
bool libHRGE_TalentDisadvantageAffixAdded (bool testConds, bool runActions) {
    int i;
    for (i = 6; i <= libCore_gv_bALMaxPlayers; i += 1) {
        libHRGE_ApplyTalentDisadvantage(i, UnitLevel(libGame_gv_players[i].lv_heroUnit));
        libHRGE_Wait(0.0625, c_timeGame);
    }
    return true;
}
bool libHRGE_TalentDisadvantageLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (!(player >= 6 && player <= 10)) {
            return false;
        }
    }
    libHRGE_ApplyTalentDisadvantage(player, level);
    return true;
}
