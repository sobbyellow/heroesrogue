bool libHRGE_ToxicFieldTimerElapsed (bool testConds, bool runActions) {
    int i;
    point randPoint;
    if (testConds) {
        if (!libHRGE_GateIsOpen()) {
            return false;
        }
    }
    for (i = 1; i <= libHRGE_ToxicFieldCount; i += 1) {
        randPoint = RegionRandomPoint(RegionEntireMap());
        if (PointPathingPassable(randPoint)) {
            UnitCreateEffectPoint(libGame_gv_teams[libHRGE_teamChaosIndex].lv_core, "AffixToxicNestCreateUnit", randPoint);
        }
    }
    return true;
}
