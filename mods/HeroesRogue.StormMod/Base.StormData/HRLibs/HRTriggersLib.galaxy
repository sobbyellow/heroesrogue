    libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheWizardBehavior", "Modification.VitalRegenArray[Energy]", player, 0.2 * count * (level + libHRGE_PathoftheFighterBonus));
    libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheWizardBehavior", "Modification.VitalMaxArray[Energy]", player, 10 * count * (level + libHRGE_PathoftheFighterBonus));
}
