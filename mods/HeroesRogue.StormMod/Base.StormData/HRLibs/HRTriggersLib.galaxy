// ============================================================
// Army of BUDDYs
// ============================================================
bool libHRGE_ArmyofBUDDYsOncePerGame (bool testConds, bool runActions) {
    int i;
    for (i = 1; i <= 5; i += 1) {
        if (i != libHRGE_player) {
            libHRGE_AddPlayerBehaviorWithExclusion(i, "AffixBuddyDroneSpawnBehavior", 1, true, "HeroDVaMech");
            if (i == libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_gallPlayer || i == libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_choPlayer) {
                libHRGE_BuddyCount[i] += 1;
            }
        }
        libHRGE_SetLevelScalingAndValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", i, 0.04, StringToFixed(libHRGE_GetCatalogDefaultValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate")) * libHRGE_ArmyOfBUDDYsDamageHealingPenalty);
        libHRGE_SetLevelScalingAndValue("Effect,AffixBuddyDroneMissileDamage,Amount", i, 0.04, StringToFixed(libHRGE_GetCatalogDefaultValue("Effect,AffixBuddyDroneMissileDamage,Amount")) * libHRGE_ArmyOfBUDDYsDamageHealingPenalty);
    }
    return true;
}
bool libHRGE_ArmyofBUDDYsAffixAdded (bool testConds, bool runActions) {
    libHRGE_BuddyCount[libHRGE_player] += libHRGE_EventAffixCountAdded();
    libHRGE_BuddyCountPlayer1 = libHRGE_BuddyCount[libHRGE_player];
    return true;
}
bool libHRGE_ArmyofBUDDYsLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player < 1 || player > 5) {
            return false;
        }
    }

    libHRGE_SetLevelScalingAndValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", player, 0.04, StringToFixed(libHRGE_GetCatalogDefaultValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate")) * libHRGE_ArmyOfBUDDYsDamageHealingPenalty);
    libHRGE_SetLevelScalingAndValue("Effect,AffixBuddyDroneMissileDamage,Amount", player, 0.04, StringToFixed(libHRGE_GetCatalogDefaultValue("Effect,AffixBuddyDroneMissileDamage,Amount")) * libHRGE_ArmyOfBUDDYsDamageHealingPenalty);
    return true;
}

// ============================================================
// Ammunition
// ============================================================
bool libHRGE_Ammunition (bool testConds, bool runActions) {
    int i;
    unit unitVar;
    unitgroup unitGroup;
    libHRGE_CopyFilter(libHRGE_filterAlliedStructures, libHRGE_filterAmmunitionTowers);
    libHRGE_CopyFilter(libHRGE_filterAlliedStructures, libHRGE_filterAmmunitionForts);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAmmunitionTowers, "TownCannonTowerL2");
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAmmunitionTowers, "TownCannonTowerL3");
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAmmunitionTowers, "TownCannonTowerL2Standalone");
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAmmunitionTowers, "TownCannonTowerL3Standalone");
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAmmunitionForts, "TownTownHallL2");
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAmmunitionForts, "TownTownHallL3");

    CatalogFieldValueModify(c_gameCatalogActor, "TownCannonTowerL2", "CustomUnitStatusFrame", libHRGE_teamOrder, "AffixUI/TowerUnitStatusFrameTemplateRealAmmo", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "TownCannonTowerL3", "CustomUnitStatusFrame", libHRGE_teamOrder, "AffixUI/TowerUnitStatusFrameTemplateRealAmmo", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "TownCannonTowerL2Standalone", "CustomUnitStatusFrame", libHRGE_teamOrder, "AffixUI/TowerUnitStatusFrameTemplateRealAmmo", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "TownCannonTowerL3Standalone", "CustomUnitStatusFrame", libHRGE_teamOrder, "AffixUI/TowerUnitStatusFrameTemplateRealAmmo", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "TownTownHallL2", "CustomUnitStatusFrame", libHRGE_teamOrder, "AffixUI/TowerUnitStatusFrameTemplate40RealAmmo", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogActor, "TownTownHallL3", "CustomUnitStatusFrame", libHRGE_teamOrder, "AffixUI/TowerUnitStatusFrameTemplate40RealAmmo", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "StructureAmmoConsumeAmmoSet", "Chance", libHRGE_teamOrder, "1", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "StructureAmmoReplenish", "VitalArray[Energy].Change", libHRGE_teamOrder, "2", c_upgradeOperationSet);

    libHRGE_AddUnitBehaviorToAllFilter("StructureAmmoMonitor", 1, libHRGE_filterAmmunitionTowers);
    libHRGE_AddUnitBehaviorToAllFilter("StructureAmmoMonitor", 1, libHRGE_filterAmmunitionForts);
    libHRGE_AddUnitBehaviorToAllFilter("StructureAmmoReplenisher", 1, libHRGE_filterAmmunitionTowers);
    libHRGE_AddUnitBehaviorToAllFilter("StructureAmmoReplenisher", 1, libHRGE_filterAmmunitionForts);
    libHRGE_UnitSetPropertyFixedToAllFilter(c_unitPropEnergyMax, 20, libHRGE_filterAmmunitionTowers);
    libHRGE_UnitSetPropertyFixedToAllFilter(c_unitPropEnergyMax, 40, libHRGE_filterAmmunitionForts);

    return true;
}
bool libHRGE_AmmunitionUnitCreated (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    if (testConds) {
        if (!UnitTypeTestAttribute(UnitGetType(eventUnit), c_unitAttributeStructure)) {
            return false;
        }
    }
    libHRGE_AddUnitBehaviorFilter(eventUnit, "StructureAmmoMonitor", 1, libHRGE_filterAmmunitionTowers);
    libHRGE_AddUnitBehaviorFilter(eventUnit, "StructureAmmoMonitor", 1, libHRGE_filterAmmunitionForts);
    libHRGE_AddUnitBehaviorFilter(eventUnit, "StructureAmmoReplenisher", 1, libHRGE_filterAmmunitionTowers);
    libHRGE_AddUnitBehaviorFilter(eventUnit, "StructureAmmoReplenisher", 1, libHRGE_filterAmmunitionForts);
    libHRGE_SetUnitPropertyFilter(eventUnit, c_unitPropEnergyMax, 20, libHRGE_filterAmmunitionTowers);
    libHRGE_SetUnitPropertyFilter(eventUnit, c_unitPropEnergyMax, 40, libHRGE_filterAmmunitionForts);
    return true;
}
// ============================================================
// Grenadier
// ============================================================

bool libHRGE_GrenadierAffixAdded (bool testConds, bool runActions) {
    int i;
    int amount = MinI(libHRGE_EventAffixCount() + 5, 10);
    unit playerUnit;
    string unitType;
    for (i = 6; i <= amount; i += 1) {
        playerUnit = libHRGE_GetPlayerHeroUnit(i);
        if (!UnitHasBehavior2(playerUnit, "AffixGrenadierController")) {
            libHRGE_grenadierTotalHeroes += 1;
            unitType = UnitGetType(playerUnit);
            if (unitType == "HeroDVaPilot" || unitType == "HeroDVaMech") {
                libHRGE_AddPlayerBehavior(i, "AffixGrenadierController", 1, false);
            } else {
                libHRGE_AddPlayerBehavior(i, "AffixGrenadierController", 1, true);
            }
        }
    }
    return true;
}

bool libHRGE_GrenadierEffectUsed (bool testConds, bool runActions) {
    int random;
    unit caster = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    unit target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    if (testConds) {
        if (UnitTestState(caster, c_unitStateHallucination)) {
            return false;
        }
    }
    random = RandomInt(1, 3);
    libHRGE_Wait(RandomFixed(0.125, 0.5), c_timeGame);
    if (random == 1) {
        UnitCreateEffectUnit(caster, "GrenadeInitialSet", target);
    } else if (random == 2) {
        UnitCreateEffectUnit(caster, "AnaBioticGrenadeInitialSet", target);
    } else if (random == 3) {
        UnitCreateEffectUnit(caster, "AffixZaryaParticleGrenadeLaunchMissile", target);
    }

    return true;
}
