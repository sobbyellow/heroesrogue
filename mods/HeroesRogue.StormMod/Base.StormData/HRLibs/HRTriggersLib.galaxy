// ============================================================
// Overwhelming Power
// ============================================================
bool libHRGE_OverwhelmingPowerBehaviorChange (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    while ((UnitHasBehavior2(heroUnit, "AffixOverwhelmingPowerBehavior") == true)) {
        while ((UnitHasBehaviorWithCategoryFlag(heroUnit, c_behaviorCategoryTimeStop) == true) || libHRGE_gamePaused) {
            libHRGE_Wait(0.0625, c_timeGame);
        }
        libHRGE_ModifyAllCooldowns(heroUnit, -(libHRGE_OverwhelmingPowerCDRModifier / 16), false, false, false);
        libHRGE_Wait(0.0625, c_timeGame);
    }
    return true;
}
// ============================================================
// Injury
// ============================================================
bool libHRGE_Injury (bool testConds, bool runActions) {
    unitgroup unitGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    unit heroUnit;
    int groupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; groupCount -= 1) {
        if (groupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(unitGroup, groupCount);
        if (UnitGetType(heroUnit) == "HeroLostVikingsController") { continue; }
        if (UnitGetType(heroUnit) == "HeroErik" || UnitGetType(heroUnit) == "HeroRexxar" || UnitGetType(heroUnit) == "HeroDVaMech") {
            libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixInjuryBehavior2", "Modification.VitalRegenArray[Life]", libHRGE_player, -UnitGetPropertyFixed(heroUnit, c_unitPropLifeRegen, false) * Pow(1.04, UnitLevel(heroUnit)));
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior", 1);
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior3", 1);
            UnitBehaviorAdd(heroUnit, "AffixInjuryBehavior2", heroUnit, 1);
        } else if (UnitGetType(heroUnit) == "HeroBaleog") {
            libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixInjuryBehavior3", "Modification.VitalRegenArray[Life]", libHRGE_player, -UnitGetPropertyFixed(heroUnit, c_unitPropLifeRegen, false) * Pow(1.04, UnitLevel(heroUnit)));
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior", 1);
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior2", 1);
            UnitBehaviorAdd(heroUnit, "AffixInjuryBehavior3", heroUnit, 1);
        } else {
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior2", 1);
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior3", 1);
            libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixInjuryBehavior", "Modification.VitalRegenArray[Life]", libHRGE_player, -UnitGetPropertyFixed(heroUnit, c_unitPropLifeRegen, false) * Pow(1.04, UnitLevel(heroUnit)));
        }
    }

    return true;
}
bool libHRGE_InjuryLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    unitgroup unitGroup;
    unit heroUnit;
    int groupCount;
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
    }
    if (level <= 0) {
        return true;
    }
    unitGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    groupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; groupCount -= 1) {
        if (groupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(unitGroup, groupCount);
        if (UnitGetType(heroUnit) == "HeroLostVikingsController") { continue; }
        if (UnitGetType(heroUnit) == "HeroErik" || UnitGetType(heroUnit) == "HeroRexxar" || UnitGetType(heroUnit) == "HeroDVaMech") {
            libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixInjuryBehavior2", "Modification.VitalRegenArray[Life]", libHRGE_player, -UnitGetPropertyFixed(heroUnit, c_unitPropLifeRegen, false) * Pow(1.04, level));
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior", 1);
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior3", 1);
            UnitBehaviorAdd(heroUnit, "AffixInjuryBehavior2", heroUnit, 1);
        } else if (UnitGetType(heroUnit) == "HeroBaleog") {
            libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixInjuryBehavior3", "Modification.VitalRegenArray[Life]", libHRGE_player, -UnitGetPropertyFixed(heroUnit, c_unitPropLifeRegen, false) * Pow(1.04, level));
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior", 1);
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior2", 1);
            UnitBehaviorAdd(heroUnit, "AffixInjuryBehavior3", heroUnit, 1);
        } else {
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior2", 1);
            UnitBehaviorRemove(heroUnit, "AffixInjuryBehavior3", 1);
            libHRGE_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixInjuryBehavior", "Modification.VitalRegenArray[Life]", libHRGE_player, -UnitGetPropertyFixed(heroUnit, c_unitPropLifeRegen, false) * Pow(1.04, level));
        }
    }

    return true;
}

