const string libHRGE_affixUserTriggerGameStart                  = "GAMESTART"; // Runs one time at the start of the game, regardless of stack count
const string libHRGE_affixUserTriggerOncePerGame                = "ONCEPERGAME"; // Runs immediately and at the start of every game. Can only run once per game
const string libHRGE_affixUserTriggerOneTime                    = "ONETIME"; // Runs immediately. Does not run at the start of the game
const string libHRGE_affixUserTriggerNPCTakedown                = "NPCTAKEDOWN"; // Runs on any NPC takedown
const string libHRGE_affixUserTriggerHeroTakedown               = "HEROTAKEDOWN"; // Runs on any Hero takedown
const string libHRGE_affixUserTriggerUnitCreated                = "UNITCREATED"; // Runs when any unit is created
const string libHRGE_affixUserTriggerUnitDied                   = "UNITDIED"; // Runs when any unit dies
const string libHRGE_affixUserTriggerUnitDamaged                = "UNITDAMAGED"; // Runs when a unit takes damage.
const string libHRGE_affixUserTriggerUnitBehaviorChange         = "UNITBEHAVIORCHANGE"; // Runs when a unit receives specified behavior
const string libHRGE_affixUserTriggerUnitBehaviorCreate         = "UNITBEHAVIORCREATE"; // 
const string libHRGE_affixUserTriggerUnitBehaviorChangeCategory = "UNITBEHAVIORCHANGECATEGORY"; // Runs when a unit receives behavior with the specified category
const string libHRGE_affixUserTriggerUnitChangeOwner            = "UNITCHANGEOWNER"; // Runs when a unit changes ownership
const string libHRGE_affixUserTriggerPlayerEffectUsed           = "PLAYEREFFECTUSED"; // Runs when any player triggers the specified effect
const string libHRGE_affixUserTriggerHeroLevelUp                = "HEROLEVELUP"; // Runs immediately once and on Hero level up
const string libHRGE_affixUserTriggerHeroRespawn                = "HERORESPAWN"; // Runs when Hero respawns
const string libHRGE_affixUserTriggerHeroKilled                 = "HEROKILLED"; // Runs when a Hero is killed
const string libHRGE_affixUserTriggerHeroGainTalent             = "HEROGAINTALENT"; // Runs when a Hero gains a Talent
const string libHRGE_affixUserTriggerScaling                    = "SCALING"; // Same as LevelUp but also runs regardless of stack count
const string libHRGE_affixUserTriggerQuest                      = "QUEST"; // Runs immediately if affix quest is NOT complete
const string libHRGE_affixUserTriggerPeriodic                   = "PERIODIC"; // Runs periodically. Default: 0.0625s
const string libHRGE_affixUserTriggerWin                        = "WIN"; // Executes when enemy core dies.
const string libHRGE_affixUserTriggerPaused                     = "PAUSED"; // Executes when game is paused.
const string libHRGE_affixUserTriggerTimer                      = "TIMER"; // Executes when timer runs out. Optional argument1 to start the timer with a duration, argument2 to make it periodic.

const string libHRGE_affixUserFilterAll                         = "ALL";
const string libHRGE_affixUserFilterAITeammates                 = "AITEAMMATES";
const string libHRGE_affixUserFilterAllAllies                   = "ALLALLIES";
const string libHRGE_affixUserFilterAlliedHeroes                = "ALLIEDHEROES";
