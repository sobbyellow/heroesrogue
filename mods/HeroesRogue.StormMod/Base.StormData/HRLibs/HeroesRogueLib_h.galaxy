const string libHRGE_affixUserFilterAlliedCore                  = "ALLIEDCORE";
const string libHRGE_affixUserFilterAlliedMinions               = "ALLIEDMINIONS";
const string libHRGE_affixUserFilterAlliedMinionsRanged         = "ALLIEDMINIONSRANGED";
