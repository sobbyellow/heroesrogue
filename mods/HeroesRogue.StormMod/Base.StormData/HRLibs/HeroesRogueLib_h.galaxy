    int choiceCount;
    bool rerollDisabled;
};

struct libHRGE_Achievement {
    string name;
    int difficulty;
    bool earned;
    int type;
    int hero;
    string icon;
    int round;
    int time;
    int timeRequired;
    int roundRequired;
};

