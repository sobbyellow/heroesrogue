// ============================================================
// Trigger IDs
// ============================================================

const int libHRGE_triggerAffixAdded                  =   1;     // Runs immediately and at the start of every game
const int libHRGE_triggerGameStart                   =   2;     // Runs one time at the start of the game, regardless of stack count
const int libHRGE_triggerOncePerGame                 =   3;     // Runs immediately and at the start of every game. Can only run once per game
const int libHRGE_triggerOneTime                     =   4;     // Runs immediately. Does not run at the start of the game
const int libHRGE_triggerNPCTakedown                 =   5;     // Runs on any NPC takedown
const int libHRGE_triggerHeroTakedown                =   6;     // Runs on any Hero takedown
const int libHRGE_triggerUnitCreated                 =   7;     // Runs when any unit is created
const int libHRGE_triggerUnitDied                    =   8;     // Runs when any unit dies
const int libHRGE_triggerUnitBehaviorChange          =   9;     // Runs when a unit receives specified behavior
const int libHRGE_triggerUnitBehaviorCreate          =   10;    // 
const int libHRGE_triggerUnitBehaviorChangeCategory  =   11;    // Runs when a unit receives behavior with the specified category
const int libHRGE_triggerUnitChangeOwner             =   12;    // Runs when a unit changes ownership
const int libHRGE_triggerPlayerEffectUsed            =   13;    // Runs when any player triggers the specified effect
const int libHRGE_triggerHeroLevelUp                 =   14;    // Runs immediately once and on Hero level up
const int libHRGE_triggerHeroRespawn                 =   15;    // Runs when Hero respawns
const int libHRGE_triggerHeroKilled                  =   16;    // Runs when a Hero is killed
const int libHRGE_triggerHeroGainTalent              =   17;    // Runs when a Hero gains a Talent
const int libHRGE_triggerScaling                     =   18;    // Same as libHRGE_triggerHeroLevelUp but also runs regardless of stack count
const int libHRGE_triggerQuest                       =   19;    // Runs immediately if affix quest is NOT complete
const int libHRGE_triggerPeriodic                    =   20;    // Runs periodically. Default: 0.0625s
const int libHRGE_triggerWin                         =   21;    // Executes when enemy core dies.
const int libHRGE_triggerAnyAffixAdded               =   22;    // Executes when ANY affix is added that has an affix added trigger.
const int libHRGE_triggerExecute                     =   23;    // Obsolete, converts into libHRGE_triggerAffixAdded
const int libHRGE_triggerUnitDamaged                 =   24;    // Runs when a unit takes damage.

// ============================================================
// Catalog Modification IDs
// ============================================================

const int libHRGE_catalogTypeFlat                        =   1;     // Base value
const int libHRGE_catalogTypePerStack                    =   2;     // Value * total stacks
const int libHRGE_catalogTypePerStackDelta               =   3;     // Value * added stacks
const int libHRGE_catalogTypePerStackDeltaExclFirst      =   4;     // Value * added stacks (excluding first stack)
const int libHRGE_catalogTypeBase                        =   5;     // Catalog base value (operation) value * total stacks
const int libHRGE_catalogTypeBaseDelta                   =   6;     // Catalog base value (operation) value * added stacks
const int libHRGE_catalogTypeBaseMult                    =   7;     // Catalog base value (operation) 1 + (value * total stacks)
const int libHRGE_catalogTypeString                      =   8;     // Sets catalog value to a string

