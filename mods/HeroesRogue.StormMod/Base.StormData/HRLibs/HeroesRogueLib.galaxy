text libHRGE_GetTalentTooltip(string talent) {
    string face = CatalogReferenceGet("Talent," + talent + ",Face", 0);
    string tooltip = CatalogReferenceGet("Button," + face + ",Tooltip", 0);

    if (tooltip != "" && tooltip != null) {
        return StringExternal(tooltip);
    }
    return StringExternal("Button/Tooltip/" + talent);
}
text libHRGE_GetTalentSimpleTooltip(string talent) {
    string face = CatalogReferenceGet("Talent," + talent + ",Face", 0);
    string simple = CatalogReferenceGet("Button," + face + ",SimpleDisplayText", 0);

    if (simple != "" && simple != null) {
        return StringExternal(simple);
    }
    return StringExternal("Button/SimpleDisplayText/" + talent);
}
text libHRGE_GetExtendedAffixTooltip(string instance, bool onlyShowWithAlt, bool addNewLines, bool stackingValues, bool talents, bool unlockedAffixes) {
    int i;
    int j;
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTalentsAddCount, 1);
    string talent;
    string instanceUnlocks;
    text previewTooltip;
    text stackingTooltip;
    text unlockTooltip;
    text talentTooltip;
    int count = libHRGE_GetAffixCount(instance);
    int max = libHRGE_GetAffixMax(instance);
    bool showAltTooltip = false;

    // Total stacking values
    if (((count > 0 && max != 1) || (count > 0 && libHRGE_AffixAlwaysAppendTooltip(instance))) && stackingValues) {
        if (libHRGE_pressingALT) {
            stackingTooltip += StringExternal("Affix/Tooltip/Append/" + instance);
        } else {
            if (StringExternal("Affix/Tooltip/Append/" + instance) != null) {
                showAltTooltip = true;
            }
        }
        previewTooltip += stackingTooltip;
    }

    // Talents
    if (talents) {
        for (i = 1; i <= fieldCount; i += 1) {
            talent = CatalogReferenceGet("Talent," + libHRGE_GetAffixAddTalents(instance, i) + ",Face", libHRGE_player);
            
            TextExpressionSetToken("Param/Expression/AffixTalentTooltip", "A", StringExternal("Button/Name/" + talent));
            if (libHRGE_pressingALT) {
                TextExpressionSetToken("Param/Expression/AffixTalentTooltip", "B", libHRGE_GetTalentTooltip(talent));
                talentTooltip += TextExpressionAssemble("Param/Expression/AffixTalentTooltip");
            } else {
                if (!onlyShowWithAlt) {
                    TextExpressionSetToken("Param/Expression/AffixTalentTooltip", "B", libHRGE_GetTalentSimpleTooltip(talent));
                    talentTooltip += TextExpressionAssemble("Param/Expression/AffixTalentTooltip");
                }
                showAltTooltip = true;
            }
        }
        if (talentTooltip != null) {
            if (previewTooltip == null) {
                previewTooltip += StringExternal("Param/Expression/AffixTalentsPreview") + talentTooltip;
            } else {
                previewTooltip += StringToText("<n/><n/>") + StringExternal("Param/Expression/AffixTalentsPreview") + talentTooltip;
            }
        }
    }

    // Unlocked affixes
    if (unlockedAffixes) {
        for (i = 1; i <= DataTableGetInt(true, instance + "UnlocksCount"); i += 1) {
            instanceUnlocks = DataTableGetString(true, instance + "Unlocks" + IntToString(i));
            TextExpressionSetToken("Param/Expression/AffixUnlockTooltip", "A", TextWithColor(StringToText("[") + StringExternal("Affix/Name/" + instanceUnlocks) + StringToText("]:"), libHRGE_GetAffixColor(instanceUnlocks)));
            if (libHRGE_pressingALT) {
                unlockTooltip += TextExpressionAssemble("Param/Expression/AffixUnlockTooltip") + StringExternal("Affix/Tooltip/" + instanceUnlocks);
            } else {
                if (!onlyShowWithAlt) {
                    unlockTooltip += TextExpressionAssemble("Param/Expression/AffixUnlockTooltip") + StringExternal("Affix/SimpleDisplayText/" + instanceUnlocks);
                }
                showAltTooltip = true;
            }
        }
        if (unlockTooltip != null) {
            TextExpressionSetToken("Param/Expression/AffixUnlocksPreview", "A", StringExternal("Affix/Name/" + instance));
            if (previewTooltip == null) {
                previewTooltip += TextExpressionAssemble("Param/Expression/AffixUnlocksPreview") + unlockTooltip;
            } else {
                previewTooltip += StringToText("<n/><n/>") + TextExpressionAssemble("Param/Expression/AffixUnlocksPreview") + unlockTooltip;
            }
        }
    }
    if (!libHRGE_pressingALT && showAltTooltip) {
        previewTooltip += StringExternal("Button/Tooltip/AffixShowTooltip");
    } else if (addNewLines && stackingTooltip == null && (talentTooltip != null || unlockTooltip != null)) {
        previewTooltip = StringToText("<n/><n/>") + previewTooltip;
    }

    return previewTooltip;
}
text libHRGE_GetAffixTooltip(int affix, bool smallTooltip) {
    string instance = libHRGE_GetAffixInstance(affix);
    string name = instance;
    int count = libHRGE_GetAffixCount(instance);
    int max = libHRGE_GetAffixMax(instance);
    int skipCurses = libHRGE_GetAffixCurseSkips(instance);
    text tooltip = StringExternal("Affix/Tooltip/" + name);
    int heroIndex = libGame_gv_players[libHRGE_player].lv_heroIndex;
    string hero = libCore_gf_GetHeroFromIndex(heroIndex);
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserHeroTooltipCount, 1);
    string heroTooltip;
    int i;
    text extendedTooltip;

    // Tooltip - Base tooltip
    for (i = 1; i <= fieldCount; i += 1) {
        heroTooltip = libHRGE_GetHeroTooltip(instance, i);
        if (heroTooltip == hero) {
            tooltip = StringExternal("Affix/Tooltip/" + name + "/" + hero);
        } else if (heroTooltip == "NoMana" && UnitHasBehavior2(libHRGE_GetPlayerHeroUnit(libHRGE_player), "NotManaUserDummy")) {
            tooltip = StringExternal("Affix/Tooltip/" + name + "/NoMana");
        }
    }

    // Tooltip - Stacks up to X
    if (max > 1 && !smallTooltip) {
        TextExpressionSetToken("Param/Expression/AffixStacksUpTo", "A", IntToText(max));
        tooltip += TextExpressionAssemble("Param/Expression/AffixStacksUpTo");
    }

    // Tooltip - Skips the next X curses
    if (max == 1) {
        if (skipCurses == 1) {
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkips");
        } else if (skipCurses > 1) {
            TextExpressionSetToken("Param/Expression/AffixCurseSkipsMultiple", "A", IntToText(skipCurses));
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkipsMultiple");
        }
    } else {
        if (skipCurses == 1) {
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkipsEachStack");
        } else if (skipCurses > 1) {
            TextExpressionSetToken("Param/Expression/AffixCurseSkipsMultiple", "A", IntToText(skipCurses));
            tooltip += TextExpressionAssemble("Param/Expression/AffixCurseSkipsMultipleEachStack");
        }
    }

    if (smallTooltip) {
        extendedTooltip += libHRGE_GetExtendedAffixTooltip(instance, true, true, true, true, true);
    } else {
        extendedTooltip += libHRGE_GetExtendedAffixTooltip(instance, true, true, true, false, false);
    }

    return tooltip + extendedTooltip;
}

bool libHRGE_IsAffixBannable(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    int rarity = libHRGE_GetAffixRarity(instance);
    int max = libHRGE_GetAffixMax(instance);
    if (max <= 0 || rarity == libHRGE_rarityStarter || rarity == libHRGE_rarityMythic || rarity == libHRGE_rarityMilestone) {
        return false;
    }
    return true;
}

bool libHRGE_IsCurrentQueueBannable() {
    int rarity = libHRGE_currentQueue.rarity;
    if (rarity == libHRGE_rarityStarter || rarity == libHRGE_rarityMythic || rarity == libHRGE_rarityMilestone) {
        return false;
    }
    return true;
}
bool libHRGE_IsCurrentQueueRerollable() {
    int rarity = libHRGE_currentQueue.rarity;
    if (libHRGE_currentQueue.rerollDisabled || rarity == libHRGE_rarityMythic || rarity == libHRGE_rarityMilestone || rarity == libHRGE_rarityStarter) {
        return false;
    }
    return true;
}
int libHRGE_GetRolledAffixCount() {
    int count;
    int i;
    for (i = 1; i <= libHRGE_currentQueue.choiceCount; i += 1) {
        if (libHRGE_rolledAffixes[i] != 0) {
            count += 1;
        }
    }
    return count;
}
bool libHRGE_IsAnyRolledAffixBannable() {
    int i;
    for (i = 1; i <= libHRGE_currentQueue.choiceCount; i += 1) {
        if (libHRGE_rolledAffixes[i] != 0 && libHRGE_IsAffixBannable(libHRGE_rolledAffixes[i])) {
            return true;
        }
    }
    return false;
}
bool libHRGE_ShouldShowBefore(int affix1, int affix2) {
    string instance1 = libHRGE_GetAffixInstance(affix1);
    string instance2 = libHRGE_GetAffixInstance(affix2);
    int rarity1 = libHRGE_GetAffixRarity(instance1);
    int rarity2 = libHRGE_GetAffixRarity(instance2);
    bool heroExclusive1 = libHRGE_AffixIsHeroExclusive(instance1);
    bool heroExclusive2 = libHRGE_AffixIsHeroExclusive(instance2);
    if (rarity1 < rarity2) {
        return true;
    }
    if (rarity1 > rarity2) {
        return false;
    }
    if (heroExclusive1 && !heroExclusive2) {
        return true;
    }
    if (!heroExclusive1 && heroExclusive2) {
        return false;
    }
    return false;
}
