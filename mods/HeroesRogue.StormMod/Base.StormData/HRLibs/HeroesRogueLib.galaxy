}
void libHRGE_SetDialogControlPosition(int dialogControl, int anchor, int offsetX, int offsetY) {
    if (dialogControl == c_invalidDialogControlId) { return; }
    DialogControlSetPosition(dialogControl, PlayerGroupAll(), anchor, offsetX, offsetY);
}
void libHRGE_SetDialogControlEnabled(int dialogControl, bool enabled) {
    if (dialogControl == c_invalidDialogControlId) { return; }
    DialogControlSetEnabled(dialogControl, PlayerGroupAll(), enabled);
}
void libHRGE_SetDialogControlVisible(int dialogControl, bool visible) {
    if (dialogControl == c_invalidDialogControlId) { return; }
    DialogControlSetVisible(dialogControl, PlayerGroupAll(), visible);
}
void libHRGE_SetDialogVisible(int dialog, bool visible) {
    if (dialog == c_invalidDialogId) { return; }
    DialogSetVisible(dialog, PlayerGroupAll(), visible);
}
void libHRGE_SetDialogControlSize(int dialogControl, int width, int height) {
    if (dialogControl == c_invalidDialogControlId) { return; }
    DialogControlSetSize(dialogControl, PlayerGroupAll(), width, height);
}
void libHRGE_SetDialogControlTooltip(int dialogControl, text tooltip) {
    if (dialogControl == c_invalidDialogControlId) { return; }
    libNtve_gf_SetDialogItemTooltip(dialogControl, tooltip, PlayerGroupAll());
}
void libHRGE_SetDialogControlChecked(int dialogControl, bool checked) {
    if (dialogControl == c_invalidDialogControlId) { return; }
    libNtve_gf_SetDialogItemChecked(dialogControl, checked, PlayerGroupAll());
}

void libHRGE_ShowBackdrop(bool show) {
    if (show) {
        libHRGE_SetDialogVisible(libHRGE_dialogBackdrop, true);
        return;
    }
    if (libHRGE_AnyDialogVisible()) { return; }
    libHRGE_SetDialogVisible(libHRGE_dialogBackdrop, false);
}

void libHRGE_SetBackdropDark(bool dark) {
    string texture = libHRGE_textureBlackout;
    if (dark) {
        texture = libHRGE_textureBlackoutDark;
    }
    libHRGE_SetDialogControlImage(libHRGE_dialogControlBackdrop, texture);
}

int libHRGE_CreateOptionDialogPulldown(text optionText) {
    libHRGE_dialogOptions.optionIndex += 1;
    libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].label = libHRGE_CreateDialogControlLabel(libHRGE_dialogOptions.dialog, optionText, "Affix_DialogLeft", libHRGE_optionsCheckboxLabelWidth, libHRGE_optionsCheckboxLabelHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].pulldown = libHRGE_CreateDialogControlPulldown(libHRGE_dialogOptions.dialog);
    return libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].pulldown;
}
int libHRGE_CreateOptionDialogCheckbox(text optionText) {
    libHRGE_dialogOptions.optionIndex += 1;
    libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].label = libHRGE_CreateDialogControlLabel(libHRGE_dialogOptions.dialog, optionText, "Affix_DialogLeft", libHRGE_optionsCheckboxLabelWidth, libHRGE_optionsCheckboxLabelHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].checkbox = libHRGE_CreateDialogControlCheckbox(libHRGE_dialogOptions.dialog);
    return libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].checkbox;
}
int libHRGE_CreateOptionDialogButton(text buttonText) {
    libHRGE_dialogOptions.optionIndex += 1;
    libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].button = libHRGE_CreateDialogControlButton(libHRGE_dialogOptions.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].button, libHRGE_optionsButtonWidth, libHRGE_optionsButtonHeight);
    libHRGE_SetDialogControlText(libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].button, buttonText);
    return libHRGE_dialogOptions.option[libHRGE_dialogOptions.optionIndex].button;
}

void libHRGE_CreateUI() {
    text versionLabel = StringToText("v" + libHRGE_version);

    libHRGE_dialogBackdrop = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libHRGE_dialogBackdrop, true);
    DialogSetImageVisible(libHRGE_dialogBackdrop, false);
    libHRGE_dialogControlBackdrop = libHRGE_CreateDialogControlImageWithColor(libHRGE_dialogBackdrop, libHRGE_textureBlackout, 3000, 3000, c_anchorTop, 0, 0, null, ColorWithAlpha(0, 0, 0, 0));

    libHRGE_CreateAffixSelectionDialog();
    libHRGE_CreateGameoverDialog();
    libHRGE_CreateOwnedAffixesDialog();
    libHRGE_CreateOptionsDialog();
    libHRGE_CreateAchievementsDialog();
    
    libHRGE_dialogControls = DialogCreate(500, 500, c_anchorTopRight, 0, 0, true);
    DialogSetFullscreen(libHRGE_dialogControls, true);
    DialogSetImageVisible(libHRGE_dialogControls, false);
    DialogSetVisible(libHRGE_dialogControls, PlayerGroupAll(), true);

    libHRGE_dialogControlOptionsButton = libHRGE_CreateDialogControlButton(libHRGE_dialogControls);
    libHRGE_SetDialogControlSize(libHRGE_dialogControlOptionsButton, libHRGE_optionsCogButtonWidth, libHRGE_optionsCogButtonHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogControlOptionsButton, c_anchorTopRight, libHRGE_optionsCogButtonOffsetX, libHRGE_optionsCogButtonOffsetY);
    libHRGE_CreateDialogControlImage(libHRGE_dialogControls, libHRGE_textureSettingsCog, libHRGE_optionsCogButtonWidth, libHRGE_optionsCogButtonHeight, c_anchorTopRight, libHRGE_optionsCogButtonOffsetX, libHRGE_optionsCogButtonOffsetY, null);
    libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOptionsButton, false);

    libHRGE_dialogControlOwnedAffixesButton = libHRGE_CreateDialogControlButton(libHRGE_dialogControls);
    libHRGE_SetDialogControlSize(libHRGE_dialogControlOwnedAffixesButton, libHRGE_ownedAffixesButtonWidth, libHRGE_ownedAffixesButtonHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogControlOwnedAffixesButton, c_anchorTopRight, libHRGE_ownedAffixesButtonOffsetX, libHRGE_ownedAffixesButtonOffsetY);
    libHRGE_SetDialogControlText(libHRGE_dialogControlOwnedAffixesButton, StringExternal("Button/Name/OwnedAffixes"));
    libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOwnedAffixesButton, false);
    
    libHRGE_dialogInfo = DialogCreate(500, 500, c_anchorTopLeft, 0, 0, true);
    DialogSetImageVisible(libHRGE_dialogInfo, false);
    libHRGE_SetDialogVisible(libHRGE_dialogInfo, true);

    libHRGE_dialogControlRunLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogInfo, null, "HeroSelectPanelHeaderLabel", libHRGE_runAndDifficultyLabelWidth, libHRGE_runAndDifficultyLabelHeight, c_anchorTopLeft, libHRGE_runAndDifficultyLabelOffsetX, libHRGE_runAndDifficultyLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), true);
    libHRGE_CreateDialogControlLabel(libHRGE_dialogInfo, versionLabel, "Affix_Version", libHRGE_versionLabelWidth, libHRGE_versionLabelHeight, c_anchorTopLeft, libHRGE_versionLabelOffsetX, libHRGE_versionLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), true);
}

void libHRGE_UpdateInfoDialog() {
    TextExpressionSetToken("Param/Expression/InfoRun", "A", IntToText(libHRGE_currentRun));
    TextExpressionSetToken("Param/Expression/InfoRun", "B", libHRGE_GetDifficultyLabel(libHRGE_difficulty));
    libHRGE_SetDialogControlText(libHRGE_dialogControlRunLabel, TextExpressionAssemble("Param/Expression/InfoRun"));
    if (libHRGE_currentRun > libHRGE_winningRound) {
        libHRGE_SetDialogControlColor(libHRGE_dialogControlRunLabel, Color(100, 84, 20));
    }
}

void libHRGE_CreateAchievementsDialogItem(int achievement) {
    int column = (achievement - 1) % libHRGE_achievementsColumns;
    int row = (achievement - 1) / libHRGE_achievementsColumns;
    int rows = (libHRGE_maxAchievements + libHRGE_achievementsColumns - 1) / libHRGE_achievementsColumns;
    int gridWidth = libHRGE_achievementsColumns * libHRGE_achievementsItemWidth + (libHRGE_achievementsColumns - 1) * libHRGE_achievementsItemSpacingX;
    int gridHeight = rows * libHRGE_achievementsItemHeight + (rows - 1) * libHRGE_achievementsItemSpacingY;
    int x = -gridWidth / 2 + libHRGE_achievementsItemWidth / 2 + column * (libHRGE_achievementsItemWidth + libHRGE_achievementsItemSpacingX);
    int y = (-gridHeight / 2 + libHRGE_achievementsItemHeight / 2 + row * (libHRGE_achievementsItemHeight + libHRGE_achievementsItemSpacingY)) + libHRGE_achievementsItemsOffsetY;

    libHRGE_dialogAchievements.achievement[achievement].button = libHRGE_CreateDialogControlImage(libHRGE_dialogAchievements.dialog,
        null, libHRGE_achievementsItemWidth, libHRGE_achievementsItemHeight, c_anchorCenter, x, y, null);
    libHRGE_dialogAchievements.achievement[achievement].label = libHRGE_CreateDialogControlLabel(libHRGE_dialogAchievements.dialog,
        null, "Affix_Owned", libHRGE_achievementsItemLabelWidth, libHRGE_achievementsItemLabelHeight, c_anchorCenter, x, y + libHRGE_achievementsItemLabelSpacingY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogAchievements.achievement[achievement].overlay = libHRGE_CreateDialogControlImage(libHRGE_dialogAchievements.dialog,
        libHRGE_textureAchievementNoneOverlay, libHRGE_achievementsItemOverlayWidth, libHRGE_achievementsItemOverlayHeight, c_anchorCenter, x, y, null);

}
void libHRGE_CreateAchievementsDialog() {
    int i;
    libHRGE_dialogAchievements.dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libHRGE_dialogAchievements.dialog, true);
    DialogSetImageVisible(libHRGE_dialogAchievements.dialog, false);
    libHRGE_dialogAchievements.label = libHRGE_CreateDialogControlLabel(libHRGE_dialogAchievements.dialog, StringExternal("Label/Name/Achievements"), "Storm_Map_Large_Bold_Centered", libHRGE_achievementsLabelWidth, libHRGE_achievementsLabelHeight, c_anchorTop, libHRGE_achievementsLabelOffsetX, libHRGE_achievementsLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogAchievements.closeButton = libHRGE_CreateDialogControlButton(libHRGE_dialogAchievements.dialog);
    libHRGE_SetDialogControlText(libHRGE_dialogAchievements.closeButton, StringExternal("Button/Name/Close"));
    libHRGE_SetDialogControlSize(libHRGE_dialogAchievements.closeButton, libHRGE_achievementsCloseButtonWidth, libHRGE_achievementsCloseButtonHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogAchievements.closeButton, c_anchorCenter, libHRGE_achievementsCloseButtonOffsetX, libHRGE_achievementsCloseButtonOffsetY);
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        libHRGE_CreateAchievementsDialogItem(i);
    }

    libHRGE_dialogAchievements.resetButton = libHRGE_CreateDialogControlButton(libHRGE_dialogAchievements.dialog);
    libHRGE_SetDialogControlText(libHRGE_dialogAchievements.resetButton, StringExternal("Button/Name/ResetAchievements"));
    libHRGE_SetDialogControlSize(libHRGE_dialogAchievements.resetButton, libHRGE_achievementsResetButtonWidth, libHRGE_achievementsResetButtonHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogAchievements.resetButton, c_anchorCenter, libHRGE_achievementsResetButtonOffsetX, libHRGE_achievementsResetButtonOffsetY);
    libHRGE_SetDialogControlColor(libHRGE_dialogAchievements.resetButton, Color(100, 50, 50));
    
    libHRGE_dialogAchievementsReset.dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libHRGE_dialogAchievementsReset.dialog, true);
    DialogSetImageVisible(libHRGE_dialogAchievementsReset.dialog, false);
    libHRGE_dialogAchievementsReset.frame = DialogControlCreateFromTemplate(libHRGE_dialogAchievementsReset.dialog, c_triggerControlTypeImage, "StandardTemplates/StandardContextMenuFrame");
    libHRGE_SetDialogControlSize(libHRGE_dialogAchievementsReset.frame, libHRGE_achievementsResetFrameWidth, libHRGE_achievementsResetFrameHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogAchievementsReset.frame, c_anchorCenter, 0, 0);
    libHRGE_dialogAchievementsReset.label = libHRGE_CreateDialogControlLabel(libHRGE_dialogAchievementsReset.dialog,
        StringExternal("Label/Name/ResetAchievements"), "Affix_Dialog", libHRGE_achievementsResetLabelWidth, libHRGE_achievementsResetLabelHeight,
        c_anchorCenter, libHRGE_achievementsResetLabelOffsetX, libHRGE_achievementsResetLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogAchievementsReset.option[1].button = libHRGE_CreateDialogControlButton(libHRGE_dialogAchievementsReset.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogAchievementsReset.option[1].button, libHRGE_optionsRestartButtonWidth, libHRGE_optionsRestartButtonHeight);
    libHRGE_SetDialogControlText(libHRGE_dialogAchievementsReset.option[1].button, StringExternal("Button/Name/Yes"));
    libHRGE_SetDialogControlPosition(libHRGE_dialogAchievementsReset.option[1].button, c_anchorCenter, libHRGE_optionsRestartButtonYesOffsetX, libHRGE_optionsRestartButtonYesOffsetY);
    libHRGE_dialogAchievementsReset.option[2].button = libHRGE_CreateDialogControlButton(libHRGE_dialogAchievementsReset.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogAchievementsReset.option[2].button, libHRGE_optionsRestartButtonWidth, libHRGE_optionsRestartButtonHeight);
    libHRGE_SetDialogControlText(libHRGE_dialogAchievementsReset.option[2].button, StringExternal("Button/Name/No"));
    libHRGE_SetDialogControlPosition(libHRGE_dialogAchievementsReset.option[2].button, c_anchorCenter, libHRGE_optionsRestartButtonNoOffsetX, libHRGE_optionsRestartButtonNoOffsetY);

}
void libHRGE_UpdateAchievementsDialog() {
    int i;
    color labelColor;
    string overlayImage;
    text appendTooltip;
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        appendTooltip = null;
        if (libHRGE_achievements[i].earned) {
            if (libHRGE_achievements[i].difficulty == libHRGE_difficultyHeroic) {
                labelColor = Color(100, 84, 20);
                overlayImage = libHRGE_textureAchievementHeroicOverlay;
                appendTooltip += StringExternal("Achievement/Tooltip/HighestDifficultyHeroic");
            } else if (libHRGE_achievements[i].difficulty == libHRGE_difficultyMythic) {
                labelColor = Color(66, 29, 53);
                overlayImage = libHRGE_textureAchievementMythicOverlay;
                appendTooltip += StringExternal("Achievement/Tooltip/HighestDifficultyMythic");
            } else {
                labelColor = Color(100, 100, 100);
                overlayImage = libHRGE_textureAchievementNormalOverlay;
                appendTooltip += StringExternal("Achievement/Tooltip/HighestDifficultyNormal");
            }
            if (libHRGE_AchievementHasRoundAndTimeNumber(i) && libHRGE_achievements[i].round > 0) {
                TextExpressionSetToken("Achievement/Tooltip/RoundNumber", "A", IntToText(libHRGE_achievements[i].round));
                appendTooltip += TextExpressionAssemble("Achievement/Tooltip/RoundNumber");
            }
            if (libHRGE_AchievementHasRoundAndTimeNumber(i) && libHRGE_achievements[i].time > 0) {
                TextExpressionSetToken("Achievement/Tooltip/TimeNumber", "A", libHRGE_IntToTimeText(libHRGE_achievements[i].time));
                appendTooltip += TextExpressionAssemble("Achievement/Tooltip/TimeNumber");
            }
            libHRGE_SetDialogControlColor(libHRGE_dialogAchievements.achievement[i].button, Color(100, 100, 100));
            libHRGE_SetDialogControlColor(libHRGE_dialogAchievements.achievement[i].label, labelColor);
            libHRGE_SetDialogControlImage(libHRGE_dialogAchievements.achievement[i].overlay, overlayImage);
        } else {
            libHRGE_SetDialogControlColor(libHRGE_dialogAchievements.achievement[i].button, Color(8, 8, 8));
            libHRGE_SetDialogControlColor(libHRGE_dialogAchievements.achievement[i].label, Color(50, 50, 50));
            libHRGE_SetDialogControlImage(libHRGE_dialogAchievements.achievement[i].overlay, libHRGE_textureAchievementNoneOverlay);
        }
        libHRGE_SetDialogControlImage(libHRGE_dialogAchievements.achievement[i].button, libHRGE_achievements[i].icon);
        libHRGE_SetDialogControlTooltip(libHRGE_dialogAchievements.achievement[i].button, StringExternal("Achievement/Tooltip/" + libHRGE_achievements[i].name) + appendTooltip);
        libHRGE_SetDialogControlText(libHRGE_dialogAchievements.achievement[i].label, StringExternal("Achievement/Name/" + libHRGE_achievements[i].name));
    }
}

void libHRGE_ShowAchievementsDialog(bool show) {
    libHRGE_UpdateAchievementsDialog();
    libHRGE_SetDialogVisible(libHRGE_dialogAchievements.dialog, show);
    libHRGE_ShowBackdrop(show);
    if (show && libHRGE_IsOptionsDialogVisible()) {
        DialogSetTransparency(libHRGE_dialogOptions.dialog, 75);
    } else {
        DialogSetTransparency(libHRGE_dialogOptions.dialog, 0);
    }
    if (!libPBU2_heroSelected && libHRGE_currentRun == 1 && !libHRGE_debug_disableHeroSelection) {
        libHRGE_SetDialogVisible(libPBU2_gv_curateHeroSelectionUI.lv_dialog, !show);
        libHRGE_SetDialogVisible(libPBU2_informationDialog, false);
    }
    libHRGE_SetDialogVisible(libHRGE_dialogAchievementsReset.dialog, false);
}


