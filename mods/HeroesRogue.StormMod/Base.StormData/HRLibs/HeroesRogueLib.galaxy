// ============================================================
// Chen - Sync behaviors on Storm Earth Fire units
// ============================================================
bool libHRGE_ChenStormEarthFireTrigger_Func (bool testConds, bool runActions) {
    unit caster = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int player = UnitGetOwner(caster);
    unitgroup pandas = libGDHL_gv_heroChenStormEarthFireUnits[player].lv_stormEarthFireUnits;
    int pandaCount;
    unit pandaUnit;
    
    libHRGE_Wait(0.0625, c_timeGame);
    pandaCount = UnitGroupCount(pandas, c_unitCountAll);
    for (;; pandaCount -= 1) {
        if (pandaCount <= 0) { break; }
        pandaUnit = UnitGroupUnitFromEnd(pandas, pandaCount);
        libHRGE_DisplayDebugMessage("Syncing behaviors from " + UnitGetType(caster) + " to " + UnitGetType(pandaUnit));
        libHRGE_SyncBehaviors(caster, pandaUnit);
    }
    return true;
}

