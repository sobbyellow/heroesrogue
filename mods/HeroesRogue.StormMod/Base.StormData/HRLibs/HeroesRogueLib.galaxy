string libHRGE_GetAffixRarityLabel(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    int rarity = libHRGE_GetAffixRarity(instance);
    bool curse = libHRGE_AffixIsCurse(instance);
    if (rarity == libHRGE_rarityMythic) {
        return "Label/Name/RarityMythic";
    } else if (rarity == libHRGE_rarityChallenge) {
        return "Label/Name/RarityCurseChallenge";
    } else if (curse) {
        return "Label/Name/RarityCurse";
    } else if (rarity == libHRGE_rarityMilestone) {
        return "Label/Name/RarityMilestone";
    } else if (rarity == libHRGE_rarityCommon) {
        return "Label/Name/RarityCommon";
    } else if (rarity == libHRGE_rarityUncommon) {
        return "Label/Name/RarityUncommon";
    } else if (rarity == libHRGE_rarityRare) {
        return "Label/Name/RarityRare";
    } else if (rarity == libHRGE_rarityEpic) {
        return "Label/Name/RarityEpic";
    } else if (rarity == libHRGE_rarityLegendary) {
        return "Label/Name/RarityLegendary";
    } else if (rarity == libHRGE_rarityStarter) {
        return "Label/Name/RarityStarter";
    }
    return "Label/Name/AffixNone";
}
string libHRGE_GetAffixStackLabel(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    int rarity = libHRGE_GetAffixRarity(instance);
    int max = libHRGE_GetAffixMax(instance);
    if (rarity == libHRGE_rarityMythic) {
        return "Label/Name/RaritySuffixNone";
    } else if (max > 1) {
        return "Label/Name/RaritySuffixStackable";
    } else if (max <= 0) {
        return "Label/Name/RaritySuffixInfinite";
    }
    return "Label/Name/RaritySuffixNone";
}

color libHRGE_GetAffixColor(string instance) {
    int rarity = libHRGE_GetAffixRarity(instance);
    bool curse = libHRGE_AffixIsCurse(instance);
    if (rarity == libHRGE_rarityMythic) {
        return Color(66, 29, 53);
    } else if (rarity == libHRGE_rarityChallenge) {
        return Color(89, 39, 0);
    } else if (curse) {
        return Color(77, 12, 12);
    } else if (rarity == libHRGE_rarityMilestone) {
        return Color(0, 100, 100);
    } else if (rarity == libHRGE_rarityCommon) {
        return Color(100, 100, 100);
    } else if (rarity == libHRGE_rarityUncommon) {
        return Color(0, 100, 33);
    } else if (rarity == libHRGE_rarityRare) {
        return Color(0, 44, 87);
    } else if (rarity == libHRGE_rarityEpic) {
        return Color(64, 21, 93);
    } else if (rarity == libHRGE_rarityLegendary) {
        return Color(100, 50, 0);
    } else if (rarity == libHRGE_rarityStarter) {
        return Color(90, 80, 50);
    }
    return Color(100, 100, 100);
}

string libHRGE_GetAffixTextureSuffix(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    int rarity = libHRGE_GetAffixRarity(instance);
    bool curse = libHRGE_AffixIsCurse(instance);
    if (rarity == libHRGE_rarityMythic) {
        return "_mythic";
    } else if (rarity == libHRGE_rarityChallenge) {
        return "_curse_challenge";
    } else if (curse) {
        return "_curse";
    } else if (rarity == libHRGE_rarityMilestone) {
        return "_milestone";
    } else if (rarity == libHRGE_rarityCommon) {
        return "_common";
    } else if (rarity == libHRGE_rarityUncommon) {
        return "_uncommon";
    } else if (rarity == libHRGE_rarityRare) {
        return "_rare";
    } else if (rarity == libHRGE_rarityEpic) {
        return "_epic";
    } else if (rarity == libHRGE_rarityLegendary) {
        return "_legendary";
    } else if (rarity == libHRGE_rarityStarter) {
        return "_starter";
    }
    return "";
}
string libHRGE_GetCountSuffix(int count, int maxCount) {
    if (count > 0 && maxCount != 1) {
        if (maxCount > 1) {
            return " (" + IntToString(count) + "/" + IntToString(maxCount) + ")";
        } else {
            return " (" + IntToString(count) + ")";
        }
    }
    return "";
}
