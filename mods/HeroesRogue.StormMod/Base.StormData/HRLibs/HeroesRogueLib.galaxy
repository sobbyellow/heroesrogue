    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].unlockPreview, c_anchorTop, offsetX + libHRGE_affixItemUnlockPreviewOffsetX, offsetY + libHRGE_affixItemUnlockPreviewOffsetY);
}

void libHRGE_UpdateAffixSelectionDialogItem(int index, int rolledCount) {
    int i;
    int affix = libHRGE_rolledAffixes[index];
    int span = libHRGE_affixItemSpacing * (rolledCount - 1);
    int offsetX = -span / 2 + libHRGE_affixItemSpacing * (index - 1);
    int rarityOffsetY = libHRGE_affixItemRarityOffsetY;
    string instance = libHRGE_GetAffixInstance(affix);
    bool bannable = libHRGE_IsAffixBannable(affix);
    text previewTalentsTooltip = libHRGE_GetExtendedAffixTooltip(instance, false, false, false, true, false);
    text previewUnlocksTooltip = libHRGE_GetExtendedAffixTooltip(instance, false, false, false, false, true);

    if (bannable) {
        rarityOffsetY = libHRGE_affixItemRarityBanOffsetY;
    }

    libHRGE_SetDialogControlImage(libHRGE_dialogAffixSelection.items[index].affixBackground, "Assets/Textures/affix_bg" + libHRGE_GetAffixTextureSuffix(affix) + ".dds");
    libHRGE_SetDialogControlImage(libHRGE_dialogAffixSelection.items[index].icon, libHRGE_GetAffixIcon(instance));
    libHRGE_SetDialogControlImage(libHRGE_dialogAffixSelection.items[index].iconOverlay, "Assets/Textures/icon_overlay_large" + libHRGE_GetAffixTextureSuffix(affix) + ".dds");
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.items[index].nameLabel, StringExternal("Affix/Name/" + instance) + StringToText(libHRGE_GetCountSuffix(libHRGE_GetAffixCount(instance), libHRGE_GetAffixMax(instance))));
    libHRGE_SetDialogControlColor(libHRGE_dialogAffixSelection.items[index].nameLabel, libHRGE_GetAffixColor(instance));
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.items[index].tooltipLabel, libHRGE_GetAffixTooltip(affix, false));
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.items[index].rarityLabel, StringExternal(libHRGE_GetAffixRarityLabel(affix)) + StringExternal(libHRGE_GetAffixStackLabel(affix)));
    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].rarityLabel, c_anchorTop, offsetX + libHRGE_affixItemRarityOffsetX, libHRGE_affixItemOffsetY + rarityOffsetY);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].banButton, bannable);
    
    libHRGE_UpdateAffixSelectionPosDialogItem(index, offsetX, libHRGE_affixItemOffsetY);

    if (previewTalentsTooltip != null) {
        libHRGE_SetDialogControlTooltip(libHRGE_dialogAffixSelection.items[index].talentPreview, previewTalentsTooltip);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].talentPreview, true);
    } else {
        libHRGE_SetDialogControlTooltip(libHRGE_dialogAffixSelection.items[index].talentPreview, null);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].talentPreview, false);
    }

    if (previewUnlocksTooltip != null) {
        libHRGE_SetDialogControlTooltip(libHRGE_dialogAffixSelection.items[index].unlockPreview, previewUnlocksTooltip);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].unlockPreview, true);
        if (previewTalentsTooltip == null) {
            libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].unlockPreview, c_anchorTop, offsetX + libHRGE_affixItemUnlockPreviewOffsetX, libHRGE_affixItemOffsetY + libHRGE_affixItemTalentPreviewOffsetY);
        } else {
            libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].unlockPreview, c_anchorTop, offsetX + libHRGE_affixItemUnlockPreviewOffsetX, libHRGE_affixItemOffsetY + libHRGE_affixItemUnlockPreviewOffsetY);
        }
    } else {
        libHRGE_SetDialogControlTooltip(libHRGE_dialogAffixSelection.items[index].unlockPreview, null);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].unlockPreview, false);
    }

    if (libHRGE_bans <= 0) {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogAffixSelection.items[index].banButton, false);
    } else {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogAffixSelection.items[index].banButton, true);
    }
}

void libHRGE_UpdateAffixSelectionDialog() {
    int i;
    int rolledCount = libHRGE_GetRolledAffixCount();
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.titleLabel, libHRGE_GetAffixTitleLabel());
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.rerollLabel, libHRGE_GetAffixRerollLabel());
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.banLabel, StringExternal("Label/Name/Bans") + IntToText(libHRGE_bans));
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.rerollButton, libHRGE_IsCurrentQueueRerollable());
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.rerollLabel, libHRGE_IsCurrentQueueRerollable());
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.banLabel, libHRGE_IsAnyRolledAffixBannable());

    if (libHRGE_rerolls <= 0) {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogAffixSelection.rerollButton, false);
    } else {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogAffixSelection.rerollButton, true);
    }

    for (i = 1; i <= libHRGE_maxAffixSelection; i += 1) {
        if (i <= libHRGE_currentQueue.choiceCount && libHRGE_rolledAffixes[i] != 0) {
            libHRGE_ShowAffixSelectionDialogItem(i, true);
            libHRGE_UpdateAffixSelectionDialogItem(i, rolledCount);
        } else {
            libHRGE_ShowAffixSelectionDialogItem(i, false);
        }
    }
}

void libHRGE_ShowAffixSelectionDialogItem(int index, bool show) {
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].background, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].affixBackground, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].selectButton, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].icon, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].iconOverlay, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].nameLabel, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].tooltipLabel, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].rarityLabel, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].banButton, show);
    if (!show) {
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].talentPreview, show);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].unlockPreview, show);
    }
}

void libHRGE_ShowAffixSelectionDialog(bool show) {
    libHRGE_UpdateAffixSelectionDialog();
    libHRGE_SetDialogVisible(libHRGE_dialogAffixSelection.dialog, show);
    libHRGE_UpdateOptionsDialog();
    libHRGE_ShowBackdrop(show);
    libHRGE_Pause(show);
}

void libHRGE_SortOwnedAffixes() {
    int i;
    int j;
    int affix;
    for (i = 2; i <= (libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon]); i += 1) {
        affix = libHRGE_ownedAffixes[libHRGE_affixTypeBoon][i];
        j = i - 1;
        for ( ; j >= 1; j -= 1) {
            if (libHRGE_ShouldShowBefore(affix, libHRGE_ownedAffixes[libHRGE_affixTypeBoon][j])) {
                libHRGE_ownedAffixes[libHRGE_affixTypeBoon][j + 1] = libHRGE_ownedAffixes[libHRGE_affixTypeBoon][j];
            } else {
                break;
            }
        } 
        libHRGE_ownedAffixes[libHRGE_affixTypeBoon][j + 1] = affix;
    }
    for (i = 2; i <= libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse]; i += 1) {
        affix = libHRGE_ownedAffixes[libHRGE_affixTypeCurse][i];
        j = i - 1;
        for ( ; j >= 1; j -= 1) {
            if (libHRGE_ShouldShowBefore(affix, libHRGE_ownedAffixes[libHRGE_affixTypeCurse][j])) {
                libHRGE_ownedAffixes[libHRGE_affixTypeCurse][j + 1] = libHRGE_ownedAffixes[libHRGE_affixTypeCurse][j];
            } else {
                break;
            }
        } 
        libHRGE_ownedAffixes[libHRGE_affixTypeCurse][j + 1] = affix;
    }
}

void libHRGE_CreateOwnedAffixesDialogItem(int index) {
    libHRGE_dialogOwnedAffixes.items[index].icon = libHRGE_CreateDialogControlImage(libHRGE_dialogOwnedAffixes.dialog, null, libHRGE_ownedAffixesIconWidth, libHRGE_ownedAffixesIconHeight, c_anchorCenter, 0, 0, null);
    libHRGE_dialogOwnedAffixes.items[index].iconOverlay = libHRGE_CreateDialogControlImage(libHRGE_dialogOwnedAffixes.dialog, null, libHRGE_ownedAffixesIconOverlayWidth, libHRGE_ownedAffixesIconOverlayHeight, c_anchorCenter, 0, 0, null);
    libHRGE_dialogOwnedAffixes.items[index].nameLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogOwnedAffixes.dialog, null, "Affix_Owned", libHRGE_ownedAffixesNameWidth, libHRGE_ownedAffixesNameHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogOwnedAffixes.items[index].cooldownLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogOwnedAffixes.dialog, null, "Storm_Tutorial_Small_Centered", libHRGE_ownedAffixesCooldownWidth, libHRGE_ownedAffixesCooldownHeight, c_anchorCenter, 0, 0, ColorWithAlpha(0, 0, 0, 0), false);
}

void libHRGE_CreateOwnedAffixesDialog() {
    int i;
    DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    libHRGE_dialogOwnedAffixes.dialog = DialogLastCreated();
    DialogSetFullscreen(libHRGE_dialogOwnedAffixes.dialog, true);
    DialogSetImageVisible(libHRGE_dialogOwnedAffixes.dialog, false);
    libHRGE_dialogOwnedAffixes.label = libHRGE_CreateDialogControlLabel(libHRGE_dialogOwnedAffixes.dialog, StringExternal("Label/Name/ShowAffixes"), "Storm_Map_Large_Bold_Centered", libHRGE_ownedAffixesLabelWidth, libHRGE_ownedAffixesLabelHeight, c_anchorTop, libHRGE_ownedAffixesLabelOffsetX, libHRGE_ownedAffixesLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);

    for (i = 1; i <= libHRGE_maxOwnedAffixesPerPage; i += 1) {
        libHRGE_CreateOwnedAffixesDialogItem(i);
    }

    libHRGE_dialogOwnedAffixes.previousButton = libHRGE_CreateDialogControlButton(libHRGE_dialogOwnedAffixes.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogOwnedAffixes.previousButton, libHRGE_ownedAffixesPagesButtonWidth, libHRGE_ownedAffixesPagesButtonHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogOwnedAffixes.previousButton, c_anchorBottomLeft, 0, 0);
    libHRGE_SetDialogControlText(libHRGE_dialogOwnedAffixes.previousButton, StringExternal("Button/Name/PreviousPage"));

    libHRGE_dialogOwnedAffixes.nextButton = libHRGE_CreateDialogControlButton(libHRGE_dialogOwnedAffixes.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogOwnedAffixes.nextButton, libHRGE_ownedAffixesPagesButtonWidth, libHRGE_ownedAffixesPagesButtonHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogOwnedAffixes.nextButton, c_anchorBottomRight, 0, 0);
    libHRGE_SetDialogControlText(libHRGE_dialogOwnedAffixes.nextButton, StringExternal("Button/Name/NextPage"));
}
void libHRGE_UpdateOwnedAffixesDialogItem(int slotIndex, int pageStart, int pageAffixes, int totalRows) {
    int affixIndex;
    int affix;
    int offsetX;
    int offsetY;
    int row = (slotIndex - 1) / libHRGE_ownedAffixesPerRow;
    int column = (slotIndex - 1) % libHRGE_ownedAffixesPerRow;
    int affixesThisRow;
    string questIcon;
    text cooldownLabel;
    string instance;
    string cooldownLink;
    fixed cooldown;
    timer cooldownTimer;
    unit playerUnit;

    if (row == totalRows - 1) {
        affixesThisRow = pageAffixes - row * libHRGE_ownedAffixesPerRow;
    } else {
        affixesThisRow = libHRGE_ownedAffixesPerRow;
    }

    offsetX = -(affixesThisRow - 1) * libHRGE_ownedAffixesAffixWidth / 2 + column * libHRGE_ownedAffixesAffixWidth;
    offsetY = -(totalRows - 1) * libHRGE_ownedAffixesAffixHeight / 2 + row * libHRGE_ownedAffixesAffixHeight;
    affixIndex = pageStart + slotIndex - 1;
    
    if (affixIndex <= libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon]) {
        affix = libHRGE_ownedAffixes[libHRGE_affixTypeBoon][affixIndex];
    } else {
        affix = libHRGE_ownedAffixes[libHRGE_affixTypeCurse][affixIndex - libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon]];
    }
    instance = libHRGE_GetAffixInstance(affix);

    if (libHRGE_AffixIsQuest(instance)) {
        questIcon = "Affix/Quest";
    }
    libHRGE_SetDialogControlPosition(libHRGE_dialogOwnedAffixes.items[slotIndex].icon, c_anchorCenter, offsetX + libHRGE_ownedAffixesIconOffsetX, offsetY + libHRGE_ownedAffixesIconOffsetY);
    libHRGE_SetDialogControlImage(libHRGE_dialogOwnedAffixes.items[slotIndex].icon, libHRGE_GetAffixIcon(instance));
    libHRGE_SetDialogControlColor(libHRGE_dialogOwnedAffixes.items[slotIndex].icon, ColorWithAlpha(0, 0, 0, 0));
    libHRGE_SetDialogControlTooltip(libHRGE_dialogOwnedAffixes.items[slotIndex].icon, StringExternal("<c val=\"#TooltipNumbers\">") + StringExternal("Affix/Name/" + instance) + StringExternal("</c><n/><n/>") + libHRGE_GetAffixTooltip(affix, true));
    libHRGE_SetDialogControlPosition(libHRGE_dialogOwnedAffixes.items[slotIndex].iconOverlay, c_anchorCenter, offsetX + libHRGE_ownedAffixesIconOverlayOffsetX, offsetY + libHRGE_ownedAffixesIconOverlayOffsetY);
    libHRGE_SetDialogControlImage(libHRGE_dialogOwnedAffixes.items[slotIndex].iconOverlay, "Assets/Textures/icon_overlay" + libHRGE_GetAffixTextureSuffix(affix) + ".dds");
    libHRGE_SetDialogControlPosition(libHRGE_dialogOwnedAffixes.items[slotIndex].nameLabel, c_anchorCenter, offsetX + libHRGE_ownedAffixesNameOffsetX, offsetY + libHRGE_ownedAffixesNameOffsetY);
    libHRGE_SetDialogControlText(libHRGE_dialogOwnedAffixes.items[slotIndex].nameLabel, StringExternal(questIcon) + StringExternal("Affix/Name/" + instance) + StringToText(libHRGE_GetCountSuffix(libHRGE_GetAffixCount(instance), libHRGE_GetAffixMax(instance))));
    libHRGE_SetDialogControlColor(libHRGE_dialogOwnedAffixes.items[slotIndex].nameLabel, libHRGE_GetAffixColor(instance));
    libHRGE_SetDialogControlPosition(libHRGE_dialogOwnedAffixes.items[slotIndex].cooldownLabel, c_anchorCenter, offsetX + libHRGE_ownedAffixesCooldownOffsetX, offsetY + libHRGE_ownedAffixesCooldownOffsetY);
    libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.items[slotIndex].cooldownLabel, false);

    cooldownLink = libHRGE_GetAffixCooldownLink(instance);
    playerUnit = libHRGE_GetPlayerHeroUnit(libHRGE_player);
    if (cooldownLink != null && cooldownLink != "") {
        if (UnitGetCooldown(playerUnit, cooldownLink) > 0) {
            cooldownLabel = StringToText(FixedToString(UnitGetCooldown(playerUnit, cooldownLink), 0));
        } else {
            playerUnit = libHRGE_GetPlayerUnitWithBehavior(libHRGE_player, cooldownLink);
            if (UnitBehaviorDuration(playerUnit, cooldownLink) > 0) {
                cooldownLabel = StringToText(FixedToString(UnitBehaviorDuration(playerUnit, cooldownLink), 0));
            }
        }
    } else {
        cooldownTimer = libHRGE_GetAffixPrimaryTimer(instance);
        if (cooldownTimer != null && TimerGetRemaining(cooldownTimer) > 0 && !libHRGE_AffixCooldownHidden(instance)) {
            cooldownLabel = StringToText(FixedToString(TimerGetRemaining(cooldownTimer), 0));
        }
    }
    if (cooldownLabel != null) {
        libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.items[slotIndex].cooldownLabel, true);
        libHRGE_SetDialogControlColor(libHRGE_dialogOwnedAffixes.items[slotIndex].icon, Color(40, 40, 40));
        libHRGE_SetDialogControlText(libHRGE_dialogOwnedAffixes.items[slotIndex].cooldownLabel, cooldownLabel);
    }
    if (libHRGE_AffixQuestDone(instance)) {
        libHRGE_SetDialogControlColor(libHRGE_dialogOwnedAffixes.items[slotIndex].icon, Color(40, 40, 40));
        libHRGE_SetDialogControlColor(libHRGE_dialogOwnedAffixes.items[slotIndex].nameLabel, Color(40, 40, 40));
    }
}
void libHRGE_UpdateOwnedAffixesDialog() {
    int i;
    int totalAffixes;
    int pageStart;
    int pageEnd;
    int pageAffixes;
    int totalRows;
    libHRGE_CountOwnedAffixes();
    libHRGE_SortOwnedAffixes();
    totalAffixes = libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon] + libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse];
    libHRGE_ownedAffixesMaxPages = CeilingI(IntToFixed(libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse] + libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon]) / IntToFixed(libHRGE_maxOwnedAffixesPerPage));
    pageStart = (libHRGE_ownedAffixesCurrentPage - 1) * libHRGE_maxOwnedAffixesPerPage + 1;
    pageEnd = MinI(totalAffixes, pageStart + libHRGE_maxOwnedAffixesPerPage - 1);
    pageAffixes =  pageEnd - pageStart + 1;
    totalRows = CeilingI(IntToFixed(pageAffixes) / IntToFixed(libHRGE_ownedAffixesPerRow));

    for (i = 1; i <= libHRGE_maxOwnedAffixesPerPage; i += 1) {
        if (i <= pageAffixes) {
            libHRGE_ShowOwnedAffixesDialogItem(i, true);
            libHRGE_UpdateOwnedAffixesDialogItem(i, pageStart, pageAffixes, totalRows);
        } else {
            libHRGE_ShowOwnedAffixesDialogItem(i, false);
        }
    }
    if (libHRGE_ownedAffixesMaxPages > 1) {
        libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.previousButton, true);
        libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.nextButton, true);
        libHRGE_SetDialogControlEnabled(libHRGE_dialogOwnedAffixes.previousButton, libHRGE_ownedAffixesCurrentPage > 1);
        libHRGE_SetDialogControlEnabled(libHRGE_dialogOwnedAffixes.nextButton, libHRGE_ownedAffixesCurrentPage < libHRGE_ownedAffixesMaxPages);
        libHRGE_SetDialogControlText(libHRGE_dialogOwnedAffixes.label, StringExternal("Label/Name/ShowAffixes") + StringToText(" (" + IntToString(libHRGE_ownedAffixesCurrentPage) + "/" + IntToString(libHRGE_ownedAffixesMaxPages) + ")"));
    } else {
        libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.previousButton, false);
        libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.nextButton, false);
    }
}
void libHRGE_ShowOwnedAffixesDialogItem(int index, bool show) {
    libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.items[index].icon, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.items[index].iconOverlay, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.items[index].nameLabel, show);
    libHRGE_SetDialogControlVisible(libHRGE_dialogOwnedAffixes.items[index].cooldownLabel, show);
}
void libHRGE_ShowOwnedAffixesDialog(bool show) {
    libHRGE_UpdateOwnedAffixesDialog();
    libHRGE_SetDialogVisible(libHRGE_dialogOwnedAffixes.dialog, show);
    libHRGE_UpdateOptionsDialog();
    libHRGE_ShowBackdrop(show);
    if (show && libHRGE_IsAffixSelectionDialogVisible()) {
        DialogSetTransparency(libHRGE_dialogAffixSelection.dialog, 75);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.titleLabel, false);
    } else {
        DialogSetTransparency(libHRGE_dialogAffixSelection.dialog, 0);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.titleLabel, true);
    }
    if (show && libHRGE_IsGameoverDialogVisible()) {
        DialogSetTransparency(libHRGE_dialogGameover.dialog, 75);
    } else {
        DialogSetTransparency(libHRGE_dialogGameover.dialog, 0);
    }
    if (show) {
        libHRGE_SetDialogControlText(libHRGE_dialogControlOwnedAffixesButton, StringExternal("Button/Name/OwnedAffixesHide"));
    } else {
        libHRGE_SetDialogControlText(libHRGE_dialogControlOwnedAffixesButton, StringExternal("Button/Name/OwnedAffixes"));
    }
    libHRGE_Pause(show);
}
void libHRGE_CountOwnedAffixes() {
    int i;
    string instance;
    libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon] = 0;
    libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse] = 0;
    for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
        instance = libHRGE_GetAffixInstance(i);
        if (libHRGE_GetAffixCount(instance) <= 0) {
            continue;
        }
        if (libHRGE_AffixIsCurse(instance)) {
            libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse] += 1;
            libHRGE_ownedAffixes[libHRGE_affixTypeCurse][libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse]] = i;
        } else {
            libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon] += 1;
            libHRGE_ownedAffixes[libHRGE_affixTypeBoon][libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon]] = i;
        }
    }
}

void libHRGE_DialogControlTriggers_Init() {
    trigger optionsClicked = TriggerCreate("libHRGE_OptionsClickedTrigger_Func");
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_OwnedAffixesPagesClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_OptionsRestartClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(optionsClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(optionsClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_ShowAffixesClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_AffixSelectedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_AffixBanTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_AffixRerollTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_GameoverButtonsClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(TriggerCreate("libHRGE_AchievementsClickedTrigger_Func"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}


bool libHRGE_AchievementsClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libHRGE_dialogControlOptionsAchievementsButton && eventDialog != libPBU2_dialogAchievements && 
            eventDialog != libHRGE_dialogAchievements.closeButton && eventDialog != libHRGE_dialogAchievementsReset.option[1].button && 
            eventDialog != libHRGE_dialogAchievementsReset.option[2].button && eventDialog != libHRGE_dialogAchievements.resetButton) {
            return false;
        }
        if (eventDialog == libPBU2_dialogAchievements && libPBU2_heroSelected) {
            return false;
        }
    }
    if (eventDialog == libHRGE_dialogControlOptionsAchievementsButton || eventDialog == libPBU2_dialogAchievements || eventDialog == libHRGE_dialogAchievements.closeButton) {
        libHRGE_ShowAchievementsDialog(!libHRGE_IsAchievementsDialogVisible());
    } else if (eventDialog == libHRGE_dialogAchievements.resetButton) {
        libHRGE_SetDialogVisible(libHRGE_dialogAchievementsReset.dialog, true);
    } else if (eventDialog == libHRGE_dialogAchievementsReset.option[1].button) {
        libHRGE_ResetAllAchievements();
        libHRGE_SetDialogVisible(libHRGE_dialogAchievementsReset.dialog, false);
    } else if (eventDialog == libHRGE_dialogAchievementsReset.option[2].button) {
        libHRGE_SetDialogVisible(libHRGE_dialogAchievementsReset.dialog, false);
    }

    return true;
}

bool libHRGE_GameoverButtonsClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libHRGE_dialogGameover.continueButton && eventDialog != libHRGE_dialogGameover.restartButton &&
            eventDialog != libHRGE_dialogGameover.exitButton && eventDialog != libHRGE_dialogGameoverExit.option[1].button &&
            eventDialog != libHRGE_dialogGameoverExit.option[2].button) {
            return false;
        }
        if (libHRGE_IsOptionsDialogVisible() || libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsAchievementsDialogVisible()) {
            return false;
        }
    }
    
    if (eventDialog == libHRGE_dialogGameover.continueButton && !libHRGE_IsGameoverExitDialogVisible()) {
        libHRGE_ShowGameoverDialog(false);
    } else if (eventDialog == libHRGE_dialogGameover.restartButton && !libHRGE_IsGameoverExitDialogVisible()) {
        libHRGE_ShowOptionsRestartDialog(true);
    } else if (eventDialog == libHRGE_dialogGameover.exitButton) {
        libHRGE_ShowGameoverExitDialog(true);
    } else if (eventDialog == libHRGE_dialogGameoverExit.option[1].button) {
        libHRGE_ResetBank();
        KickFromGame(PlayerGroupAll());
    } else if (eventDialog == libHRGE_dialogGameoverExit.option[2].button) {
        libHRGE_ShowGameoverExitDialog(false);
    }
    return true;
}

bool libHRGE_OwnedAffixesPagesClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libHRGE_dialogOwnedAffixes.previousButton && eventDialog != libHRGE_dialogOwnedAffixes.nextButton) {
            return false;
        }
    }
    
    if (eventDialog == libHRGE_dialogOwnedAffixes.previousButton) {
        libHRGE_ownedAffixesCurrentPage = MaxI(1, libHRGE_ownedAffixesCurrentPage - 1);
    } else if (eventDialog == libHRGE_dialogOwnedAffixes.nextButton) {
        libHRGE_ownedAffixesCurrentPage = MinI(libHRGE_ownedAffixesMaxPages, libHRGE_ownedAffixesCurrentPage + 1);
    }
    libHRGE_UpdateOwnedAffixesDialog();
    return true;
}

bool libHRGE_SpeedUpDeathUnitDiedTrigger_Func (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    if (testConds) {
        if (UnitGetOwner(deadUnit) != libHRGE_player) {
            return false;
        }
        if (!libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpDeath, libHRGE_player)) {
            return false;
        }
    }
    
    libHRGE_Wait(0.0625, c_timeGame);
    TriggerExecute(libHRGE_SpeedUpDeathTrigger, true, false);
    return true;
}
void libHRGE_SpeedUpDeathUnitDiedTrigger_Init() {
    libHRGE_SpeedUpDeathUnitDiedTrigger = TriggerCreate("libHRGE_SpeedUpDeathUnitDiedTrigger_Func");
    TriggerAddEventUnitDied(libHRGE_SpeedUpDeathUnitDiedTrigger, null);
}

bool libHRGE_SpeedUpDeathTrigger_Func (bool testConds, bool runActions) {
    unitgroup heroGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    string hero = libHRGE_GetPlayerHero(libHRGE_player);
    int groupCount = UnitGroupCount(heroGroup, c_unitCountAlive);
    unit heroUnit;

    if (testConds) {
        if (groupCount > 0 || (hero == "LostVikings" && groupCount > 1)) {
            return false;
        }
        if (!libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpDeath, libHRGE_player)) {
            return false;
        }
        if (libGame_gv_gameOver) {
            return false;
        }
    }
    
    if (libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpDeath, libHRGE_player)) {
        GameSetSpeedValue(4);
        while ((groupCount <= 0 || (hero == "LostVikings" && groupCount <= 1)) && libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpDeath, libHRGE_player) && !libGame_gv_gameOver) {
            groupCount = UnitGroupCount(heroGroup, c_unitCountAlive);
            Wait(0.0625, c_timeGame);
        }
        GameSetSpeedValue(2);
    }
    return true;
}

bool libHRGE_SpeedUpTrigger_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (libHRGE_GateIsOpen()) {
            return false;
        }
        if (!libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpGates, libHRGE_player)) {
            return false;
        }
        if (libGame_gv_gameOver) {
            return false;
        }
    }
    
    if (libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpGates, libHRGE_player)) {
        GameSetSpeedValue(4);
        while (!libHRGE_GateIsOpen() && libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpGates, libHRGE_player) && !libGame_gv_gameOver) {
            Wait(0.0625, c_timeGame);
        }
        GameSetSpeedValue(2);
    }
    return true;
}

void libHRGE_SpeedUpTrigger_Init() {
    libHRGE_SpeedUpTrigger = TriggerCreate("libHRGE_SpeedUpTrigger_Func");
    libHRGE_SpeedUpDeathTrigger = TriggerCreate("libHRGE_SpeedUpDeathTrigger_Func");
}

bool libHRGE_OptionsRestartClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libHRGE_dialogControlOptionsReturnButton && eventDialog != libHRGE_dialogControlOptionsRestartButton && 
            eventDialog != libHRGE_dialogOptionsRestart.option[1].button && eventDialog != libHRGE_dialogOptionsRestart.option[2].button) {
            return false;
        }
        if (!libHRGE_IsOptionsDialogVisible() && !libHRGE_IsGameoverDialogVisible()) {
            return false;
        }
        if (libHRGE_IsAchievementsDialogVisible()) {
            return false;
        }
    }
    
    if (eventDialog == libHRGE_dialogControlOptionsRestartButton) {
        libHRGE_ShowOptionsRestartDialog(true);
    } else if (eventDialog == libHRGE_dialogOptionsRestart.option[1].button) {
        libHRGE_ResetBank();
        GameSetNextMap(libHRGE_GetMapPathFromIndex(libHRGE_startingMap));
        KickFromGame(PlayerGroupAll());
    } else if (eventDialog == libHRGE_dialogOptionsRestart.option[2].button) {
        libHRGE_ShowOptionsRestartDialog(false);
    } else if (eventDialog == libHRGE_dialogControlOptionsReturnButton) {
        libHRGE_ShowOptionsDialog(false);
    }

    return true;
}
bool libHRGE_OptionsClickedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    if (testConds) {
        if (eventDialog != libHRGE_dialogControlOptionsButton && eventDialog != libHRGE_dialogControlOptionsSpeedUpGates
        && eventDialog != libHRGE_dialogControlOptionsSpeedUpDeath && eventDialog != libHRGE_dialogControlOptionsDisplayPicksBans
        && eventDialog != libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips) {
            return false;
        }
    }
    
    if (eventDialog == libHRGE_dialogControlOptionsButton) {
        if (!libHRGE_IsOptionsDialogVisible()) {
            libHRGE_ShowOptionsRestartDialog(false);
            libHRGE_ShowGameoverExitDialog(false);
        }
        libHRGE_ShowAchievementsDialog(false);
        libHRGE_ShowOptionsDialog(!libHRGE_IsOptionsDialogVisible());
    } else if (eventDialog == libHRGE_dialogControlOptionsSpeedUpGates && !libHRGE_IsAchievementsDialogVisible()) {
        libHRGE_SaveBankSettings();
        if (TriggerActiveCount(libHRGE_SpeedUpTrigger) <= 0) {
            TriggerExecute(libHRGE_SpeedUpTrigger, true, false);
        }
    } else if (eventDialog == libHRGE_dialogControlOptionsSpeedUpDeath && !libHRGE_IsAchievementsDialogVisible()) {
        libHRGE_SaveBankSettings();
        if (TriggerActiveCount(libHRGE_SpeedUpDeathTrigger) <= 0) {
            TriggerExecute(libHRGE_SpeedUpDeathTrigger, true, false);
        }
    } else if (eventDialog == libHRGE_dialogControlOptionsDisplayPicksBans && !libHRGE_IsAchievementsDialogVisible()) {
        libHRGE_SaveBankSettings();
    } else if (eventDialog == libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips && !libHRGE_IsAchievementsDialogVisible()) {
        libHRGE_pressingALT = libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, libHRGE_player);
        if (libHRGE_IsOwnedAffixesDialogVisible()) {
            libHRGE_UpdateOwnedAffixesDialog();
        }
        if (libHRGE_IsAffixSelectionDialogVisible()) {
            libHRGE_UpdateAffixSelectionDialog();
        }
        libHRGE_SaveBankSettings();
    }
    return true;
}

bool libHRGE_ShowAffixesClickedTrigger_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (EventDialogControl() != libHRGE_dialogControlOwnedAffixesButton) {
            return false;
        }
        if (libHRGE_IsOptionsDialogVisible() || libHRGE_IsGameoverExitDialogVisible()) {
            return false;
        }
    }
    
    if (libHRGE_IsOwnedAffixesDialogVisible()) {
        libHRGE_ShowOwnedAffixesDialog(false);
    } else {
        libHRGE_ShowOwnedAffixesDialog(true);
    }
    return true;
}

// ============================================================
// Talent functions
// ============================================================

void libHRGE_SelectAllTalentsOnTier(int player, int tier) {
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    unit heroUnit = libHRGE_GetPlayerHeroUnit(player);
    int i;
    int choGallPlayer = 0;
    string talentLink;
    int team = libGame_gf_TeamNumberOfPlayer(player);

    if (libHRGE_allTalentsSelected[player][tier]) { return; }

    if ((hero == "Varian" && tier > 2) || (hero != "Varian" && tier > 4)) {
        while ((!UnitHasBehavior2(heroUnit, "Ultimate1Unlocked") && !UnitHasBehavior2(heroUnit, "Ultimate2Unlocked") && !UnitHasBehavior2(heroUnit, "Ultimate3Unlocked"))) {
            libHRGE_Wait(0.0625, c_timeGame);
        }
    }
    if (hero == "Tracer" && tier > 4) {
        while (!PlayerHasTalent(player, "TracerQuantumSpike") && !PlayerHasTalent(player, "TracerStickyBomb") && !PlayerHasTalent(player, "TracerPulseRounds")) {
            libHRGE_Wait(0.0625, c_timeGame);
        }
    }
    if (player == libGDHL_gv_chogallPairs[team].lv_choPlayer) {
        choGallPlayer = libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_gallPlayer;
    } else if (player == libGDHL_gv_chogallPairs[team].lv_gallPlayer) {
        choGallPlayer = libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_choPlayer;
    }
    if (hero == "Alarak" && tier == 4) {
        SetTalentEnabled("AlarakMightOfTheHighlord", false);
    }
    libHRGE_DisplayDebugMessage("Selecting all tier " + IntToString(tier) + " talents for player " + IntToString(player));
    for (i = 1; i <= libCore_gv_talents_MaxTalentsPerTier_C; i += 1) {
        talentLink = libGame_gv_talents_TalentChoices[player][tier].lv_talentData[i].lv_talentCatalogLink;
        if (!PlayerHasTalent(player, talentLink)) {
            libGame_gf_TalentsChooseTalentForPlayer(tier, i, player);
        }
        if (choGallPlayer != 0) {
            talentLink = libGame_gv_talents_TalentChoices[choGallPlayer][tier].lv_talentData[i].lv_talentCatalogLink;
            if (!PlayerHasTalent(choGallPlayer, talentLink)) {
                libGame_gf_TalentsChooseTalentForPlayer(tier, i, choGallPlayer);
            }
        }
    }
    libHRGE_allTalentsSelected[player][tier] = true;
    if (choGallPlayer != 0) {
        libHRGE_allTalentsSelected[choGallPlayer][tier] = true;
    }
}
void libHRGE_SelectAllTalents(int player, int level, bool excludeHeroics) {
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    if (hero == "Chromie") {
        level += 2;
    }
    
    if (level >= 1) {
        libHRGE_SelectAllTalentsOnTier(player, 1);
    } 
    if (level >= 4 && (hero != "Varian" || !excludeHeroics)) {
        libHRGE_SelectAllTalentsOnTier(player, 2);
    }
    if (level >= 7) {
        libHRGE_SelectAllTalentsOnTier(player, 3);
    }
    if (level >= 10 && (hero == "Varian" || !excludeHeroics)) {
        libHRGE_SelectAllTalentsOnTier(player, 4);
    }
    if (level >= 13) {
        libHRGE_SelectAllTalentsOnTier(player, 5);
    }
    if (level >= 16) {
        libHRGE_SelectAllTalentsOnTier(player, 6);
    }
    if (level >= 20) {
        libHRGE_SelectAllTalentsOnTier(player, 7);
    }
}

void libHRGE_DummyTalentChoicesFromTalentName(int lp_player, string talent) {
    int lv_itBehavior;
    int lv_itAbilityMod;
    int lv_itAbilityModChange;
    int lv_behaviorCount;
    int lv_numberOfAbilitiesModified;
    int lv_numberOfFieldsModified;
    int lv_catalogInt;
    int lv_changeTypeInt;
    int lv_currentTalentModNumber;

    int auto38B17200_ae;
    int autoDE132AE1_ae;
    libGame_gv_talents_TalentChoices[lp_player][0].lv_numberOfTalentsForThisTier = 1; // tier 0 column 0 as dummy talent data
    libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_talentCatalogLink = (talent);
    if ((CatalogFieldValueCount(c_gameCatalogTalent, talent, "RankArray", c_playerAny) != 0)) {
        libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount = MaxI(libCore_gv_talents_MaxBehaviorsPerTalent_C, CatalogFieldValueCount(c_gameCatalogTalent, talent, "RankArray[" + IntToString(0) + "].BehaviorArray", c_playerAny));
    }
    else {
        libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount = 0;
    }
    if ((libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount != 0)) {
        lv_behaviorCount = libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviorCount;
        lv_itBehavior = 1;
        for ( ; ( (1 >= 0 && lv_itBehavior <= lv_behaviorCount) || (1 < 0 && lv_itBehavior >= lv_behaviorCount) ) ; lv_itBehavior += 1 ) {
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_behaviors[lv_itBehavior] = (CatalogFieldValueGet(c_gameCatalogTalent, talent, "RankArray[" + IntToString(0) + "].BehaviorArray[" + IntToString((lv_itBehavior - 1)) + "]", c_playerAny));
        }
    }
    libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_totalModifications = 0;
    lv_currentTalentModNumber = 0;
    lv_numberOfAbilitiesModified = MaxI(libCore_gv_talents_MaxModificationsPerTalent_C, CatalogFieldValueCount(c_gameCatalogTalent, talent, "AbilityModificationArray", c_playerAny));

    auto38B17200_ae = lv_numberOfAbilitiesModified;
    lv_itAbilityMod = 1;

    for ( ; ( (1 >= 0 && lv_itAbilityMod <= auto38B17200_ae) || (1 < 0 && lv_itAbilityMod >= auto38B17200_ae) ) ; lv_itAbilityMod += 1 ) {
        lv_numberOfFieldsModified = CatalogFieldValueCount(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString(lv_itAbilityMod - 1) + "].Modifications", c_playerAny);
        autoDE132AE1_ae = lv_numberOfFieldsModified;
        lv_itAbilityModChange = 1;
        for ( ; ( (1 >= 0 && lv_itAbilityModChange <= autoDE132AE1_ae) || (1 < 0 && lv_itAbilityModChange >= autoDE132AE1_ae) ) ; lv_itAbilityModChange += 1 ) {
            lv_currentTalentModNumber += 1;
            if ((lv_currentTalentModNumber > libGame_gv_talents_DebugMaxModifedAbilites)) {
                libGame_gv_talents_DebugMaxModifedAbilites = lv_currentTalentModNumber;
            }

            lv_changeTypeInt = CatalogFieldValueGetAsInt(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Type", c_playerAny);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_changeType = lv_changeTypeInt;
            lv_catalogInt = CatalogFieldValueGetAsInt(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Catalog", c_playerAny);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_catalog = lv_catalogInt;
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_field = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Field", c_playerAny);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_fieldIsInteger = (CatalogFieldValueGetAsInt(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].FieldIsInteger", c_playerAny) == 1);
            libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_value = CatalogFieldValueGetAsFixed(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Value", c_playerAny);
            if ((libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_changeType == c_talentModificationCatalogReplacement)) {
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_catalogReplaceFrom = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Entry", c_playerAny);
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_catalogChangeTo = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].StringReplacement", c_playerAny);
            }
            else {
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_entry = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].Entry", c_playerAny);
                libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_abilityModificationData[lv_currentTalentModNumber].lv_stringReplacementValue = CatalogFieldValueGet(c_gameCatalogTalent, talent, "AbilityModificationArray[" + IntToString((lv_itAbilityMod - 1)) + "].Modifications[" + IntToString((lv_itAbilityModChange - 1)) + "].StringReplacement", c_playerAny);
            }
        }
    }
    if ((lv_numberOfAbilitiesModified > 0)) {
        libGame_gv_talents_TalentChoices[lp_player][0].lv_talentData[0].lv_totalModifications = lv_currentTalentModNumber;
    }
}

void libHRGE_AddTalent(int player, string talent) {
    int behavior = 1;
    unit heroUnit = libGame_gv_players[player].lv_heroUnit;
    int behaviorCount;
    int statEvent;

    if (talent == "") { return; }

    libHRGE_DummyTalentChoicesFromTalentName(player, talent);
    behaviorCount = libGame_gv_talents_TalentChoices[player][0].lv_talentData[0].lv_behaviorCount;

    for (; behavior <= behaviorCount; behavior += 1 ) {
        UnitBehaviorAdd(heroUnit, libGame_gv_talents_TalentChoices[player][0].lv_talentData[0].lv_behaviors[behavior], heroUnit, 1);
    }
    libGame_gf_SendEventHeroGainTalent((libGame_gv_talents_TalentChoices[player][0].lv_talentData[0].lv_talentCatalogLink), player);
    libGame_gf_ApplyAbilityModificationsForPlayerAtTalent(player, 0, 0);

    statEvent = StatEventCreate("TalentChosen");
    StatEventAddDataInt(statEvent, "PlayerID", player);
    StatEventAddDataString(statEvent, "PurchaseName", (libGame_gv_talents_TalentChoices[player][0].lv_talentData[0].lv_talentCatalogLink));
    StatEventSend(statEvent);
    PlayerAddTalent(player, libGame_gv_talents_TalentChoices[player][0].lv_talentData[0].lv_talentCatalogLink);
    libGame_gf_TalentsUpdateChoicePanelForPlayer(player);
    libUIUI_gf_UIPartyFrameHeroicTalentUpdate(player, 0);
    ActorSend(libNtve_gf_MainActorofUnit(libGame_gv_players[player].lv_heroUnit), (("Signal " + (libGame_gv_talents_TalentChoices[player][0].lv_talentData[0].lv_talentCatalogLink))));
}

void libHRGE_ShowTalent(string talent, bool show) {
    if (talent == "") { return; }
    SetTalentEnabled(talent, show);
    SetTalentHidden(talent, !show);
}
void libHRGE_DisableTalent(string talent, bool disable) {
    if (talent == "") { return; }
    SetTalentEnabled(talent, !disable);
}

void libHRGE_CatalogSetForAllPlayers(int type, string entry, string path, string value) {
    int i;
    for (i = 1; i <= libCore_gv_bALMaxEnginePlayerCount; i += 1) {
        CatalogFieldValueSet(type, entry, path, i, value);
    }
}
void libHRGE_CatalogSetFixedForAllPlayers(int type, string entry, string path, fixed value) {
    int i;
    for (i = 1; i <= libCore_gv_bALMaxEnginePlayerCount; i += 1) {
        CatalogFieldValueSetFixed(type, entry, path, i, value);
    }
}
void libHRGE_CatalogModifyForAllPlayers(string reference, string value) {
    int i;
    for (i = 1; i <= libCore_gv_bALMaxEnginePlayerCount; i += 1) {
        CatalogReferenceModify(reference, i, value, c_upgradeOperationSet);
    }
}

void libHRGE_SendAffixAddedEvent (int affix, int amount) {
    string instance = libHRGE_GetAffixInstance(affix);
    DataTableSetInt(false, TriggerEventParamName(libHRGE_eventAffixAddedID + instance, libHRGE_eventAffixAddedParam), affix);
    DataTableSetInt(false, TriggerEventParamName(libHRGE_eventAffixAddedID + instance, libHRGE_eventAffixAddedParam2), amount);
    DataTableSetString(false, TriggerEventParamName(libHRGE_eventAffixAddedID + instance, libHRGE_eventAffixAddedParam3), instance);
    TriggerSendEvent(libHRGE_eventAffixAddedID + instance);
    TriggerSendEvent(libHRGE_eventAffixAddedID);
}
int libHRGE_EventAffix() {
    return DataTableGetInt(false, TriggerEventParamName(EventGenericName(), libHRGE_eventAffixAddedParam));
}
int libHRGE_EventAffixCountAdded() {
    return DataTableGetInt(false, TriggerEventParamName(EventGenericName(), libHRGE_eventAffixAddedParam2));
}
string libHRGE_EventAffixInstance() {
    return DataTableGetString(false, TriggerEventParamName(EventGenericName(), libHRGE_eventAffixAddedParam3));
}
int libHRGE_EventAffixCount() {
    return libHRGE_GetAffixCount(libHRGE_EventAffixInstance());
}

void libHRGE_SendPausedEvent (bool paused) {
    DataTableSetBool(false, TriggerEventParamName(libHRGE_eventPausedID, libHRGE_eventPausedParam), paused);
    TriggerSendEvent(libHRGE_eventPausedID);
}
bool libHRGE_IsGamePaused() {
    return DataTableGetBool(false, TriggerEventParamName(EventGenericName(), libHRGE_eventPausedParam));
}

void libHRGE_CopyFilter(structref<libHRGE_Filter> original, structref<libHRGE_Filter> copyTo) {
    int i;
    copyTo.unitFilter = original.unitFilter;
    copyTo.requiredPlayer = original.requiredPlayer;
    for (i = 1; i <= original.requiredUnitTypeIndex; i += 1) {
        libHRGE_AddRequiredUnitTypeFilter(copyTo, original.requiredUnitTypes[i]);
    }
    for (i = 1; i <= original.excludedUnitTypeIndex; i += 1) {
        libHRGE_AddExcludedUnitTypeFilter(copyTo, original.excludedUnitTypes[i]);
    }
}
void libHRGE_AddRequiredUnitTypeFilter(structref<libHRGE_Filter> filter, string unitType) {
    if (filter.requiredUnitTypeIndex >= libHRGE_maxFilters) {
        libHRGE_DisplayDebugMessage("Warning: A filter reached maximum limit!");
        return;
    }
    if (unitType == "") { return; }
    filter.requiredUnitTypeIndex += 1;
    filter.requiredUnitTypes[filter.requiredUnitTypeIndex] = unitType;
}
void libHRGE_AddExcludedUnitTypeFilter(structref<libHRGE_Filter> filter, string unitType) {
    if (filter.excludedUnitTypeIndex >= libHRGE_maxFilters) {
        libHRGE_DisplayDebugMessage("Warning: A filter reached maximum limit!");
        return;
    }
    if (unitType == "") { return; }
    filter.excludedUnitTypeIndex += 1;
    filter.excludedUnitTypes[filter.excludedUnitTypeIndex] = unitType;
}
bool libHRGE_UnitIsMinion(unit unitVar) {
    string unitType = UnitGetType(unitVar);
    if (unitType == "FootmanMinion" || unitType == "RangedMinion" || (UnitBehaviorCount(unitVar, "IsCatapultMinionOrCatapultReplacement") > 0) || unitType == "WizardMinion") {
        return true;
    }
    return false;
}
bool libHRGE_CampIsBoss(int unitType) {
    if (unitType == libMapM_ge_JungleCampDefenderTypes_GraveGolem || unitType == libMapM_ge_JungleCampDefenderTypes_BossCamp1 ||
        unitType == libMapM_ge_JungleCampDefenderTypes_BossCamp2 || unitType == libMapM_ge_JungleCampDefenderTypes_BossCamp3) {
        return true;
    }
    return false;
}
bool libHRGE_UnitMatchesType(unit unitVar, structref<libHRGE_Filter> filter) {
    int i;
    if (filter.requiredUnitTypeIndex <= 0) { return true; }
    for (i = 1; i <= filter.requiredUnitTypeIndex; i += 1) {
        if (filter.requiredUnitTypes[i] != null && filter.requiredUnitTypes[i] != "" && UnitGetType(unitVar) == filter.requiredUnitTypes[i]) {
            return true;
        }
    }
    return false;
}
bool libHRGE_UnitMatchesFilter(unit unitVar, structref<libHRGE_Filter> filter) {
    int i;
    if (UnitGetType(unitVar) == "KingsCore" && libCore_gv_mAPMapStringID == "TowersOfDoom") {
        return false;
    }
    if (filter.unitFilter != null && !UnitFilterMatch(unitVar, libHRGE_player, filter.unitFilter)) {
        return false;
    }
    if (filter.requiredPlayer != 0 && filter.requiredPlayer != c_playerAny && UnitGetOwner(unitVar) != filter.requiredPlayer) {
        return false;
    }
    if (!libHRGE_UnitMatchesType(unitVar, filter)) {
        return false;
    }
    for (i = 1; i <= filter.excludedUnitTypeIndex; i += 1) {
        if (filter.excludedUnitTypes[i] != null && filter.excludedUnitTypes[i] != "" && UnitGetType(unitVar) == filter.excludedUnitTypes[i]) {
            return false;
        }
    }
    return true;
}
void libHRGE_AddUnitBehaviorFilter(unit unitVar, string behavior, int stacks, structref<libHRGE_Filter> filter) {
    if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
        libHRGE_AddUnitBehavior(unitVar, behavior, unitVar, stacks, true);
    }
}
void libHRGE_UpdateUnitBehaviorFilter(unit unitVar, string behavior, int stacks, structref<libHRGE_Filter> filter) {
    if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
        libHRGE_AddUnitBehavior(unitVar, behavior, unitVar, stacks, true);
    } else {
        UnitBehaviorRemove(unitVar, behavior, stacks);
    }
}
void libHRGE_SetUnitPropertyFilter(unit unitVar, int inProp, fixed value, structref<libHRGE_Filter> filter) {
    if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
        UnitSetPropertyFixed(unitVar, inProp, value);
    }
}
void libHRGE_UnitCreateEffectUnitToAllFilter (unit caster, string effect, structref<libHRGE_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
            UnitCreateEffectUnit(caster, effect, unitVar);
        }
    }
}
void libHRGE_UnitSetPropertyFixedToAllFilter (int inProp, fixed value, structref<libHRGE_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
            UnitSetPropertyFixed(unitVar, inProp, value);
        }
    }
}
void libHRGE_AddUnitBehaviorToAllFilter (string behavior, int stacks, structref<libHRGE_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
            libHRGE_AddUnitBehavior(unitVar, behavior, unitVar, stacks, true);
        }
    }
}
void libHRGE_RemoveUnitBehaviorFromAllFilter (string behavior, int stacks, structref<libHRGE_Filter> filter) {
    unit unitVar;
    unitgroup unitGroup = UnitGroup(null, c_playerAny, RegionEntireMap(), filter.unitFilter, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (libHRGE_UnitMatchesFilter(unitVar, filter)) {
            UnitBehaviorRemove(unitVar, behavior, stacks);
        }
    }
}
void libHRGE_SendActorMessageToPlayer(int player, string actorMessage) {
    unit unitVar;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    for (;; i -= 1) {
        if (i <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitVar == null) { continue; }
        if (UnitGetType(unitVar) != "HeroLostVikingsController") {
            libNtve_gf_SendActorMessageToUnit(unitVar, actorMessage);
        }
    }
}

void libHRGE_SetPlayerPropertyFixed (int player, int inProp, fixed value, bool applyToAllUnits) {
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    unit heroUnit;
    if (applyToAllUnits) {
        for (;; unitGroupCount -= 1) {
            if (unitGroupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
            if (UnitGetType(heroUnit) != "HeroLostVikingsController") {
                UnitSetPropertyFixed(heroUnit, inProp, value);
            }
        }
    } else {
        heroUnit = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
        if (UnitGetType(heroUnit) == "HeroLostVikingsController") {
            UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), inProp, value);
        } else {
            UnitSetPropertyFixed(heroUnit, inProp, value);
        }
    }
}
void libHRGE_AddUnitPropertyFixed (unit unitVar, int inProp, fixed value) {
    UnitSetPropertyFixed(unitVar, inProp, UnitGetPropertyFixed(unitVar, inProp, true) + value);
}
void libHRGE_AddPlayerPropertyFixed (int player, int inProp, fixed value, bool applyToAllUnits) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    if (applyToAllUnits) {
        for (i = unitGroupCount; i > 0; i -= 1) {
            if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) != "HeroLostVikingsController") {
                UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, i), inProp, UnitGetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, i), inProp, true) + value);
            }
        }
    } else {
        if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, unitGroupCount)) == "HeroLostVikingsController") {
            UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), inProp, UnitGetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), inProp, true) + value);
        } else {
            UnitSetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), inProp, UnitGetPropertyFixed(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), inProp, true) + value);
        }
    }
}
bool libHRGE_PlayerHasAffixBehavior(int player, string behavior) {
    int i;
    for (i = 1; i <= libHRGE_syncBehaviorIndex[player]; i += 1) {
        if (libHRGE_syncBehaviors[player][i] == behavior) {
            return true;
        }
    }
    return false;
}
void libHRGE_AddSyncBehavior(int player, string behavior) {
    if (player < 1 || player > 10 || behavior == "" || behavior == null || (libHRGE_syncBehaviorIndex[player] + 1) > libHRGE_maxSyncBehaviors) {
        return;
    }
    if (UnitBehaviorHasCategoryFlag(behavior, c_behaviorCategoryTemporary) || libHRGE_PlayerHasAffixBehavior(player, behavior)) {
        return;
    }

    libHRGE_syncBehaviorIndex[player] += 1;
    libHRGE_syncBehaviors[player][libHRGE_syncBehaviorIndex[player]] = behavior;
}
void libHRGE_AddUnitBehavior(unit targetUnit, string behavior, unit casterUnit, int stacks, bool sync) {
    int player = UnitGetOwner(targetUnit);
    string hero = libHRGE_GetPlayerHero(player);
    UnitBehaviorAdd(targetUnit, behavior, casterUnit, stacks);
    // Sometimes Attack Speed does not increase properly for certain Heroes, fixed by reducing Attack Speed for a game tick
    if (!UnitHasBehavior2(targetUnit, "AttackSpeedFix") && (hero == "Tassadar" || hero == "Zarya")) {
        UnitBehaviorAdd(targetUnit, "AttackSpeedFix", targetUnit, 1);
    }
    if (player >= 1 && player <= 10 && behavior != "" && behavior != null && sync) {
        if (libHRGE_syncBehaviorIndex[player] <= libHRGE_maxSyncBehaviors) {
            if (!UnitTestState(targetUnit, c_unitStateHallucination) && UnitTypeTestAttribute(UnitGetType(targetUnit), c_unitAttributeHeroic)) {
                libHRGE_AddSyncBehavior(player, behavior);
            }
        } else {
            libHRGE_DisplayDebugMessage("Warning: Too many affix behaviors added!");
        }
    }
}
void libHRGE_AddPlayerBehaviorWithExclusionAndSync (int player, string behavior, int stacks, bool applyToAllUnits, string excludeUnit, bool sync) {
    int i;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    unit heroUnit;
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    int team = libGame_gf_TeamNumberOfPlayer(player);
    if (applyToAllUnits || (hero == "DVa" && excludeUnit != "HeroDVaMech")) {
        for (i = unitGroupCount; i > 0; i -= 1) {
            heroUnit = UnitGroupUnitFromEnd(unitGroup, i);
            if (UnitGetType(heroUnit) != "HeroLostVikingsController" && UnitGetType(heroUnit) != excludeUnit) {
                if (player == libGDHL_gv_chogallPairs[team].lv_choPlayer || player == libGDHL_gv_chogallPairs[team].lv_gallPlayer) {
                    libHRGE_AddUnitBehavior(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_gallPlayer].lv_heroUnit, behavior, libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_gallPlayer].lv_heroUnit, stacks, true);
                    libHRGE_AddUnitBehavior(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_choPlayer].lv_heroUnit, behavior, libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_choPlayer].lv_heroUnit, stacks, true);
                    break;
                } else {
                    libHRGE_AddUnitBehavior(heroUnit, behavior, heroUnit, stacks, true);
                }
            }
        }
    } else {
        heroUnit = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
        if (UnitGetType(heroUnit) == excludeUnit) {
        } else if (UnitGetType(heroUnit) == "HeroLostVikingsController") {
            libHRGE_AddUnitBehavior(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), behavior, UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), stacks, true);
        } else {
            if (player == libGDHL_gv_chogallPairs[team].lv_choPlayer || player == libGDHL_gv_chogallPairs[team].lv_gallPlayer) {
                libHRGE_AddUnitBehavior(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_gallPlayer].lv_heroUnit, behavior, libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_gallPlayer].lv_heroUnit, stacks, true);
                libHRGE_AddUnitBehavior(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_choPlayer].lv_heroUnit, behavior, libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_choPlayer].lv_heroUnit, stacks, true);
            } else {
                libHRGE_AddUnitBehavior(heroUnit, behavior, heroUnit, stacks, true);
            }
        }
    }
}
void libHRGE_AddPlayerBehaviorWithExclusion (int player, string behavior, int stacks, bool applyToAllUnits, string excludeUnit) {
    libHRGE_AddPlayerBehaviorWithExclusionAndSync(player, behavior, stacks, applyToAllUnits, excludeUnit, true);
}
void libHRGE_AddPlayerBehaviorSync (int player, string behavior, int stacks, bool applyToAllUnits, bool sync) {
    libHRGE_AddPlayerBehaviorWithExclusionAndSync(player, behavior, stacks, applyToAllUnits, null, sync);
}
void libHRGE_AddPlayerBehavior (int player, string behavior, int stacks, bool applyToAllUnits) {
    libHRGE_AddPlayerBehaviorWithExclusion(player, behavior, stacks, applyToAllUnits, null);
}
void libHRGE_RemovePlayerBehavior (int player, string behavior, int stacks, bool applyToAllUnits) {
    int i;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    int team = libGame_gf_TeamNumberOfPlayer(player);
    if (applyToAllUnits) {
        for (i = unitGroupCount; i > 0; i -= 1) {
            if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) != "HeroLostVikingsController" && UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, i), behavior)) {
                if (player == libGDHL_gv_chogallPairs[team].lv_choPlayer || player == libGDHL_gv_chogallPairs[team].lv_gallPlayer) {
                    UnitBehaviorRemove(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_gallPlayer].lv_heroUnit, behavior, stacks);
                    UnitBehaviorRemove(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_choPlayer].lv_heroUnit, behavior, stacks);
                    break;
                } else {
                    UnitBehaviorRemove(UnitGroupUnitFromEnd(unitGroup, i), behavior, stacks);
                }
            }
        }
    } else {
        if (UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), behavior)) {
            if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, unitGroupCount)) == "HeroLostVikingsController") {
                UnitBehaviorRemove(UnitGroupUnitFromEnd(unitGroup, unitGroupCount - 1), behavior, stacks);
            } else {
                if (player == libGDHL_gv_chogallPairs[team].lv_choPlayer || player == libGDHL_gv_chogallPairs[team].lv_gallPlayer) {
                    UnitBehaviorRemove(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_gallPlayer].lv_heroUnit, behavior, stacks);
                    UnitBehaviorRemove(libGame_gv_players[libGDHL_gv_chogallPairs[team].lv_choPlayer].lv_heroUnit, behavior, stacks);
                } else {
                    UnitBehaviorRemove(UnitGroupUnitFromEnd(unitGroup, unitGroupCount), behavior, stacks);
                }
            }
        }
    }
}

void libHRGE_ModifyPlayerTokenCount (int player, int tokens, string quest) {
    int i;
    unitgroup unitGroup;
    int unitGroupCount;
    unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        libGame_gf_ModifyTokenCount(tokens, quest, UnitGroupUnitFromEnd(unitGroup, i));
    }
}

void libHRGE_AddUnitTokenCount(unit unitToAdd, string tokenBehavior, fixed value) {
    UnitSetTokenCount(unitToAdd, tokenBehavior, UnitGetTokenCount(unitToAdd, tokenBehavior) + value, unitToAdd);
}

bool libHRGE_PlayerHasBehavior (int player, string behavior) {
    int i;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        if (UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, i), behavior)) {
            return true;
        }
    }
    return false;
}

int libHRGE_PlayerBehaviorCount (int player, string behavior) {
    int i;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        if (UnitHasBehavior2(UnitGroupUnitFromEnd(unitGroup, i), behavior)) {
            return UnitBehaviorCount(UnitGroupUnitFromEnd(unitGroup, i), behavior);
        }
    }
    return 0;
}

void libHRGE_UnitCreateEffectUnit (int player, string effect) {
    int i;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    if (unitGroupCount == 1) {
        UnitCreateEffectUnit(libGame_gv_players[player].lv_heroUnit, effect, libGame_gv_players[player].lv_heroUnit);
    } else {
        for (i = unitGroupCount; i > 0; i -= 1) {
            UnitCreateEffectUnit(UnitGroupUnitFromEnd(unitGroup, i), effect, UnitGroupUnitFromEnd(unitGroup, i));
        }
    }
}

unit libHRGE_GetPlayerHeroUnit (int player) {
    unitgroup heroGroup;
    unit heroUnit;
    int unitGroupCount;
    if (libGame_gv_players[player].lv_heroIndex == libCore_gf_GetIndexFromHero("LostVikings")) {
        heroGroup = libGame_gv_players[player].lv_heroUnitGroup;
        unitGroupCount = UnitGroupCount(heroGroup, c_unitCountAll);
        for (;; unitGroupCount -= 1) {
            if (unitGroupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(heroGroup, unitGroupCount);
            if (UnitGetType(heroUnit) == "HeroOlaf") {
                return heroUnit;
            }
        }
        return null;
    } else {
        return libGame_gv_players[player].lv_heroUnit;
    }
}
unit libHRGE_GetPlayerUnitWithBehavior(int player, string behavior) {
    unitgroup heroGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unit heroUnit;
    int unitGroupCount = UnitGroupCount(heroGroup, c_unitCountAll);
    for (;; unitGroupCount -= 1) {
        if (unitGroupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(heroGroup, unitGroupCount);
        if (UnitHasBehavior2(heroUnit, behavior)) {
            return heroUnit;
        }
    }
    return null;
}
string libHRGE_GetPlayerHero (int player) {
    if (player >= 1 && player <= 10) {
        return libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    }
    return "";
}

bool libHRGE_PlayerIsHumanOrChoGallPair(int player) {
    if (player == libHRGE_player || (libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_choPlayer == player &&
            libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_gallPlayer == libHRGE_player) ||
        (libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_gallPlayer == player &&
            libGDHL_gv_chogallPairs[libHRGE_teamOrderIndex].lv_choPlayer == libHRGE_player)) {
        return true;
    }
    return false;
}
bool libHRGE_PlayerIsChoGallPair(int player) {
    int team = libGame_gf_TeamNumberOfPlayer(player);
    if ((libGDHL_gv_chogallPairs[team].lv_choPlayer == player) ||
        (libGDHL_gv_chogallPairs[team].lv_gallPlayer == player)) {
        return true;
    }
    return false;
}

void libHRGE_SetLevelScalingAndValue(string reference, int player, fixed scaling, fixed value) {
    int level = UnitLevel(libGame_gv_players[player].lv_heroUnit);
    if (player == 0) { return; }
    if (level <= 0) { level = 1; }
    CatalogReferenceModify(reference, player, FixedToString(value * Pow(1 + scaling, level), 4), c_upgradeOperationSet);
}

void libHRGE_SetLevelScaling(string reference, int player, fixed scaling) {
    libHRGE_SetLevelScalingAndValue(reference, player, scaling, StringToFixed(CatalogReferenceGet(reference, 0)));
}
void libHRGE_SetDefaultLevelScaling(string reference, int player) {
    libHRGE_SetLevelScaling(reference, player, 0.04);
}
string libHRGE_GetCatalogDefaultValue(string reference) {
    return CatalogReferenceGet(reference, 0);
}
fixed libHRGE_CatalogReferenceGetAsFixed(string reference, int player) {
    return StringToFixed(CatalogReferenceGet(reference, player));
}

void libHRGE_CatalogFieldValueSetFixed(int catalog, string entry, string fieldPath, int player, fixed value) {
    int team = libGame_gf_TeamNumberOfPlayer(player);
    if (player != 0 && (player == libGDHL_gv_chogallPairs[team].lv_choPlayer || player == libGDHL_gv_chogallPairs[team].lv_gallPlayer)) {
        CatalogFieldValueSetFixed(catalog, entry, fieldPath, libGDHL_gv_chogallPairs[team].lv_gallPlayer, value);
        CatalogFieldValueSetFixed(catalog, entry, fieldPath, libGDHL_gv_chogallPairs[team].lv_choPlayer, value);
    } else {
        CatalogFieldValueSetFixed(catalog, entry, fieldPath, player, value);
    }
}
void libHRGE_CatalogReferenceModify (string reference, int player, string value, int operation) {
    int team = libGame_gf_TeamNumberOfPlayer(player);
    if (player != 0 && (player == libGDHL_gv_chogallPairs[team].lv_choPlayer || player == libGDHL_gv_chogallPairs[team].lv_gallPlayer)) {
        CatalogReferenceModify(reference, libGDHL_gv_chogallPairs[team].lv_choPlayer, value, operation);
        CatalogReferenceModify(reference, libGDHL_gv_chogallPairs[team].lv_gallPlayer, value, operation);
    } else {
        CatalogReferenceModify(reference, player, value, operation);
    }
}
void libHRGE_CatalogReferenceSet (string reference, int player, string value) {
    libHRGE_CatalogReferenceModify(reference, player, value, c_upgradeOperationSet);
}


// ============================================================
// Affix effects
// ============================================================

void libHRGE_ApplyAffix(int affix, int amount) {
    string instance = libHRGE_GetAffixInstance(affix);
    if (libHRGE_GetAffixCount(instance) <= 0 || amount <= 0) {
        return;
    }

    libHRGE_ResolveTalents(affix);
    libHRGE_ResolveCatalogModifications(affix, amount);
    libHRGE_ResolveBehaviors(affix, amount);
    libHRGE_ResolveTriggers(affix);
    libHRGE_ResolveQuestTokens(affix);

    libHRGE_SetAffixApplied(instance, true);
}
void libHRGE_AddAffix(int affix, int count) {
    string instance = libHRGE_GetAffixInstance(affix);
    if (instance == "" || instance == null) { return; }
    libHRGE_AddAffixCount(instance, count);
    libHRGE_skipCurseCounter += libHRGE_GetAffixCurseSkips(instance);
    libHRGE_ApplyAffix(affix, count);
}
void libHRGE_SetAffix(int affix, int count) {
    string instance = libHRGE_GetAffixInstance(affix);
    if (instance == "" || instance == null) { return; }
    libHRGE_SetAffixCount(instance, count);
    libHRGE_skipCurseCounter += libHRGE_GetAffixCurseSkips(instance);
    libHRGE_ApplyAffix(affix, count);
}
void libHRGE_RemoveAffix(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    if (instance == "" || instance == null) { return; }
    libHRGE_SetAffixCount(instance, 0);
}

// ============================================================
// Bank
// ============================================================

int libHRGE_BankGetStats(string key) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    if (BankKeyExists(bankRogue, libHRGE_bankSectionStats, key)) {
        return BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, key);
    } else {
        return 0;
    }
}

string libHRGE_BankLoadValueString(string key) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    return BankValueGetAsString(bankRogue, libHRGE_bankSection, key);
}
int libHRGE_BankLoadValueInt(string key) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    return BankValueGetAsInt(bankRogue, libHRGE_bankSection, key);
}
fixed libHRGE_BankLoadValueFixed(string key) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    return BankValueGetAsFixed(bankRogue, libHRGE_bankSection, key);
}
void libHRGE_BankSaveValueString(string key, string value) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    BankValueSetFromString(bankRogue, libHRGE_bankSection, key, value);
    BankSave(bankRogue);
}
void libHRGE_BankSaveValueInt(string key, int value) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, key, value);
    BankSave(bankRogue);
}
void libHRGE_BankSaveValueFixed(string key, fixed value) {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    BankValueSetFromFixed(bankRogue, libHRGE_bankSection, key, value);
    BankSave(bankRogue);
}

void libHRGE_SaveBankSettings() {
    bank bankSettings = BankLoad(libHRGE_bankSettings, libHRGE_player);
    if (libHRGE_difficulty != 0) {
        BankValueSetFromInt(bankSettings, libHRGE_bankSectionSettings, "Difficulty", libHRGE_difficulty);
    }
    BankValueSetFromInt(bankSettings, libHRGE_bankSectionSettings, "SpeedUp", BoolToInt(libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpGates, libHRGE_player)));
    BankValueSetFromInt(bankSettings, libHRGE_bankSectionSettings, "SpeedUpDeath", BoolToInt(libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsSpeedUpDeath, libHRGE_player)));
    BankValueSetFromInt(bankSettings, libHRGE_bankSectionSettings, "DisplayPicksBans", BoolToInt(libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsDisplayPicksBans, libHRGE_player)));
    BankValueSetFromInt(bankSettings, libHRGE_bankSectionSettings, "AlwaysShowExtendedTooltips", BoolToInt(libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, libHRGE_player)));
    BankSave(bankSettings);
}
void libHRGE_LoadBankSettings() {
    bank bankSettings = BankLoad(libHRGE_bankSettings, libHRGE_player);

    if (BankKeyExists(bankSettings, libHRGE_bankSectionSettings, "Difficulty")) {
        libHRGE_difficulty = BankValueGetAsInt(bankSettings, libHRGE_bankSectionSettings, "Difficulty");
    }
    if (BankKeyExists(bankSettings, libHRGE_bankSectionSettings, "SpeedUp")) {
        if (BankValueGetAsInt(bankSettings, libHRGE_bankSectionSettings, "SpeedUp") == 1) {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsSpeedUpGates, true);
        } else {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsSpeedUpGates, false);
        }
    }
    if (BankKeyExists(bankSettings, libHRGE_bankSectionSettings, "SpeedUpDeath")) {
        if (BankValueGetAsInt(bankSettings, libHRGE_bankSectionSettings, "SpeedUpDeath") == 1) {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsSpeedUpDeath, true);
        } else {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsSpeedUpDeath, false);
        }
    }
    if (BankKeyExists(bankSettings, libHRGE_bankSectionSettings, "DisplayPicksBans")) {
        if (BankValueGetAsInt(bankSettings, libHRGE_bankSectionSettings, "DisplayPicksBans") == 1) {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsDisplayPicksBans, true);
        } else {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsDisplayPicksBans, false);
        }
    }
    if (BankKeyExists(bankSettings, libHRGE_bankSectionSettings, "AlwaysShowExtendedTooltips")) {
        if (BankValueGetAsInt(bankSettings, libHRGE_bankSectionSettings, "AlwaysShowExtendedTooltips") == 1) {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, true);
        } else {
            libHRGE_SetDialogControlChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, false);
        }
        libHRGE_pressingALT = libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, libHRGE_player);
        if (libHRGE_IsOwnedAffixesDialogVisible()) {
            libHRGE_UpdateOwnedAffixesDialog();
        }
        if (libHRGE_IsAffixSelectionDialogVisible()) {
            libHRGE_UpdateAffixSelectionDialog();
        }
    }
    libPBU2_SetDifficulty(libHRGE_difficulty);
    libHRGE_DisplayDebugMessage("Loaded player settings!");
}

void libHRGE_SaveBankAchievements() {
    int i;
    bank bankAchievements = BankLoad(libHRGE_bankAchievements, libHRGE_player);
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        if (libHRGE_achievements[i].earned) {
            BankValueSetFromInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarned_" + libHRGE_achievements[i].name, libHRGE_achievements[i].difficulty);
            BankValueSetFromInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarnedRound_" + libHRGE_achievements[i].name, libHRGE_achievements[i].round);
            BankValueSetFromInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarnedTime_" + libHRGE_achievements[i].name, libHRGE_achievements[i].time);
        }
    }
    BankSave(bankAchievements);
}
void libHRGE_LoadBankAchievements() {
    bank bankAchievements = BankLoad(libHRGE_bankAchievements, libHRGE_player);
    int i;
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        if (BankKeyExists(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarned_" + libHRGE_achievements[i].name)) {
            libHRGE_achievements[i].earned = libHRGE_IntToBoolean(BankValueGetAsInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarned_" + libHRGE_achievements[i].name));
            libHRGE_achievements[i].difficulty = BankValueGetAsInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarned_" + libHRGE_achievements[i].name);
        }
        if (BankKeyExists(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarnedRound_" + libHRGE_achievements[i].name)) {
            libHRGE_achievements[i].round = BankValueGetAsInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarnedRound_" + libHRGE_achievements[i].name);
        }
        if (BankKeyExists(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarnedTime_" + libHRGE_achievements[i].name)) {
            libHRGE_achievements[i].time = BankValueGetAsInt(bankAchievements, libHRGE_bankSectionAchievements, "AchievementEarnedTime_" + libHRGE_achievements[i].name);
        }
    }
}

void libHRGE_SaveBank() {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    string affixName;
    int i;
    int j;
    int i2;
    unitgroup heroGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    unit heroUnit;
    int groupCount;
    string instance;
    string fieldInstance;
    int fieldCount;

    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "Takedowns", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "Takedowns") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_takedowns));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "Kills", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "Kills") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_kills));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "Assists", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "Assists") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_assists));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "RegenGlobes", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "RegenGlobes") + libGame_gv_scoreValues[libHRGE_player].lv_regenGlobes);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "SpellDamage", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "SpellDamage") + libGame_gv_scoreValues[libHRGE_player].lv_spellDamage);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "PhysicalDamage", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "PhysicalDamage") + libGame_gv_scoreValues[libHRGE_player].lv_physicalDamage);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "HeroDamage", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "HeroDamage") + FixedToInt(PlayerScoreValueGetAsFixed(libHRGE_player, "HeroDamage")));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "SiegeDamage", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "SiegeDamage") + FixedToInt(PlayerScoreValueGetAsFixed(libHRGE_player, "SiegeDamage")));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "MinionKills", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "MinionKills") + libGame_gv_scoreValues[libHRGE_player].lv_minionKills);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "Experience", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "Experience") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_individualXPEarned));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "Healing", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "Healing") + FixedToInt(PlayerScoreValueGetAsFixed(libHRGE_player, "Healing")));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "Deaths", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "Deaths") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_deaths));
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "DamageTaken", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "DamageTaken") + libGame_gv_scoreValues[libHRGE_player].lv_damageTaken);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "MercCaptures", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "MercCaptures") + libGame_gv_scoreValues[libHRGE_player].lv_creepCampsCaptured);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "ObjectivesWon", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "ObjectivesWon") + libHRGE_objectivesWonThisGame);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "ObjectivesLost", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "ObjectivesLost") + libHRGE_objectivesLostThisGame);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "RerollsUsed", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "RerollsUsed") + libHRGE_rerollsUsed);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "RerollsCurseUsed", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "RerollsCurseUsed") + libHRGE_rerollsCurseUsed);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "BansUsed", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "BansUsed") + libHRGE_bansUsed);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "CursesSkipped", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "CursesSkipped") + libHRGE_cursesSkipped);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "CursesSwapped", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "CursesSwapped") + libHRGE_cursesSwapped);
    BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "GameTime", BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "GameTime") + FixedToInt(TimerGetElapsed(libGame_gv_gameTimer)));
    for (i = 1; i <= libHRGE_maxHeroes; i += 1) {
        BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "HeroCounterOrder_" + libCore_gf_GetHeroFromIndex(i), BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "HeroCounterOrder_" + libCore_gf_GetHeroFromIndex(i)) + libHRGE_heroCounter[libHRGE_teamOrderIndex][i]);
    }
    for (i = 1; i <= libHRGE_maxHeroes; i += 1) {
        BankValueSetFromInt(bankRogue, libHRGE_bankSectionStats, "HeroCounterChaos_" + libCore_gf_GetHeroFromIndex(i), BankValueGetAsInt(bankRogue, libHRGE_bankSectionStats, "HeroCounterChaos_" + libCore_gf_GetHeroFromIndex(i)) + libHRGE_heroCounter[libHRGE_teamChaosIndex][i]);
    }
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "Map", libHRGE_map);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "CurrentRun", libHRGE_currentRun);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "Hero", libGame_gv_players[libHRGE_player].lv_heroIndex);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "ObjectiveCounter", libHRGE_objectivesWonCounter);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "SkipCurseCounter", libHRGE_skipCurseCounter);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "Rerolls", libHRGE_rerolls);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "RerollsCurse", libHRGE_rerollsCurse);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "Bans", libHRGE_bans);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "CursesNextGame", libHRGE_cursesNextGame);
    BankValueSetFromInt(bankRogue, libHRGE_bankSection, "BoonsNextGame", libHRGE_boonsNextGame);

    for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
        instance = libHRGE_GetAffixInstance(i);
        fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserQuestRetainCount, 1);
        if (libHRGE_GetAffixCount(instance) > 0) {
            for (j = 1; j <= fieldCount; j += 1) {
                fieldInstance = UserDataGetString(libHRGE_affixUserData, instance, libHRGE_affixUserQuestRetain, j);
                if (fieldInstance == "" || fieldInstance == null) { continue; }
                groupCount = UnitGroupCount(heroGroup, c_unitCountAll);
                for (;; groupCount -= 1) {
                    if (groupCount <= 0) { break; }
                    heroUnit = UnitGroupUnitFromEnd(heroGroup, groupCount);
                    libHRGE_SetAffixQuestToken(instance, j, UnitGetTokenCount(heroUnit, StringWord(fieldInstance, 1)) * StringToFixed(StringWord(fieldInstance, 2)));
                    break;
                }
            }
        }
        if (libHRGE_AffixIsQuest(instance) && !libHRGE_AffixQuestPersists(instance) && libHRGE_GetAffixQuestProgress(instance) > 0) {
            libHRGE_SetAffixQuestProgress(instance, 0);
        }
    }
    UserDataSaveType(libHRGE_affixUserData, bankRogue, libHRGE_bankSection);
    BankSave(bankRogue);
}
void libHRGE_LoadBank() {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    string affixName;
    int i;
    int i2;

    if (BankKeyExists(bankRogue, libHRGE_bankSection, "Map")) {
        libHRGE_map = BankValueGetAsInt(bankRogue, libHRGE_bankSection, "Map");
    } else {
        libHRGE_map = libHRGE_startingMap;
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "CurrentRun")) {
        libHRGE_currentRun = BankValueGetAsInt(bankRogue, libHRGE_bankSection, "CurrentRun");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "Hero")) {
        libHRGE_playerSelectedHero = BankValueGetAsInt(bankRogue, libHRGE_bankSection, "Hero");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "ObjectiveCounter")) {
        libHRGE_objectivesWonCounter = BankValueGetAsInt(bankRogue, libHRGE_bankSection, "ObjectiveCounter");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "SkipCurseCounter")) {
        libHRGE_skipCurseCounter = BankValueGetAsInt(bankRogue, libHRGE_bankSection, "SkipCurseCounter");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "Rerolls")) {
        libHRGE_rerolls += BankValueGetAsInt(bankRogue, libHRGE_bankSection, "Rerolls");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "RerollsCurse")) {
        libHRGE_rerollsCurse += BankValueGetAsInt(bankRogue, libHRGE_bankSection, "RerollsCurse");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "Bans")) {
        libHRGE_bans += BankValueGetAsInt(bankRogue, libHRGE_bankSection, "Bans");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "CursesNextGame")) {
        libHRGE_cursesQueued += BankValueGetAsInt(bankRogue, libHRGE_bankSection, "CursesNextGame");
    }
    if (BankKeyExists(bankRogue, libHRGE_bankSection, "BoonsNextGame")) {
        libHRGE_boonsQueued += BankValueGetAsInt(bankRogue, libHRGE_bankSection, "BoonsNextGame");
    }

    UserDataLoadType(libHRGE_affixUserData, bankRogue, libHRGE_bankSection);
}

void libHRGE_MigrateBankSection(string source, string sourceSection, string destination, string destinationSection) {
    bank sourceBank = BankLoad(source, libHRGE_player);
    bank destinationBank = BankLoad(destination, libHRGE_player);
    int keyCount = BankKeyCount(sourceBank, sourceSection);
    int i;
    string key;

    if (keyCount <= 0 || BankKeyExists(sourceBank, sourceSection, "Migrated")) { return; }

    for (i = 0; i < keyCount; i += 1) {
        key = BankKeyName(sourceBank, sourceSection, i);
        if (BankValueIsType(sourceBank, sourceSection, key, c_bankTypeFixed)) {
            BankValueSetFromFixed(destinationBank, destinationSection, key, BankValueGetAsFixed(sourceBank, sourceSection, key));
        } else if (BankValueIsType(sourceBank, sourceSection, key, c_bankTypeInt)) {
            BankValueSetFromInt(destinationBank, destinationSection, key, BankValueGetAsInt(sourceBank, sourceSection, key));
        } else if (BankValueIsType(sourceBank, sourceSection, key, c_bankTypeString)) {
            if (key == "Map") {
                BankValueSetFromInt(destinationBank, destinationSection, key, 1);
            } else {
                BankValueSetFromString(destinationBank, destinationSection, key, BankValueGetAsString(sourceBank, sourceSection, key));
            }
        }
    }

    BankValueSetFromInt(sourceBank, sourceSection, "Migrated", 1);

    BankSave(sourceBank);
    BankSave(destinationBank);
}
void libHRGE_MigrateBank() {
    if (!BankExists(libHRGE_bank, libHRGE_player)) {
        libHRGE_MigrateBankSection(libHRGE_bankOld, libHRGE_bankSectionOld, libHRGE_bank, libHRGE_bankSection);
        libHRGE_MigrateBankSection(libHRGE_bankOld, libHRGE_bankSectionStatsOld, libHRGE_bank, libHRGE_bankSectionStats);
    }
    if (!BankExists(libHRGE_bankSettings, libHRGE_player)) {
        libHRGE_MigrateBankSection(libHRGE_bankOld, libHRGE_bankSectionSettingsOld, libHRGE_bankSettings, libHRGE_bankSectionSettings);
    }
    if (!BankExists(libHRGE_bankAchievements, libHRGE_player)) {
        libHRGE_MigrateBankSection(libHRGE_bankOld, libHRGE_bankSectionAchievementsOld, libHRGE_bankAchievements, libHRGE_bankSectionAchievements);
    }
}

void libHRGE_ResetBank() {
    bank bankRogue = BankLoad(libHRGE_bank, libHRGE_player);
    libHRGE_DisplayDebugMessage("Resetting bank...");
    BankSectionRemove(bankRogue, libHRGE_bankSection);
    BankSectionRemove(bankRogue, libHRGE_bankSectionStats);
    BankSave(bankRogue);
}
void libHRGE_ResetBankAchievements() {
    bank bankAchievements = BankLoad(libHRGE_bankAchievements, libHRGE_player);
    libHRGE_DisplayDebugMessage("Resetting achievements...");
    BankSectionRemove(bankAchievements, libHRGE_bankSectionAchievements);
    BankSave(bankAchievements);
}
void libHRGE_ResetBankSettings() {
    bank bankSettings = BankLoad(libHRGE_bankSettings, libHRGE_player);
    libHRGE_DisplayDebugMessage("Resetting settings...");
    BankSectionRemove(bankSettings, libHRGE_bankSection);
    BankSave(bankSettings);
}


// ============================================================
// Game over - Save on win or reset on loss
// ============================================================
bool libHRGE_GameOverCallbackTrigger_Func (bool testConds, bool runActions) {
    int winningTeam = libGame_winningTeam;
    int mapIndex = libHRGE_GetCurrentMapPathIndex();

    libHRGE_EvaluateAllAchievements();

    if (winningTeam == libHRGE_teamOrderIndex) {
        if (mapIndex >= libHRGE_mapMaxIndex) {
            mapIndex = 1;
        } else {
            mapIndex += 1;
        }
        GameSetNextMap(libHRGE_GetMapPathFromIndex(mapIndex));
        libHRGE_map = mapIndex;
        
        if (libHRGE_currentRun == libHRGE_winningRound) {
            libHRGE_SetDialogControlText(libHRGE_dialogGameover.label, StringExternal("Label/Name/Victory"));
            libHRGE_SetDialogControlEnabled(libHRGE_dialogGameover.continueButton, true);
            libHRGE_SetDialogControlVisible(libHRGE_dialogGameover.continueButton, true);
            libHRGE_ShowGameoverDialog(true);
        }
        libHRGE_SaveBank();
    } else {
        libHRGE_SetDialogControlText(libHRGE_dialogGameover.label, StringExternal("Label/Name/GameOver"));
        libHRGE_SetDialogControlEnabled(libHRGE_dialogGameover.continueButton, false);
        libHRGE_SetDialogControlVisible(libHRGE_dialogGameover.continueButton, false);
        libHRGE_ShowGameoverDialog(true);
        libHRGE_ResetBank();
    }

    return true;
}
void libHRGE_GameOverCallbackTrigger_Init () {
    libHRGE_GameOverCallbackTrigger = TriggerCreate("libHRGE_GameOverCallbackTrigger_Func");
    libGame_gv_gameOverCallback = libHRGE_GameOverCallbackTrigger;
}


int libHRGE_RollRarity(int baseRarity, bool curse) {
    int result = baseRarity;
    fixed roll = RandomFixed(0, 1.0);
    fixed modifier = 1.0;
    fixed modifierHigh = 0;
    if (curse) {
        return baseRarity;
    } else if (baseRarity == libHRGE_rarityCommon) {
        if (roll <= libHRGE_commonToLegendary * (modifier + modifierHigh)) {
            result = libHRGE_rarityLegendary;
        } else if (roll <= (libHRGE_commonToLegendary + libHRGE_commonToEpic) * (modifier + modifierHigh)) {
            result = libHRGE_rarityEpic;
        } else if (roll <= (libHRGE_commonToLegendary + libHRGE_commonToEpic + libHRGE_commonToRare) * modifier) {
            result = libHRGE_rarityRare;
        } else if (roll <= (libHRGE_commonToLegendary + libHRGE_commonToEpic + libHRGE_commonToRare + libHRGE_commonToUncommon) * modifier) {
            result = libHRGE_rarityUncommon;
        }
    } else if (baseRarity == libHRGE_rarityUncommon) {
        if (roll <= libHRGE_uncommonToLegendary * (modifier + modifierHigh)) {
            result = libHRGE_rarityLegendary;
        } else if (roll <= (libHRGE_uncommonToLegendary + libHRGE_uncommonToEpic) * (modifier + modifierHigh)) {
            result = libHRGE_rarityEpic;
        } else if (roll <= (libHRGE_uncommonToLegendary + libHRGE_uncommonToEpic + libHRGE_uncommonToRare) * modifier) {
            result = libHRGE_rarityRare;
        }
    } else if (baseRarity == libHRGE_rarityRare) {
        if (roll <= libHRGE_rareToLegendary * (modifier + modifierHigh)) {
            result = libHRGE_rarityLegendary;
        } else if (roll <= (libHRGE_rareToLegendary + libHRGE_rareToEpic) * (modifier + modifierHigh)) {
            result = libHRGE_rarityEpic;
        }
    } else if (baseRarity == libHRGE_rarityEpic) {
        if (roll <= libHRGE_epicToLegendary * (modifier + modifierHigh)) {
            result = libHRGE_rarityLegendary;
        }
    }
    return result;
}

bool libHRGE_AffixAlreadyRolled(int affix) {
    int i;
    for (i = 1; i <= libHRGE_currentAffixSelection; i += 1) {
        if (libHRGE_rolledAffixes[i] == affix) {
            return true;
        }
    }
    return false;
}

int libHRGE_RollAffix(int rarity, bool curse, int level, bool lockRarity) {
    int repeat = 3;
    int[libHRGE_maxEligibleAffixes + 1] eligibleAffixes;
    int[libHRGE_maxEligibleAffixes + 1] eligibleWeights;
    int totalWeight;
    int cumulativeWeight;
    int randomWeight;
    int slotRarity;
    int slotAffixCount;
    int i;
    int random;
    bool rarityHasUpgraded;
    string instance;
    int lastSeen;
    int max;
    bool affixIsCurse;
    int affixRarity;
    int minDifficulty;
    int maxDifficulty;
    int minRound;
    int maxRound;
    int minLevel;
    int maxLevel;
    int weight;
    int failSafe = 10000; // Max amount of rolls possible, just in case

    slotRarity = rarity;

    while (failSafe > 0) {
        slotAffixCount = 0;
        totalWeight = 0;
        cumulativeWeight = 0;
        failSafe -= 1;

        // Search for eligible affixes
        for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
            instance = libHRGE_GetAffixInstance(i);
            affixRarity = libHRGE_GetAffixRarity(instance);
            // Is blank, is disabled, has already rolled, cannot roll, or is banned
            if (instance == "" || instance == null || libHRGE_AffixAlreadyRolled(i) || !libHRGE_AffixIsEnabled(instance) || libHRGE_AffixCannotRoll(instance) || libHRGE_AffixIsBanned(instance)) {
                continue;
            }

            lastSeen = DataTableGetInt(true, instance + "LastSeen");
            // Check if it has already been seen previously
            if (lastSeen > 0) {
                DataTableSetInt(true, instance + "LastSeen", lastSeen - 1);
                continue;
            }
            
            max = libHRGE_GetAffixMax(instance);
            // Check maximum count
            if ((libHRGE_GetAffixCount(instance) >= max) && max != 0) {
                continue;
            }

            affixIsCurse = libHRGE_AffixIsCurse(instance);
            // Check boon/curse and rarity requirement
            if ((curse != affixIsCurse) || (affixRarity != slotRarity && !curse)) {
                continue;
            }

            minDifficulty = libHRGE_GetAffixMinDifficulty(instance);
            maxDifficulty = libHRGE_GetAffixMaxDifficulty(instance);
            minRound = libHRGE_GetAffixMinRound(instance);
            maxRound = libHRGE_GetAffixMaxRound(instance);
            // Check difficulty and round requirements
            if ((minDifficulty != 0 && minDifficulty > libHRGE_difficulty) || (maxDifficulty != 0 && maxDifficulty < libHRGE_difficulty) ||
            (minRound != 0 && minRound > libHRGE_currentRun) || (maxRound != 0 && maxRound < libHRGE_currentRun)) {
                continue;
            }

            // Check for map and hero requirements
            if (libHRGE_IsHeroExcludedForAffix(instance) || libHRGE_IsMapExcludedForAffix(instance)) {
                continue;
            }

            minLevel = libHRGE_GetAffixMinLevel(instance);
            maxLevel = libHRGE_GetAffixMaxLevel(instance);
            // Check min and max level requirement
            if ((minLevel > 0 && level < minLevel) || (maxLevel > 0 && level > maxLevel)) {
                continue;
            }

            // Check for affix exclusions, prerequisites, and talent requirements
            if (libHRGE_AffixIsExcluded(instance) || libHRGE_AffixPrerequisitesNotMet(instance) || libHRGE_IsMissingTalentsForAffix(instance)) {
                continue;
            }

            slotAffixCount += 1;
            eligibleAffixes[slotAffixCount] = i;

            weight = libHRGE_GetAffixWeight(instance);

            if (curse) {
                if (affixRarity == libHRGE_rarityChallenge) {
                    eligibleWeights[slotAffixCount] = FixedToInt(weight / (1 + (libHRGE_rarityLegendary - 1) * (libHRGE_rarityLegendary - 1) * 0.25));
                } else {
                    eligibleWeights[slotAffixCount] = FixedToInt(weight / (1 + (affixRarity - 1) * (affixRarity - 1) * 0.25));
                }
            } else {
                eligibleWeights[slotAffixCount] = weight;
            }
            totalWeight += eligibleWeights[slotAffixCount];
        }
        
        // Shuffle
        if (slotAffixCount > 0) {
            randomWeight = RandomInt(1, MaxI(totalWeight, 1));
            for (i = 1; i <= slotAffixCount; i += 1) {
                cumulativeWeight += eligibleWeights[i];
                if (randomWeight <= cumulativeWeight) {
                    DataTableSetInt(true, libHRGE_GetAffixInstance(eligibleAffixes[i]) + "LastSeen", 3);
                    return eligibleAffixes[i];
                }
            }
            random = RandomInt(1, slotAffixCount);
            DataTableSetInt(true, libHRGE_GetAffixInstance(eligibleAffixes[random]) + "LastSeen", 3);
            return eligibleAffixes[random];
        }
        // Upgrade rarity if no affixes are found, and then downgrade if no upgraded rarity affixes are found
        if (curse) {
            return 0;
        } else if (!lockRarity) {
            if (slotRarity < libHRGE_rarityLegendary && !rarityHasUpgraded) {
                slotRarity += 1;
                rarityHasUpgraded = true;
            } else if (!rarityHasUpgraded) {
                rarityHasUpgraded = true;
                slotRarity = MaxI(rarity - 1, libHRGE_rarityCommon);
            } else if (slotRarity > libHRGE_rarityCommon) {
                slotRarity -= 1;
            } else {
                if (repeat > 0) {
                    repeat -= 1;
                } else {
                    return 0;
                }
            }
        } else if (lockRarity && slotRarity > libHRGE_rarityCommon && slotRarity != libHRGE_rarityStarter) {
            slotRarity -= 1;
        } else {
            if (repeat > 0) {
                repeat -= 1;
            } else {
                return 0;
            }
        } 
    }

    return 0;
}

bool libHRGE_ProcessQueueTimeElapsed_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (!libHRGE_processingQueue || libHRGE_processQueueTimeElapsed > 60) {
            return false;
        }
    }
    
    libHRGE_processQueueTimeElapsed += 0.0625;
    return true;
}
void libHRGE_ProcessQueueTimeElapsed_Init() {
    libHRGE_ProcessQueueTimeElapsedTrigger = TriggerCreate("libHRGE_ProcessQueueTimeElapsed_Func");
    TriggerAddEventTimePeriodic(libHRGE_ProcessQueueTimeElapsedTrigger, 0.0625, c_timeGame);
}


void libHRGE_ShowRolledAffixes() {
    SoundPlayOnUnit(SoundLink("UI_Game_LevelUp_Talent", -1), PlayerGroupSingle(1), libGame_gv_players[libHRGE_player].lv_heroUnit, 8.0, 100.0, 0.0);
    libHRGE_ShowAffixSelectionDialog(true);
}

void libHRGE_RollForSlot(int slot) {
    int rolledRarity;
    if (libHRGE_currentQueue.lockRarity) {
        rolledRarity = libHRGE_currentQueue.rarity;
    } else {
        rolledRarity = libHRGE_RollRarity(libHRGE_currentQueue.rarity, libHRGE_currentQueue.curse);
    }
    libHRGE_rolledAffixes[slot] = libHRGE_RollAffix(rolledRarity, libHRGE_currentQueue.curse, libHRGE_currentQueue.level, libHRGE_currentQueue.lockRarity);
}

void libHRGE_RollAffixChoices() {
    bool anyRolled = false;
    int rolledRarity;
    int i;
    libHRGE_processQueueTimeElapsed = 0;
    if (libHRGE_currentQueue.overrideAffix != 0) {
        libHRGE_rolledAffixes[1] = libHRGE_currentQueue.overrideAffix;
        libHRGE_ShowRolledAffixes();
    } else if (libHRGE_currentQueue.rarity == libHRGE_rarityMythic) {
        if (libHRGE_currentRun == 1) {
            libHRGE_rolledAffixes[1] = libHRGE_GetAffixIndex(libHRGE_mythicCurse1);
        } else if (libHRGE_currentRun == 3) {
            libHRGE_rolledAffixes[1] = libHRGE_GetAffixIndex(libHRGE_mythicCurse2);
        } else if (libHRGE_currentRun == 5) {
            libHRGE_rolledAffixes[1] = libHRGE_GetAffixIndex(libHRGE_mythicCurse3);
        } else if (libHRGE_currentRun == 7) {
            libHRGE_rolledAffixes[1] = libHRGE_GetAffixIndex(libHRGE_mythicCurse4);
        } else if (libHRGE_currentRun == 9) {
            libHRGE_rolledAffixes[1] = libHRGE_GetAffixIndex(libHRGE_mythicCurse5);
        } else {
            libHRGE_rolledAffixes[1] = libHRGE_GetAffixIndex(libHRGE_mythicCurse6);
        }
        if (libHRGE_rolledAffixes[1] == 0) {
            libHRGE_processingQueue = false;
            libHRGE_AdvanceQueue();
            libHRGE_ProcessQueue();
        } else {
            libHRGE_ShowRolledAffixes();
        }
    } else {
        for (i = 1; i <= libHRGE_currentQueue.choiceCount; i += 1) {
            libHRGE_RollForSlot(i);
            if (libHRGE_rolledAffixes[i] != 0) {
                anyRolled = true;
            }
        }
        if (!anyRolled) {
            libHRGE_processingQueue = false;
            libHRGE_AdvanceQueue();
            libHRGE_ProcessQueue();
        } else {
            libHRGE_ShowRolledAffixes();
        }
    }
}

void libHRGE_AdvanceQueue() {
    int i;
    for (i = 1; i <= libHRGE_queueCount; i += 1) {
        libHRGE_queue[i].choiceCount = libHRGE_queue[i + 1].choiceCount;
        libHRGE_queue[i].curse = libHRGE_queue[i + 1].curse;
        libHRGE_queue[i].level = libHRGE_queue[i + 1].level;
        libHRGE_queue[i].lockRarity = libHRGE_queue[i + 1].lockRarity;
        libHRGE_queue[i].overrideAffix = libHRGE_queue[i + 1].overrideAffix;
        libHRGE_queue[i].rarity = libHRGE_queue[i + 1].rarity;
        libHRGE_queue[i].rerollDisabled = libHRGE_queue[i + 1].rerollDisabled;
    }
    libHRGE_currentQueue.choiceCount = libHRGE_queue[1].choiceCount;
    libHRGE_currentQueue.curse = libHRGE_queue[1].curse;
    libHRGE_currentQueue.level = libHRGE_queue[1].level;
    libHRGE_currentQueue.lockRarity = libHRGE_queue[1].lockRarity;
    libHRGE_currentQueue.overrideAffix = libHRGE_queue[1].overrideAffix;
    libHRGE_currentQueue.rarity = libHRGE_queue[1].rarity;
    libHRGE_currentQueue.rerollDisabled = libHRGE_queue[1].rerollDisabled;
    
    libHRGE_queueCount = MaxI(0, libHRGE_queueCount - 1);
}

void libHRGE_ProcessCurrentEntry() {
    libHRGE_processingQueue = true;
    libHRGE_RollAffixChoices();
}

void libHRGE_SwapCurseToBoon() {
    libHRGE_processingQueue = true;
    libHRGE_objectivesWonCounter -= 1;
    libHRGE_cursesSwapped += 1;
    libHRGE_DisplayChatMessage(StringExternal("Message/CurseSwap"));
    libHRGE_currentQueue.curse = false;
    libHRGE_RollAffixChoices();
}

void libHRGE_SkipCurse() {
    libHRGE_processingQueue = false;
    libHRGE_skipCurseCounter -= 1;
    libHRGE_cursesSkipped += 1;
    libHRGE_DisplayChatMessage(StringExternal("Message/CurseSkipped"));
    libHRGE_AdvanceQueue();
    libHRGE_ProcessQueue();
}

void libHRGE_ProcessQueue() {
    int i;
    string instance;
    if (libHRGE_processingQueue || libHRGE_queueCount <= 0 || libGame_gv_gameOver) {
        return;
    }

    for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
        instance = libHRGE_GetAffixInstance(i);
        DataTableSetInt(true, instance + "LastSeen", 0);
    }

    if (libHRGE_currentQueue.rarity == libHRGE_rarityMythic || libHRGE_currentQueue.rarity == libHRGE_rarityMilestone || libHRGE_debugCommandAddAll) {
        libHRGE_ProcessCurrentEntry();
    } else if (libHRGE_objectivesWonCounter > 0 && libHRGE_currentQueue.curse) {
        libHRGE_SwapCurseToBoon();
    } else if (libHRGE_skipCurseCounter > 0 && libHRGE_currentQueue.curse) {
        libHRGE_SkipCurse();
    } else {
        libHRGE_ProcessCurrentEntry();
    }
}

void libHRGE_EnqueueAffix(structref<libHRGE_QueuedAffix> queued, int amountToQueue) {
    int i;
    if (libHRGE_debug_disableAffixQueue) {
        return;
    }
    if (amountToQueue > 0) {
        for (i = 1; i <= amountToQueue; i += 1) {
            if (libHRGE_queueCount >= libHRGE_maxQueue) {
                break;
            }
            libHRGE_queueCount += 1;
            libHRGE_queue[libHRGE_queueCount].choiceCount = queued.choiceCount;
            libHRGE_queue[libHRGE_queueCount].curse = queued.curse;
            libHRGE_queue[libHRGE_queueCount].level = queued.level;
            libHRGE_queue[libHRGE_queueCount].lockRarity = queued.lockRarity;
            libHRGE_queue[libHRGE_queueCount].overrideAffix = queued.overrideAffix;
            libHRGE_queue[libHRGE_queueCount].rarity = queued.rarity;
            libHRGE_queue[libHRGE_queueCount].rerollDisabled = queued.rerollDisabled;
        }
        libHRGE_currentQueue.choiceCount = libHRGE_queue[1].choiceCount;
        libHRGE_currentQueue.curse = libHRGE_queue[1].curse;
        libHRGE_currentQueue.level = libHRGE_queue[1].level;
        libHRGE_currentQueue.lockRarity = libHRGE_queue[1].lockRarity;
        libHRGE_currentQueue.overrideAffix = libHRGE_queue[1].overrideAffix;
        libHRGE_currentQueue.rarity = libHRGE_queue[1].rarity;
        libHRGE_currentQueue.rerollDisabled = libHRGE_queue[1].rerollDisabled;
    }
    libHRGE_ProcessQueue();
}
void libHRGE_Enqueue(int choiceCount, int amountToQueue, int rarity, int level, bool curse, bool lockRarity, bool rerollDisabled) {
    libHRGE_QueuedAffix queued;
    queued.choiceCount = choiceCount;
    queued.curse = curse;
    queued.level = level;
    queued.lockRarity = lockRarity;
    queued.overrideAffix = 0;
    queued.rarity = rarity;
    queued.rerollDisabled = rerollDisabled;
    libHRGE_EnqueueAffix(queued, amountToQueue);
}

void libHRGE_QueueBoon(int rarity, int amountToQueue, bool rerollDisabled, bool lockRarity) {
    libHRGE_Enqueue(libHRGE_currentAffixSelection, amountToQueue, rarity, UnitLevel(libGame_gv_players[libHRGE_player].lv_heroUnit), false, lockRarity, rerollDisabled);
}
void libHRGE_QueueBoonWithChoiceCount(int choiceCount, int rarity, int amountToQueue, bool rerollDisabled, bool lockRarity) {
    libHRGE_Enqueue(choiceCount, amountToQueue, rarity, UnitLevel(libGame_gv_players[libHRGE_player].lv_heroUnit), false, lockRarity, rerollDisabled);
}
void libHRGE_QueueMythicCurse(int amountToQueue) {
    libHRGE_Enqueue(1, amountToQueue, libHRGE_rarityMythic, UnitLevel(libGame_gv_players[libHRGE_enemy].lv_heroUnit), true, true, true);
}
void libHRGE_QueueCurse(int amountToQueue, bool rerollDisabled) {
    libHRGE_Enqueue(libHRGE_currentAffixSelection, amountToQueue, libHRGE_rarityCommon, UnitLevel(libGame_gv_players[libHRGE_enemy].lv_heroUnit), true, false, rerollDisabled);
}

void libHRGE_RerollAffixes() {
    if (libHRGE_rerolls <= 0 && !libHRGE_currentQueue.curse) {
        return;
    }
    if (libHRGE_rerollsCurse <= 0 && libHRGE_currentQueue.curse) {
        return;
    }
    if (!libHRGE_processingQueue) {
        return;
    }

    if (libHRGE_currentQueue.curse) {
        libHRGE_rerollsCurse -= 1;
        libHRGE_rerollsCurseUsed += 1;
        libHRGE_RollAffixChoices();
    } else {
        libHRGE_rerolls -= 1;
        libHRGE_rerollsUsed += 1;
        libHRGE_RollAffixChoices();
    }
}

void libHRGE_BanAffix(int selectionIndex) {
    int rolledRarity;
    string instance = libHRGE_GetAffixInstance(libHRGE_rolledAffixes[selectionIndex]);
    if (libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsDisplayPicksBans, libHRGE_player)) {
        libHRGE_DisplayChatMessage(StringExternal("Message/Ban") + TextWithColor(StringExternal("Affix/Name/" + instance), libHRGE_GetAffixColor(instance)) + StringToText("."));
    }
    
    libHRGE_processQueueTimeElapsed = 0;
    libHRGE_bans -= 1;
    libHRGE_bansUsed += 1;
    libHRGE_SetAffixBanned(instance, true);
    libHRGE_rolledAffixes[selectionIndex] = 0;
    libHRGE_RollForSlot(selectionIndex);
    libHRGE_ShowAffixSelectionDialog(true);
}

void libHRGE_SelectAffix(int selectionIndex) {
    int i;
    string instance = libHRGE_GetAffixInstance(libHRGE_rolledAffixes[selectionIndex]);
    if (libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsDisplayPicksBans, libHRGE_player) && libHRGE_currentQueue.choiceCount > 1) {
        libHRGE_DisplayChatMessage(StringExternal("Message/Pick") + TextWithColor(StringExternal("Affix/Name/" + instance), libHRGE_GetAffixColor(instance)) + StringToText("."));
    }
    
    libHRGE_ShowAffixSelectionDialog(false);
    libHRGE_AddAffix(libHRGE_rolledAffixes[selectionIndex], 1);
    libHRGE_Pause(false);
    libHRGE_processingQueue = false;
    libHRGE_AdvanceQueue();
    libHRGE_ProcessQueue();
    libHRGE_UpdateOwnedAffixesDialog();
}

bool libHRGE_AffixHotkeyPressedTrigger_Func (bool testConds, bool runActions) {
    int hotkeyPressed = EventKeyPressed() - 3;
    if (testConds) {
        if (!libHRGE_processingQueue){
            return false;
        }
        if (libHRGE_processQueueTimeElapsed < libHRGE_disableHotkeysDuration) {
            return false;
        }
        if (hotkeyPressed > libHRGE_currentAffixSelection) {
            return false;
        }
        if (hotkeyPressed > libHRGE_currentQueue.choiceCount) {
            return false;
        }
        if (libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsOptionsDialogVisible()) {
            return false;
        }
    }

    if (libHRGE_rolledAffixes[hotkeyPressed] == 0) {
        return true;
    }

    libHRGE_SelectAffix(hotkeyPressed);
    SoundPlayForPlayer(SoundLink("UI_Game_Click", -1), libHRGE_player, PlayerGroupSingle(libHRGE_player), 100.0, 0.0);

    return true;
}
void libHRGE_AffixHotkeyPressedTrigger_Init() {
    libHRGE_AffixHotkeyPressedTrigger = TriggerCreate("libHRGE_AffixHotkeyPressedTrigger_Func");
    TriggerAddEventKeyPressed(libHRGE_AffixHotkeyPressedTrigger, libHRGE_player, c_key1, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libHRGE_AffixHotkeyPressedTrigger, libHRGE_player, c_key2, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libHRGE_AffixHotkeyPressedTrigger, libHRGE_player, c_key3, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libHRGE_AffixHotkeyPressedTrigger, libHRGE_player, c_key4, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(libHRGE_AffixHotkeyPressedTrigger, libHRGE_player, c_key5, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
}
bool libHRGE_AffixHotkeyRerollPressed_Func (bool testConds, bool runActions) {
    int hotkeyPressed = EventKeyPressed();
    if (testConds) {
        if (!libHRGE_processingQueue){
            return false;
        }
        if (libHRGE_processQueueTimeElapsed < libHRGE_disableHotkeysDuration) {
            return false;
        }
        if (hotkeyPressed != c_keyR) {
            return false;
        }
        if (libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsOptionsDialogVisible()) {
            return false;
        }
    }
    
    libHRGE_RerollAffixes();

    return true;
}
void libHRGE_AffixHotkeyRerollPressed_Init() {
    TriggerAddEventKeyPressed(TriggerCreate("libHRGE_AffixHotkeyRerollPressed_Func"), libHRGE_player, libHRGE_hotkeyReroll, false, c_keyModifierStateIgnore, c_keyModifierStateRequire, c_keyModifierStateIgnore);
}
bool libHRGE_AffixALTPressed_Func (bool testConds, bool runActions) {
    int hotkeyPressed = EventKeyPressed();
    if (testConds) {
        if (hotkeyPressed != c_keyAlt) {
            return false;
        }
        if (libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, libHRGE_player)) {
            return false;
        }
    }
    libHRGE_pressingALT = true;
    if (libHRGE_IsOwnedAffixesDialogVisible()) {
        libHRGE_UpdateOwnedAffixesDialog();
    }
    if (libHRGE_IsAffixSelectionDialogVisible()) {
        libHRGE_UpdateAffixSelectionDialog();
    }
    return true;
}
bool libHRGE_AffixALTReleased_Func (bool testConds, bool runActions) {
    int hotkeyPressed = EventKeyPressed();
    if (testConds) {
        if (hotkeyPressed != c_keyAlt) {
            return false;
        }
        if (libNtve_gf_DialogItemIsChecked(libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips, libHRGE_player)) {
            return false;
        }
    }
    libHRGE_pressingALT = false;
    if (libHRGE_IsOwnedAffixesDialogVisible()) {
        libHRGE_UpdateOwnedAffixesDialog();
    }
    if (libHRGE_IsAffixSelectionDialogVisible()) {
        libHRGE_UpdateAffixSelectionDialog();
    }
    return true;
}
void libHRGE_AffixALTPressedReleased_Init() {
    TriggerAddEventKeyPressed(TriggerCreate("libHRGE_AffixALTPressed_Func"), libHRGE_player, libHRGE_hotkeyALT, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
    TriggerAddEventKeyPressed(TriggerCreate("libHRGE_AffixALTReleased_Func"), libHRGE_player, libHRGE_hotkeyALT, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}
int libHRGE_GetSelectButtonIndex(int dialogControl) {
    int i;
    for (i = 1; i <= libHRGE_maxAffixSelection; i += 1) {
        if (dialogControl == libHRGE_dialogAffixSelection.items[i].selectButton) {
            return i;
        }
    }
    return 0;
}
bool libHRGE_AffixSelectedTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    int selectedButton = libHRGE_GetSelectButtonIndex(eventDialog);

    if (testConds) {
        if (libHRGE_processQueueTimeElapsed < libHRGE_disableDialogControlDuration) {
            return false;
        }
        if (selectedButton == 0 || libHRGE_rolledAffixes[selectedButton] == 0) {
            return false;
        }
        if (!libHRGE_processingQueue){
            return false;
        }
        if (libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsOptionsDialogVisible()) {
            return false;
        }
    }

    libHRGE_SelectAffix(selectedButton);

    return true;
}

int libHRGE_GetBanButtonIndex(int dialog) {
    int i;
    for (i = 1; i <= libHRGE_maxAffixSelection; i += 1) {
        if (dialog == libHRGE_dialogAffixSelection.items[i].banButton) {
            return i;
        }
    }
    return 0;
}

bool libHRGE_AffixBanTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();
    int selectedButton = libHRGE_GetBanButtonIndex(eventDialog);

    if (testConds) {
        if (libHRGE_processQueueTimeElapsed < libHRGE_disableDialogControlDuration) {
            return false;
        }
        if (libHRGE_bans <= 0) {
            return false;
        }
        if (selectedButton == 0 || libHRGE_rolledAffixes[selectedButton] == 0) {
            return false;
        }
        if (!libHRGE_processingQueue) {
            return false;
        }
        if (libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsOptionsDialogVisible()) {
            return false;
        }
    }

    libHRGE_BanAffix(selectedButton);

    return true;
}

bool libHRGE_AffixRerollTrigger_Func (bool testConds, bool runActions) {
    int eventDialog = EventDialogControl();

    if (testConds) {
        if (eventDialog != libHRGE_dialogAffixSelection.rerollButton){
            return false;
        }
        if (!libHRGE_processingQueue) {
            return false;
        }
        if (libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsOptionsDialogVisible()) {
            return false;
        }
    }

    libHRGE_RerollAffixes();

    return true;
}

bool libHRGE_ObjectiveWonTrigger_Func (bool testConds, bool runActions) {
    if (libHRGE_objectivesWonThisGame < libHRGE_maxCurseSwapsFromObjectives) {
        libHRGE_objectivesWonCounter += 1;
        libHRGE_DisplayChatMessage(StringExternal("Message/CurseToBoon"));
    }
    libHRGE_objectivesWonThisGame += 1;
    return true;
}
bool libHRGE_ObjectiveLostTrigger_Func (bool testConds, bool runActions) {
    libHRGE_objectivesLostThisGame += 1;
    return true;
}
void libHRGE_ObjectiveTriggers_Init() {
    libHRGE_ObjectiveWonTrigger = TriggerCreate("libHRGE_ObjectiveWonTrigger_Func");
    libHRGE_ObjectiveLostTrigger = TriggerCreate("libHRGE_ObjectiveLostTrigger_Func");
    TriggerAddEventGeneric(libHRGE_ObjectiveWonTrigger, "AffixObjectiveWon");
    TriggerAddEventGeneric(libHRGE_ObjectiveLostTrigger, "AffixObjectiveLost");
}

bool libHRGE_ResetCommandTrigger_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (StringWord(EventChatMessage(false), 1) != "resetgame") {
            return false;
        }
    }

    libHRGE_DisplayChatMessage(StringExternal("Message/ResetCommand"));
    libHRGE_ResetBank();
    GameSetNextMap(libHRGE_GetMapPathFromIndex(libHRGE_startingMap));
    KickFromGame(PlayerGroupAll());

    return true;
}
void libHRGE_ResetCommandTrigger_Init () {
    libHRGE_ResetCommandTrigger = TriggerCreate("libHRGE_ResetCommandTrigger_Func");
    TriggerAddEventChatMessage(libHRGE_ResetCommandTrigger, c_playerAny, "resetgame", false);
}

bool libHRGE_PrintDialogPressed_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (!libHRGE_debug_printDialogControls) {
            return false;
        }
    }
    libHRGE_DisplayDebugMessage("DialogControl: " + IntToString(EventDialogControl()) + ", EventType: " + IntToString(EventDialogControlEventType()) + ", MouseButton: " + IntToString(EventDialogControlMouseButton()));
    return true;
}
void libHRGE_PrintDialogPressedTrigger_Init () {
    libHRGE_PrintDialogPressedTrigger = TriggerCreate("libHRGE_PrintDialogPressed_Func");
    TriggerAddEventDialogControl(libHRGE_PrintDialogPressedTrigger, libHRGE_player, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

bool libHRGE_TestCommandTrigger_Func (bool testConds, bool runActions) {
    int i;
    int i2;
    string chatMessage;
    string argument1;
    string argument2;
    string argument3;
    int afxaddallAffixes;
    int afxaddallAmount;
    int nextmapValue;
    int rerollsAmount;
    int cooldownId;
    int affixAmount;
    int affixRarity;
    int affixId;
    string unitType;
    int xpAmount;
    string instance;
    string triggerInstance;
    trigger triggerFunc;
    int fieldCount;
    int max;
    int count;
    timer affixTimer;
    
    if (testConds) {
        if (!libHRGE_debug_enableCheatCommands) {
            return false;
        }
    }

    chatMessage = StringWord(EventChatMessage(false), 1);
    argument1 = StringWord(EventChatMessage(false), 2);
    argument2 = StringWord(EventChatMessage(false), 3);
    argument3 = StringWord(EventChatMessage(false), 4);

    if (chatMessage == "help" || chatMessage == "h") {
        if (argument1 == "addall" || argument1 == "aa") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/AddAll"));
        } else if (argument1 == "nextmap" || argument1 == "nm") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/NextMap"));
        } else if (argument1 == "rerolls" || argument1 == "rr") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Rerolls"));
        } else if (argument1 == "bans") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Bans"));
        } else if (argument1 == "cooldown" || argument1 == "cd") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Cooldown"));
        } else if (argument1 == "boon") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Boon"));
        } else if (argument1 == "curse") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Curse"));
        } else if (argument1 == "add" || argument1 == "afx") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Add"));
        } else if (argument1 == "teleport" || argument1 == "tp") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Teleport"));
        } else {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Commands"));
        }
    } else if (chatMessage == "boon") {
        if (argument1 != "" && argument1 != "0") {
            affixAmount = StringToInt(argument1);
        } else {
            affixAmount = 1;
        }
        if (argument2 != "") {
            affixRarity = libHRGE_GetRarityIndex(argument2);
            if (affixRarity == 0) {
                affixRarity = StringToInt(argument2);
            }
        } else {
            affixRarity = libHRGE_rarityCommon;
        }

        libHRGE_QueueBoon(MaxI(affixRarity, libHRGE_rarityCommon), affixAmount, false, false);
    } else if (chatMessage == "curse") {
        if (argument1 != "" && argument1 != "0") {
            affixAmount = StringToInt(argument1);
        } else {
            affixAmount = 1;
        }
        libHRGE_QueueCurse(affixAmount, false);
    } else if (chatMessage == "add" || chatMessage == "afx") {
        if (argument1 == "") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Add"));
        } else {
            if (argument2 != "" && argument2 != "0") {
                affixAmount = StringToInt(argument2);
            } else {
                affixAmount = 1;
            }
            affixId = libHRGE_GetAffixIndex(argument1);
            instance = libHRGE_GetAffixInstance(affixId);
            if (affixId == 0) {
                TextExpressionSetToken("Message/TestCommand/CouldNotFind", "A", StringToText(argument1));
                libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CouldNotFind"));
            } else {
                libHRGE_AddAffix(affixId, affixAmount);
                TextExpressionSetToken("Message/TestCommand/Added", "A", StringToText(IntToString(affixAmount)));
                TextExpressionSetToken("Message/TestCommand/Added", "B", StringToText(instance));
                libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/Added"));
                libHRGE_UpdateOwnedAffixesDialog();
            }
        }
    } else if (chatMessage == "remove" || chatMessage == "rm") {
        if (argument1 == "") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Remove"));
        } else {
            affixId = libHRGE_GetAffixIndex(argument1);
            instance = libHRGE_GetAffixInstance(affixId);
            if (affixId == 0) {
                TextExpressionSetToken("Message/TestCommand/CouldNotFind", "A", StringToText(argument1));
                libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CouldNotFind"));
            } else {
                libHRGE_RemoveAffix(affixId);
                TextExpressionSetToken("Message/TestCommand/Removed", "A", StringToText(instance));
                libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/Removed"));
                libHRGE_UpdateOwnedAffixesDialog();
            }
        }
    } else if (chatMessage == "addall" || chatMessage == "aa") {
        if (argument1 != "" && argument1 != "0") {
            afxaddallAmount = StringToInt(argument1);
        } else {
            afxaddallAmount = 1;
        }
        libHRGE_debugCommandAddAll = true;
        for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
            instance = libHRGE_GetAffixInstance(i);
            max = libHRGE_GetAffixMax(instance);
            count = libHRGE_GetAffixCount(instance);
            if (((libHRGE_AffixIsEnabled(instance) && !libHRGE_IsHeroExcludedForAffix(instance)) || argument2 == "ignore") &&
            ((max > 0 && count <= max) || (max <= 0))) {
                if (argument2 == "hero" && !libHRGE_AffixIsHeroExclusive(instance)) {
                    continue;
                }
                if (((argument2 == "boons" || argument2 == "boon") && libHRGE_AffixIsCurse(instance)) || ((argument2 == "curses" || argument2 == "curse") && !libHRGE_AffixIsCurse(instance))) {
                    continue;
                }
                if (max <= 0) {
                    afxaddallAffixes += afxaddallAmount;
                    libHRGE_AddAffix(i, afxaddallAmount);
                } else if (count < max) {
                    afxaddallAffixes += max - count;
                    libHRGE_AddAffix(i, max - count);
                }
            }
        }
        libHRGE_debugCommandAddAll = false;
        libHRGE_UpdateOwnedAffixesDialog();
        TextExpressionSetToken("Message/TestCommand/AddedTotal", "A", StringToText(IntToString(afxaddallAffixes)));
        libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/AddedTotal"));
    } else if (chatMessage == "nextmap" || chatMessage == "nm") {
        libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/NextMapLoading"));
        if (argument1 != "") {
            nextmapValue = StringToInt(argument1);
            libHRGE_currentRun = nextmapValue - 1;
        } else {
            nextmapValue = libHRGE_currentRun + 1;
        }
        libHRGE_map = nextmapValue % libHRGE_mapMaxIndex;
        if (libHRGE_map == 0) {
            libHRGE_map = libHRGE_mapMaxIndex;
        }
        GameSetNextMap(libHRGE_GetMapPathFromIndex(libHRGE_map));
        libHRGE_SaveBank();
        Wait(1, c_timeGame);
        KickFromGame(PlayerGroupAll());
    } else if (chatMessage == "rerolls" || chatMessage == "rr") {
        if (argument1 != "" && argument1 != "0") {
            rerollsAmount = StringToInt(argument1);
        } else {
            rerollsAmount = 999;
        }
        libHRGE_rerolls += rerollsAmount;
        libHRGE_rerollsCurse += rerollsAmount;
        TextExpressionSetToken("Message/TestCommand/AddingRerolls", "A", StringToText(IntToString(rerollsAmount)));
        libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/AddingRerolls"));
    } else if (chatMessage == "bans") {
        if (argument1 != "" && argument1 != "0") {
            rerollsAmount = StringToInt(argument1);
        } else {
            rerollsAmount = 999;
        }
        libHRGE_bans += rerollsAmount;
        TextExpressionSetToken("Message/TestCommand/AddingBans", "A", StringToText(IntToString(rerollsAmount)));
        libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/AddingBans"));
    } else if (chatMessage == "cooldown" || chatMessage == "cd") {
        if (argument1 == "") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Cooldown"));
        } else {
            instance = argument1;
            if (instance == "" || instance == null) {
                TextExpressionSetToken("Message/TestCommand/CouldNotFind", "A", StringToText(argument1));
                libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CouldNotFind"));
                return true;
            }
            affixTimer = libHRGE_GetAffixPrimaryTimer(instance);
            if (affixTimer == null) {
                TextExpressionSetToken("Message/TestCommand/CooldownNotFound", "A", StringToText(instance));
                libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CooldownNotFound"));
            }
            libNtve_gf_StopTimer(affixTimer);
            TimerStart(affixTimer, 0.125, false, c_timeGame);
            TextExpressionSetToken("Message/TestCommand/CooldownSet", "A", StringToText(instance));
            libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/CooldownSet"));
        }
    } else if (chatMessage == "forcepause") {
        libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/ForcedPause"));
        libHRGE_Pause(true);
    } else if (chatMessage == "forceunpause") {
        libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/ForcedUnpause"));
        libHRGE_Pause(false);
    } else if (chatMessage == "camera") {
        if (argument1 == "" || argument2 == "") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Camera"));
        } else {
            if (argument3 == "") {
                CameraSetValue(libHRGE_player, StringToInt(argument1), StringToFixed(argument2), 0, -1, 10);
            } else {
                CameraSetValue(libHRGE_player, StringToInt(argument1), StringToFixed(argument2), StringToFixed(argument3), -1, 10);
            }
        }
    } else if (chatMessage == "ravencurse") {
        if (argument1 == "") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/RavenCurse"));
        } else {
            libMapM_gf_MMRavenTributeCollectionThresholdReached(StringToInt(argument1));
        }
    } else if (chatMessage == "skytemple") {
        TriggerExecute(TriggerCreate("libMLCP_gt_MMSkyTempleDebugStart1_Func"), false, false);
    } else if (chatMessage == "printheroindex") {
        for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
            TextExpressionSetToken("Message/TestCommand/PrintHeroIndex", "A", StringToText(IntToString(i)));
            TextExpressionSetToken("Message/TestCommand/PrintHeroIndex", "B", StringToText(libCore_gf_GetHeroFromIndex(libGame_gv_players[i].lv_heroIndex)));
            libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/PrintHeroIndex"));
        }
    } else if (chatMessage == "teleport" || chatMessage == "tp") {
        if (argument1 == "" || argument2 == "") {
            libHRGE_DisplayChatMessage(StringExternal("Message/TestCommand/Teleport"));
        } else {
            UnitSetPosition(libHRGE_GetPlayerHeroUnit(libHRGE_player), Point(StringToFixed(argument1), StringToFixed(argument2)), false);
            TextExpressionSetToken("Message/TestCommand/Teleported", "A", StringToText(argument1 + " " + argument2));
            libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/Teleported"));
        }
    } else if (chatMessage == "showgameover") {
        libHRGE_ShowGameoverDialog(!libHRGE_IsGameoverDialogVisible());
    } else if (chatMessage == "achievement") {
        libHRGE_GrantAchievement(libHRGE_GetAchievementId(argument1));
    } else if (chatMessage == "resetachievements") {
        libHRGE_ResetAllAchievements();
    } else if (chatMessage == "displaytime") {
        libHRGE_DisplayChatMessage(StringToText("gameTimer: ") + FixedToText(TimerGetElapsed(libGame_gv_gameTimer), 2));
        libHRGE_DisplayChatMessage(StringToText("totalTime: ") + FixedToText(TimerGetElapsed(libGame_gv_totalTime), 2));
        libHRGE_DisplayChatMessage(StringToText("matchGameplayTimer: ") + FixedToText(TimerGetElapsed(libGame_gv_matchGameplayTimer), 2));
        libHRGE_DisplayChatMessage(StringToText("gobalTimer: ") + FixedToText(TimerGetElapsed(libGame_gv_gobalTimer), 2));
        libHRGE_DisplayChatMessage(StringToText("Mission Time: ") + FixedToText(GameGetMissionTime(), 2));
    } else if (chatMessage == "adbhu") { // Add behavior to player 1's hero unit
        if (argument1 != "") {
            TextExpressionSetToken("Message/TestCommand/Viking", "A", StringToText(argument1));
            TextExpressionSetToken("Message/TestCommand/Viking", "B", StringToText(UnitGetType(libGame_gv_players[libHRGE_player].lv_heroUnit)));
            libHRGE_DisplayChatMessage(TextExpressionAssemble("Message/TestCommand/Viking"));
            UnitBehaviorAdd(libGame_gv_players[libHRGE_player].lv_heroUnit, argument1, libGame_gv_players[libHRGE_player].lv_heroUnit, 1);
        }
    } else if (chatMessage == "xpall") {
        xpAmount = StringToInt(argument1);
        for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
            if ((xpAmount >= 524287)) {
                do {
                    libGame_gf_GrantXPToPlayer(524287, i, 0);
                    libGame_gf_ScoreValuesRecordXPContributionForPlayer(i, 524287, true);
                    xpAmount = (xpAmount - 524287);
                }while ((xpAmount >= 524287));
            }

            libGame_gf_GrantXPToPlayer(xpAmount, i, 0);
            libGame_gf_ScoreValuesRecordXPContributionForPlayer(i, xpAmount, true);
        }
    } else if (chatMessage == "hideui") {
        libHRGE_SetDialogVisible(libHRGE_dialogInfo, !DialogIsVisible(libHRGE_dialogInfo, libHRGE_player));
        libHRGE_SetDialogVisible(libHRGE_dialogControls, !DialogIsVisible(libHRGE_dialogControls, libHRGE_player));
    } else if (chatMessage == "test") {
        libHRGE_DisplayDebugMessage("Running test command...");
    } 
    return true;
}
