    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].icon, c_anchorTop, offsetX + libHRGE_affixItemIconOffsetX, offsetY + libHRGE_affixItemIconOffsetY);
    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].iconOverlay, c_anchorTop, offsetX + libHRGE_affixItemIconOverlayOffsetX, offsetY + libHRGE_affixItemIconOverlayOffsetY);
