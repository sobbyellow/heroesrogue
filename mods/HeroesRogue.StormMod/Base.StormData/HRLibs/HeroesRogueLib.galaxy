text libHRGE_GetAffixTitleLabel() {
    int rarity = libHRGE_currentQueue.rarity;
    bool curse = libHRGE_currentQueue.curse;
    if (rarity == libHRGE_rarityStarter) {
        return StringExternal("Label/Name/PickAffixStarter");
    } else if (rarity == libHRGE_rarityMythic) {
        return StringExternal("Label/Name/PickAffixCurseMythic");
    } else if (rarity == libHRGE_rarityMilestone) {
        return StringExternal("Label/Name/PickAffixMilestone");
    } else if (curse) {
        return StringExternal("Label/Name/PickAffixCurse");
    }
    return StringExternal("Label/Name/PickAffix");
