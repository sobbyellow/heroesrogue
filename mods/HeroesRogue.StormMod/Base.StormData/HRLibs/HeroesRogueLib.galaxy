bool libHRGE_MapInitLoadBankTrigger_Func (bool testConds, bool runActions) {
    
    libHRGE_MigrateBank();
    libHRGE_LoadBankSettings();
    libHRGE_LoadBankAchievements();
    libHRGE_LoadBank();

    return true;
}
void libHRGE_MapInitLoadBankTrigger_Init () {
    libHRGE_MapInitLoadBankTrigger = TriggerCreate("libHRGE_MapInitLoadBankTrigger_Func");
}

bool libHRGE_MapInitTrigger_Func (bool testConds, bool runActions) {
    int i;
    string instance;
    int count;
    
    SetTalentsEnabled(false);
    libHRGE_ShowTalent("DoNothing", false);
    libHRGE_ShowTalent("DoNothing4", false);
    libHRGE_ShowTalent("DoNothing7", false);
    libHRGE_ShowTalent("DoNothing10", false);
    libHRGE_ShowTalent("DoNothing13", false);
    libHRGE_ShowTalent("DoNothing16", false);
    libHRGE_ShowTalent("DoNothing20", false);

    libHRGE_DisplayDebugMessage("HeroesRogue v" + libHRGE_version);
    if (libHRGE_debug_enableTryMeMode2 || libHRGE_debug_enableCheatCommands || libHRGE_debug_disableHeroSelection ||
    libHRGE_debug_enableDebugLogging || libHRGE_debug_ignoreMap || libHRGE_debug_disablePausing || libHRGE_debug_disableAffixQueue) {
        libHRGE_DisplayChatMessage(StringExternal("Message/DebugEnabled"));
    }

    TriggerExecute(libHRGE_MapInitLoadBankTrigger, true, true);
    TriggerExecute(libHRGE_SpeedUpTrigger, true, false);
    libHRGE_currentRun += 1;
    libHRGE_UpdateInfoDialog();

    if (!libHRGE_debug_ignoreMap && libHRGE_map != libHRGE_GetCurrentMapPathIndex()) {
        GameSetNextMap(libHRGE_GetMapPathFromIndex(libHRGE_map));
        KickFromGame(PlayerGroupAll());
        return true;
    }

    libHRGE_SetupAffixes();
    
    if (libHRGE_playerSelectedHero == 0 && !libHRGE_debug_disableHeroSelection) {
        libGame_gv_pickingHeroesCallback = libHRGE_CurateHeroesTrigger;
    } else {
        libGame_gv_pickingHeroesCallback = libHRGE_HeroSelectionTrigger;
    }

    if (libHRGE_currentRun == 1) {
        libHRGE_rerolls += libHRGE_rerollsStart;
        libHRGE_rerollsCurse += libHRGE_rerollsStart;
        libHRGE_bans += libHRGE_bansStart;
    } else {
        libHRGE_rerolls += libHRGE_rerollsPerGame;
        libHRGE_rerollsCurse += libHRGE_rerollsPerGame;
        libHRGE_bans += libHRGE_bansPerGame;
    }

    while (libGame_gv_players[libHRGE_player].lv_playerStatus != libGame_ge_PlayerStatusStorm_Playing) {
        libHRGE_Wait(0.0625, c_timeGame);
    }

    if (libCore_gv_mAPMapStringID == "TowersOfDoom") {
        UnitBehaviorAdd(libGame_gv_teams[libHRGE_teamOrderIndex].lv_core, "TowersOfDoomMax1DamageClampBehavior", libGame_gv_teams[libHRGE_teamOrderIndex].lv_core, 1);
        UnitBehaviorAdd(libGame_gv_teams[libHRGE_teamChaosIndex].lv_core, "TowersOfDoomMax1DamageClampBehavior", libGame_gv_teams[libHRGE_teamChaosIndex].lv_core, 1);

    }
    libHRGE_DisplayDebugMessage("Map initialization complete. Map loaded: " + libCore_gv_mAPMapStringID + " (Map index: " + IntToString(libHRGE_map) + ")");
    libHRGE_DisplayDebugMessage("Total amount of boons & curses: " + IntToString(UserDataInstanceCount(libHRGE_affixUserData)));

    libHRGE_Wait(libHRGE_gameStartDelay, c_timeGame);

    libHRGE_ResolveImmediateTriggers();

    for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
        count = libHRGE_GetAffixCount(libHRGE_GetAffixInstance(i));
        if (count > 0) {
            libHRGE_ApplyAffix(i, count);
        }
    }

    libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOwnedAffixesButton, true);
    libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOptionsButton, true);

    SetTalentsEnabled(true);
    
    libHRGE_mapInit = true;

    return true;
}
void libHRGE_MapInitTrigger_Init () {
    libHRGE_MapInitTrigger = TriggerCreate("libHRGE_MapInitTrigger_Func");
    TriggerAddEventMapInit(libHRGE_MapInitTrigger);
}

// ============================================================
// Hero selection
// ============================================================

bool libHRGE_CurateHeroesTrigger_Func (bool testConds, bool runActions) {
    int i;
    int role;
    int row;
    int[7] column;
    string hero;

    libHRGE_DisplayDebugMessage("Curating " + IntToString(libCore_gv_dataHeroesNumberOfHeroes) + " heroes...");

    for (i = 1; i <= libCore_gv_dataHeroesNumberOfHeroes; i += 1) {
        hero = DataTableGetString(true, ("HeroIndex_" + IntToString(i)));
        role = CatalogFieldValueGetAsInt(c_gameCatalogHero, hero, "ExpandedRole", c_playerAny);
        
        if (role == c_expandedRoleTank) {
            row = libPBU2_ge_CurateHeroSelectionRole_Tank;
        } else if (role == c_expandedRoleBruiser) {
            row = libPBU2_ge_CurateHeroSelectionRole_Bruiser;
        } else if (role == c_expandedRoleRangedAssassin) {
            if (column[libPBU2_ge_CurateHeroSelectionRole_RangedAssassin1] >= libPBU2_gv_curateHeroSelectionUIRoleHeroCountCol_C) {
                row = libPBU2_ge_CurateHeroSelectionRole_RangedAssassin2;
            } else {
                row = libPBU2_ge_CurateHeroSelectionRole_RangedAssassin1;
            }
        } else if (role == c_expandedRoleMeleeAssassin || role == c_expandedRoleSupport) {
            row = libPBU2_ge_CurateHeroSelectionRole_MeleeAssassin;
        } else if (role == c_expandedRoleHealer) {
            row = libPBU2_ge_CurateHeroSelectionRole_Healer;
        } else {
            continue;
        }
        column[row] += 1;
        libPBU2_gv_curateHeroSelections[row][column[row]] = hero;
        if (libHRGE_goldenHero[i]) {
            libPBU2_gv_curateHeroSelectionUI.heroGolden[row][column[row]] = true;
        }
    }

    libPBU2_gf_DisplayCurateHSUI();

    if (libHRGE_difficulty != 0) {
        libPBU2_SetDifficulty(libHRGE_difficulty);
    }

    return true;
}
void libHRGE_CurateHeroesTrigger_Init () {
    libHRGE_CurateHeroesTrigger = TriggerCreate("libHRGE_CurateHeroesTrigger_Func");
}

