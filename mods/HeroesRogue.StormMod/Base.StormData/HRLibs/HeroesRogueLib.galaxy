// ============================================================
// Lost Vikings - Sync behaviors on Longboat Raid unit
// ============================================================
bool libHRGE_LostVikingsRaidboatTrigger_Func (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int player = UnitGetOwner(createdUnit);
    unitgroup heroGroup = libGame_gv_players[player].lv_heroUnitGroup;
    int heroGroupCount = UnitGroupCount(heroGroup, c_unitCountAll);
    unit heroUnit;
    if (testConds) {
        if (UnitGetType(createdUnit) != "LongboatRaidBoat") {
            return false;
        }
    }
    
    libHRGE_Wait(0.0625, c_timeGame);
    libHRGE_SyncBehaviors(libGame_gv_players[player].lv_heroUnit, createdUnit);
    for (;; heroGroupCount -= 1) {
        if (heroGroupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(heroGroup, heroGroupCount);
        libHRGE_DisplayDebugMessage(UnitGetType(heroUnit));
        if (UnitGetType(heroUnit) != "HeroLostVikingsController") {
            libHRGE_DisplayDebugMessage("Syncing " + UnitGetType(heroUnit) + " behaviors with " + UnitGetType(createdUnit));
            libHRGE_SyncBehaviors(heroUnit, createdUnit);
            break;
        }
    }
    return true;
}

void libHRGE_LostVikingsTriggers_Init() {
    libHRGE_LostVikingsRaidboatTrigger = TriggerCreate("libHRGE_LostVikingsRaidboatTrigger_Func");
    TriggerAddEventUnitCreated(libHRGE_LostVikingsRaidboatTrigger, null, null, null);
}

// ============================================================
// Wait function
// ============================================================
void libHRGE_Wait(fixed duration, int inTimeType) {
    fixed elapsed = 0.0;
    while (elapsed < duration) {
        if (libHRGE_gamePaused) {
            Wait(0.0625, inTimeType);
        } else {
            Wait(0.0625, inTimeType);
            elapsed += 0.0625;
        }
    }
}

bool libHRGE_GateIsOpen() {
    if (TimerGetElapsed(libGame_gv_openTheGatesTimer) > 0.0 && TimerGetRemaining(libGame_gv_openTheGatesTimer) <= 0.0) {
        return true;
    }
    return false;
}

bool libHRGE_TimerFinished(timer checkTimer) {
    if (TimerGetElapsed(checkTimer) > 0.0 && TimerGetRemaining(checkTimer) <= 0.0) {
        return true;
    }
    return false;
}
void libHRGE_PauseTimerIfRunning(timer timerToPause, bool pause) {
    if (timerToPause == null) { return; }
    if (TimerGetRemaining(timerToPause) > 0.0) {
        TimerPause(timerToPause, pause);
    }
}

string libHRGE_IntToTimeString(int time) {
    int hours = time / 3600;
    int minutes = (time % 3600) / 60;
    int seconds = time % 60;
    string hoursText;
    string minutesText;
    string secondsText;
    if (hours < 10) {
        hoursText = "0" + IntToString(hours);
    } else {
        hoursText = IntToString(hours);
    }
    if (minutes < 10) {
        minutesText = "0" + IntToString(minutes);
    } else {
        minutesText = IntToString(minutes);
    }
    if (seconds < 10) {
        secondsText = "0" + IntToString(seconds);
    } else {
        secondsText = IntToString(seconds);
    }

    return hoursText + ":" + minutesText + ":" + secondsText;
}
text libHRGE_IntToTimeText(int time) {
    return StringToText(libHRGE_IntToTimeString(time));
}

// ============================================================
// Pause system
// ============================================================
void libHRGE_Pause(bool pause) {
    int i;
    string hero;
    string instance;

    if (libHRGE_debug_disablePausing || (!pause && libHRGE_AnyDialogVisible())) { return; }

    libHRGE_gamePaused = pause;
    libGame_paused = pause;

    if (pause) {
        libStEx_gf_FreezeUnfreezeAllUnits(libStEx_ge_FreezeOptions_Freeze); 
        GameSetGlobalTimeScale(0);
    } else {
        libStEx_gf_FreezeUnfreezeAllUnits(libStEx_ge_FreezeOptions_Unfrezze); 
        GameSetGlobalTimeScale(1);
    }

    libNtve_gf_MakeUnitUncommandable(libGame_gv_players[libHRGE_player].lv_heroUnit, pause);
    SetTalentsEnabled(!pause);

    libHRGE_PauseTimerIfRunning(libGame_gv_openTheGatesTimer, pause); // Gate timer
    libHRGE_PauseTimerIfRunning(libGame_gv_scalingTimer, pause); // Minion stats scaling timer
    libHRGE_PauseTimerIfRunning(libGame_gv_totalTime, pause);

    // Pause all primary affix timers
    for (i = 1; i <= UserDataInstanceCount(libHRGE_affixUserData); i += 1) {
        instance = libHRGE_GetAffixInstance(i);
        if (libHRGE_GetAffixCount(instance) > 0 && UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTriggerCount, 1) > 0) {
            libHRGE_PauseTimerIfRunning(libHRGE_GetAffixPrimaryTimer(instance), pause);
        }
    }

    // Mercenary spawn/respawn timers
    for (i = 1; i <= libMapM_gv_jungleNumberOfCreepCamps; i += 1) {
        libHRGE_PauseTimerIfRunning(libMapM_gv_jungleCreepCamps[i].lv_stateCreepBirthTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_jungleCreepCamps[i].lv_stateCreepRespawnTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_jungleCreepCamps[i].lv_stateCreepActiveTimer, pause);
    }
    
    for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
        hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[i].lv_heroIndex);
        // Player respawn timers
        libHRGE_PauseTimerIfRunning(libGame_gv_players[i].lv_respawnTimer, pause);
        if (hero == "LostVikings") {
            libHRGE_PauseTimerIfRunning(libGDHL_gv_lostVikingsPlayer[i].lv_erikDeathTimer, pause);
            libHRGE_PauseTimerIfRunning(libGDHL_gv_lostVikingsPlayer[i].lv_olafDeathTimer, pause);
            libHRGE_PauseTimerIfRunning(libGDHL_gv_lostVikingsPlayer[i].lv_baleogDeathTimer, pause);
            libHRGE_PauseTimerIfRunning(libGDHL_gv_lostVikingsPlayer[i].lv_checkpointReachedCarinRespawnTimer, pause);
        } else if (hero == "Rexxar") {
            libHRGE_PauseTimerIfRunning(libGDHL_gv_mishaDeathTimer[i], pause);
        }
        libHRGE_PauseTimerIfRunning(libGame_gv_players[i].lv_respawnSoundCueTimer, pause);
        libHRGE_PauseTimerIfRunning(libGame_gv_players[i].lv_multikillTimer, pause);
    }

    // Map specific pause logic
    if (libCore_gv_mAPMapStringID == "Volskaya" && libHRGE_PauseVLSKTrigger != null) {
        TriggerExecute(libHRGE_PauseVLSKTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "CursedHollow") {
        libMapM_gf_PauseUnpauseCurseHollowTimers(pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMRavenObjectivePreviewTimer, pause);
    } else if (libCore_gv_mAPMapStringID == "Shrines" && libHRGE_PauseMSHETrigger != null) {
        TriggerExecute(libHRGE_PauseMSHETrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "Crypts" && libHRGE_PauseMSOCTrigger != null) {
        TriggerExecute(libHRGE_PauseMSOCTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "HauntedMines" && libHRGE_PauseMHTMTrigger != null) {
        TriggerExecute(libHRGE_PauseMHTMTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "TowersOfDoom" && libHRGE_PauseMTODTrigger != null) {
        TriggerExecute(libHRGE_PauseMTODTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "HauntedWoods" && libHRGE_PauseGRDNTrigger != null) {
        TriggerExecute(libHRGE_PauseGRDNTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "BlackheartsBay" && libHRGE_PauseBBAYTrigger != null) {
        TriggerExecute(libHRGE_PauseBBAYTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "ControlPoints" && libHRGE_PauseMLCPTrigger != null) {
        TriggerExecute(libHRGE_PauseMLCPTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "DragonShire") {
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMGardensDragonDragonTowerStartTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMGardensDragonDragonTowerRespawnTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMGardensDragonDragonTowerWarningTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMGardensDragonDragonStatueActiveReminderTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMGardensDragonDragonTowerGoalActivationTimer, pause);
        libHRGE_PauseTimerIfRunning(libMapM_gv_mMGardensDragonDragonKnightLifeTimer, pause);
    } else if (libCore_gv_mAPMapStringID == "Hanamura" && libHRGE_PauseMHMUTrigger != null) {
        TriggerExecute(libHRGE_PauseMHMUTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "BattlefieldOfEternity" && libHRGE_PauseMLBDTrigger != null) {
        TriggerExecute(libHRGE_PauseMLBDTrigger, true, false);
    } else if (libCore_gv_mAPMapStringID == "BraxisHoldout" && libHRGE_PauseSCHOTrigger != null) {
        TriggerExecute(libHRGE_PauseSCHOTrigger, true, false);
    }
    libHRGE_SendPausedEvent(pause);
}
void libHRGE_PauseUnpause() {
    libHRGE_Pause(!libHRGE_gamePaused);
}

