    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].selectButton, c_anchorTop, offsetX + libHRGE_affixItemSelectButtonOffsetX, offsetY + libHRGE_affixItemSelectButtonOffsetY);
