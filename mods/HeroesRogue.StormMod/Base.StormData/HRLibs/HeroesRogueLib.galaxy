    libHRGE_ChenStormEarthFireTrigger = TriggerCreate("libHRGE_ChenStormEarthFireTrigger_Func");
    TriggerAddEventPlayerEffectUsed(libHRGE_ChenStormEarthFireTrigger, c_playerAny, "ChenStormEarthFireCreateFinishSet");
}

