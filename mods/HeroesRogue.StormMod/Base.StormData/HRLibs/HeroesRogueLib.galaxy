string libHRGE_GetAffixExcluded(string instance, int index) {
    return UserDataGetUserInstance(libHRGE_affixUserData, instance, libHRGE_affixUserAffixesExcluded, index);
}
bool libHRGE_AffixIsExcluded(string instance) {
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserAffixesExcludedCount, 1);
    string checkInstance;
    int i;

    for (i = 1; i <= fieldCount; i += 1) {
        checkInstance = libHRGE_GetAffixExcluded(instance, i);
        if (libHRGE_GetAffixCount(checkInstance) > 0) {
            return true;
        }
    }
    return false;
}

string libHRGE_GetAffixRequired(string instance, int index) {
    return UserDataGetUserInstance(libHRGE_affixUserData, instance, libHRGE_affixUserAffixesRequired, index);
}
bool libHRGE_AffixPrerequisitesNotMet(string instance) {
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserAffixesRequiredCount, 1);
    int i;
    string checkInstance;
    int count;
    int max;
    bool requiresMaxStacks = libHRGE_AffixRequiresMaxStacks(instance);
    int requiredAffixesMet = fieldCount;

    for (i = 1; i <= fieldCount; i += 1) {
        checkInstance = libHRGE_GetAffixRequired(instance, i);
        count = libHRGE_GetAffixCount(checkInstance);
        max = libHRGE_GetAffixMax(checkInstance);
        if (requiresMaxStacks && max != 0) {
            if (count < max) {
                requiredAffixesMet -= 1;
            }
        } else if (count < 1) {
            requiredAffixesMet -= 1;
        }
    }
    if (requiredAffixesMet < fieldCount) {
        return true;
    }
    return false;
}

string libHRGE_GetAffixHero(string instance) {
    return UserDataGetString(libHRGE_affixUserData, instance, libHRGE_affixUserHeroSpecific, 1);
}
bool libHRGE_AffixIsHeroExclusive(string instance) {
    string hero = libHRGE_GetAffixHero(instance);
    if (hero != "" && hero != null) {
        return true;
    }
    return false;
}

string libHRGE_GetAffixHeroTags(string instance, int index) {
    return UserDataGetString(libHRGE_affixUserData, instance, libHRGE_affixUserHeroTags, index);
}

string libHRGE_GetAffixExcludedHero(string instance, int index) {
    return UserDataGetString(libHRGE_affixUserData, instance, libHRGE_affixUserHeroesExcluded, index);
}

bool libHRGE_HeroIsMeleeAndRanged(string hero) {
    if (hero == "Greymane" || hero == "DVa" || hero == "Gall" || libHRGE_heroCountsAsMeleeAndRanged) {
        return true;
    }
    return false;
}
bool libHRGE_HeroIsMelee(string hero) {
    int melee = CatalogFieldValueGetAsInt(c_gameCatalogHero, hero, "Melee", c_playerAny);
    if (libHRGE_IntToBoolean(melee) || libHRGE_HeroIsMeleeAndRanged(hero)) {
        return true;
    }
    return false;
}
bool libHRGE_HeroIsRanged(string hero) {
    int melee = CatalogFieldValueGetAsInt(c_gameCatalogHero, hero, "Melee", c_playerAny);
    if (!libHRGE_IntToBoolean(melee) || libHRGE_HeroIsMeleeAndRanged(hero)) {
        return true;
    }
    return false;
}
bool libHRGE_HeroUsesRegularMount(string hero) {
    int mount = CatalogFieldValueGetAsInt(c_gameCatalogHero, hero, "Flags[UsesMount]", c_playerAny);
    if (libHRGE_IntToBoolean(mount)) {
        return true;
    }
    return false;
}
bool libHRGE_HeroIsGolden(string hero) {
    int heroIndex = libCore_gf_GetIndexFromHero(hero);
    if (libHRGE_goldenHero[heroIndex]) {
        return true;
    }
    return false;
}
bool libHRGE_HeroFailsTag(string tag, string hero) {
    string role = CatalogFieldValueGet(c_gameCatalogHero, hero, "ExpandedRole", c_playerAny);
    if (tag == libHRGE_affixUserTagMount) {
        return !libHRGE_HeroUsesRegularMount(hero);
    } else if (tag == libHRGE_affixUserTagMana) {
        return UnitHasBehavior2(libHRGE_GetPlayerHeroUnit(libHRGE_player), "NotManaUserDummy");
    } else if (tag == libHRGE_affixUserTagMelee) {
        return !libHRGE_HeroIsMelee(hero);
    } else if (tag == libHRGE_affixUserTagStarter) {
        return !libHRGE_HeroIsGolden(hero);
    } else if (tag == libHRGE_affixUserTagTank) {
        return role != "Tank";
    } else if (tag == libHRGE_affixUserTagBruiser) {
        return role != "Bruiser";
    } else if (tag == libHRGE_affixUserTagRangedAssassin) {
        return role != "RangedAssassin";
    } else if (tag == libHRGE_affixUserTagMeleeAssassin) {
        return role != "MeleeAssassin";
    } else if (tag == libHRGE_affixUserTagHealer) {
        return role != "Healer";
    } else if (tag == libHRGE_affixUserTagSupport) {
        return role != "Support";
    }
    return false;
}

bool libHRGE_IsHeroExcludedForAffix(string instance) {
    int excludedCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserHeroesExcludedCount, 1);
    int tagsCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserHeroTagsCount, 1);
    string hero = libHRGE_GetPlayerHero(libHRGE_player);
    string heroSpecific = libHRGE_GetAffixHero(instance);
    string tag;
    int i;
    if (heroSpecific != "" && heroSpecific != null) {
        if (heroSpecific == hero) {
            return false;
        } else {
            return true;
        }
    }
    for (i = 1; i <= excludedCount; i += 1) {
        if (libHRGE_GetAffixExcludedHero(instance, i) == hero) {
            return true;
        }
    }
    for (i = 1; i <= tagsCount; i += 1) {
        tag = StringCase(libHRGE_GetAffixHeroTags(instance, i), true);
        if (tag == "!" + libHRGE_affixUserTagAll) {
            return true;
        } else if (StringSub(tag, 1, 1) == "!" && !libHRGE_HeroFailsTag(StringSub(tag, 2, StringLength(tag)), hero)) {
            return true;
        } else if (libHRGE_HeroFailsTag(tag, hero)) {
            return true;
        }
    }
    return false;
}

