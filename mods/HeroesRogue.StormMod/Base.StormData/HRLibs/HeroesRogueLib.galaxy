    int i;
    if (mapSpecific != "" && mapSpecific != null) {
        if (mapSpecific == libCore_gv_mAPMapStringID) {
            return false;
        } else {
            return true;
        }
    }
    for (i = 1; i <= fieldCount; i += 1) {
        if (libHRGE_GetAffixExcludedMaps(instance, i) == libCore_gv_mAPMapStringID) {
            return true;
        }
    }
    return false;
}

