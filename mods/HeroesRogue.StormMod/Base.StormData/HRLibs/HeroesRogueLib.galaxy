bool libHRGE_AnyDialogVisible() {
    if (libHRGE_IsAffixSelectionDialogVisible() || libHRGE_IsOwnedAffixesDialogVisible() || libHRGE_IsOptionsDialogVisible() ||
    libHRGE_IsGameoverDialogVisible() || libHRGE_IsAchievementsDialogVisible()) {
        return true;
    }
    return false;
}

