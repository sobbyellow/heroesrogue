bool libHRGE_AffixIsEnabled(string instance) {
    return libHRGE_IntToBoolean(UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserEnabled, 1));
}
void libHRGE_SetAffixEnabled(string instance, bool enabled) {
