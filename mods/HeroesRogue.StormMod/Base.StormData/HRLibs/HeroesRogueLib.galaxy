int libHRGE_GetAchievementId(string achievementName) {
    int i;
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        if (libHRGE_achievements[i].name == achievementName) {
            return i;
        }
    }
    return 0;
}

void libHRGE_ResetAllAchievements() {
    int i;
    libHRGE_ResetBankAchievements();
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        libHRGE_achievements[i].earned = false;
        libHRGE_achievements[i].difficulty = 0;
    }
    if (libHRGE_IsAchievementsDialogVisible()) {
        libHRGE_UpdateAchievementsDialog();
    }
    libHRGE_DisplayChatMessage(StringExternal("Message/AchievementsReset"));
}

void libHRGE_GrantAchievement(int achievement) {
    if (libHRGE_achievements[achievement].difficulty >= libHRGE_difficulty) {
        return;
    }
    libHRGE_achievements[achievement].earned = true;
    libHRGE_achievements[achievement].difficulty = libHRGE_difficulty;
    libHRGE_achievements[achievement].round = libHRGE_currentRun;
    libHRGE_achievements[achievement].time = FixedToInt(TimerGetElapsed(libGame_gv_gameTimer));
    TextExpressionSetToken("Param/Expression/AchievementEarned", "A", StringExternal("Achievement/Name/" + libHRGE_achievements[achievement].name));
    TextExpressionSetToken("Param/Expression/AchievementEarned", "B", libHRGE_GetDifficultyLabel(libHRGE_achievements[achievement].difficulty));
    libHRGE_DisplayChatMessage(TextExpressionAssemble("Param/Expression/AchievementEarned"));
    libHRGE_SaveBankAchievements();
}

bool libHRGE_AchievementHasRoundAndTimeNumber(int achievement) {
    int type = libHRGE_achievements[achievement].type;
    if (type == libHRGE_achievementTypeWinOnHero || type == libHRGE_achievementTypeWinNoDeaths || type == libHRGE_achievementTypeWinNoObjLost ||
    type == libHRGE_achievementTypeWinNoRerolls || type == libHRGE_achievementTypeWinNoBans || type == libHRGE_achievementTypeWinTimer || type == libHRGE_achievementTypeWinRound) {
        return true;
    }
    return false;
}
void libHRGE_UpdateAchievementRoundNumber(int achievement) {
    if (libHRGE_achievements[achievement].difficulty < libHRGE_difficulty || !libHRGE_achievements[achievement].earned) {
        return;
    }
    libHRGE_achievements[achievement].round = libHRGE_currentRun;
    libHRGE_SaveBankAchievements();
}
void libHRGE_UpdateAchievementTime(int achievement) {
    if (libHRGE_achievements[achievement].difficulty < libHRGE_difficulty || !libHRGE_achievements[achievement].earned) {
        return;
    }
    libHRGE_achievements[achievement].time = FixedToInt(TimerGetElapsed(libGame_gv_gameTimer));
    libHRGE_SaveBankAchievements();
}

void libHRGE_EvaluateAchievement(int achievement) {
    if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinOnHero && libHRGE_achievements[achievement].hero == libGame_gv_players[libHRGE_player].lv_heroIndex) {
        if (libGame_winningTeam == libHRGE_teamOrderIndex && libHRGE_currentRun == libHRGE_winningRound) {
            libHRGE_GrantAchievement(achievement);
        }
    } else if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinNoDeaths && libGame_winningTeam == libHRGE_teamOrderIndex &&
        libHRGE_currentRun == libHRGE_winningRound && (libHRGE_BankGetStats("Deaths") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_deaths) <= 0)) {
        libHRGE_GrantAchievement(achievement);
    } else if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinNoObjLost && libGame_winningTeam == libHRGE_teamOrderIndex &&
        libHRGE_currentRun == libHRGE_winningRound && (libHRGE_BankGetStats("ObjectivesLost") + libHRGE_objectivesLostThisGame) <= 0) {
        libHRGE_GrantAchievement(achievement);
    } else if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinNoRerolls && libGame_winningTeam == libHRGE_teamOrderIndex &&
        libHRGE_currentRun == libHRGE_winningRound && (libHRGE_BankGetStats("RerollsUsed") + libHRGE_rerollsUsed + libHRGE_BankGetStats("RerollsCurseUsed") + libHRGE_rerollsCurseUsed) <= 0) {
        libHRGE_GrantAchievement(achievement);
    } else if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinNoBans && libGame_winningTeam == libHRGE_teamOrderIndex &&
        libHRGE_currentRun == libHRGE_winningRound && (libHRGE_BankGetStats("BansUsed") + libHRGE_bansUsed) <= 0) {
        libHRGE_GrantAchievement(achievement);
    } else if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinTimer && libGame_winningTeam == libHRGE_teamOrderIndex &&
        libHRGE_currentRun == libHRGE_winningRound && (libHRGE_BankGetStats("GameTime") + FixedToInt(TimerGetElapsed(libGame_gv_gameTimer))) <= libHRGE_achievements[achievement].timeRequired) {
        libHRGE_GrantAchievement(achievement);
    } else if (libHRGE_achievements[achievement].type == libHRGE_achievementTypeWinRound && libGame_winningTeam == libHRGE_teamOrderIndex &&
        libHRGE_currentRun >= libHRGE_achievements[achievement].roundRequired) {
        libHRGE_GrantAchievement(achievement);
    }
    if (libHRGE_AchievementHasRoundAndTimeNumber(achievement)) {
        if (libHRGE_achievements[achievement].round < libHRGE_currentRun) {
            libHRGE_UpdateAchievementRoundNumber(achievement);
        }
        if (libHRGE_achievements[achievement].time > FixedToInt(TimerGetElapsed(libGame_gv_gameTimer))) {
            libHRGE_UpdateAchievementTime(achievement);
        }
    }
}

void libHRGE_EvaluateAllAchievements() {
    int i;
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        libHRGE_EvaluateAchievement(i);
    }
}
int libHRGE_LastRegisteredAchievement() {
    return libHRGE_lastRegisteredAchievement;
}

int libHRGE_RegisterAchievement(string name, int achievementType) {
    if (libHRGE_achievementsIndex >= libHRGE_maxAchievements) {
        return 0;
    }
    libHRGE_achievementsIndex += 1;
    libHRGE_achievements[libHRGE_achievementsIndex].name = name;
    libHRGE_achievements[libHRGE_achievementsIndex].type = achievementType;
    libHRGE_achievements[libHRGE_achievementsIndex].icon = "Assets/Textures/Achievements/" + name + ".dds";
    libHRGE_lastRegisteredAchievement = libHRGE_achievementsIndex;
    return libHRGE_achievementsIndex;
}

bool libHRGE_InitAchievements_completed = false;
void libHRGE_InitAchievements() {
    int i;
    int achievement;
    if (libHRGE_InitAchievements_completed) { return; }
    for (i = 1; i <= libHRGE_maxHeroes; i += 1) {
        libHRGE_RegisterAchievement(libHRGE_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(i) + ",HyperlinkId"), libHRGE_achievementTypeWinOnHero);
        libHRGE_achievements[libHRGE_LastRegisteredAchievement()].hero = i;
    }
    libHRGE_RegisterAchievement("Deathless", libHRGE_achievementTypeWinNoDeaths);
    libHRGE_RegisterAchievement("Objective", libHRGE_achievementTypeWinNoObjLost);
    libHRGE_RegisterAchievement("NoRerolls", libHRGE_achievementTypeWinNoRerolls);
    libHRGE_RegisterAchievement("NoBans", libHRGE_achievementTypeWinNoBans);
    libHRGE_RegisterAchievement("Speedrun1", libHRGE_achievementTypeWinTimer);
    libHRGE_achievements[libHRGE_LastRegisteredAchievement()].timeRequired = 3600;
    libHRGE_RegisterAchievement("Speedrun2", libHRGE_achievementTypeWinTimer);
    libHRGE_achievements[libHRGE_LastRegisteredAchievement()].timeRequired = 7200;
    libHRGE_RegisterAchievement("Round20", libHRGE_achievementTypeWinRound);
    libHRGE_achievements[libHRGE_LastRegisteredAchievement()].roundRequired = 20;
    libHRGE_RegisterAchievement("Round30", libHRGE_achievementTypeWinRound);
    libHRGE_achievements[libHRGE_LastRegisteredAchievement()].roundRequired = 30;
    libHRGE_RegisterAchievement("Round40", libHRGE_achievementTypeWinRound);
    libHRGE_achievements[libHRGE_LastRegisteredAchievement()].roundRequired = 40;

    libHRGE_InitAchievements_completed = true;
}

