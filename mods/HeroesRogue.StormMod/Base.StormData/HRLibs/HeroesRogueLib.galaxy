string libHRGE_GetAffixInstance(int affix) {
    return UserDataInstance(libHRGE_affixUserData, affix);
}
int libHRGE_GetAffixIndex(string instance) {
    return UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserIndex, 1);
}
int libHRGE_GetAffixFieldCount(string affixInstance, string field) {
    int fieldCount = UserDataFieldValueCount(libHRGE_affixUserData, field);
    int fieldType = UserDataFieldType(libHRGE_affixUserData, field);
    int i;
    int totalCount;

    for (i = 1; i <= fieldCount; i += 1) {
        if ((fieldType == c_userTypeUser && UserDataGetUserInstance(libHRGE_affixUserData, affixInstance, field, i) != "") ||
            (fieldType == c_userTypeString && UserDataGetString(libHRGE_affixUserData, affixInstance, field, i) != "")) {
            totalCount += 1;            
        }
    }
    return totalCount;
}

