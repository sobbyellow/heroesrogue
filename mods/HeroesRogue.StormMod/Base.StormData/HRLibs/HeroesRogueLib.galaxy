    libHRGE_dialogAffixSelection.items[index].iconOverlay = libHRGE_CreateDialogControlImage(libHRGE_dialogAffixSelection.dialog, null, libHRGE_affixItemIconOverlayWidth, libHRGE_affixItemIconOverlayHeight, c_anchorTop, offsetX + libHRGE_affixItemIconOverlayOffsetX, offsetY + libHRGE_affixItemIconOverlayOffsetY, null);
    
    libHRGE_dialogAffixSelection.items[index].nameLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogAffixSelection.dialog, StringToText("Affix" + IntToString(index)), "Storm_Tutorial_Small_Centered", libHRGE_affixItemNameWidth, libHRGE_affixItemNameHeight, c_anchorTop, offsetX + libHRGE_affixItemNameOffsetX, offsetY + libHRGE_affixItemNameOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogAffixSelection.items[index].tooltipLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogAffixSelection.dialog, null, "TalentDescription", libHRGE_affixItemTooltipWidth, libHRGE_affixItemTooltipHeight, c_anchorTop, offsetX + libHRGE_affixItemTooltipOffsetX, offsetY + libHRGE_affixItemTooltipOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogAffixSelection.items[index].rarityLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogAffixSelection.dialog, null, "Storm_MapMechanic_MechanicCounterCentered_Small", libHRGE_affixItemRarityWidth, libHRGE_affixItemRarityHeight, c_anchorTop, offsetX + libHRGE_affixItemRarityOffsetX, offsetY + libHRGE_affixItemRarityOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
   
    libHRGE_dialogAffixSelection.items[index].banButton = libHRGE_CreateDialogControlButton(libHRGE_dialogAffixSelection.dialog);
    libHRGE_SetDialogControlColor(libHRGE_dialogAffixSelection.items[index].banButton, Color(100, 50, 50));
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.items[index].banButton, StringExternal("Button/Name/BanAffix"));
    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].banButton, c_anchorTop, offsetX + libHRGE_affixItemBanButtonOffsetX, offsetY + libHRGE_affixItemBanButtonOffsetY);
    libHRGE_SetDialogControlSize(libHRGE_dialogAffixSelection.items[index].banButton, libHRGE_affixItemBanButtonWidth, libHRGE_affixItemBanButtonHeight);

    libHRGE_dialogAffixSelection.items[index].talentPreview = libHRGE_CreateDialogControlImage(libHRGE_dialogAffixSelection.dialog, libHRGE_textureTalentsPreview, libHRGE_affixItemTalentPreviewWidth, libHRGE_affixItemTalentPreviewHeight, c_anchorTop, offsetX + libHRGE_affixItemTalentPreviewOffsetX, offsetY + libHRGE_affixItemTalentPreviewOffsetY, null);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].talentPreview, false);
    libHRGE_dialogAffixSelection.items[index].unlockPreview = libHRGE_CreateDialogControlImage(libHRGE_dialogAffixSelection.dialog, libHRGE_textureUnlocksPreview, libHRGE_affixItemUnlockPreviewWidth, libHRGE_affixItemUnlockPreviewHeight, c_anchorTop, offsetX + libHRGE_affixItemUnlockPreviewOffsetX, offsetY + libHRGE_affixItemUnlockPreviewOffsetY, null);
    libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.items[index].unlockPreview, false);
}

void libHRGE_CreateAffixSelectionDialog() {
    int i;
    int span = libHRGE_affixItemSpacing * (libHRGE_maxAffixSelection - 1);

    DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    libHRGE_dialogAffixSelection.dialog = DialogLastCreated();
    DialogSetFullscreen(libHRGE_dialogAffixSelection.dialog, true);
    DialogSetImageVisible(libHRGE_dialogAffixSelection.dialog, false);
    
    libHRGE_dialogAffixSelection.titleLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogAffixSelection.dialog, null, "Storm_Map_Large_Bold_Centered", libHRGE_affixSelectionTitleWidth, libHRGE_affixSelectionTitleHeight, c_anchorTop, libHRGE_affixSelectionTitleOffsetX, libHRGE_affixSelectionTitleOffsetY, ColorWithAlpha(0, 0, 0, 0), true);

    libHRGE_dialogAffixSelection.rerollButton = libHRGE_CreateDialogControlButton(libHRGE_dialogAffixSelection.dialog);
    libHRGE_SetDialogControlText(libHRGE_dialogAffixSelection.rerollButton, StringExternal("Button/Name/Reroll"));
    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.rerollButton, c_anchorTop, libHRGE_affixRerollButtonOffsetX, libHRGE_affixRerollButtonOffsetY);
    libHRGE_SetDialogControlSize(libHRGE_dialogAffixSelection.rerollButton, libHRGE_affixRerollButtonWidth, libHRGE_affixRerollButtonHeight);

    libHRGE_dialogAffixSelection.rerollLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogAffixSelection.dialog, null, "Storm_Tutorial_Small_Centered", libHRGE_affixRerollLabelWidth, libHRGE_affixRerollLabelHeight, c_anchorTop, libHRGE_affixRerollLabelOffsetX, libHRGE_affixRerollLabelOffsetY, ColorWithAlpha(0,0,0,0), false);
    libHRGE_dialogAffixSelection.banLabel = libHRGE_CreateDialogControlLabel(libHRGE_dialogAffixSelection.dialog, null, "Storm_Tutorial_Small_Centered", libHRGE_affixBanLabelWidth, libHRGE_affixBanLabelHeight, c_anchorTop, libHRGE_affixBanLabelOffsetX, libHRGE_affixBanLabelOffsetY, ColorWithAlpha(0,0,0,0), false);

    for (i = 1; i <= libHRGE_maxAffixSelection; i += 1) {
        libHRGE_CreateAffixSelectionDialogItem(i, -span / 2 + libHRGE_affixItemSpacing * (i - 1), libHRGE_affixItemOffsetY);
    }
}

