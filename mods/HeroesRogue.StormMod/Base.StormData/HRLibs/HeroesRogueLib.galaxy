bool libHRGE_DifficultyUnitCreated_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (libHRGE_difficulty <= libHRGE_difficultyHeroic) {
            return false;
        }
    }
    libHRGE_AddUnitBehaviorFilter(EventUnitCreatedUnit(), "AffixDifficultyBehavior", 1, libHRGE_filterDifficulty);
    return true;
}
bool libHRGE_DifficultyUnitChangeOwner_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (libHRGE_difficulty <= libHRGE_difficultyHeroic) {
            return false;
        }
    }
    libHRGE_UpdateUnitBehaviorFilter(EventUnit(), "AffixDifficultyBehavior", 1, libHRGE_filterDifficulty);
    return true;
}
void libHRGE_Difficulty_Init() {
    libHRGE_DifficultyUnitCreatedTrigger = TriggerCreate("libHRGE_DifficultyUnitCreated_Func");
    libHRGE_DifficultyUnitChangeOwner = TriggerCreate("libHRGE_DifficultyUnitChangeOwner_Func");
    TriggerAddEventUnitCreated(libHRGE_DifficultyUnitCreatedTrigger, null, null, null);
    TriggerAddEventUnitChangeOwner(libHRGE_DifficultyUnitChangeOwner, null);
}

void libHRGE_ApplyDifficulty () {
    fixed scaledModifier;
    string scaledModString;
    int i;

    if (libHRGE_difficulty == libHRGE_difficultyMythic) {
        libHRGE_mythicDifficultyXPModifier = libHRGE_mythicModifierXP * libHRGE_currentRun;
        libGame_xpModifier[libGame_gv_teamChaosIndex_C] += libHRGE_mythicDifficultyXPModifier;
        scaledModifier = MaxF(0, (libHRGE_mythicModifier + libHRGE_mythicModifierPerRound * libHRGE_currentRun) * libHRGE_currentRun);

        libHRGE_SetAffix(libHRGE_GetAffixIndex("DifficultyMythic"), 1);
        libHRGE_AddUnitBehaviorToAllFilter("AffixDifficultyBehavior", 1, libHRGE_filterDifficulty);

        if (libHRGE_currentRun > libHRGE_winningRound) {
            libHRGE_maxCurseSwapsFromObjectives = 0;
        }
    } else if (libHRGE_difficulty == libHRGE_difficultyHeroic) {
        libHRGE_heroicDifficultyXPModifier = libHRGE_heroicModifierXP * libHRGE_currentRun;
        libGame_xpModifier[libGame_gv_teamChaosIndex_C] += libHRGE_heroicDifficultyXPModifier;
        scaledModifier = MaxF(0, Pow((1 + libHRGE_heroicModifier), libHRGE_currentRun) - 1);
        libHRGE_SetAffix(libHRGE_GetAffixIndex("DifficultyHeroic"), 1);
    } else {
        libHRGE_SetAffix(libHRGE_GetAffixIndex("DifficultyNormal"), 1);
    }
    
    scaledModString = FixedToString(scaledModifier, c_fixedPrecisionAny);

    if (libHRGE_difficulty == libHRGE_difficultyHeroic || libHRGE_difficulty == libHRGE_difficultyMythic) {
        libHRGE_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.DamageDealtFraction[Ability]", scaledModString);
        libHRGE_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.DamageDealtFraction[Basic]", scaledModString);
        libHRGE_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Life]", scaledModString);
        libHRGE_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Life]", scaledModString);
        libHRGE_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Energy]", scaledModString);
        libHRGE_CatalogModifyForAllPlayers("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Energy]", scaledModString);
        for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
            if (UnitHasBehavior2(libGame_gv_players[i].lv_heroUnit, "NotManaUserDummy")) {
                libHRGE_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Energy]", i, "0");
                libHRGE_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Energy]", i, "0");
            }
            if (libGame_gf_TeamNumberOfPlayer(i) == libHRGE_teamOrderIndex) {
                libHRGE_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Life]", i, "0");
                libHRGE_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalMaxFractionArray[Energy]", i, "0");
                libHRGE_CatalogReferenceSet("Behavior,AffixDifficultyBehavior,Modification.VitalRegenMultiplier[Energy]", i, "0");
            } else {
                libHRGE_AddPlayerBehavior(i, "AffixDifficultyBehavior", 1, true);
            }
        }
    }
}

bool libHRGE_IsCurseLevel(int level) {
    return level == 4 || level == 7 || level == 10 || level == 13 || level == 16 || level == 20 || level == 24 || level == 27 || level == 30;
}
bool libHRGE_IsQueueAffixNextGameLevel(int level) {
    return level == 4 || level == 7 || level == 10;
}

bool libHRGE_BoonsCursesLevelUp_Func (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libHRGE_player && player != libHRGE_enemy) {
            return false;
        }
    }
    if (player == libHRGE_player) {
        if (level == 1) {
            libHRGE_Wait(libHRGE_gameStartDelay, c_timeGame);
            if ((libHRGE_currentRun - 1) % 2 == 0 && libHRGE_difficulty == libHRGE_difficultyMythic) {
                libHRGE_QueueMythicCurse(1);
            }
            if (libHRGE_currentRun == libHRGE_milestoneRound) {
                libHRGE_QueueBoon(libHRGE_rarityMilestone, 1, true, true);
                libHRGE_DisplayChatMessage(StringExternal("Message/MilestoneReached"));
            }
            if (libHRGE_currentRun <= 1) {
                libHRGE_QueueBoon(libHRGE_rarityStarter, 1, true, true);
            } else {
                if ((libHRGE_currentRun - 1) % 4 == 0) {
                    libHRGE_QueueBoon(libHRGE_rarityLegendary, 1, false, false);
                } else {
                    libHRGE_QueueBoon(libHRGE_rarityRare, 1, false, false);
                }
            }
            if (libHRGE_boonsQueued > 0) {
                libHRGE_DisplayChatMessage(StringExternal("Message/BoonNextGame" + IntToString(MinI(libHRGE_boonsQueued, 3))));
                libHRGE_QueueBoon(libHRGE_rarityCommon, libHRGE_boonsQueued, false, false);
                libHRGE_boonsQueued = 0;
            }
        } else if (libHRGE_IsQueueAffixNextGameLevel(level)) {
            libHRGE_QueueBoon(libHRGE_rarityCommon, 1, false, false);
            libHRGE_boonsNextGame -= 1;
        }
        libHRGE_startingBoonsQueued = true;
    } else if (player == libHRGE_enemy) {
        if (level == 1) {
            libHRGE_Wait(libHRGE_gameStartDelay, c_timeGame);
            while (!libHRGE_startingBoonsQueued) {
                libHRGE_Wait(0.0625, c_timeGame);
            }
            libHRGE_ApplyDifficulty();
            libHRGE_QueueCurse(1, false);
            if (libHRGE_cursesQueued > 0) {
                libHRGE_DisplayChatMessage(StringExternal("Message/CurseNextGame" + IntToString(MinI(libHRGE_cursesQueued, 3))));
                libHRGE_QueueCurse(libHRGE_cursesQueued, false);
                libHRGE_cursesQueued = 0;
            }
        } else if (libHRGE_IsQueueAffixNextGameLevel(level)) {
            while (!libHRGE_startingBoonsQueued) {
                libHRGE_Wait(0.0625, c_timeGame);
            }
            if (level == 4 || level == 7 || level == 10) {
                libHRGE_cursesNextGame -= 1;
            }
            libHRGE_QueueCurse(1, false);
        } else if (libHRGE_IsCurseLevel(level)) {
            while (!libHRGE_startingBoonsQueued) {
                libHRGE_Wait(0.0625, c_timeGame);
            }
            libHRGE_QueueCurse(1, false);
        }
    }
    return true;
}
void libHRGE_BoonsCursesLevelUp_Init () {
    libGame_gf_HeroLevelUp(TriggerCreate("libHRGE_BoonsCursesLevelUp_Func"));
}

void libHRGE_SetupAffixes() {
    int i;
    int j;
    string instance;
    string instanceRequired;
    int fieldCount;
    int unlocksCount;
    for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
        instance = libHRGE_GetAffixInstance(i);
        fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserAffixesRequiredCount, 1);
        for (j = 1; j <= fieldCount; j += 1) {
            instanceRequired = libHRGE_GetAffixRequired(instance, j);
            unlocksCount = DataTableGetInt(true, instanceRequired + "UnlocksCount");
            DataTableSetString(true, instanceRequired + "Unlocks" + IntToString(unlocksCount + 1), instance);
            DataTableSetInt(true, instanceRequired + "UnlocksCount", unlocksCount + 1);
        }
    }
}

