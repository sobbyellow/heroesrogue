    libHRGE_DVaCallMechCompletedTrigger = TriggerCreate("libHRGE_DVaCallMechCompletedTrigger_Func");
    libHRGE_DVaRespawnTrigger = TriggerCreate("libHRGE_DVaRespawnTrigger_Func");
    libHRGE_DVaEjectTrigger = TriggerCreate("libHRGE_DVaEjectTrigger_Func");
    TriggerAddEventUnitAbility(libHRGE_DVaCallMechCompletedTrigger, null, AbilityCommand("DVaPilotCallMech", 0), c_abilEffectStageFinish, false);
    TriggerAddEventGeneric(libHRGE_DVaRespawnTrigger, libGame_gv_eventID_HeroRespawn_C);
    TriggerAddEventPlayerEffectUsed(libHRGE_DVaEjectTrigger, c_playerAny, "DVaMechPilotUnloadSet");
}

