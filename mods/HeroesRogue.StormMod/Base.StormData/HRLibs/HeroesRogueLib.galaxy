}
bool libHRGE_IsGameoverDialogVisible() {
    return DialogIsVisible(libHRGE_dialogGameover.dialog, libHRGE_player);
}
bool libHRGE_IsGameoverExitDialogVisible() {
    return DialogIsVisible(libHRGE_dialogGameoverExit.dialog, libHRGE_player);
}
bool libHRGE_IsAchievementsDialogVisible() {
    return DialogIsVisible(libHRGE_dialogAchievements.dialog, libHRGE_player);
}
bool libHRGE_IntToBoolean(int value) {
    return value >= 1;
}
unit libHRGE_GetPlayerDVaMech (int player) { 
    unitgroup heroUnitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unit heroUnit;
    unit mechUnit;
    int groupCount = UnitGroupCount(heroUnitGroup, c_unitCountAll);

    for (;; groupCount -= 1) {
        if (groupCount <= 0) { break; }
        heroUnit = UnitGroupUnitFromEnd(heroUnitGroup, groupCount);
        if (UnitGetType(heroUnit) == "HeroDVaMech") {
            mechUnit = heroUnit;
        }
    }
    return mechUnit;
}

