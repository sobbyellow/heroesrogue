    libHRGE_SetDialogControlPosition(libHRGE_dialogAffixSelection.items[index].tooltipLabel, c_anchorTop, offsetX + libHRGE_affixItemTooltipOffsetX, offsetY + libHRGE_affixItemTooltipOffsetY);
