void libHRGE_UpdateGameoverDialog() {
    int takedowns = libHRGE_BankGetStats("Takedowns") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_takedowns);
    int kills = libHRGE_BankGetStats("Kills") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_kills);
    int assists = libHRGE_BankGetStats("Assists") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_assists);
    int deaths = libHRGE_BankGetStats("Deaths") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_deaths);
    int spellDamage = libHRGE_BankGetStats("SpellDamage") + libGame_gv_scoreValues[libHRGE_player].lv_spellDamage;
    int physicalDamage = libHRGE_BankGetStats("PhysicalDamage") + libGame_gv_scoreValues[libHRGE_player].lv_physicalDamage;
    int heroDamage = libHRGE_BankGetStats("HeroDamage") + FixedToInt(PlayerScoreValueGetAsFixed(libHRGE_player, "HeroDamage"));
    int siegeDamage = libHRGE_BankGetStats("SiegeDamage") + FixedToInt(PlayerScoreValueGetAsFixed(libHRGE_player, "SiegeDamage"));
    int healing = libHRGE_BankGetStats("Healing") + FixedToInt(PlayerScoreValueGetAsFixed(libHRGE_player, "Healing"));
    int damageTaken = libHRGE_BankGetStats("DamageTaken") + libGame_gv_scoreValues[libHRGE_player].lv_damageTaken;
    int experience = libHRGE_BankGetStats("Experience") + FixedToInt(libGame_gv_scoreValues[libHRGE_player].lv_individualXPEarned);
    int regenGlobes = libHRGE_BankGetStats("RegenGlobes") + libGame_gv_scoreValues[libHRGE_player].lv_regenGlobes;
    int minionKills = libHRGE_BankGetStats("MinionKills") + libGame_gv_scoreValues[libHRGE_player].lv_minionKills;
    int mercs = libHRGE_BankGetStats("MercCaptures") + libGame_gv_scoreValues[libHRGE_player].lv_creepCampsCaptured;
    int objectivesWon = libHRGE_BankGetStats("ObjectivesWon") + libHRGE_objectivesWonThisGame;
    int objectivesLost = libHRGE_BankGetStats("ObjectivesLost") + libHRGE_objectivesLostThisGame;
    int rerollsUsed = libHRGE_BankGetStats("RerollsUsed") + libHRGE_rerollsUsed;
    int rerollsCurseUsed = libHRGE_BankGetStats("RerollsCurseUsed") + libHRGE_rerollsCurseUsed;
    int bansUsed = libHRGE_BankGetStats("BansUsed") + libHRGE_bansUsed;
    int cursesSkipped = libHRGE_BankGetStats("CursesSkipped") + libHRGE_cursesSkipped;
    int cursesSwapped = libHRGE_BankGetStats("CursesSwapped") + libHRGE_cursesSwapped;
    int gameTime = libHRGE_BankGetStats("GameTime") + FixedToInt(TimerGetElapsed(libGame_gv_gameTimer));
    int[libCore_gv_bALMaxTeams + 1][libHRGE_maxHeroes + 1] heroCounter;
    int[libCore_gv_bALMaxTeams + 1] mostHeroCounter;
    int[libCore_gv_bALMaxTeams + 1] mostHeroIndex;
    int kda;
    int boons;
    int curses;
    int[libHRGE_maxRarities + 1] boonsRarity;
    int[libHRGE_maxRarities + 1] cursesRarity;
    int i;
    int affix;
    string instance;
    int count;
    libHRGE_DisplayDebugMessage("Updating gameover dialog...");
    libHRGE_CountOwnedAffixes();
    for (i = 1; i <= libHRGE_ownedAffixesIndex[libHRGE_affixTypeBoon]; i += 1) {
        affix = libHRGE_ownedAffixes[libHRGE_affixTypeBoon][i];
        instance = libHRGE_GetAffixInstance(affix);
        if (libHRGE_AffixIgnoredForStats(instance)) {
            continue;
        }
        count = libHRGE_GetAffixCount(instance);
        boons += count;
        boonsRarity[libHRGE_GetAffixRarity(instance)] += count;
    }
    for (i = 1; i <= libHRGE_ownedAffixesIndex[libHRGE_affixTypeCurse]; i += 1) {
        affix = libHRGE_ownedAffixes[libHRGE_affixTypeCurse][i];
        instance = libHRGE_GetAffixInstance(affix);
        if (libHRGE_AffixIgnoredForStats(instance)) {
            continue;
        }
        count = libHRGE_GetAffixCount(instance);
        curses += count;
        cursesRarity[libHRGE_GetAffixRarity(instance)] += count;
    }
    for (i = 1; i <= libHRGE_maxHeroes; i += 1) {
        heroCounter[libHRGE_teamOrderIndex][i] = libHRGE_BankGetStats("HeroCounterOrder_" + libCore_gf_GetHeroFromIndex(i)) + libHRGE_heroCounter[libHRGE_teamOrderIndex][i];
        if (heroCounter[libHRGE_teamOrderIndex][i] > mostHeroCounter[libHRGE_teamOrderIndex]) {
            mostHeroCounter[libHRGE_teamOrderIndex] = heroCounter[libHRGE_teamOrderIndex][i];
            mostHeroIndex[libHRGE_teamOrderIndex] = i;
        }
    }
    for (i = 1; i <= libHRGE_maxHeroes; i += 1) {
        heroCounter[libHRGE_teamChaosIndex][i] = libHRGE_BankGetStats("HeroCounterChaos_" + libCore_gf_GetHeroFromIndex(i)) + libHRGE_heroCounter[libHRGE_teamChaosIndex][i];
        if (heroCounter[libHRGE_teamChaosIndex][i] > mostHeroCounter[libHRGE_teamChaosIndex]) {
            mostHeroCounter[libHRGE_teamChaosIndex] = heroCounter[libHRGE_teamChaosIndex][i];
            mostHeroIndex[libHRGE_teamChaosIndex] = i;
        }
    }
    if (deaths != 0) {
        kda = FixedToInt(takedowns / deaths);
    } else {
        kda = takedowns;
    }
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "M", StringToText(StringCase(libHRGE_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(libGame_gv_players[libHRGE_player].lv_heroIndex) + ",HyperlinkId"), true)));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "A", FormatNumber(boons));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "C", FormatNumber(boonsRarity[libHRGE_rarityCommon]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "D", FormatNumber(boonsRarity[libHRGE_rarityUncommon]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "E", FormatNumber(boonsRarity[libHRGE_rarityRare]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "F", FormatNumber(boonsRarity[libHRGE_rarityEpic]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "G", FormatNumber(boonsRarity[libHRGE_rarityLegendary]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "H", FormatNumber(boonsRarity[libHRGE_rarityStarter]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "I", FormatNumber(boonsRarity[libHRGE_rarityMilestone]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "B", FormatNumber(curses));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "J", FormatNumber(cursesRarity[libHRGE_rarityCommon] + cursesRarity[libHRGE_rarityUncommon] + cursesRarity[libHRGE_rarityRare] + cursesRarity[libHRGE_rarityEpic] + cursesRarity[libHRGE_rarityLegendary]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "K", FormatNumber(cursesRarity[libHRGE_rarityChallenge]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats1", "L", FormatNumber(cursesRarity[libHRGE_rarityMythic]));
    libHRGE_SetDialogControlText(libHRGE_dialogGameover.leftStats, TextExpressionAssemble("Param/Expression/AffixGameoverStats1"));

    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "A", FormatNumber(rerollsUsed));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "B", FormatNumber(rerollsCurseUsed));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "C", FormatNumber(bansUsed));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "F", FormatNumber(minionKills));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "G", FormatNumber(mercs));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "H", FormatNumber(regenGlobes));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "I", FormatNumber(objectivesWon));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "J", FormatNumber(objectivesLost));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "D", FormatNumber(cursesSkipped));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "E", FormatNumber(cursesSwapped));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "K", StringToText(libHRGE_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(mostHeroIndex[libHRGE_teamOrderIndex]) + ",HyperlinkId")));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "L", StringToText(libHRGE_GetCatalogDefaultValue("Hero," + libCore_gf_GetHeroFromIndex(mostHeroIndex[libHRGE_teamChaosIndex]) + ",HyperlinkId")));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "M", FormatNumber(mostHeroCounter[libHRGE_teamOrderIndex]));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats2", "N", FormatNumber(mostHeroCounter[libHRGE_teamChaosIndex]));
    libHRGE_SetDialogControlText(libHRGE_dialogGameover.middleStats, TextExpressionAssemble("Param/Expression/AffixGameoverStats2"));
    
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "L", libHRGE_IntToTimeText(gameTime));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "A", FormatNumber(spellDamage + physicalDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "B", FormatNumber(spellDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "C", FormatNumber(physicalDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "M", FormatNumber(siegeDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "N", FormatNumber(heroDamage));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "D", FormatNumber(healing));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "E", FormatNumber(damageTaken));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "F", FormatNumber(experience));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "G", FormatNumber(takedowns));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "H", FormatNumber(kills));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "I", FormatNumber(assists));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "J", FormatNumber(deaths));
    TextExpressionSetToken("Param/Expression/AffixGameoverStats3", "K", FormatNumber(kda));
    libHRGE_SetDialogControlText(libHRGE_dialogGameover.rightStats, TextExpressionAssemble("Param/Expression/AffixGameoverStats3"));
}
void libHRGE_ShowGameoverDialog(bool show) {
    libHRGE_UpdateGameoverDialog();
    libHRGE_SetDialogVisible(libHRGE_dialogGameover.dialog, show);
    libHRGE_SetBackdropDark(show);
    libHRGE_ShowBackdrop(show);
    libHRGE_Pause(show);
}
void libHRGE_ShowGameoverExitDialog(bool show) {
    libHRGE_SetDialogVisible(libHRGE_dialogGameoverExit.dialog, show);
}

void libHRGE_CreateOptionsDialog() {
    int i;

    libHRGE_dialogOptions.dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libHRGE_dialogOptions.dialog, true);
    DialogSetImageVisible(libHRGE_dialogOptions.dialog, false);
    libHRGE_dialogOptions.label = libHRGE_CreateDialogControlLabel(libHRGE_dialogOptions.dialog, StringExternal("Label/Name/Options"), "Storm_Map_Large_Bold_Centered", libHRGE_optionsLabelWidth, libHRGE_optionsLabelHeight, c_anchorTop, libHRGE_optionsLabelOffsetX, libHRGE_optionsLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogControlOptionsSpeedUpDeath = libHRGE_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsSpeedupDeath"));
    libHRGE_dialogControlOptionsSpeedUpGates = libHRGE_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsSpeedup"));
    libHRGE_dialogControlOptionsDisplayPicksBans = libHRGE_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsPicksBans"));
    libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips = libHRGE_CreateOptionDialogCheckbox(StringExternal("Label/Name/OptionsAlwaysShowExtendedTooltips"));
    libHRGE_dialogControlOptionsAchievementsButton = libHRGE_CreateOptionDialogButton(StringExternal("Button/Name/OptionsAchievements"));
    libHRGE_dialogControlOptionsRestartButton = libHRGE_CreateOptionDialogButton(StringExternal("Button/Name/OptionsRestart"));
    libHRGE_dialogControlOptionsReturnButton = libHRGE_CreateOptionDialogButton(StringExternal("Button/Name/OptionsReturn"));
    for (i = 1; i <= libHRGE_dialogOptions.optionIndex; i += 1) {
        libHRGE_SetDialogControlPosition(libHRGE_dialogOptions.option[i].label, c_anchorCenter, libHRGE_optionsSpacingX, libHRGE_optionsSpacingY * (2 * i - libHRGE_dialogOptions.optionIndex - 1) / 2);
        libHRGE_SetDialogControlPosition(libHRGE_dialogOptions.option[i].button, c_anchorCenter, libHRGE_optionsButtonSpacingX, libHRGE_optionsButtonSpacingY * (2 * i - libHRGE_dialogOptions.optionIndex - 1) / 2);
        libHRGE_SetDialogControlPosition(libHRGE_dialogOptions.option[i].checkbox, c_anchorCenter, libHRGE_optionsCheckboxSpacingX, libHRGE_optionsSpacingY * (2 * i - libHRGE_dialogOptions.optionIndex - 1) / 2);
    }
    libHRGE_dialogOptionsRestart.dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(libHRGE_dialogOptionsRestart.dialog, true);
    DialogSetImageVisible(libHRGE_dialogOptionsRestart.dialog, false);
    libHRGE_dialogOptionsRestart.frame = DialogControlCreateFromTemplate(libHRGE_dialogOptionsRestart.dialog, c_triggerControlTypeImage, "StandardTemplates/StandardContextMenuFrame");
    libHRGE_SetDialogControlSize(libHRGE_dialogOptionsRestart.frame, libHRGE_optionsRestartFrameWidth, libHRGE_optionsRestartFrameHeight);
    libHRGE_SetDialogControlPosition(libHRGE_dialogOptionsRestart.frame, c_anchorCenter, 0, 0);
    libHRGE_dialogOptionsRestart.label = libHRGE_CreateDialogControlLabel(libHRGE_dialogOptionsRestart.dialog, StringExternal("Label/Name/OptionsRestart"), "Affix_Dialog", libHRGE_optionsRestartLabelWidth, libHRGE_optionsRestartLabelHeight, c_anchorCenter, libHRGE_optionsRestartLabelOffsetX, libHRGE_optionsRestartLabelOffsetY, ColorWithAlpha(0, 0, 0, 0), false);
    libHRGE_dialogOptionsRestart.option[1].button = libHRGE_CreateDialogControlButton(libHRGE_dialogOptionsRestart.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogOptionsRestart.option[1].button, libHRGE_optionsRestartButtonWidth, libHRGE_optionsRestartButtonHeight);
    libHRGE_SetDialogControlText(libHRGE_dialogOptionsRestart.option[1].button, StringExternal("Button/Name/Yes"));
    libHRGE_SetDialogControlPosition(libHRGE_dialogOptionsRestart.option[1].button, c_anchorCenter, libHRGE_optionsRestartButtonYesOffsetX, libHRGE_optionsRestartButtonYesOffsetY);
    libHRGE_dialogOptionsRestart.option[2].button = libHRGE_CreateDialogControlButton(libHRGE_dialogOptionsRestart.dialog);
    libHRGE_SetDialogControlSize(libHRGE_dialogOptionsRestart.option[2].button, libHRGE_optionsRestartButtonWidth, libHRGE_optionsRestartButtonHeight);
    libHRGE_SetDialogControlText(libHRGE_dialogOptionsRestart.option[2].button, StringExternal("Button/Name/No"));
    libHRGE_SetDialogControlPosition(libHRGE_dialogOptionsRestart.option[2].button, c_anchorCenter, libHRGE_optionsRestartButtonNoOffsetX, libHRGE_optionsRestartButtonNoOffsetY);
}
void libHRGE_UpdateOptionsDialog() {
    if (libHRGE_IsOwnedAffixesDialogVisible()) {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOptionsButton, false);
    } else {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOptionsButton, true);
    }
    if (libHRGE_IsOptionsDialogVisible()) {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOwnedAffixesButton, false);
    } else {
        libHRGE_SetDialogControlEnabled(libHRGE_dialogControlOwnedAffixesButton, true);
    }
}
void libHRGE_ShowOptionsDialog(bool show) {
    libHRGE_SetDialogVisible(libHRGE_dialogOptions.dialog, show);
    libHRGE_ShowBackdrop(show);
    if (!show) {
        libHRGE_ShowOptionsRestartDialog(false);
    }
    if (show && libHRGE_IsAffixSelectionDialogVisible()) {
        DialogSetTransparency(libHRGE_dialogAffixSelection.dialog, 75);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.titleLabel, false);
    } else {
        DialogSetTransparency(libHRGE_dialogAffixSelection.dialog, 0);
        libHRGE_SetDialogControlVisible(libHRGE_dialogAffixSelection.titleLabel, true);
    }
    if (show && libHRGE_IsGameoverDialogVisible()) {
        DialogSetTransparency(libHRGE_dialogGameover.dialog, 75);
    } else {
        DialogSetTransparency(libHRGE_dialogGameover.dialog, 0);
    }
    libHRGE_UpdateOptionsDialog();
    libHRGE_Pause(show);
}
void libHRGE_UpdateOptionsRestartDialog() {
    if (libGame_winningTeam == libHRGE_teamChaosIndex) {
        libHRGE_SetDialogControlText(libHRGE_dialogOptionsRestart.label, StringExternal("Label/Name/OptionsRestartEnemyWon"));
    } else {
        libHRGE_SetDialogControlText(libHRGE_dialogOptionsRestart.label, StringExternal("Label/Name/OptionsRestart"));
    }
}
void libHRGE_ShowOptionsRestartDialog(bool show) {
    libHRGE_UpdateOptionsRestartDialog();
    libHRGE_SetDialogVisible(libHRGE_dialogOptionsRestart.dialog, show);
}

void libHRGE_CreateAffixSelectionDialogItem(int index, int offsetX, int offsetY) {
    libHRGE_dialogAffixSelection.items[index].background = libHRGE_CreateDialogControlImage(libHRGE_dialogAffixSelection.dialog, libHRGE_textureAffixBackground, libHRGE_affixItemWidth + libHRGE_affixItemBackgroundWidth, libHRGE_affixItemHeight + libHRGE_affixItemBackgroundHeight, c_anchorTop, offsetX + libHRGE_affixItemBackgroundOffsetX, offsetY + libHRGE_affixItemBackgroundOffsetY, null);
    libHRGE_dialogAffixSelection.items[index].affixBackground = libHRGE_CreateDialogControlImage(libHRGE_dialogAffixSelection.dialog, null, libHRGE_affixItemWidth + libHRGE_affixItemAffixBackgroundWidth, libHRGE_affixItemHeight + libHRGE_affixItemAffixBackgroundHeight, c_anchorTop, offsetX + libHRGE_affixItemAffixBackgroundOffsetX, offsetY + libHRGE_affixItemAffixBackgroundOffsetY, null);

    libHRGE_dialogAffixSelection.items[index].selectButton = libHRGE_CreateDialogControlButton(libHRGE_dialogAffixSelection.dialog);
