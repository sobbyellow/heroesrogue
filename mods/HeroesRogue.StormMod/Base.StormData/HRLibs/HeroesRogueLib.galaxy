// External Library Initialization
void libHRGE_InitLibraries () {
    libNtve_InitVariables();
    libCore_InitVariables();
    libGame_InitVariables();
    libMapM_InitVariables();
    libStEx_InitVariables();
    libPBU2_InitLib();
}

void libHRGE_DisplayDebugMessage(string printText) {
    if (libHRGE_debug_enableDebugLogging) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(printText));
    }
}
void libHRGE_DisplayChatMessage(text chatMessage) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, chatMessage);
}

// ============================================================
// Hero Selection
// ============================================================

int libHRGE_HeroSelectionPickHero(int player) {
    int heroIndex = libGame_gf_HeroSelectionRandomlyPickMetaUnusedHero(player);
    if (heroIndex == 0) {
        heroIndex = libGame_gf_HeroSelectionRandomlyPickUnusedHeroWithRole(player, true, true, true, true, true, false);
    }
    if (heroIndex == 0) {
        heroIndex = libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(player, false, false);
    }
    if (heroIndex == 0) {
        heroIndex = libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(player, true, false);
    }
    if (heroIndex == 0) {
        heroIndex = libGame_gf_HeroSelectionRandomlyPickAnyUnusedHero(player, true, true);
    }
    return heroIndex;
}

bool libHRGE_HeroSelectionTrigger_Func(bool testConds, bool runActions) {
    int player = 1;
    int heroIndexCho = libCore_gf_GetIndexFromHero("Cho");
    int heroIndexGall = libCore_gf_GetIndexFromHero("Gall");
    int heroIndex;

    for (; player <= libCore_gv_bALMaxPlayers; player += 1 ) {
        if (PlayerStatus(player) == c_playerStatusUnused || PlayerType(player) == c_playerTypeHostile) { continue; }
        heroIndex = libGame_gv_players[player].lv_heroIndex;
        if (heroIndex != 0) { continue; }
        
        if (player == libHRGE_player && libHRGE_playerSelectedHero != 0) {
            heroIndex = libHRGE_playerSelectedHero;
        }
        if (libHRGE_debug_playerHero[player] != "") {
            heroIndex = libCore_gf_GetIndexFromHero(libHRGE_debug_playerHero[player]);
        }
        if (heroIndex == 0) {
            heroIndex = libHRGE_HeroSelectionPickHero(player);
        }
        if (player == 2) {
            if (libGame_gv_players[libHRGE_player].lv_heroIndex == heroIndexCho) {
                heroIndex = heroIndexGall;
            } else if (libGame_gv_players[libHRGE_player].lv_heroIndex == heroIndexGall) {
                heroIndex = heroIndexCho;
            }
        }
        if (player != libHRGE_player) {
            if (libGame_gf_TeamNumberOfPlayer(player) == libHRGE_teamOrderIndex) {
                libHRGE_heroCounter[libHRGE_teamOrderIndex][heroIndex] += 1;
            } else {
                libHRGE_heroCounter[libHRGE_teamChaosIndex][heroIndex] += 1;
            }
        }

        libGame_gv_players[player].lv_heroIndex = heroIndex;
        libCore_gf_DataClearHeroDataAtIndex(player);
        libCore_gf_DataLoadHeroDataIntoIndex(libCore_gf_GetHeroFromIndex(heroIndex), player);
        libGame_gf_HeroSelectionRandomlyPickSkin(player);
        libGame_gf_HeroSelectionRandomlyPickMount(player);
        PlayerSetSpray(player, "RandomSpray");
    }
    libGame_gv_heroPickDone = true;

    return true;
}
void libHRGE_HeroSelectionTrigger_Init () {
    libHRGE_HeroSelectionTrigger = TriggerCreate("libHRGE_HeroSelectionTrigger_Func");
}

// ============================================================
// Cooldown functions
// ============================================================

bool libHRGE_IsCooldownModifiableAbility (string ability) {
    if (ability == "AbathurSpawnLocusts") {
        return true;
    }
    return false;
}

void libHRGE_ModifyAllCooldowns (unit targetUnit, fixed cooldownChange, bool includeTrait, bool includeHeroic, bool includeMount) {
    string abilLink;
    string cooldownLink;
    string chargeLink;
    int player = UnitGetOwner(targetUnit);
    int ability = 1;
    int maxAbilities = libGame_gv_players[player].lv_heroData.lv_numberOfAbilities;
    int i;
    string unitType = UnitGetType(targetUnit);

    if (unitType == "HeroOlaf" || unitType == "HeroErik" || unitType == "HeroBaleog") {
        for (i = 0; i < 8; i += 1) {
            libHRGE_CatalogReferenceModify("Effect,LostVikingsCooldownReductionModifyUnit,Cost[" + IntToString(i) + "].CooldownTimeUse", player, FixedToString(cooldownChange / 3, 5), c_upgradeOperationSet);
        }
        UnitCreateEffectUnit(targetUnit, "LostVikingsCooldownReductionModifyUnit", targetUnit);
    } else {
        for (; ability <= maxAbilities; ability += 1) {
            if ((libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_isAffectedByCooldownReduction) ||
                (libHRGE_IsCooldownModifiableAbility(libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_ability))) {
                if ((libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_isHeroic && includeHeroic == false) ||
                    (libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_isTrait && includeTrait == false) ||
                    ((libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_isMountReplacement || 
                    libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_ability == "Mount") && includeMount == false)) {
                    continue;
                }
                abilLink = libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_ability;
                cooldownLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Cooldown.Link", player);
                chargeLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Charge.Link", player);
                if (StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Cooldown.TimeUse", player)) <= 0 &&
                    StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[0].Charge.TimeUse", player)) <= 0) {
                    continue;
                }
                UnitModifyCooldown(targetUnit, cooldownLink, cooldownChange, c_cooldownOperationAdd);
                if (libGame_gv_players[player].lv_heroData.lv_abilities[ability].lv_usesCharges || chargeLink != "") {
                    UnitAddChargeRegenRemaining(targetUnit, chargeLink, cooldownChange);
                }
            }
        }
    }
}

void libHRGE_ResetCooldowns(unit playerUnit) {
    int i;
    int ability;
    int heroIndex;
    int player = UnitGetOwner(playerUnit);
    string abilLink;
    string cooldownLink;
    string chargeLink;
    int chargeCount;
    unitgroup unitGroup = libGame_gv_players[player].lv_heroUnitGroup;
    unit unitVar;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    int abilityNumber = libCore_gv_dataHeroesMaxAbilitiesPerHero;

    for (;; unitGroupCount -= 1) {
        if (unitGroupCount <= 0) { break; }
        unitVar = UnitGroupUnitFromEnd(unitGroup, unitGroupCount);
        libHRGE_DisplayDebugMessage(UnitGetType(unitVar));
        cooldownLink = "";
        chargeLink = "";
        heroIndex = libCore_gf_GetHeroIndexForUnitType(UnitGetType(unitVar));
        abilityNumber = UnitAbilityCount(unitVar);
        ability = 1;

        for ( ; ability <= abilityNumber ; ability += 1 ) {
            abilLink = UnitAbilityGet(unitVar, ability);
            if ((libGame_gf_HeroAbilityCooldownCanBeReset(heroIndex, abilLink) == true)) {
                cooldownLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[" + IntToString(0) + "].Cooldown.Link", player);
                libNtve_gf_UnitRemoveCooldown(unitVar, cooldownLink);
                libNtve_gf_PlayerRemoveCooldown(player, cooldownLink);
                chargeLink = CatalogFieldValueGet(c_gameCatalogAbil, abilLink, "Cost[" + IntToString(0) + "].Charge.Link", player);
                chargeCount = CatalogFieldValueGetAsInt(c_gameCatalogAbil, abilLink, "Cost[" + IntToString(0) + "].Charge.CountMax", player);
                UnitAddChargeUsed(unitVar, chargeLink, (-1));
                PlayerAddChargeUsed(player, chargeLink, (-1));
            }
        }
    }
}

void libHRGE_MuteAllChannelsExcept(playergroup pg, bool mute, int except) {
    int i;

    for (i = 0; i < except; i += 1) {
        SoundChannelMute(pg, i, mute);
    }
    for (i = except + 1; i < 30; i += 1) {
        SoundChannelMute(pg, i, mute);
    }
}

// ============================================================
// Sync boons and curses
// ============================================================

void libHRGE_SyncBehaviors(unit sourceUnit, unit targetUnit) {
    int i;
    int player = UnitGetOwner(sourceUnit); 
    string behavior;
    int behaviorStacks;
    fixed behaviorDuration;

    libHRGE_Wait(0.0625, c_timeGame);
    for (i = 1; i <= libHRGE_syncBehaviorIndex[player]; i += 1) { 
        behavior = libHRGE_syncBehaviors[player][i];
        if (behavior == "" || behavior == null) { continue; }
        if (!UnitHasBehavior2(sourceUnit, behavior)) {
            libHRGE_DisplayDebugMessage("Syncing " + behavior + " to unit " + UnitGetType(targetUnit) +
                " for Player " + IntToString(player) + " but source does not have the behavior.");
        }
        behaviorStacks = MaxI(1, UnitBehaviorCount(sourceUnit, behavior));
        behaviorDuration = UnitBehaviorDuration(sourceUnit, behavior);
        UnitModifyCooldown(targetUnit, "Abil/" + behavior, UnitGetCooldown(sourceUnit, "Abil/" + behavior), c_cooldownOperationSet);
        if (UnitHasBehavior2(targetUnit, behavior) && UnitBehaviorCount(targetUnit, behavior) == UnitBehaviorCount(sourceUnit, behavior)) {
            continue;
        }
        libHRGE_DisplayDebugMessage("Syncing " + IntToString(behaviorStacks) + "x " + behavior + " (" + 
            FixedToString(behaviorDuration, 2) + "s)" + " to unit " + UnitGetType(targetUnit) + " for player " + IntToString(player) + ".");
        UnitBehaviorAdd(targetUnit, behavior, targetUnit, behaviorStacks);
        UnitBehaviorSetDuration(targetUnit, behavior, behaviorDuration);
    }
}

// ============================================================
// D.Va - Sync behaviors on respawn
// ============================================================
bool libHRGE_DVaRespawnTrigger_Func (bool testConds, bool runActions) {
    int player = libGame_gf_HeroRespawnPlayer();
    unit respawnUnit = libGame_gf_HeroRespawnUnit();
    string hero = libCore_gf_GetHeroFromIndex(libGame_gv_players[player].lv_heroIndex);
    if (testConds) {
        if (hero != "DVa") {
            return false;
        }
    }
    libHRGE_SyncBehaviors(respawnUnit, libHRGE_GetPlayerDVaMech(player));
    return true;
}

