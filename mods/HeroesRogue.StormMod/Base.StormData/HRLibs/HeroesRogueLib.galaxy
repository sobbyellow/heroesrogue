void libHRGE_ResolveTalents(int affix) {
    string talent;
    string instance = libHRGE_GetAffixInstance(affix);
    int fieldCount;
    int i;
    if (libHRGE_AffixIsApplied(instance)) { return; }
    fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTalentsAddCount, 1);
    for (i = 1; i <= fieldCount; i += 1) {
        talent = libHRGE_GetAffixAddTalents(instance, i);
        libHRGE_AddTalent(libHRGE_player, talent);
        SetTalentEnabled(talent, false);
    }
    fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTalentsDisableCount, 1);
    for (i = 1; i <= fieldCount; i += 1) {
        talent = libHRGE_GetAffixDisableTalents(instance, i);
        libHRGE_DisableTalent(talent, true);
    }
    fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTalentsShowCount, 1);
    for (i = 1; i <= fieldCount; i += 1) {
        talent = libHRGE_GetAffixShowTalents(instance, i);
        libHRGE_ShowTalent(talent, true);
    }
}

void libHRGE_ResolveBehaviors(int affix, int addedCount) {
    string instance = libHRGE_GetAffixInstance(affix);
    int affixCount = libHRGE_GetAffixCount(instance);
    bool choGallExcluded = libHRGE_AffixExcludesChoGall(instance);
    string behaviorInstance;
    string behavior;
    string filter;
    string arg1;
    int player;
    int fieldCount;
    int i;
    int i2;
    fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserBehaviorsAddCount, 1);
    for (i = 1; i <= fieldCount; i += 1) {
        behaviorInstance = libHRGE_GetAffixAddBehaviors(instance, i);
        if (behaviorInstance == "" || behaviorInstance == null) { continue; }
        player = StringToInt(StringWord(behaviorInstance, 1));
        behavior = StringWord(behaviorInstance, 2);
        arg1 = StringWord(behaviorInstance, 3);
        if (behavior == "" || behavior == null) { continue; }
        if (arg1 != libHRGE_affixBehaviorNoSync && arg1 != "" && arg1 != null) {
            addedCount = MaxI(1, StringToInt(arg1));
        }

        if (player == c_playerAny) {
            if (arg1 == libHRGE_affixBehaviorNoSync) {
                libHRGE_DisplayDebugMessage("Warning: " + instance + " has invalid arguments " + behaviorInstance);
                continue;
            }
            filter = StringCase(arg1, true);
            libHRGE_AddGeneralBehavior(behavior, filter);
        } else if (choGallExcluded && libHRGE_PlayerIsChoGallPair(player)) {
            continue;
        } else if (player == 0) {
            for (i2 = 1; i2 <= libCore_gv_bALMaxPlayers; i2 += 1) {
                if (choGallExcluded && libHRGE_PlayerIsChoGallPair(i2)) { continue; }
                if (arg1 == libHRGE_affixBehaviorNoSync) {
                    libHRGE_AddPlayerBehavior(i2, behavior, addedCount, false);
                } else {
                    libHRGE_AddPlayerBehavior(i2, behavior, addedCount, true);
                }
            }
        } else {
            if (arg1 == libHRGE_affixBehaviorNoSync) {
                libHRGE_AddPlayerBehavior(player, behavior, addedCount, false);
            } else {
                libHRGE_AddPlayerBehavior(player, behavior, addedCount, true);
            }
        }
    }
    fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserBehaviorsSyncCount, 1);
    for (i = 1; i <= fieldCount; i += 1) {
        behaviorInstance = libHRGE_GetAffixSyncBehaviors(instance, i);
        if (behaviorInstance == "" || behaviorInstance == null) { continue; }
        player = StringToInt(StringWord(behaviorInstance, 1));
        behavior = StringWord(behaviorInstance, 2);
        if (choGallExcluded && libHRGE_PlayerIsChoGallPair(player)) {
            continue;
        } else if (player == 0) {
            for (i2 = 1; i2 <= libCore_gv_bALMaxPlayers; i2 += 1) {
                if (choGallExcluded && libHRGE_PlayerIsChoGallPair(i2)) { continue; }
                libHRGE_AddSyncBehavior(i2, behavior);
            }
        } else {
            libHRGE_AddSyncBehavior(player, behavior);
        }
    }
    fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserBehaviorsRemoveCount, 1);
    for (i = 1; i <= fieldCount; i += 1) {
        behaviorInstance = libHRGE_GetAffixRemoveBehaviors(instance, i);
        if (behaviorInstance == "" || behaviorInstance == null) { continue; }
        player = StringToInt(StringWord(behaviorInstance, 1));
        behavior = StringWord(behaviorInstance, 2);
        if (choGallExcluded && libHRGE_PlayerIsChoGallPair(player)) {
            continue;
        } else if (player == 0) {
            for (i2 = 1; i2 <= libCore_gv_bALMaxPlayers; i2 += 1) {
                if (choGallExcluded && libHRGE_PlayerIsChoGallPair(i2)) { continue; }
                libHRGE_RemovePlayerBehavior(i2, behavior, affixCount, true);
            }
        } else {
            libHRGE_RemovePlayerBehavior(player, behavior, affixCount, true);
        }
    }
}

trigger libHRGE_GetOrCreateTrigger(string triggerName) {
    trigger triggerFunc = TriggerFind(triggerName);
    if (triggerFunc == null) {
        triggerFunc = TriggerCreate(triggerName);
    }
    if (triggerFunc == null) {
        libHRGE_DisplayDebugMessage("Warning: Could not find or create trigger " + triggerName);
    }
    return triggerFunc;
}

void libHRGE_ResolveImmediateTriggers() {
    int instanceCount = UserDataInstanceCount(libHRGE_affixUserData);
    int fieldCount;
    string triggerInstance;
    string instance;
    string triggerType;
    string triggerName;
    string triggerArg1;
    trigger triggerFunc;
    int player;
    string scalingInstance;
    string reference;
    fixed modifier;
    int i;
    int j;
    int k;
    for (i = 1; i <= instanceCount; i += 1) {
        instance = UserDataInstance(libHRGE_affixUserData, i);
        if (instance == "" || instance == null) { continue; }
        fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTriggerCount, 1);
        for (j = 1; j <= fieldCount; j += 1) {
            triggerInstance = libHRGE_GetAffixTriggers(instance, j);
            triggerType = StringCase(StringWord(triggerInstance, 1), true);
            triggerName = StringWord(triggerInstance, 2);
            triggerArg1 = StringWord(triggerInstance, 3);
            if (triggerType == libHRGE_affixUserTriggerGameStart) {
                triggerFunc = libHRGE_GetOrCreateTrigger(triggerName);
                TriggerExecute(triggerFunc, true, false);
            } else if (triggerType == libHRGE_affixUserTriggerScaling) {
                triggerFunc = libHRGE_GetOrCreateTrigger(triggerName);
                libGame_gf_HeroLevelUp(triggerFunc);
                for (k = 1; k <= libCore_gv_bALMaxPlayers; k += 1) {
                    DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Player), k);
                    DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Level), UnitLevel(libGame_gv_players[k].lv_heroUnit));
                    TriggerExecute(triggerFunc, true, false);
                }
            }
        }
        fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserScalingCount, 1);
        for (j = 1; j <= fieldCount; j += 1) {
            scalingInstance = libHRGE_GetAffixScaling(instance, j);
            player = StringToInt(StringWord(scalingInstance, 1));
            reference = StringWord(scalingInstance, 2);
            modifier = StringToFixed(StringWord(scalingInstance, 3));
            libHRGE_AddScaling(instance, player, reference, modifier);
            for (k = 1; k <= libCore_gv_bALMaxPlayers; k += 1) {
                libHRGE_ResolveScaling(j, k);
            }
        }
    }
}

void libHRGE_ResolveTriggers(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    int affixCount = libHRGE_GetAffixCount(instance);
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserTriggerCount, 1);
    bool triggerInit = libHRGE_AffixIsInitialized(instance);
    trigger triggerFunc;
    string triggerInstance;
    string triggerType;
    string triggerName;
    string triggerArg1;
    string triggerArg2;
    fixed timerDuration;
    int triggerExecCount;
    int i;
    int j;
    timer affixTimer;
    for (i = 1; i <= fieldCount; i += 1) {
        triggerInstance = libHRGE_GetAffixTriggers(instance, i);
        if (triggerInstance == "" || triggerInstance == null) { continue; }
        triggerType = StringCase(StringWord(triggerInstance, 1), true);
        triggerName = StringWord(triggerInstance, 2);
        triggerArg1 = StringWord(triggerInstance, 3);
        triggerArg2 = StringWord(triggerInstance, 4);
        triggerFunc = TriggerFind(triggerName);
        if (!triggerInit) {
            triggerFunc = libHRGE_GetOrCreateTrigger(triggerName);
            if (triggerType == libHRGE_affixUserTriggerAnyAffixAdded) {
                TriggerAddEventGeneric(triggerFunc, libHRGE_eventAffixAddedID);
            } else if (triggerType == libHRGE_affixUserTriggerAffixAdded) {
                TriggerAddEventGeneric(triggerFunc, libHRGE_eventAffixAddedID + instance);
            } else if (triggerType == libHRGE_affixUserTriggerNPCTakedown) {
                libGame_gf_HeroParticipatedInNPCTakedown(triggerFunc);
            } else if (triggerType == libHRGE_affixUserTriggerHeroTakedown) {
                libGame_gf_HeroParticipatedInTakedown(triggerFunc);
            } else if (triggerType == libHRGE_affixUserTriggerUnitCreated) {
                TriggerAddEventUnitCreated(triggerFunc, null, null, null);
            } else if (triggerType == libHRGE_affixUserTriggerHeroRespawn) {
                libGame_gf_HeroRespawn(triggerFunc);
            } else if (triggerType == libHRGE_affixUserTriggerUnitBehaviorChange) {
                if (triggerArg1 != "" && triggerArg1 != null) {
                    TriggerAddEventUnitBehaviorChange(triggerFunc, null, triggerArg1, c_unitBehaviorChangeActivate);
                } else {
                    libHRGE_DisplayDebugMessage("Warning: " + instance + " has invalid arguments for " + triggerType);
                }
            } else if (triggerType == libHRGE_affixUserTriggerUnitBehaviorCreate) {
                if (triggerArg1 != "" && triggerArg1 != null) {
                    TriggerAddEventUnitBehaviorChange(triggerFunc, null, triggerArg1, c_unitBehaviorChangeCreate);
                } else {
                    libHRGE_DisplayDebugMessage("Warning: " + instance + " has invalid arguments for " + triggerType);
                }
            } else if (triggerType == libHRGE_affixUserTriggerUnitBehaviorChangeCategory) {
                triggerArg1 = StringCase(triggerArg1, true);
                if (triggerArg1 == libHRGE_behaviorCategoryCrowdControl) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategorySlow, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategorySlow, c_unitBehaviorChangeRefresh);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeRefresh);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryStun, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryStun, c_unitBehaviorChangeRefresh);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffSilence, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffSilence, c_unitBehaviorChangeRefresh);
                } else if (triggerArg1 == libHRGE_behaviorCategoryBlind) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffBlind, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffBlind, c_unitBehaviorChangeRefresh);
                } else if (triggerArg1 == libHRGE_behaviorCategorySlow) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategorySlow, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategorySlow, c_unitBehaviorChangeRefresh);
                } else if (triggerArg1 == libHRGE_behaviorCategoryRoot) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeRefresh);
                } else if (triggerArg1 == libHRGE_behaviorCategoryStun) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryStun, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryStun, c_unitBehaviorChangeRefresh);
                } else if (triggerArg1 == libHRGE_behaviorCategorySilence) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffSilence, c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, c_behaviorCategoryDebuffSilence, c_unitBehaviorChangeRefresh);
                } else if (triggerArg1 != "" && triggerArg1 != null) {
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, StringToInt(triggerArg1), c_unitBehaviorChangeCreate);
                    TriggerAddEventUnitBehaviorChangeFromCategory(triggerFunc, null, StringToInt(triggerArg1), c_unitBehaviorChangeRefresh);
                } else {
                    libHRGE_DisplayDebugMessage("Warning: " + instance + " has invalid arguments for " + triggerType);
                }
            } else if (triggerType == libHRGE_affixUserTriggerPlayerEffectUsed) {
                if (triggerArg1 != "" && triggerArg1 != null) {
                    TriggerAddEventPlayerEffectUsed(triggerFunc, c_playerAny, triggerArg1);
                } else {
                    libHRGE_DisplayDebugMessage("Warning: " + instance + " has invalid arguments for " + triggerType);
                }
            } else if (triggerType == libHRGE_affixUserTriggerHeroLevelUp) {
                libGame_gf_HeroLevelUp(triggerFunc);
            } else if (triggerType == libHRGE_affixUserTriggerUnitDied) {
                TriggerAddEventUnitDied(triggerFunc, null);
            } else if (triggerType == libHRGE_affixUserTriggerHeroKilled) {
                libGame_gf_HeroKilled(triggerFunc);
            } else if (triggerType == libHRGE_affixUserTriggerHeroGainTalent) {
                libGame_gf_HeroGainTalent(triggerFunc);
            } else if (triggerType == libHRGE_affixUserTriggerUnitDamaged) {
                TriggerAddEventUnitDamaged(triggerFunc, null, c_unitDamageTypeAny, c_unitDamageEither, null);
            } else if (triggerType == libHRGE_affixUserTriggerQuest) {
                if (!libHRGE_AffixQuestDone(instance)) {
                    TriggerExecute(triggerFunc, true, false);
                }
            } else if (triggerType == libHRGE_affixUserTriggerUnitChangeOwner) {
                TriggerAddEventUnitChangeOwner(triggerFunc, null);
            } else if (triggerType == libHRGE_affixUserTriggerPeriodic) {
                if (triggerArg1 != "" && triggerArg1 != null) {
                    TriggerAddEventTimePeriodic(triggerFunc, StringToFixed(triggerArg1), c_timeGame);
                } else {
                    TriggerAddEventTimePeriodic(triggerFunc, 0.0625, c_timeGame);
                }
            } else if (triggerType == libHRGE_affixUserTriggerWin) {
                TriggerAddEventGeneric(triggerFunc, "GameWonEvent");
            } else if (triggerType == libHRGE_affixUserTriggerPaused) {
                TriggerAddEventGeneric(triggerFunc, libHRGE_eventPausedID);
            } else if (triggerType == libHRGE_affixUserTriggerTimer) {
                affixTimer = TimerCreate();
                DataTableSetTimer(true, triggerName + "Timer", affixTimer);
                TriggerAddEventTimer(triggerFunc, affixTimer);
                if (triggerArg1 != "" && triggerArg1 != null) {
                    timerDuration = StringToFixed(triggerArg1);
                }
                if (triggerArg2 != "" && triggerArg2 != null && libHRGE_IntToBoolean(StringToInt(triggerArg2))) {
                    TimerStart(affixTimer, timerDuration, true, c_timeGame);
                } else {
                    if (timerDuration > 0) {
                        TimerStart(affixTimer, timerDuration, false, c_timeGame);
                    } else if (timerDuration != -1) {
                        TriggerExecute(triggerFunc, true, false);
                    }
                }
            }
        }
        if (triggerFunc == null) { continue; }
        triggerExecCount = TriggerGetExecCount(triggerFunc);
        if (triggerType == libHRGE_affixUserTriggerAffixAdded) {
            libHRGE_SendAffixAddedEvent(affix, affixCount);
        } else if (triggerType == libHRGE_affixUserTriggerOneTime && libHRGE_mapInit) {
            TriggerExecute(triggerFunc, true, false);
        } else if (triggerType == libHRGE_affixUserTriggerOncePerGame && triggerExecCount <= 0) {
            TriggerExecute(triggerFunc, true, false);
        } else if (triggerType == libHRGE_affixUserTriggerHeroLevelUp && triggerExecCount <= 0) {
            for (j = 1; j <= libCore_gv_bALMaxPlayers; j += 1) {
                DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Player), j);
                DataTableSetInt(false, TriggerEventParamName(libGame_gv_eventID_HeroLevelUp_C, libGame_gv_eventParam_HeroLevelUp_Level), UnitLevel(libGame_gv_players[j].lv_heroUnit));
                TriggerExecute(triggerFunc, true, false);
            }
        }
    }
    libHRGE_SetAffixInitialized(instance, true);
}

void libHRGE_ResolveQuestTokens(int affix) {
    string instance = libHRGE_GetAffixInstance(affix);
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserQuestRetainCount, 1);
    string questRetain;
    string behavior;
    fixed token;
    int i;
    for (i = 1; i <= fieldCount; i += 1) {
        questRetain = libHRGE_GetQuestRetain(instance, i);
        token = libHRGE_GetAffixQuestToken(instance, i);
        behavior = StringWord(questRetain, 1);
        if (behavior != "" && behavior != null && token > 0) {
            libHRGE_ModifyPlayerTokenCount(libHRGE_player, RoundI(token), behavior);
        }
    }
}

void libHRGE_ApplyCatalogModificationBaseMult(string reference, int player, string valueString, fixed value, int stacks, string operation, fixed mult) {
    if (operation == libHRGE_affixUserCatalogOperationSubtract) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) - (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else if (operation == libHRGE_affixUserCatalogOperationMultiply) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) * (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else if (operation == libHRGE_affixUserCatalogOperationDivide) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) / (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else if (operation == libHRGE_affixUserCatalogOperationAdd) {
        CatalogReferenceModify(reference, player, FixedToString(StringToFixed(valueString) + (mult + (value * stacks)), c_fixedPrecisionAny), c_upgradeOperationSet);
    } else if (operation == libHRGE_affixUserCatalogOperationSet) {
        CatalogReferenceModify(reference, player, FixedToString(mult + (value * stacks), c_fixedPrecisionAny), c_upgradeOperationSet);
    }
}
void libHRGE_ApplyCatalogModificationBase(string reference, int player, string valueString, fixed value, int stacks, string operation) {
    libHRGE_ApplyCatalogModificationBaseMult(reference, player, valueString, value, stacks, operation, 0);
}

int libHRGE_GetUpgradeOperation(string operation) {
    if (operation == libHRGE_affixUserCatalogOperationSet || operation == libHRGE_affixUserCatalogOperationString) {
        return c_upgradeOperationSet;
    } else if (operation == libHRGE_affixUserCatalogOperationAdd) {
        return c_upgradeOperationAdd;
    } else if (operation == libHRGE_affixUserCatalogOperationSubtract) {
        return c_upgradeOperationSubtract;
    } else if (operation == libHRGE_affixUserCatalogOperationMultiply) {
        return c_upgradeOperationMultiply;
    } else if (operation == libHRGE_affixUserCatalogOperationDivide) {
        return c_upgradeOperationDivide;
    }
    libHRGE_DisplayDebugMessage("Warning: Invalid operation " + operation + ". Defaulting to Set.");
    return c_upgradeOperationSet;
}

void libHRGE_ResolveCatalogModifications(int affix, int addedCount) {
    string instance = libHRGE_GetAffixInstance(affix);
    string catalogMod;
    bool choGallExcluded = libHRGE_AffixExcludesChoGall(instance);
    int affixCount = libHRGE_GetAffixCount(instance);
    int fieldCount = UserDataGetInt(libHRGE_affixUserData, instance, libHRGE_affixUserCatalogModsCount, 1);
    int i;
    int j;
    int catalogPlayer;
    string catalogType;
    string catalogOperation;
    string catalogReference;
    fixed catalogValue;
    string catalogValueString;
    string catalogValueFinal;
    
    for (i = 1; i <= fieldCount; i += 1) {
        catalogMod = libHRGE_GetCatalogModifications(instance, i);
        if (catalogMod == "" || catalogMod == null) { continue; }
        catalogPlayer = StringToInt(StringWord(catalogMod, 1));
        catalogType = StringCase(StringWord(catalogMod, 2), true);
        catalogOperation = StringCase(StringWord(catalogMod, 3), true);
        catalogReference = StringWord(catalogMod, 4);
        catalogValueString = StringWord(catalogMod, 5);
        catalogValue = StringToFixed(StringWord(catalogMod, 5));
        if (catalogType == libHRGE_affixUserCatalogTypeFlat) {
            catalogValueFinal = FixedToString(catalogValue, c_fixedPrecisionAny);
        } else if (catalogType == libHRGE_affixUserCatalogTypePerStack) {
            catalogValueFinal = FixedToString(catalogValue * affixCount, c_fixedPrecisionAny);
        } else if (catalogType == libHRGE_affixUserCatalogTypePerStackDelta) {
            catalogValueFinal = FixedToString(catalogValue * addedCount, c_fixedPrecisionAny);
        } else if (catalogType == libHRGE_affixUserCatalogTypePerStackDeltaExclFirst) {
            catalogValueFinal = FixedToString(catalogValue * (MaxI(0, affixCount - 1) - MaxI(0, affixCount - addedCount - 1)), c_fixedPrecisionAny);
        } else if (catalogType == libHRGE_affixUserCatalogTypeBase || catalogType == libHRGE_affixUserCatalogTypeBaseDelta || catalogType == libHRGE_affixUserCatalogTypeBaseMult) {
            catalogValueFinal = CatalogReferenceGet(catalogReference, 0);
        } else if (catalogType == libHRGE_affixUserCatalogTypeString) {
            catalogValueFinal = catalogValueString;
        } else {
            libHRGE_DisplayDebugMessage("Warning: " + instance + " has invalid catalog mod type " + catalogType + ". Defaulting to Flat.");
            catalogValueFinal = FixedToString(catalogValue, c_fixedPrecisionAny);
        }

        if (catalogPlayer == 0) {
            for (j = 1; j <= libCore_gv_bALMaxGamePlayers; j += 1) {
                if (libHRGE_PlayerIsChoGallPair(j) && choGallExcluded) { continue; }

                if (catalogType == libHRGE_affixUserCatalogTypeBase) {
                    libHRGE_ApplyCatalogModificationBase(catalogReference, j, catalogValueFinal, catalogValue, affixCount, catalogOperation);
                } else if (catalogType == libHRGE_affixUserCatalogTypeBaseDelta) {
                    libHRGE_ApplyCatalogModificationBase(catalogReference, j, catalogValueFinal, catalogValue, addedCount, catalogOperation);
                } else if (catalogType == libHRGE_affixUserCatalogTypeBaseMult) {
                    libHRGE_ApplyCatalogModificationBaseMult(catalogReference, j, catalogValueFinal, catalogValue, affixCount, catalogOperation, 1);
                } else {
                    CatalogReferenceModify(catalogReference, j, catalogValueFinal, libHRGE_GetUpgradeOperation(catalogOperation));
                }
            }
        } else if (libHRGE_PlayerIsChoGallPair(catalogPlayer) && choGallExcluded) {
            continue;
        } else if (catalogPlayer >= 1 && catalogPlayer <= libCore_gv_bALMaxGamePlayers) {
            if (catalogType == libHRGE_affixUserCatalogTypeBase) {
                libHRGE_ApplyCatalogModificationBase(catalogReference, catalogPlayer, catalogValueFinal, catalogValue, affixCount, catalogOperation);
            } else if (catalogType == libHRGE_affixUserCatalogTypeBaseDelta) {
                libHRGE_ApplyCatalogModificationBase(catalogReference, catalogPlayer, catalogValueFinal, catalogValue, addedCount, catalogOperation);
            } else if (catalogType == libHRGE_affixUserCatalogTypeBaseMult) {
                libHRGE_ApplyCatalogModificationBaseMult(catalogReference, catalogPlayer, catalogValueFinal, catalogValue, affixCount, catalogOperation, 1);
            } else {
                CatalogReferenceModify(catalogReference, catalogPlayer, catalogValueFinal, libHRGE_GetUpgradeOperation(catalogOperation));
            }
        }
    }
}

void libHRGE_AddScaling(string instance, int player, string reference, fixed modifier) {
    string hero = libHRGE_GetAffixHero(instance);
    int heroIndex = libCore_gf_GetIndexFromHero(hero);
    if (libHRGE_scalingIndex >= libHRGE_maxScalingTriggers) {
        libHRGE_DisplayDebugMessage("Warning: General scaling triggers have reached maximum capacity. Failed to add " + reference);
        return;
    }
    libHRGE_scalingIndex += 1;
    libHRGE_scalingPlayers[libHRGE_scalingIndex] = player;
    libHRGE_scalingReferences[libHRGE_scalingIndex] = reference;
    libHRGE_scalingModifiers[libHRGE_scalingIndex] = modifier;
    if (hero != "" && heroIndex != 0) {
        libHRGE_scalingHeroes[libHRGE_scalingIndex] = heroIndex;
    }
}

void libHRGE_AddGeneralBehavior(string behavior, string filter) {
    if (filter == libHRGE_affixUserFilterAlliedHeroes || filter == libHRGE_affixUserFilterEnemyHeroes || filter == libHRGE_affixUserFilterAITeammates) {
        return;
    }
    if (libHRGE_generalBehaviorsIndex >= libHRGE_maxGeneralBehaviors) {
        libHRGE_DisplayDebugMessage("Warning: General behaviors have reached maximum capacity. Failed to add " + behavior);
        return;
    }
    libHRGE_generalBehaviorsIndex += 1;
    libHRGE_generalBehaviors[libHRGE_generalBehaviorsIndex] = behavior;
    libHRGE_generalFilters[libHRGE_generalBehaviorsIndex] = filter;
    libHRGE_ResolveGeneralBehavior(null, behavior, filter, libHRGE_affixOperationAddToAll);
}

void libHRGE_ResolveScaling(int index, int player) {
    int scalingPlayer = libHRGE_scalingPlayers[index];
    string reference = libHRGE_scalingReferences[index];
    fixed modifier = libHRGE_scalingModifiers[index];
    int heroIndex = libHRGE_scalingHeroes[index];
    int team = libGame_gf_TeamNumberOfPlayer(player);

    if (scalingPlayer == 0 || scalingPlayer == c_playerAny) {
        libHRGE_SetLevelScaling(reference, player, modifier);
        if (player == libHRGE_player) {
            libHRGE_SetLevelScaling(reference, libHRGE_teamOrder, modifier);
        } else if (player == libHRGE_enemy) {
            libHRGE_SetLevelScaling(reference, libHRGE_teamChaos, modifier);
        }
    } else if (scalingPlayer == libHRGE_teamOrder) {
        if (team == libHRGE_teamOrderIndex) {
            libHRGE_SetLevelScaling(reference, player, modifier);
            if (player == libHRGE_player) {
                libHRGE_SetLevelScaling(reference, libHRGE_teamOrder, modifier);
            }
        }
    } else if (scalingPlayer == libHRGE_teamChaos) {
        if (team == libHRGE_teamChaosIndex) {
            libHRGE_SetLevelScaling(reference, player, modifier);
            if (player == libHRGE_enemy) {
                libHRGE_SetLevelScaling(reference, libHRGE_teamChaos, modifier);
            }
        }
    } else if (scalingPlayer == player && scalingPlayer >= 1 && scalingPlayer <= libCore_gv_bALMaxPlayers && (libGame_gv_players[player].lv_heroIndex == heroIndex || heroIndex == 0)) {
        libHRGE_SetLevelScaling(reference, player, modifier);
    }
}

bool libHRGE_ScalingLevelUp_Func (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    int i = 1;
    
    for (;; i += 1) {
        if (i > libHRGE_scalingIndex) { break; }
        libHRGE_ResolveScaling(i, player);
    }

    return true;
}

void libHRGE_ScalingTriggers_Init() {
    libHRGE_ScalingTrigger = TriggerCreate("libHRGE_ScalingLevelUp_Func");
    libGame_gf_HeroLevelUp(libHRGE_ScalingTrigger);
}

void libHRGE_ResolveGeneralBehavior(unit targetUnit, string behavior, string filter, int operation) {
    libHRGE_Filter affixFilter;
    if (filter == libHRGE_affixUserFilterAITeammates) {
        libHRGE_CopyFilter(libHRGE_filterAITeammates, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAllAllies) {
        libHRGE_CopyFilter(libHRGE_filterAllAllies, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedHeroes) {
        libHRGE_CopyFilter(libHRGE_filterAlliedHeroes, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedStructures) {
        libHRGE_CopyFilter(libHRGE_filterAlliedStructures, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedStructuresExclCore) {
        libHRGE_CopyFilter(libHRGE_filterAlliedStructuresExcludingCore, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedCore) {
        libHRGE_CopyFilter(libHRGE_filterAlliedCore, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedMinions) {
        libHRGE_CopyFilter(libHRGE_filterAlliedMinions, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedMinionsRanged) {
        libHRGE_CopyFilter(libHRGE_filterAlliedMinionsRanged, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedMinionsCatapult) {
        libHRGE_CopyFilter(libHRGE_filterAlliedMinionsCatapult, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedMinionsMelee) {
        libHRGE_CopyFilter(libHRGE_filterAlliedMinionsMelee, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedMinionsWizard) {
        libHRGE_CopyFilter(libHRGE_filterAlliedMinionsWizard, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedMercenaries) {
        libHRGE_CopyFilter(libHRGE_filterAlliedMercenaries, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedSummons) {
        libHRGE_CopyFilter(libHRGE_filterAlliedSummons, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAlliedSiegeGiants) {
        libHRGE_CopyFilter(libHRGE_filterAlliedSiegeGiants, affixFilter);
    } else if (filter == libHRGE_affixUserFilterAllEnemies) {
        libHRGE_CopyFilter(libHRGE_filterAllEnemies, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyHeroes) {
        libHRGE_CopyFilter(libHRGE_filterEnemyHeroes, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyStructures) {
        libHRGE_CopyFilter(libHRGE_filterEnemyStructures, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyStructuresExclCore) {
        libHRGE_CopyFilter(libHRGE_filterEnemyStructuresExcludingCore, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyCore) {
        libHRGE_CopyFilter(libHRGE_filterEnemyCore, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyMinions) {
        libHRGE_CopyFilter(libHRGE_filterEnemyMinions, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyMinionsRanged) {
        libHRGE_CopyFilter(libHRGE_filterEnemyMinionsRanged, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyMinionsCatapult) {
        libHRGE_CopyFilter(libHRGE_filterEnemyMinionsCatapult, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyMinionsMelee) {
        libHRGE_CopyFilter(libHRGE_filterEnemyMinionsMelee, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyMinionsWizard) {
        libHRGE_CopyFilter(libHRGE_filterEnemyMinionsWizard, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemyMercenaries) {
        libHRGE_CopyFilter(libHRGE_filterEnemyMercenaries, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemySummons) {
        libHRGE_CopyFilter(libHRGE_filterEnemySummons, affixFilter);
    } else if (filter == libHRGE_affixUserFilterEnemySiegeGiants) {
        libHRGE_CopyFilter(libHRGE_filterEnemySiegeGiants, affixFilter);
    } else {
        libHRGE_DisplayDebugMessage("Warning: " + behavior + " has invalid filter " + filter);
        return;
    }

    if (operation == libHRGE_affixOperationAll) {
        libHRGE_AddUnitBehaviorToAllFilter(behavior, 1, affixFilter);
        libHRGE_AddUnitBehaviorFilter(targetUnit, behavior, 1, affixFilter);
        libHRGE_UpdateUnitBehaviorFilter(targetUnit, behavior, 1, affixFilter);
    } else if (operation == libHRGE_affixOperationAddToAll) {
        libHRGE_AddUnitBehaviorToAllFilter(behavior, 1, affixFilter);
    } else if (operation == libHRGE_affixOperationUnitCreated) {
        libHRGE_AddUnitBehaviorFilter(targetUnit, behavior, 1, affixFilter);
    } else if (operation == libHRGE_affixOperationUnitChangeOwner) {
        libHRGE_UpdateUnitBehaviorFilter(targetUnit, behavior, 1, affixFilter);
    } else {
        libHRGE_DisplayDebugMessage("Warning: " + behavior + " has invalid operation " + IntToString(operation));
    }
}

bool libHRGE_GeneralUnitCreated_Func (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    string behavior;
    string filter;
    int i = 1;
    if (testConds) {
        if (UnitFilterMatch(eventUnit, c_playerAny, UnitFilter(1 << c_targetFilterMissile | 1 << c_targetFilterItem, 1 << c_targetFilterHidden, 0, 0))) {
            return false;
        }
    }
    for (;; i += 1) {
        if (i > libHRGE_generalBehaviorsIndex) { break; }
        behavior = libHRGE_generalBehaviors[i];
        filter = libHRGE_generalFilters[i];
        libHRGE_ResolveGeneralBehavior(eventUnit, behavior, filter, libHRGE_affixOperationUnitCreated);
    }
    return true;
}
bool libHRGE_GeneralUnitChangeOwner_Func (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    string behavior;
    string filter;
    int i = 1;
    if (testConds) {
        if (UnitFilterMatch(eventUnit, c_playerAny, UnitFilter(1 << c_targetFilterMissile | 1 << c_targetFilterItem, 1 << c_targetFilterHidden, 0, 0))) {
            return false;
        }
    }
    for (;; i += 1) {
        if (i > libHRGE_generalBehaviorsIndex) { break; }
        behavior = libHRGE_generalBehaviors[i];
        filter = libHRGE_generalFilters[i];
        libHRGE_ResolveGeneralBehavior(eventUnit, behavior, filter, libHRGE_affixOperationUnitChangeOwner);
    }
    return true;
}
void libHRGE_GeneralTriggers_Init() {
    libHRGE_GeneralUnitCreatedTrigger = TriggerCreate("libHRGE_GeneralUnitCreated_Func");
    libHRGE_GeneralUnitChangeOwnerTrigger = TriggerCreate("libHRGE_GeneralUnitChangeOwner_Func");
    TriggerAddEventUnitCreated(libHRGE_GeneralUnitCreatedTrigger, null, null, null);
    TriggerAddEventUnitChangeOwner(libHRGE_GeneralUnitChangeOwnerTrigger, null);
}

void libHRGE_AddDefaultExcludedUnits(structref<libHRGE_Filter> filter) {
    libHRGE_AddExcludedUnitTypeFilter(filter, "AnubarakCocoonNormal");
    libHRGE_AddExcludedUnitTypeFilter(filter, "AnubarakCocoonFat");
    libHRGE_AddExcludedUnitTypeFilter(filter, "RagnarosLavaWaveLaneUnit");
    libHRGE_AddExcludedUnitTypeFilter(filter, "ArtanisSpearofAdunPurifierBeamInvisibleTrackingUnit");
    libHRGE_AddExcludedUnitTypeFilter(filter, "DeckardLorenado");
    libHRGE_AddExcludedUnitTypeFilter(filter, "MaievContainmentDiscCrystalUnit");
    libHRGE_AddExcludedUnitTypeFilter(filter, "AmazonBallLightningController");
    libHRGE_AddExcludedUnitTypeFilter(filter, "ZuljinTwinCleaveRightUnit");
    libHRGE_AddExcludedUnitTypeFilter(filter, "ZuljinTwinCleaveLeftUnit");
    libHRGE_AddExcludedUnitTypeFilter(filter, "AnubarakLocustSwarmMasteryBug");
    libHRGE_AddExcludedUnitTypeFilter(filter, "DocksTreasureChest");
}
void libHRGE_InitFilters() {
    // ============================================================
    // ALLIED
    // ============================================================
    libHRGE_filterAllAllies.unitFilter = UnitFilter(0, 0, (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterCreep) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_AddDefaultExcludedUnits(libHRGE_filterAllAllies);

    libHRGE_filterAlliedHeroes.unitFilter = UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));;
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterAlliedHeroes, "SlivanBoss");

    libHRGE_filterAITeammates.unitFilter = UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterPlayer) | (1 << c_targetFilterSelf) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));;
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterAITeammates, "SlivanBoss");

    libHRGE_filterAlliedStructures.unitFilter = UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_filterAlliedStructures.requiredPlayer = libHRGE_teamOrder;

    libHRGE_CopyFilter(libHRGE_filterAlliedStructures, libHRGE_filterAlliedStructuresExcludingCore);
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterAlliedStructuresExcludingCore, "KingsCore");

    libHRGE_CopyFilter(libHRGE_filterAlliedStructures, libHRGE_filterAlliedCore);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlliedCore, "KingsCore");

    libHRGE_filterAlliedMinions.unitFilter = UnitFilter((1 << c_targetFilterMinion), 0, (1 << c_targetFilterMerc) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterMapBoss - 32)) | (1 << (c_targetFilterMapCreature - 32)));
    libHRGE_filterAlliedMinions.requiredPlayer = libHRGE_teamOrder;

    libHRGE_CopyFilter(libHRGE_filterAlliedMinions, libHRGE_filterAlliedMinionsRanged);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlliedMinionsRanged, "RangedMinion");

    libHRGE_CopyFilter(libHRGE_filterAlliedMinions, libHRGE_filterAlliedMinionsCatapult);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlliedMinionsCatapult, "CatapultMinion");

    libHRGE_CopyFilter(libHRGE_filterAlliedMinions, libHRGE_filterAlliedMinionsMelee);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlliedMinionsMelee, "FootmanMinion");
    
    libHRGE_CopyFilter(libHRGE_filterAlliedMinions, libHRGE_filterAlliedMinionsWizard);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlliedMinionsWizard, "WizardMinion");

    libHRGE_filterAlliedMercenaries.unitFilter = UnitFilter((1 << c_targetFilterMerc), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_filterAlliedMercenaries.requiredPlayer = libHRGE_teamOrder;

    libHRGE_filterAlliedSummons.unitFilter = UnitFilter((1 << c_targetFilterSummoned), 0, (1 << c_targetFilterMinion) | (1 << c_targetFilterMerc) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterMapBoss - 32)) | (1 << (c_targetFilterMapCreature - 32)));
    libHRGE_filterAlliedSummons.requiredPlayer = libHRGE_teamOrder;

    libHRGE_CopyFilter(libHRGE_filterAllEnemies, libHRGE_filterAlliedSiegeGiants);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterAlliedSiegeGiants, "MercLanerSiegeGiant");

    // ============================================================
    // ENEMY
    // ============================================================
    libHRGE_filterAllEnemies.unitFilter = UnitFilter(0, 0, (1 << c_targetFilterPlayer) | (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterCreep) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_AddDefaultExcludedUnits(libHRGE_filterAllEnemies);

    libHRGE_CopyFilter(libHRGE_filterAllEnemies, libHRGE_filterDifficulty);

    libHRGE_filterEnemyHeroes.unitFilter = UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterPlayer) | (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterEnemyHeroes, "SlivanBoss");

    libHRGE_filterEnemyStructures.unitFilter = UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_filterEnemyStructures.requiredPlayer = libHRGE_teamChaos;

    libHRGE_CopyFilter(libHRGE_filterEnemyStructures, libHRGE_filterEnemyStructuresExcludingCore);
    libHRGE_AddExcludedUnitTypeFilter(libHRGE_filterEnemyStructuresExcludingCore, "KingsCore");

    libHRGE_CopyFilter(libHRGE_filterEnemyStructures, libHRGE_filterEnemyCore);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterEnemyCore, "KingsCore");
    
    libHRGE_filterEnemyMinions.unitFilter = UnitFilter((1 << c_targetFilterMinion), 0, (1 << c_targetFilterMerc) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterMapBoss - 32)) | (1 << (c_targetFilterMapCreature - 32)));
    libHRGE_filterEnemyMinions.requiredPlayer = libHRGE_teamChaos;

    libHRGE_CopyFilter(libHRGE_filterEnemyMinions, libHRGE_filterEnemyMinionsRanged);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterEnemyMinionsRanged, "RangedMinion");

    libHRGE_CopyFilter(libHRGE_filterAlliedMinions, libHRGE_filterEnemyMinionsCatapult);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterEnemyMinionsCatapult, "CatapultMinion");

    libHRGE_CopyFilter(libHRGE_filterEnemyMinions, libHRGE_filterEnemyMinionsMelee);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterEnemyMinionsMelee, "FootmanMinion");
    
    libHRGE_CopyFilter(libHRGE_filterEnemyMinions, libHRGE_filterEnemyMinionsWizard);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterEnemyMinionsWizard, "WizardMinion");

    libHRGE_filterEnemyMercenaries.unitFilter = UnitFilter((1 << c_targetFilterMerc), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    libHRGE_filterEnemyMercenaries.requiredPlayer = libHRGE_teamChaos;

    libHRGE_filterEnemySummons.unitFilter = UnitFilter((1 << c_targetFilterSummoned), 0, (1 << c_targetFilterMinion) | (1 << c_targetFilterMerc) | (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterMapBoss - 32)) | (1 << (c_targetFilterMapCreature - 32)));
    libHRGE_filterEnemySummons.requiredPlayer = libHRGE_teamChaos;

    libHRGE_CopyFilter(libHRGE_filterAllEnemies, libHRGE_filterEnemySiegeGiants);
    libHRGE_AddRequiredUnitTypeFilter(libHRGE_filterEnemySiegeGiants, "MercLanerSiegeGiant");

}

void libHRGE_InitDebugOptions() {
    // Debug options
    libHRGE_debug_enableTryMeMode2 = false;
    libHRGE_debug_enableCheatCommands = false;
    libHRGE_debug_disableHeroSelection = false;
    libHRGE_debug_enableDebugLogging = false;
    libHRGE_debug_ignoreMap = false;
    libHRGE_debug_disablePausing = false;
    libHRGE_debug_disableAffixQueue = false;
    libHRGE_debug_printDialogControls = false;
    libHRGE_debug_playerHero[1] = "";
    libHRGE_debug_playerHero[2] = "";
    libHRGE_debug_playerHero[3] = "";
    libHRGE_debug_playerHero[4] = "";
    libHRGE_debug_playerHero[5] = "";
    libHRGE_debug_playerHero[6] = "";
    libHRGE_debug_playerHero[7] = "";
    libHRGE_debug_playerHero[8] = "";
    libHRGE_debug_playerHero[9] = "";
    libHRGE_debug_playerHero[10] = "";

    libTRYM_loadTryMeMode = libHRGE_debug_enableTryMeMode2;
    libCore_gv_dEBUGPingLimitEnabled = false;
}

bool libHRGE_InitVariables_completed = false;
void libHRGE_InitVariables () {
    int i;
    string instance;
    if (libHRGE_InitVariables_completed) { return; }

    libHRGE_dialogBackdrop = c_invalidDialogId;
    libHRGE_dialogControlBackdrop = c_invalidDialogControlId;
    libHRGE_dialogAffixSelection.dialog = c_invalidDialogId;
    libHRGE_dialogAffixSelection.titleLabel = c_invalidDialogControlId;
    libHRGE_dialogAffixSelection.rerollLabel = c_invalidDialogControlId;
    libHRGE_dialogAffixSelection.rerollButton = c_invalidDialogControlId;
    for (i = 1; i <= libHRGE_maxAffixSelection; i += 1) {
        libHRGE_dialogAffixSelection.items[i].affixBackground = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].background = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].banButton = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].icon = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].iconOverlay = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].nameLabel = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].rarityLabel = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].selectButton = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].tooltipLabel = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].talentPreview = c_invalidDialogControlId;
        libHRGE_dialogAffixSelection.items[i].unlockPreview = c_invalidDialogControlId;
    }
    libHRGE_dialogOwnedAffixes.dialog = c_invalidDialogId;
    libHRGE_dialogOwnedAffixes.label = c_invalidDialogControlId;
    libHRGE_dialogOwnedAffixes.nextButton = c_invalidDialogControlId;
    libHRGE_dialogOwnedAffixes.previousButton = c_invalidDialogControlId;
    for (i = 1; i <= libHRGE_maxOwnedAffixesPerPage; i += 1) {
        libHRGE_dialogOwnedAffixes.items[i].nameLabel = c_invalidDialogControlId;
        libHRGE_dialogOwnedAffixes.items[i].cooldownLabel = c_invalidDialogControlId;
        libHRGE_dialogOwnedAffixes.items[i].icon = c_invalidDialogControlId;
        libHRGE_dialogOwnedAffixes.items[i].iconOverlay = c_invalidDialogControlId;
    }
    libHRGE_dialogOptions.dialog = c_invalidDialogId;
    libHRGE_dialogOptions.frame = c_invalidDialogControlId;
    libHRGE_dialogOptions.label = c_invalidDialogControlId;
    libHRGE_dialogOptionsRestart.dialog = c_invalidDialogId;
    libHRGE_dialogOptionsRestart.frame = c_invalidDialogControlId;
    libHRGE_dialogOptionsRestart.label = c_invalidDialogControlId;
    for (i = 1; i <= libHRGE_maxOptionDialogs; i += 1) {
        libHRGE_dialogOptions.option[i].button = c_invalidDialogControlId;
        libHRGE_dialogOptions.option[i].checkbox = c_invalidDialogControlId;
        libHRGE_dialogOptions.option[i].label = c_invalidDialogControlId;
        libHRGE_dialogOptionsRestart.option[i].button = c_invalidDialogControlId;
        libHRGE_dialogOptionsRestart.option[i].checkbox = c_invalidDialogControlId;
        libHRGE_dialogOptionsRestart.option[i].label = c_invalidDialogControlId;
    }
    libHRGE_dialogControlOptionsSpeedUpDeath = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsSpeedUpGates = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsDisplayPicksBans = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsAlwaysShowExtendedTooltips = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsAchievementsButton = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsRestartButton = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsReturnButton = c_invalidDialogControlId;
    libHRGE_dialogControlOwnedAffixesButton = c_invalidDialogControlId;
    libHRGE_dialogControlOptionsButton = c_invalidDialogControlId;
    libHRGE_dialogControlRunLabel = c_invalidDialogControlId;
    
    libHRGE_dialogControls = c_invalidDialogId;
    libHRGE_dialogInfo = c_invalidDialogId;
    libHRGE_dialogGameover.dialog = c_invalidDialogId;
    libHRGE_dialogGameover.continueButton = c_invalidDialogControlId;
    libHRGE_dialogGameover.exitButton = c_invalidDialogControlId;
    libHRGE_dialogGameover.label = c_invalidDialogControlId;
    libHRGE_dialogGameover.leftStats = c_invalidDialogControlId;
    libHRGE_dialogGameover.middleStats = c_invalidDialogControlId;
    libHRGE_dialogGameover.rightStats = c_invalidDialogControlId;
    libHRGE_dialogGameover.restartButton = c_invalidDialogControlId;

    libHRGE_dialogAchievements.dialog = c_invalidDialogId;
    libHRGE_dialogAchievements.closeButton = c_invalidDialogControlId;
    libHRGE_dialogAchievements.resetButton = c_invalidDialogControlId;
    libHRGE_dialogAchievements.label = c_invalidDialogControlId;
    for (i = 1; i <= libHRGE_maxAchievements; i += 1) {
        libHRGE_dialogAchievements.achievement[i].button = c_invalidDialogControlId;
        libHRGE_dialogAchievements.achievement[i].label = c_invalidDialogControlId;
        libHRGE_dialogAchievements.achievement[i].overlay = c_invalidDialogControlId;
    }
    libHRGE_dialogAchievementsReset.dialog = c_invalidDialogId;
    libHRGE_dialogAchievementsReset.frame = c_invalidDialogControlId;
    libHRGE_dialogAchievementsReset.label = c_invalidDialogControlId;
    for (i = 1; i <= libHRGE_maxOptionDialogs; i += 1) {
        libHRGE_dialogAchievementsReset.option[i].button = c_invalidDialogControlId;
        libHRGE_dialogAchievementsReset.option[i].checkbox = c_invalidDialogControlId;
        libHRGE_dialogAchievementsReset.option[i].label = c_invalidDialogControlId;
    }
    libHRGE_dialogGameoverExit.dialog = c_invalidDialogId;
    libHRGE_dialogGameoverExit.frame = c_invalidDialogControlId;
    libHRGE_dialogGameoverExit.label = c_invalidDialogControlId;
    for (i = 1; i <= libHRGE_maxOptionDialogs; i += 1) {
        libHRGE_dialogGameoverExit.option[i].button = c_invalidDialogControlId;
        libHRGE_dialogGameoverExit.option[i].checkbox = c_invalidDialogControlId;
        libHRGE_dialogGameoverExit.option[i].label = c_invalidDialogControlId;
    }
    
    libHRGE_boonsNextGame = 3;
    libHRGE_cursesNextGame = 3;

    libHRGE_registeredAffixes = UserDataInstanceCount(libHRGE_affixUserData);

    libHRGE_InitDebugOptions();
    libHRGE_InitFilters();
    libHRGE_CreateUI();
    
    for (i = 1; i <= libHRGE_registeredAffixes; i += 1) {
        instance = libHRGE_GetAffixInstance(i);
        if (libHRGE_AffixIsHeroExclusive(instance) && libHRGE_GetAffixRarity(instance) == libHRGE_rarityStarter) {
            libHRGE_goldenHero[libCore_gf_GetIndexFromHero(libHRGE_GetAffixHero(instance))] = true;
        }
    }

    libHRGE_InitVariables_completed = true;
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libHRGE_InitLib_completed = false;
void libHRGE_InitLib () {
    if (libHRGE_InitLib_completed) { return; }

    libHRGE_InitLibraries();
    libHRGE_InitVariables();
    libHRGE_InitAchievements();
    libHRGE_InitTriggers();

    libHRGE_InitLib_completed = true;
}


include "HRLibs/HRTriggersLib"