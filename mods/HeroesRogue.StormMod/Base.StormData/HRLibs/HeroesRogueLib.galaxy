text libHRGE_GetAffixRerollLabel() {
    int rarity = libHRGE_currentQueue.rarity;
    bool curse = libHRGE_currentQueue.curse;
    if (rarity == libHRGE_rarityStarter) {
        return StringExternal("Label/Name/RerollStarter");
    } else if (curse) {
        return StringExternal("Label/Name/RerollCurse") + IntToText(libHRGE_rerollsCurse);
    }
    return StringExternal("Label/Name/Reroll") + IntToText(libHRGE_rerolls);
