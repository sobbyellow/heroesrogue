  </CEffectEnumArea>

  <CEffectSet id="LostVikingsSpinToWinVikingBeybladeImpactSet">
    <EffectArray value="LostVikingsSpinToWinVikingBeybladeApplyBehavior" />
    <ValidatorArray value="LostVikingsIsViking" />
