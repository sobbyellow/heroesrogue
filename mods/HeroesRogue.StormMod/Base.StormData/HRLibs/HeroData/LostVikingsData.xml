    <AreaArray Effect="LostVikingsSpinToWinBeybladeImpactSet">
      <Radius value="2" />
    </AreaArray>
    <SearchFlags index="ExtendByUnitRadius" value="1" />
  </CEffectEnumArea>
  <CEffectSet id="LostVikingsSpinToWinBeybladeImpactSet">
    <EffectArray value="LostVikingsSpinToWinBeybladeDamage" />
    <EffectArray value="ApplyAbilityImpactReveal" />
    <ValidatorArray value="NotLostVikingsController" />
  </CEffectSet>

  <CEffectDamage id="LostVikingsSpinToWinBeybladeDamage" parent="StormSpell">
    <Amount value="42.5" />
