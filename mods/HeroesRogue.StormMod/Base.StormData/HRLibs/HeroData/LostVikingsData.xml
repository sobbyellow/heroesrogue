  </CButton>
  <CBehaviorAbility id="LostVikingsSpinToWinBeybladeCarry">
    <Buttons Face="LostVikingsSpinToWinBeyblade" Type="AbilCmd" AbilCmd="LostVikingsSpinToWinBeyblade,Execute" />
  </CBehaviorAbility>

  <CUnit id="HeroErik">
    <AbilArray Link="LostVikingsNorseForcePassive" />
