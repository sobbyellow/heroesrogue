  <CEffectApplyBehavior id="LostVikingsSpinToWinVikingBeybladeApplyBehavior">
    <Behavior value="LostVikingsSpinToWinVikingBeybladeActive" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="LostVikingsSpinToWinVikingBeybladeActive">
    <Duration value="0.0625" />
  </CBehaviorBuff>

  <CEffectEnumArea id="LostVikingsSpinToWinBeybladeSearch">
    <ImpactLocation Value="TargetUnit" />
