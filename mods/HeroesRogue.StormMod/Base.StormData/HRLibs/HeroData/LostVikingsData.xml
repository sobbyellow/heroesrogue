      <UnifiedMoveSpeedFactor value="0">
        <AccumulatorArray value="LostVikingsGreatVikingHoardAccumulatorSpeed" />
      </UnifiedMoveSpeedFactor>
      <DamageDealtFraction index="Ability" value="0">
        <AccumulatorArray value="LostVikingsGreatVikingHoardAccumulator" />
      </DamageDealtFraction>
      <DamageDealtFraction index="Basic" value="0">
        <AccumulatorArray value="LostVikingsGreatVikingHoardAccumulator" />
      </DamageDealtFraction>
      <VitalMaxFractionArray index="Life" value="0">
        <AccumulatorArray value="LostVikingsGreatVikingHoardAccumulator" />
      </VitalMaxFractionArray>
    </Modification>
  </CBehaviorBuff>
  <CBehaviorBuff id="LostVikingsGoGoGo">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_temp_war3_btnbootsofspeed.dds" />
    <Duration value="4" />
    <Modification>
      <StateFlags index="SuppressFidgeting" value="1" />
      <UnifiedMoveSpeedFactor value="0.3">
        <AccumulatorArray value="LostVikingsGreatVikingHoardAccumulatorSpeedGoGoGo" />
      </UnifiedMoveSpeedFactor>
    </Modification>
    <DisableValidatorArray value="DoesNotHaveLostVikingDowned" />
  </CBehaviorBuff>

<CAbilEffectInstant id="LostVikingsNorseForceAffix">
