    <Effect value="LostVikingsBeybladeCastSet" />
    <Cost>
      <Cooldown Location="Player" TimeUse="30" />
    </Cost>
    <CmdButtonArray index="Execute" DefaultButtonFace="LostVikingsSpinToWinBeyblade" />
  </CAbilEffectInstant>

  <CEffectSet id="LostVikingsBeybladeCastSet">
    <EffectArray value="LostVikingsBeybladeSet" />
    <EffectArray value="LostVikingsBeybladeCreatePersistent" />
  </CEffectSet>

  <CEffectCreatePersistent id="LostVikingsBeybladeCreatePersistent">
    <PeriodCount value="10" />
    <PeriodicPeriodArray value="0.375" />
    <PeriodicEffectArray value="LostVikingsBeybladeSet" />
  </CEffectCreatePersistent>

  <CEffectSet id="LostVikingsBeybladeSet">
    <EffectArray value="LostVikingsSpinToWinVikingBeybladeSearch" />
    <EffectArray value="LostVikingsSpinToWinVikingSearch" />
  </CEffectSet>

  <CEffectEnumArea id="LostVikingsSpinToWinVikingBeybladeSearch">
    <ImpactLocation Value="SourceUnit" />
    <SearchFilters value="Heroic;Ally,Neutral,Enemy,RawResource,HarvestableResource,Missile,Item,Stasis,Dead,Hidden,OrdersPaused" />
    <AreaArray MaxCount="4" Effect="LostVikingsSpinToWinVikingBeybladeImpactSet">
