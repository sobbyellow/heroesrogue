include "HRLibs/HRTriggersLib"

unit libHRGE_NightElfBondMalfurion;
unit libHRGE_NightElfBondTyrande;

// ============================================================
// Night Elf Bond
// ============================================================
void libHRGE_TyrandeNightElfBondSpawnMalfurion () {
    fixed sharedHealth;
    if (libHRGE_NightElfBondMalfurion == null || !UnitIsAlive(libHRGE_NightElfBondMalfurion)) {
        libNtve_gf_CreateUnitsAtPoint2(1, "HeroMalfurion", c_unitCreateIgnorePlacement, libHRGE_teamOrder, PointWithOffsetPolar(UnitGetPosition(libGame_gv_players[libHRGE_player].lv_heroUnit), 5, RandomFixed(0, 360)), null);
        libHRGE_NightElfBondMalfurion = UnitLastCreated();
        libHRGE_NightElfBondTyrande = libHRGE_GetPlayerHeroUnit(libHRGE_player);
        libNtve_gf_SendActorMessageToUnit(libHRGE_NightElfBondMalfurion, "Signal Respawn");
        UnitCreateEffectUnit(libGame_gv_players[libHRGE_player].lv_heroUnit, "ApplyNightElfBondMalfurion", libHRGE_NightElfBondMalfurion);
        sharedHealth = (UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, true) + UnitGetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, true) / 2);
        UnitSetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, sharedHealth);
        UnitSetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, sharedHealth);
    }
}
bool libHRGE_TyrandeNightElfBondDamageTaken (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    fixed incomingDamage = EventUnitDamageAmount();
    if (testConds) {
        if (eventUnit != libHRGE_NightElfBondMalfurion && eventUnit != libHRGE_NightElfBondTyrande) {
            return false;
        }
        if (libHRGE_NightElfBondMalfurion == null || libHRGE_NightElfBondTyrande == null) {
            return false;
        }
    }
    if (eventUnit == libHRGE_NightElfBondTyrande) {
        //UnitSetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, true) + incomingDamage / 2);
        UnitSetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, true));
    } else {
        //UnitSetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, true) + incomingDamage / 2);
        UnitSetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, true));
    }
    return true;
}
bool libHRGE_TyrandeNightElfBondHealed (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    fixed healingReceived = EventUnitHealAmount();
    if (testConds) {
        if (eventUnit != libHRGE_NightElfBondMalfurion && eventUnit != libHRGE_NightElfBondTyrande) {
            return false;
        }
        if (libHRGE_NightElfBondMalfurion == null || libHRGE_NightElfBondTyrande == null) {
            return false;
        }
    }
    if (eventUnit == libHRGE_NightElfBondTyrande) {
        //UnitSetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, true) - healingReceived / 2);
        UnitSetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, true));
    } else {
        //UnitSetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, true) - healingReceived / 2);
        UnitSetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLife, true));
    }
    return true;
}
bool libHRGE_TyrandeNightElfBondOncePerGame (bool testConds, bool runActions) {
    trigger damageEvent = TriggerCreate("libHRGE_TyrandeNightElfBondDamageTaken");
    trigger healEvent = TriggerCreate("libHRGE_TyrandeNightElfBondHealed");

    TriggerAddDamageEvent(damageEvent, null, "HeroTyrande", c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddDamageEvent(damageEvent, null, "HeroMalfurion", c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventUnitHealed(healEvent, null, c_unitVitalLife, null);
    return true;
}
bool libHRGE_TyrandeNightElfBondAffixAdded (bool testConds, bool runActions) {
    libHRGE_TyrandeNightElfBondSpawnMalfurion();
    return true;
}
bool libHRGE_TyrandeNightElfBondRespawn (bool testConds, bool runActions) {
    int player = libGame_gf_HeroRespawnPlayer();
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
    }
    libHRGE_TyrandeNightElfBondSpawnMalfurion();

    return true;
}
bool libHRGE_TyrandeNightElfBondUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = EventPlayer();
    if (testConds) {
        if (deadPlayer != libHRGE_player && deadUnit != libHRGE_NightElfBondMalfurion) {
            return false;
        }
    }
    if (deadPlayer == libHRGE_player) {
        UnitKill(libHRGE_NightElfBondMalfurion);
        UnitRemove(libHRGE_NightElfBondMalfurion);
    } else if (deadUnit == libHRGE_NightElfBondMalfurion) {
        UnitCreateEffectUnit(libGame_gv_players[libHRGE_player].lv_heroUnit, "NightElfBondDamage", libGame_gv_players[libHRGE_player].lv_heroUnit);
    }

    return true;
}
bool libHRGE_TyrandeNightElfBondPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (!UnitIsAlive(libHRGE_NightElfBondMalfurion)) {
            return false;
        }
        if (libHRGE_gamePaused || libGame_gv_gameOver) {
            return false;
        }
    }
    if ((DistanceBetweenPoints(UnitGetPosition(libHRGE_NightElfBondMalfurion), UnitGetPosition(libHRGE_NightElfBondTyrande)) >= 24)) {
        UnitSetPosition(libHRGE_NightElfBondMalfurion, PointWithOffsetPolar(UnitGetPosition(libHRGE_NightElfBondTyrande), 1.5, RandomFixed(0, 360)), false);
        UnitIssueOrder(libHRGE_NightElfBondMalfurion, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    }

    if (UnitGetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLifeMax, true) != UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLifeMax, true)) {
        UnitSetPropertyFixed(libHRGE_NightElfBondMalfurion, c_unitPropLifeMax, UnitGetPropertyFixed(libHRGE_NightElfBondTyrande, c_unitPropLifeMax, true));
    }

    return true;
}

// ============================================================
// Flyby Attack
// ============================================================
bool libHRGE_TyrandeFlybyAttackAffixAdded (bool testConds, bool runActions) {
    if (PlayerHasTalent(libHRGE_player, "TyrandeRanger")) {
        libHRGE_CatalogReferenceModify("Effect,SentinelShotMissileSearchPvE,AreaArray[0].RectangleWidth", libHRGE_player, "1.25", c_upgradeOperationAdd);
    }
    return true;
}
bool libHRGE_TyrandeFlybyAttackEffectUsed (bool testConds, bool runActions) {
    unit caster =  EventPlayerEffectUsedUnit(c_effectUnitCaster);
    point casterPoint = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    int player = UnitGetOwner(caster);
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
    }
    UnitCreateEffectPoint(caster, "SentinelShotMissileSearchPvE", casterPoint);
    return true;
}
bool libHRGE_TyrandeFlybyAttackTalentGained (bool testConds, bool runActions) {
    int player = libGame_gf_HeroGainTalentPlayer();
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
        if (talent != "TyrandeRanger") {
            return false;
        }
    }
    libHRGE_CatalogReferenceModify("Effect,SentinelShotMissileSearchPvE,AreaArray[0].RectangleWidth", libHRGE_player, "1.25", c_upgradeOperationAdd);

    return true;
}

// ============================================================
// Shadowstalker
// ============================================================

bool libHRGE_TyrandeShadowstalkerEffectUsed (bool testConds, bool runActions) {
    unit caster = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int player = UnitGetOwner(caster);
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
    }
    libHRGE_UnitCreateEffectUnitToAllFilter(caster, "TyrandeShadowstalkApplyHealingBehavior", libHRGE_filterAlliedMinions);
    return true;
}
