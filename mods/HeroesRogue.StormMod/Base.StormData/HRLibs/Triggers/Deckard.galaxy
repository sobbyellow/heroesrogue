include "HRLibs/HRTriggersLib"

bool libHRGE_DeckardPoisonousPotionOncePerGame (bool testConds, bool runActions) {
    if (PlayerHasTalent(libHRGE_player, "DeckardPotionOfRevival")) {
        libHRGE_CatalogReferenceModify("Effect,DeckardPoisonousPotionPotionOfRevivalSearch,Chance", libHRGE_player, "1", c_upgradeOperationSet);
    }
    return true;
}

bool libHRGE_DeckardPoisonousPotionTalentGained (bool testConds, bool runActions) {
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    int player = libGame_gf_HeroGainTalentPlayer();
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
        if (talent != "DeckardPotionOfRevival") {
            return false;
        }
    }
    libHRGE_CatalogReferenceModify("Effect,DeckardPoisonousPotionPotionOfRevivalSearch,Chance", player, "1", c_upgradeOperationSet);

    return true;
}

bool libHRGE_DeckardPotionSellerTalentGained (bool testConds, bool runActions) {
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    int player = libGame_gf_HeroGainTalentPlayer();
    if (testConds) {
        if (player != libHRGE_player) {
            return false;
        }
        if (talent != "DeckardPotionOfRevival") {
            return false;
        }
    }
    libHRGE_CatalogReferenceModify("Effect,DeckardHealingPotionPotionOfRevivalNonHeroicSearch,Chance", player, "1", c_upgradeOperationSet);

    return true;
}
bool libHRGE_DeckardPotionSellerOncePerGame (bool testConds, bool runActions) {
    if (PlayerHasTalent(libHRGE_player, "DeckardPotionOfRevival")) {
        libHRGE_CatalogReferenceModify("Effect,DeckardHealingPotionPotionOfRevivalNonHeroicSearch,Chance", libHRGE_player, "1", c_upgradeOperationSet);
    }
    return true;
}