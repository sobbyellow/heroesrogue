include "HRLibs/HRTriggersLib"

// ============================================================
// Great Viking Hoard
// ============================================================
bool libHRGE_LostVikingsGreatVikingHoardHeroKilled (bool testConds, bool runActions) {
    int i;
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    if (testConds) {
        if (deadPlayer < 6 || deadPlayer > 10) {
            return false;
        }
        if (!UnitTypeTestAttribute(UnitGetType(deadUnit), c_unitAttributeHeroic)) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    for (i = 1; i <= 3; i += 1) {
        UnitCreate(1, "RegenGlobe", 0, libHRGE_teamOrder, PointWithOffsetPolar(UnitGetPosition(deadUnit), 1.5, 120 * i), 0, null);
        UnitBehaviorRemove(UnitLastCreated(), "RegenGlobeTimedLifeInitial", 1);
        UnitBehaviorAdd(UnitLastCreated(), "RegenGlobeTimedLife", UnitLastCreated(), 1);
        UnitBehaviorSetDuration(UnitLastCreated(), "RegenGlobeTimedLife", 6);
    }
              
    return true;
}
bool libHRGE_LostVikingsGreatVikingHoardUnitDiedStructure (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    if (testConds) {
        if (UnitGetOwner(deadUnit) != 12) {
            return false;
        }
        if (!UnitTypeTestAttribute(UnitGetType(deadUnit), c_unitAttributeStructure)) {
            return false;
        }
    }
    UnitCreate(1, "RegenGlobe", 0, libHRGE_teamOrder, UnitGetPosition(deadUnit), 0, null);
    UnitBehaviorRemove(UnitLastCreated(), "RegenGlobeTimedLifeInitial", 1);
    UnitBehaviorAdd(UnitLastCreated(), "RegenGlobeTimedLife", UnitLastCreated(), 1);
    UnitBehaviorSetDuration(UnitLastCreated(), "RegenGlobeTimedLife", 6);
              
    return true;
}
// ============================================================
// Specialized Vikings
// ============================================================
bool libHRGE_LostVikingsSpecializedVikings (bool testConds, bool runActions) {
    int i;
    unitgroup unitGroup = libGame_gv_players[libHRGE_player].lv_heroUnitGroup;
    int unitGroupCount = UnitGroupCount(unitGroup, c_unitCountAll);
    for (i = unitGroupCount; i > 0; i -= 1) {
        if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) == "HeroErik") {
            UnitBehaviorAdd(UnitGroupUnitFromEnd(unitGroup, i), "LostVikingsSpecializedErikBehavior", UnitGroupUnitFromEnd(unitGroup, i), 1);
        } else if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) == "HeroBaleog") {
            UnitBehaviorAdd(UnitGroupUnitFromEnd(unitGroup, i), "LostVikingsSpecializedBaleogBehavior", UnitGroupUnitFromEnd(unitGroup, i), 1);
        } else if (UnitGetType(UnitGroupUnitFromEnd(unitGroup, i)) == "HeroOlaf") {
            UnitBehaviorAdd(UnitGroupUnitFromEnd(unitGroup, i), "LostVikingsSpecializedOlafBehavior", UnitGroupUnitFromEnd(unitGroup, i), 1);
        }
    }
    
    return true;
}

// ============================================================
// Truly Lost
// ============================================================
bool libHRGE_LostVikingsTrulyLostPeriodic (bool testConds, bool runActions) {
    int i;
    libGame_gf_ShareUnshareVisionOfAlliesForPlayer(false, libHRGE_player);
    for (i = 2; i <= 5; i += 1) {
        PlayerSetAlliance(i, c_allianceIdSeekHelp, libHRGE_player, false);
        PlayerSetAlliance(i, c_allianceIdGiveHelp, libHRGE_player, false);
    }
    PlayerSetAlliance(11, c_allianceIdSeekHelp, libHRGE_player, false);
    PlayerSetAlliance(11, c_allianceIdGiveHelp, libHRGE_player, false);
    VisRevealerEnable(libGame_gv_baseRevealers[libHRGE_player], false);

    return true;
}

// ============================================================
// Trilogy
// ============================================================
bool libHRGE_LostVikingsTrilogyAffixAdded (bool testConds, bool runActions) {
    libGDHL_gv_data_LostVikingsTheSequelDeathTimeReduction[libHRGE_player] = 0.8;

    return true;
}